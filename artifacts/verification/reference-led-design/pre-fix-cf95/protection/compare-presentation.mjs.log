import { createRequire } from 'node:module';
import { readFileSync, writeFileSync } from 'node:fs';
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { join } from 'node:path';
const root='/workspace/oda-reference-redesign';
const require=createRequire(join(root,'package.json'));
const ts=require('typescript');
const base='68ae8179c875b54ce8f200e34a6148259ae6cad1';
const files=['src/layout/AppShell.tsx','src/pages/Today.tsx','src/components/FocusTimerHub.tsx','src/pages/SoundRoom.tsx','src/pages/Coach.tsx','src/pages/Notebook.tsx','src/components/notebook/JournalWorkspace.tsx','src/components/notebook/NotebookCalendar.tsx'];
const sha=s=>createHash('sha256').update(s).digest('hex');
const tokenize=s=>{const x=ts.createScanner(ts.ScriptTarget.Latest,true,ts.LanguageVariant.JSX,s);const out=[];for(let token=x.scan();token!==ts.SyntaxKind.EndOfFileToken;token=x.scan())out.push([token,x.getTokenText()]);return JSON.stringify(out);};
function unwrap(n){while(n&&ts.isParenthesizedExpression(n))n=n.expression;return n;}
const isJsx=n=>n&&(ts.isJsxElement(n)||ts.isJsxFragment(n)||ts.isJsxSelfClosingElement(n));
function inspect(source,file){
 const sf=ts.createSourceFile(file,source,ts.ScriptTarget.Latest,true,ts.ScriptKind.TSX);const components={};
 const read=(name,fn)=>{if(!fn.body||!ts.isBlock(fn.body))return;const st=fn.body.statements.filter(n=>!(ts.isReturnStatement(n)&&isJsx(unwrap(n.expression))));const attrs=[];const visit=n=>{if(ts.isJsxAttribute(n)){const name=n.name.text;if(name.startsWith('on')||name==='ref'||name==='key'||['type','value','checked','disabled','hidden','maxLength','min','max','step','required','aria-label','aria-labelledby','aria-controls','aria-selected','aria-pressed','aria-current','aria-expanded','aria-live','aria-modal','aria-describedby','aria-relevant','aria-busy','aria-disabled','role','tabIndex','id','name','multiple','readOnly'].includes(name))attrs.push({name,value:tokenize(n.initializer?.getText(sf)??''),raw:n.getText(sf)});}ts.forEachChild(n,visit);};visit(fn.body);components[name]={controllerTokens:tokenize(st.map(n=>n.getText(sf)).join('\n')),attrs};};
 for(const statement of sf.statements){if(ts.isFunctionDeclaration(statement)&&statement.name)read(statement.name.text,statement);if(ts.isVariableStatement(statement))for(const d of statement.declarationList.declarations){if(ts.isIdentifier(d.name)&&d.initializer&&(ts.isArrowFunction(d.initializer)||ts.isFunctionExpression(d.initializer)))read(d.name.text,d.initializer);}}
 return components;
}
function delta(a,b){const key=x=>JSON.stringify({name:x.name,value:x.value});const before=new Map();for(const x of a){const k=key(x);before.set(k,[...(before.get(k)||[]),x]);}const added=[];for(const x of b){const k=key(x);const arr=before.get(k);if(arr?.length)arr.pop();else added.push(x.raw);}return {removed:[...before.values()].flat().map(x=>x.raw),added};}
const result={kind:'final independent presentation/controller static audit',base,cwd:root,head:execFileSync('git',['rev-parse','HEAD'],{cwd:root,encoding:'utf8'}).trim(),branch:execFileSync('git',['branch','--show-current'],{cwd:root,encoding:'utf8'}).trim(),sourceFrozen:true,testsRun:false,findings:[],limits:['Static code review and exact commit-bound source comparison only; browser geometry, contrast, hit tests and real browser/device behavior remain separate QA evidence.'],files:[]};
for(const file of files){const old=execFileSync('git',['show',`${base}:${file}`],{cwd:root,encoding:'utf8'});const now=readFileSync(join(root,file),'utf8');const a=inspect(old,file),b=inspect(now,file);const names=Object.keys(a).filter(n=>b[n]);result.files.push({file,baseSha256:sha(old),currentSha256:sha(now),controllers:names.map(n=>({component:n,unchanged:a[n].controllerTokens===b[n].controllerTokens,afterKnownDecorativeStatementRemovalUnchanged:a[n].controllerTokens===inspect(now.replace("  const scene = SECTION_SCENES[SOUND_ROOM_SECTIONS.find((item) => item.sounds.some((entry) => entry.track === player.track))?.id ?? 'relax'];\n",''),file)[n].controllerTokens})),semanticAttributeChanges:names.map(n=>({component:n,...delta(a[n].attrs,b[n].attrs)})).filter(x=>x.removed.length||x.added.length),removedPresentationFunctions:Object.keys(a).filter(n=>!b[n]),addedPresentationFunctions:Object.keys(b).filter(n=>!a[n])});}
writeFileSync('/workspace/scratch/oda-reference-redesign/independent/protection/presentation-static-final.json',JSON.stringify(result,null,2)+'\n');
console.log(JSON.stringify({files:result.files.length,controllers:result.files.flatMap(f=>f.controllers).length,changedControllers:result.files.flatMap(f=>f.controllers.filter(c=>!c.unchanged).map(c=>({file:f.file,...c}))),semanticDeltas:result.files.filter(f=>f.semanticAttributeChanges.length).map(f=>({file:f.file,changes:f.semanticAttributeChanges})),presentationFunctionChanges:result.files.filter(f=>f.removedPresentationFunctions.length||f.addedPresentationFunctions.length).map(f=>({file:f.file,removed:f.removedPresentationFunctions,added:f.addedPresentationFunctions})),receipt:'/workspace/scratch/oda-reference-redesign/independent/protection/presentation-static-final.json'},null,2));
