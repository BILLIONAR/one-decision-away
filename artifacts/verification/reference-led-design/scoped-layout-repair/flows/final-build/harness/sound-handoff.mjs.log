import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { mkdirSync, writeFileSync } from 'node:fs';
import { observeNativeAudio, nativeGraphStarts, requireNoGraphRestart, visibleInsideViewport, remainingSeconds } from './native-audio-observer.mjs';

if (process.env.ODA_SCOPED_REPAIR_GO !== '1') throw new Error('Not executed: explicit root source/build GO required.');
const repo = process.env.ODA_QA_REPO;
const require = createRequire(`${repo}/package.json`);
const { chromium } = require('playwright');
const { getInitialDemoState } = await import(`${repo}/src/services/repository.ts`);
const { readPersonalRecordFixture } = await import(`${repo}/scripts/qa-personal-record-fixtures.mjs`);
const { TIMER_CHOICES } = await import(`${repo}/src/services/soundRoom.ts`);
const base = process.env.ODA_QA_URL;
const out = process.env.ODA_QA_OUT;
mkdirSync(out, { recursive: true });
const report = { sourceCommit: process.env.ODA_QA_SOURCE_COMMIT, synthetic: true, checks: [], screenshots: [], errors: [], blockedExternal: [], selectorFreezeReviewed: true, limitations: ['Actual native Chromium graph-start observation, no synthetic audio clock.', 'Browser web access behavior only; native billing protections are explicitly bound by unchanged sources and parent aggregate tests.', 'Selectors must be reviewed against the final frozen source before execution.'] };
const browser = await chromium.launch({ executablePath: '/usr/bin/chromium' });
const context = await browser.newContext({ viewport: { width: 390, height: 844 }, reducedMotion: 'reduce', serviceWorkers: 'block' });
const origin = new URL(base).origin;
await context.route('**/*', route => {
  if (new URL(route.request().url()).origin === origin && ['GET', 'HEAD'].includes(route.request().method())) return route.continue();
  report.blockedExternal.push(route.request().url()); return route.abort();
});
const seed = getInitialDemoState();
seed.profile = { ...seed.profile, displayName: 'Synthetic Sound handoff QA', locale: 'en', theme: 'light', onboardingStep: 'completed', soundMuted: false, nudgesEnabled: false, dailyWisdomEnabled: false };
await context.addInitScript(({ seed }) => {
  if (!localStorage.getItem('one_decision_away_app_data_v1')) localStorage.setItem('one_decision_away_app_data_v1', JSON.stringify(seed));
  localStorage.setItem('oda_locale', 'en'); localStorage.setItem('oda_theme', 'light');
}, { seed });
await context.addInitScript(observeNativeAudio);
const page = await context.newPage(); page.setDefaultTimeout(8000);
page.on('pageerror', error => report.errors.push(error.message));
const pass = (name, evidence) => { report.checks.push({ name, evidence }); console.log(`PASS ${name}`); };
const capture = async name => { await page.screenshot({ path: `${out}/${name}.png`, animations: 'disabled' }); report.screenshots.push(`${name}.png`); };
const expanded = page.locator('[data-sound-surface="expanded"]');
const mini = page.locator('[data-sound-surface="mini"]');
const status = surface => surface.locator('.oda-sound-player-status,.oda-sound-now-status').first();
const toggle = surface => surface.locator('[data-sound-control="toggle"]');
const timer = surface => surface.locator('[data-sound-control="timer"]');
const volume = surface => surface.locator('[data-sound-control="volume"]');
const until = async (predicate, label) => {
  const end = Date.now() + 4000;
  do { if (await predicate()) return; await page.waitForTimeout(50); } while (Date.now() < end);
  throw new Error(`Actual visibility handoff did not settle: ${label}`);
};
const showExpanded = async () => {
  await expanded.locator('.oda-sound-now-control-surface').evaluate(element => element.scrollIntoView({ block: 'center' }));
  await until(async () => await expanded.getAttribute('data-primary') === 'true' && await mini.count() === 0, 'expanded primary, mini hidden');
};
const showMini = async () => {
  await page.evaluate(() => window.scrollTo(0, 0));
  await until(async () => await expanded.getAttribute('data-primary') !== 'true' && await visibleInsideViewport(mini), 'expanded outside viewport, mini restored');
};
try {
  await page.goto(`${base}/app/sound`);
  await page.getByRole('tablist').waitFor();
  const beforeRecords = await readPersonalRecordFixture(page);
  const card = page.locator('.oda-sound-panel .oda-sound-card-button').first();
  const name = await card.locator('.oda-sound-card-name').innerText();
  await card.click(); await expanded.waitFor(); await showExpanded();
  assert.equal(await expanded.locator('h2').innerText(), name);
  assert.ok((await nativeGraphStarts(page)).length > 0, 'Trusted selection must start actual native synthesis');
  assert.ok(await toggle(expanded).isVisible()); assert.ok(await timer(expanded).isVisible()); assert.ok(await volume(expanded).isVisible());
  pass('Expanded primary exposes accessible real controls without a duplicate fixed mini-player');
  assert.deepEqual(await timer(expanded).locator('option').evaluateAll(options => options.map(option => option.value)), ['', ...TIMER_CHOICES.map(String)]);
  for (const value of ['', ...TIMER_CHOICES.map(String)]) {
    await timer(expanded).selectOption(value); assert.equal(await timer(expanded).inputValue(), value);
  }
  await timer(expanded).focus(); await page.keyboard.press('Home'); await page.keyboard.press('ArrowDown'); await page.keyboard.press('Enter');
  assert.equal(await timer(expanded).inputValue(), String(TIMER_CHOICES[0]));
  await page.keyboard.press('End'); await page.keyboard.press('Enter'); assert.equal(await timer(expanded).inputValue(), String(TIMER_CHOICES.at(-1)));
  pass('Every actual native timer option and first/final keyboard choice stays operable');
  await timer(expanded).selectOption(String(TIMER_CHOICES[0]));
  await volume(expanded).focus(); await page.keyboard.press('Home');
  for (let index = 0; index < 21; index++) await page.keyboard.press('ArrowRight');
  assert.equal(await volume(expanded).inputValue(), '0.21');
  const graph = await nativeGraphStarts(page);
  const startedRemaining = remainingSeconds(await status(expanded).innerText());
  await page.waitForTimeout(2200); await timer(expanded).focus(); await showMini();
  await page.waitForFunction(() => document.activeElement?.closest('[data-sound-surface="mini"]') && document.activeElement?.dataset.soundControl === 'timer');
  assert.equal(await mini.locator('.oda-sound-player-name').innerText(), name);
  assert.equal(await timer(mini).inputValue(), String(TIMER_CHOICES[0]));
  assert.equal(await volume(mini).inputValue(), '0.21');
  const runningRemaining = remainingSeconds(await status(mini).innerText());
  assert.ok(runningRemaining < startedRemaining && startedRemaining - runningRemaining < 12, 'Visibility handoff must retain actual elapsed countdown');
  pass('Scrolling restores mini-player with unchanged name, volume, timer and running countdown', await requireNoGraphRestart(page, graph, 'running handoff'));
  await capture('sound-running-mini-390');
  await toggle(mini).click();
  const pausedLabel = await toggle(mini).getAttribute('aria-label');
  const pausedRemaining = remainingSeconds(await status(mini).innerText());
  const pausedGraph = await nativeGraphStarts(page);
  await timer(mini).focus(); await showExpanded();
  await page.waitForFunction(() => document.activeElement?.closest('[data-sound-surface="expanded"]') && document.activeElement?.dataset.soundControl === 'timer');
  await page.waitForTimeout(1300);
  assert.equal(await toggle(expanded).getAttribute('aria-label'), pausedLabel);
  assert.equal(remainingSeconds(await status(expanded).innerText()), pausedRemaining);
  assert.equal(await timer(expanded).inputValue(), String(TIMER_CHOICES[0])); assert.equal(await volume(expanded).inputValue(), '0.21');
  pass('Native timer focus transfers to corresponding expanded control; paused remaining time, timer and volume stay frozen', await requireNoGraphRestart(page, pausedGraph, 'paused handoff'));
  await capture('sound-paused-expanded-390');
  await toggle(expanded).click();
  const resumedGraph = await nativeGraphStarts(page);
  const resumedRemaining = remainingSeconds(await status(expanded).innerText());
  assert.ok(Math.abs(resumedRemaining - pausedRemaining) <= 1, 'Resume must keep paused remaining time');
  await showMini(); await showExpanded();
  pass('Repeated running handoffs keep the resumed graph and remaining timer', await requireNoGraphRestart(page, resumedGraph, 'repeated handoff'));
  const disclosure = page.locator('.oda-sound-panel .oda-sound-card-rationale').first();
  await disclosure.locator('summary').focus(); await page.keyboard.press('Enter');
  assert.ok(await disclosure.getAttribute('open') !== null);
  await page.keyboard.press('Enter'); assert.equal(await disclosure.getAttribute('open'), null);
  pass('Session rationale disclosure uses native keyboard controls without restarting synthesis', await requireNoGraphRestart(page, resumedGraph, 'session disclosure'));
  await page.getByRole('tab').first().focus(); await page.keyboard.press('End');
  assert.equal(await page.getByRole('tab', { selected: true }).getAttribute('data-section'), 'breathe');
  await page.getByRole('button', { name: 'Silent guide', exact: true }).click();
  assert.ok(await page.getByRole('button', { name: 'Stop the silent guide', exact: true }).isVisible());
  await page.getByRole('button', { name: 'Stop the silent guide', exact: true }).click();
  pass('Fourth Breathe tab and silent-guide toggle remain keyboard-reachable without starting a new graph', await requireNoGraphRestart(page, resumedGraph, 'silent guide'));
  await page.getByRole('button', { name: 'Start with the tone', exact: true }).click();
  assert.ok((await nativeGraphStarts(page)).length > resumedGraph.length);
  await page.getByRole('button', { name: 'Pause the tone', exact: true }).click();
  pass('Trusted Breathe tone action starts and pauses actual synthesis');
  await capture('sound-breathe-390');
  assert.deepEqual(await readPersonalRecordFixture(page), beforeRecords);
  assert.deepEqual(report.errors, []); assert.deepEqual(report.blockedExternal, []);
  report.status = 'passed';
} catch (error) {
  report.status = 'failed'; report.failure = String(error.stack || error); process.exitCode = 1;
  await capture('failure').catch(() => {}); console.error(report.failure);
} finally {
  await browser.close(); report.finishedAt = new Date().toISOString();
  writeFileSync(`${out}/sound-handoff-report.json`, JSON.stringify(report, null, 2));
}
