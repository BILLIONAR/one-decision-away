import fs from'node:fs';import assert from'node:assert/strict';import{chromium}from'/workspace/oda-reference-redesign/node_modules/playwright/index.mjs';import{getInitialDemoState}from'/workspace/oda-reference-redesign/src/services/repository.ts';
const out='/workspace/scratch/oda-reference-redesign/scoped-layout-repair/working-surfaces';const base='http://127.0.0.1:4181';const report={kind:'Actual UI-created Read two pages with no synthetic kept records; author current dev source',cases:[],errors:[]};const browser=await chromium.launch({executablePath:'/usr/bin/chromium'});
try{for(const theme of['light','dark'])for(const width of[320,390]){const seed=getInitialDemoState();Object.assign(seed.profile,{onboardingStep:'completed',displayName:'Synthetic layout review',locale:'en',theme,soundMuted:true,nudgesEnabled:false,dailyWisdomEnabled:false,focusTabBlinkEnabled:false,focusScreenPulseEnabled:false});seed.missions=[];const ctx=await browser.newContext({viewport:{width,height:844},serviceWorkers:'block',reducedMotion:'reduce'});await ctx.route('**/*',r=>new URL(r.request().url()).origin===base?r.continue():r.abort());await ctx.addInitScript(({seed,theme})=>{localStorage.setItem('one_decision_away_app_data_v1',JSON.stringify(seed));localStorage.setItem('oda_locale','en');localStorage.setItem('oda_theme',theme);},{seed,theme});const page=await ctx.newPage();page.on('pageerror',e=>report.errors.push(e.message));await page.goto(base+'/app');await page.locator('#today-decision-input').fill('Read two pages');await page.locator('#set-one-decision form button[type="submit"]').click();await page.locator('.oda-decision-action').waitFor();const rect=await page.locator('.oda-decision-action').boundingBox();assert.ok(rect.y+rect.height<765);assert.equal(await page.locator('.oda-fidelity-command [data-tree-stage]').count(),1);assert.equal(await page.locator('.oda-growth-panel [data-kept-count]').getAttribute('data-kept-count'),'0');assert.equal(await page.locator('.oda-growth-week').getAttribute('data-kept-days'),'0');await page.evaluate(()=>document.fonts.ready);await page.screenshot({path:out+`/zero-kept-en-${theme}-${width}-today.png`,animations:'disabled'});await page.locator('.oda-growth-panel').screenshot({path:out+`/zero-kept-en-${theme}-${width}-growth.png`,animations:'disabled'});report.cases.push({theme,width,start:rect,principalTrees:1,kept:0,week:0});if(theme==='light'&&width===390){await page.locator('.oda-decision-action').click();await page.getByRole('timer').waitFor();const time=await page.getByRole('timer').innerText();assert.ok(time==='2:00'||time==='1:59');await page.waitForFunction(()=>JSON.parse(localStorage.getItem('one_decision_away_app_data_v1')).missions.some(m=>m.title==='Read two pages'&&m.startedAt));await page.screenshot({path:out+'/zero-kept-en-light-390-actual-two-minute-start.png',animations:'disabled'});await page.getByRole('button',{name:'Stop',exact:true}).click();assert.equal(await page.getByRole('timer').count(),0);assert.equal(await page.locator('.oda-growth-panel [data-kept-count]').getAttribute('data-kept-count'),'0');report.cases.at(-1).actualTwoMinuteStartStop=true;report.cases.at(-1).observedTime=time;}await ctx.close();}assert.deepEqual(report.errors,[]);report.status='passed';}catch(error){report.status='failed';report.failure=String(error.stack||error);console.error(report.failure);process.exitCode=1;}finally{await browser.close();fs.writeFileSync(out+'/zero-state-report.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report));}
