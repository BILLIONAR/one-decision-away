+.oda-fidelity-today .oda-growth-actions .oda-decision { --bg: var(--surface); --bg-elevated: var(--surface); --bg-muted: var(--work-bg); --fg: var(--work-ink); --fg-muted: var(--work-muted); --fg-subtle: var(--work-subtle); --accent: var(--work-accent); --on-accent: var(--work-on-accent); --accent-soft: var(--work-soft); --border: var(--work-border); --surface-border: var(--work-border); --brand-burgundy: var(--work-accent); --primary-grad: var(--work-primary); --on-primary: var(--work-on-primary); padding: 20px; border-radius: 18px; border: 1px solid var(--border); background: var(--surface); color: var(--fg); box-shadow: var(--surface-shadow); }
