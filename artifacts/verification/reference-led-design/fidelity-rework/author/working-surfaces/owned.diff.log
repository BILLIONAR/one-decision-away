+.oda-fidelity-focus #focus-timer-hub > div:first-child { padding-bottom: 14px; border-bottom: 1px solid var(--border); }
+.oda-fidelity-focus #focus-timer-hub button { border-radius: 10px; min-height: 44px; }
+.oda-fidelity-focus #focus-timer-hub select, .oda-fidelity-focus #focus-timer-hub input { border-radius: 10px; }
+.oda-fidelity-focus .oda-focus-launch { display: grid; gap: 12px; padding: 20px; border: 1px solid var(--border); border-radius: 16px; background: var(--surface); }
+.oda-fidelity-focus .oda-focus-launch > div:first-child { text-align: center; }
+.oda-fidelity-focus .oda-focus-duration { font-size: clamp(3rem, 6vw, 4rem); line-height: 1.15; margin-top: .35rem; letter-spacing: -.04em; font-variant-numeric: tabular-nums; color: var(--fg); }
+.oda-fidelity-focus .oda-focus-launch > div:last-child { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; text-align: center; }
+.oda-fidelity-focus .oda-focus-launch button { width: 100%; min-height: 48px !important; background: var(--accent); color: var(--on-accent); }
+.oda-fidelity-focus .oda-focus-launch > div:last-child > span { font-size: .75rem; }
+@container oda-working-today (min-width: 900px) {
+  .oda-fidelity-command { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.08fr) minmax(210px, .72fr); grid-template-rows: auto auto; gap: 16px; }
+  .oda-fidelity-command .oda-fidelity-hero { grid-column: 1; grid-row: 1 / span 2; min-height: 580px; align-self: stretch; }
+  .oda-fidelity-command .oda-growth-actions { grid-column: 2; grid-row: 1 / span 2; }
+  .oda-fidelity-command .oda-growth-panel { grid-column: 3; grid-row: 1; width: 100%; }
+  .oda-fidelity-command .oda-growth-week { grid-column: 3; grid-row: 2; }
+  .oda-fidelity-support { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+@media (min-width: 1000px) {
+  .oda-focus-workbench { grid-template-columns: minmax(190px, .65fr) minmax(0, 1.35fr); }
+  .oda-focus-workbench > .oda-focus-illustration { grid-column: 1; grid-row: 1; }
+  .oda-focus-workbench > #focus-timer-hub { grid-column: 2; grid-row: 1; }
+  .oda-focus-illustration { height: 520px; }
+}
+@media (max-width: 479px) {
+  .oda-fidelity-today > header > div > p { font-size: 11px; }
+  .oda-fidelity-today > header .oda-today-headline { font-size: 1.4rem; }
+  .oda-fidelity-today > header > button { padding-inline: 9px; font-size: .75rem; }
+  .oda-fidelity-today .oda-fidelity-hero { min-height: 370px; padding: 20px; }
+  .oda-fidelity-hero-art { height: 230px; padding: 8px; }
+  .oda-fidelity-hero-art .oda-evidence-tree { width: 240px; }
+  .oda-fidelity-hero-art::before { width: 180px; height: 205px; top: 10px; }
+  .oda-fidelity-hero-art::after { width: 155px; height: 13px; top: 202px; }
+  .oda-fidelity-hero-copy { margin-top: 205px; }
+  .oda-fidelity-today .oda-fidelity-hero blockquote { font-size: 1.5rem; }
+  .oda-fidelity-today .oda-growth-actions .oda-decision { padding: 18px; }
+  .oda-fidelity-today .oda-growth-panel { display: grid; grid-template-columns: minmax(0, 1fr) 130px; align-items: center; gap: 8px; padding: 16px; }
+  .oda-fidelity-today .oda-growth-panel .oda-evidence-tree { grid-column: 2; grid-row: 1 / span 2; width: 130px; }
+  .oda-fidelity-today .oda-growth-caption { grid-column: 1; }
+  .oda-fidelity-today .oda-growth-week { padding: 16px; }
+  .oda-focus-illustration { height: 180px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .oda-fidelity-today *, .oda-fidelity-focus * { scroll-behavior: auto; }
+}
