import fs from 'node:fs';
import assert from 'node:assert/strict';
import {chromium} from '/workspace/oda-reference-redesign/node_modules/playwright/index.mjs';
import {getInitialDemoState} from '/workspace/oda-reference-redesign/src/services/repository.ts';
const out='/workspace/scratch/oda-reference-redesign/fidelity-rework/working-surfaces/correction-6d4';const base='http://127.0.0.1:4181';const report={at:new Date().toISOString(),kind:'Author focused interactions against current dev source with synthetic isolated profile',checks:[],errors:[]};const browser=await chromium.launch({executablePath:'/usr/bin/chromium'});const ctx=await browser.newContext({viewport:{width:390,height:844},reducedMotion:'reduce',serviceWorkers:'block'});const seed=getInitialDemoState();Object.assign(seed.profile,{onboardingStep:'completed',locale:'en',theme:'light',soundMuted:true,nudgesEnabled:false,dailyWisdomEnabled:false});const today=new Date().toISOString().slice(0,10);seed.missions.push({id:'surface-current',userId:seed.profile.id,title:'Synthetic actual two-minute review mission',type:'daily_quest',area:'Learning',difficulty:'easy',estimatedMinutes:2,isOneDecision:true,status:'active',scheduledFor:today,createdAt:new Date().toISOString()});await ctx.route('**/*',r=>new URL(r.request().url()).origin===base?r.continue():r.abort());await ctx.addInitScript(seed=>{localStorage.setItem('one_decision_away_app_data_v1',JSON.stringify(seed));localStorage.setItem('oda_locale','en');localStorage.setItem('oda_theme','light');},seed);const page=await ctx.newPage();page.on('pageerror',e=>report.errors.push(e.message));
try{
await page.goto(base+'/app/notebook');const content=page.locator('#notebook-journal-content');await content.fill('Existing synthetic draft must survive date filters and section changes.');await page.locator('#notebook-journal-title').fill('Synthetic preserved draft');await page.getByRole('button',{name:'Practices',exact:true}).click();await page.getByRole('button',{name:'Journal',exact:true}).click();assert.equal(await content.inputValue(),'Existing synthetic draft must survive date filters and section changes.');
const writingDate=await page.locator('.oda-notebook-editor-heading p').innerText();const week=page.locator('.oda-notebook-week-strip button');assert.equal(await week.count(),7);await week.first().click();assert.equal(await content.inputValue(),'Existing synthetic draft must survive date filters and section changes.');assert.equal(await page.locator('.oda-notebook-editor-heading p').innerText(),writingDate);await page.locator('[aria-controls="notebook-calendar"]').click();const region=page.locator('.oda-notebook-calendar-scroll');const dates=region.locator('tbody button');const hitTargets=await dates.evaluateAll(list=>list.map(el=>({w:el.getBoundingClientRect().width,h:el.getBoundingClientRect().height})));assert.ok(hitTargets.every(r=>r.w>=44&&r.h>=44));assert.equal(await region.getAttribute('role'),'region');assert.equal(await region.getAttribute('tabindex'),'0');await region.focus();await page.keyboard.press('ArrowRight');await page.waitForFunction(()=>document.querySelector('.oda-notebook-calendar-scroll').scrollLeft>0);const sunday=region.locator('tbody tr td:last-child button').first();await sunday.focus();await page.keyboard.press('Enter');assert.equal(await sunday.getAttribute('aria-pressed'),'true');assert.ok(await region.evaluate(el=>el.scrollLeft>0));assert.equal(await content.inputValue(),'Existing synthetic draft must survive date filters and section changes.');await page.getByRole('button',{name:'All dates',exact:true}).click();report.checks.push({name:'Draft survives practices/journal toggle and real weekend archive filter; 44 px targets and keyboard horizontal scrolling',hitTargets:hitTargets.length});
await page.goto(base+'/app/focus');await page.locator('.oda-focus-duration').waitFor();assert.equal(await page.locator('.oda-focus-duration').innerText(),'25:00');await page.getByRole('button',{name:'15 min Sprint',exact:true}).click();assert.equal(await page.locator('.oda-focus-duration').innerText(),'15:00');await page.locator('#focus-mission').selectOption('surface-current');assert.equal(await page.locator('.oda-focus-duration').innerText(),'02:00');assert.ok(await page.locator('.oda-focus-launch button').innerText().then(x=>x.includes('2 min')));await page.locator('.oda-focus-launch button').click();await page.getByRole('button',{name:'Pause',exact:true}).waitFor();await page.getByRole('button',{name:'Pause',exact:true}).click();await page.getByRole('button',{name:'Resume',exact:true}).waitFor();assert.ok((await page.locator('body').innerText()).includes('02:00')||(await page.locator('body').innerText()).includes('01:59'));await page.screenshot({path:out+'/en-light-390-actual-focus-paused.png',animations:'disabled'});await page.getByRole('button',{name:'End early',exact:true}).click();await page.getByRole('button',{name:'End session',exact:true}).click();await page.locator('#focus-timer-hub').waitFor();report.checks.push({name:'Promoted readout reflects actual preset then actual mission minutes; Start opens real 120 second timer, Pause and End work'});
await page.goto(base+'/app/courses');await page.locator('[data-course-id="focus"]').click();assert.equal(await page.locator('[data-course-overview-lesson]').count(),5);const start=page.locator('#course-start-lesson');assert.ok((await start.innerText()).includes('Start lesson 1'));const at=await start.boundingBox();assert.ok(at.y+at.height<765);await start.click();await page.locator('.oda-course-step[aria-current="step"]').waitFor();report.checks.push({name:'Untouched course has five real roadmap lessons and first-fold Start lesson 1 enters actual lesson',startRect:at});assert.deepEqual(report.errors,[]);report.status='passed';
}catch(error){report.status='failed';report.failure=String(error.stack||error);process.exitCode=1;console.error(report.failure);await page.screenshot({path:out+'/interaction-failure.png',animations:'disabled'}).catch(()=>{});}finally{await browser.close();fs.writeFileSync(out+'/interaction-report.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report));}
