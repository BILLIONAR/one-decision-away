function fixture(locale,theme){const seed=structuredClone(getInitialDemoState());const now=new Date();const today=now.toISOString().slice(0,10);Object.assign(seed.profile,{displayName:'Synthetic surface review',onboardingStep:'completed',locale,theme,firstOpenedAt:'2026-08-01T12:00:00.000Z',soundMuted:true,simpleModeOff:true,nudgesEnabled:false,dailyWisdomEnabled:false});seed.missions=Array.from({length:12},(_,i)=>{const day=new Date(now);day.setUTCDate(day.getUTCDate()-i-1);const at=day.toISOString();return {id:`surface-kept-${i}`,userId:seed.profile.id,title:'Synthetic saved review decision',type:'daily_quest',area:'Learning',difficulty:'easy',estimatedMinutes:2,isOneDecision:true,status:'completed',scheduledFor:at.slice(0,10),createdAt:at,completedAt:at};});seed.missions.push({id:'surface-current',userId:seed.profile.id,title:'Read one page and write one useful sentence',type:'daily_quest',area:'Learning',difficulty:'easy',estimatedMinutes:2,isOneDecision:true,status:'active',scheduledFor:today,createdAt:now.toISOString()});return seed;}
async function capture(page,label,scope){await page.evaluate(()=>document.fonts.ready);await page.locator(scope).waitFor();const geometry=await page.evaluate(scope=>{const root=document.querySelector(scope);const rect=el=>{const r=el.getBoundingClientRect();return {x:r.x,y:r.y,width:r.width,height:r.height,right:r.right};};const selectors=['.oda-fidelity-command','.oda-fidelity-hero','.oda-fidelity-hero-art','.oda-decision','.oda-growth-panel','.oda-growth-week','.oda-notebook-workspace','.oda-notebook-reflection-hero','.oda-notebook-editor','.oda-notebook-archive','.oda-notebook-calendar-scroll','.oda-course-intro','.oda-course-overview','.oda-course-map','#focus-timer-hub','.oda-focus-illustration'];return {viewport:innerWidth,pageWidth:document.documentElement.scrollWidth,root:rect(root),elements:Object.fromEntries(selectors.flatMap(s=>{const el=root.querySelector(s);return el?[[s,{...rect(el),display:getComputedStyle(el).display}]]:[]})),images:[...root.querySelectorAll('img')].map(el=>({src:el.currentSrc,complete:el.complete,naturalWidth:el.naturalWidth,...rect(el)}))};},scope);const axe=await new AxeBuilder({page}).include(scope).withTags(['wcag2a','wcag2aa','wcag21a','wcag21aa']).analyze();await page.screenshot({path:`${out}/${label}.png`,fullPage:false,animations:'disabled'});report.cases.push({label,scope,geometry,axe:axe.violations.map(v=>({id:v.id,impact:v.impact,nodes:v.nodes.map(n=>({target:n.target,summary:n.failureSummary,html:n.html}))}))});console.log(label,JSON.stringify({pageWidth:geometry.pageWidth,viewport:geometry.viewport,violations:axe.violations.map(v=>v.id)}));}
try{for(const item of [{locale:'en',theme:'light',width:1440,height:1000},{locale:'en',theme:'light',width:390,height:844},{locale:'tr',theme:'dark',width:320,height:844},{locale:'es',theme:'light',width:390,height:844}]){const {locale,theme,width,height}=item;const label=`${locale}-${theme}-${width}`;const seed=fixture(locale,theme);const ctx=await browser.newContext({viewport:{width,height},reducedMotion:'reduce',serviceWorkers:'block'});await ctx.route('**/*',route=>new URL(route.request().url()).origin===new URL(base).origin?route.continue():route.abort());await ctx.addInitScript(({seed,locale,theme})=>{localStorage.setItem('one_decision_away_app_data_v1',JSON.stringify(seed));localStorage.setItem('oda_locale',locale);localStorage.setItem('oda_theme',theme);},{seed,locale,theme});const page=await ctx.newPage();page.on('pageerror',e=>report.errors.push({label,error:e.message}));
for(const [route,scope,name] of [['today','.oda-fidelity-today','today'],['notebook','.oda-notebook-fidelity','notebook'],['focus','.oda-fidelity-focus','focus'],['courses','.oda-courses-fidelity','courses']]){await page.goto(base+(route==='today'?'/app':'/app/'+route));await capture(page,`${label}-${name}`,scope);if(route==='notebook'){await page.locator('[aria-controls="notebook-calendar"]').click();await page.locator('.oda-notebook-calendar-scroll').scrollIntoViewIfNeeded();await page.screenshot({path:`${out}/${label}-notebook-calendar.png`,animations:'disabled'});report.cases.at(-1).calendar=await page.locator('.oda-notebook-calendar-scroll').evaluate(el=>({region:el.getAttribute('role'),tabIndex:el.tabIndex,label:el.getAttribute('aria-label'),client:el.clientWidth,scroll:el.scrollWidth,hintVisible:getComputedStyle(el.parentElement.querySelector('.oda-notebook-calendar-scroll-hint')).display,dates:[...el.querySelectorAll('tbody button')].map(b=>({width:b.getBoundingClientRect().width,height:b.getBoundingClientRect().height}))}));}
if(route==='courses'){await page.locator('[data-course-id="focus"]').click();await capture(page,`${label}-course-overview`,scope);await page.locator('.oda-course-overview .oda-course-primary').click();await capture(page,`${label}-course-lesson`,scope);}}
await ctx.close();}report.status=report.errors.length?'runtime-errors':'captured';}catch(error){report.status='failed';report.failure=String(error.stack||error);console.error(report.failure);process.exitCode=1;}finally{await browser.close();fs.writeFileSync(`${out}/preview-report.json`,JSON.stringify(report,null,2)+'\n');}
