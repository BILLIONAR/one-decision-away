l(metrics.week,'0');assert.equal(metrics.pageWidth,390);assert.ok(metrics.start.bottom<765);const file=`same-fixture-${theme}-390-today.png`;await p.screenshot({path:out+'/'+file,animations:'disabled'});const bytes=fs.readFileSync(out+'/'+file);report.cases.push({theme,file,bytes:bytes.length,sha256:crypto.createHash('sha256').update(bytes).digest('hex'),metrics,axe:axe.violations.map(v=>({id:v.id,nodes:v.nodes.map(n=>n.failureSummary)}))});console.log(JSON.stringify(report.cases.at(-1)));await c.close();}await b.close();fs.writeFileSync(out+'/same-fixture-report.json',JSON.stringify(report,null,2)+'\n');
