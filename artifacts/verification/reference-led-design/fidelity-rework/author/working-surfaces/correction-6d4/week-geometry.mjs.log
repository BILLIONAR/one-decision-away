import fs from 'node:fs';import assert from 'node:assert/strict';import{chromium}from'/workspace/oda-reference-redesign/node_modules/playwright/index.mjs';import{getInitialDemoState}from'/workspace/oda-reference-redesign/src/services/repository.ts';const out='/workspace/scratch/oda-reference-redesign/fidelity-rework/working-surfaces/correction-6d4';const report={at:new Date().toISOString(),synthetic:true,cases:[],errors:[]};const b=await chromium.launch({executablePath:'/usr/bin/chromium'});
for(const [width,locale,theme] of [[390,'en','light'],[320,'tr','dark']]){const c=await b.newContext({viewport:{width,height:844},reducedMotion:'reduce',serviceWorkers:'block'});const seed=getInitialDemoState();Object.assign(seed.profile,{onboardingStep:'completed',locale,theme,soundMuted:true,nudgesEnabled:false,dailyWisdomEnabled:false});await c.route('**/*',r=>new URL(r.request().url()).origin==='http://127.0.0.1:4181'?r.continue():r.abort());await c.addInitScript(({seed,locale,theme})=>{localStorage.setItem('one_decision_away_app_data_v1',JSON.stringify(seed));localStorage.setItem('oda_locale',locale);localStorage.setItem('oda_theme',theme);},{seed,locale,theme});const p=await c.newPage();p.on('pageerror',e=>report.errors.push(e.message));await p.goto('http://127.0.0.1:4181/app/notebook');await p.locator('#notebook-journal-content').waitFor();await p.evaluate(()=>document.fonts.ready);const metrics=await p.evaluate(()=>{const r=document.querySelector('.oda-notebook-week-region'),content=document.querySelector('#notebook-journal-content').getBoundingClientRect();return{pageWidth:document.documentElement.scrollWidth,viewport:innerWidth,calendarExpanded:document.querySelector('[aria-controls="notebook-calendar"]').getAttribute('aria-expanded'),fullCalendarCount:document.querySelectorAll('.oda-notebook-calendar').length,weekClient:r.clientWidth,weekScroll:r.scrollWidth,weekHint:getComputedStyle(document.querySelector('.oda-notebook-week-hint')).display,targets:[...r.querySelectorAll('button')].map(e=>({width:e.getBoundingClientRect().width,height:e.getBoundingClientRect().height})),writingTop:content.y,writingHeight:content.height};});assert.equal(metrics.targets.length,7);assert.ok(metrics.targets.every(x=>x.width>=44&&x.height>=44));assert.equal(metrics.calendarExpanded,'false');assert.equal(metrics.fullCalendarCount,0);assert.equal(metrics.pageWidth,width);assert.ok(metrics.writingTop<765);const file=`final-empty-${locale}-${theme}-${width}-notebook.png`;await p.screenshot({path:out+'/'+file,animations:'disabled'});report.cases.push({width,locale,theme,file,metrics});await c.close();}await b.close();assert.deepEqual(report.errors,[]);report.status='passed';fs.writeFileSync(out+'/week-geometry-report.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report));
