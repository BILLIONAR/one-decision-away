import { createRequire } from 'node:module';import fs from 'node:fs';import { getInitialDemoState } from '/workspace/oda-reference-redesign/src/services/repository.ts';
const require=createRequire('/workspace/oda-reference-redesign/package.json');const {chromium}=require('playwright');const out='/workspace/scratch/oda-reference-redesign/fidelity-rework/sound/material-pass';const phase=process.argv[2];fs.mkdirSync(`${out}/${phase}`,{recursive:true});const report={phase,at:new Date().toISOString(),errors:[],external:[],images:[],screenshots:[]};
const browser=await chromium.launch({executablePath:'/usr/bin/chromium'});try{for(const theme of ['light','dark']){const seed=getInitialDemoState();Object.assign(seed.profile,{displayName:'Synthetic material review',locale:'en',theme,onboardingStep:'completed',firstOpenedAt:new Date().toISOString(),soundMuted:false});const context=await browser.newContext({viewport:{width:390,height:844},reducedMotion:'reduce',serviceWorkers:'block'});await context.route('**/*',route=>new URL(route.request().url()).origin==='http://127.0.0.1:4181'?route.continue():(report.external.push(route.request().url()),route.abort()));await context.addInitScript(({seed})=>{localStorage.setItem('one_decision_away_app_data_v1',JSON.stringify(seed));localStorage.setItem('oda_locale','en')},{seed});const page=await context.newPage();page.on('pageerror',e=>report.errors.push(e.message));await page.goto('http://127.0.0.1:4181/app/sound');await page.locator('.oda-sound').waitFor();await page.evaluate(()=>document.fonts.ready);for(let n=0;n<3&&await page.getByRole('dialog').count();n++)await page.keyboard.press('Escape');await page.waitForFunction(()=>[...document.querySelectorAll('.oda-sound-tab:not([data-section="breathe"]) img')].every(img=>img.complete&&img.naturalWidth>0));await page.screenshot({path:`${out}/${phase}/${theme}-390-discovery.png`,animations:'disabled'});report.screenshots.push(`${phase}/${theme}-390-discovery.png`);await page.locator('.oda-sound-card-button').first().click();await page.locator('.oda-sound-panel').evaluate(el=>el.scrollIntoView({block:'start'}));await page.screenshot({path:`${out}/${phase}/${theme}-390-detail.png`,animations:'disabled'});report.screenshots.push(`${phase}/${theme}-390-detail.png`);await page.locator('.oda-sound-now-panel').evaluate(el=>el.scrollIntoView({block:'start'}));await page.waitForFunction(()=>[...document.querySelectorAll('.oda-sound-now-art img')].every(img=>img.complete&&img.naturalWidth>0));await page.screenshot({path:`${out}/${phase}/${theme}-390-player.png`,animations:'disabled'});report.screenshots.push(`${phase}/${theme}-390-player.png`);report.images.push(await page.locator('.oda-sound-now-art img').evaluate(el=>({source:el.currentSrc,naturalWidth:el.naturalWidth,naturalHeight:el.naturalHeight,width:el.getBoundingClientRect().width,height:el.getBoundingClientRect().height})));await context.close();console.log(`CAPTURE ${phase} ${theme}`)}}finally{fs.writeFileSync(`${out}/${phase}/capture-report.json`,JSON.stringify(report,null,2)+'\n');await browser.close()}
