import { createRequire } from 'node:module';import fs from 'node:fs';import assert from 'node:assert/strict';import { getInitialDemoState } from '/workspace/oda-reference-redesign/src/services/repository.ts';
const require=createRequire('/workspace/oda-reference-redesign/package.json');const {chromium}=require('playwright');const AxeBuilder=require('@axe-core/playwright').default;const out='/workspace/scratch/oda-reference-redesign/fidelity-rework/sound/material-pass';const report={at:new Date().toISOString(),contexts:[],errors:[],external:[],limits:['Scoped cloud Chromium checks for changed decorative material; no physical device performance or audio-quality claim.']};
const browser=await chromium.launch({executablePath:'/usr/bin/chromium'});report.browser=await browser.version();try{for(const theme of ['light','dark'])for(const width of [390,320]){const seed=getInitialDemoState();Object.assign(seed.profile,{displayName:'Synthetic material QA',locale:'en',theme,onboardingStep:'completed',firstOpenedAt:new Date().toISOString(),soundMuted:false,nudgesEnabled:false,dailyWisdomEnabled:false});const context=await browser.newContext({viewport:{width,height:844},reducedMotion:'reduce',serviceWorkers:'block'});await context.route('**/*',route=>new URL(route.request().url()).origin==='http://127.0.0.1:4181'?route.continue():(report.external.push(route.request().url()),route.abort()));await context.addInitScript(({seed})=>{localStorage.setItem('one_decision_away_app_data_v1',JSON.stringify(seed));localStorage.setItem('oda_locale','en')},{seed});const page=await context.newPage();page.on('pageerror',e=>report.errors.push(e.message));await page.goto('http://127.0.0.1:4181/app/sound');await page.locator('.oda-sound').waitFor();await page.evaluate(()=>document.fonts.ready);for(let n=0;n<3&&await page.getByRole('dialog').count();n++)await page.keyboard.press('Escape');await page.waitForFunction(()=>[...document.querySelectorAll('.oda-sound-tab:not([data-section="breathe"]) img')].every(img=>img.complete&&img.naturalWidth>0));const cases=[];for(const state of ['discovery','active']){if(state==='active'){await page.locator('.oda-sound-card-button').first().click();await page.waitForFunction(()=>[...document.querySelectorAll('.oda-sound-now-art img')].every(img=>img.complete&&img.naturalWidth>0));await page.locator('.oda-sound-now-panel').evaluate(el=>el.scrollIntoView({block:'start'}));}const measures=await page.evaluate(()=>({width:document.documentElement.clientWidth,scroll:document.documentElement.scrollWidth}));assert.ok(measures.scroll<=measures.width+1);const axe=await new AxeBuilder({page}).include('.oda-sound').withTags(['wcag2a','wcag2aa','wcag21a','wcag21aa']).analyze();const violations=axe.violations.map(v=>({id:v.id,impact:v.impact,nodes:v.nodes.map(n=>({target:n.target,summary:n.failureSummary}))}));assert.equal(violations.length,0,JSON.stringify(violations));let timer=null;if(state==='active'){timer=await page.locator('.oda-sound-player-timer select').evaluate(el=>({width:el.getBoundingClientRect().width,minWidth:getComputedStyle(el).minWidth,height:el.getBoundingClientRect().height,computedWidth:getComputedStyle(el).width}));assert.ok(timer.width>=118);assert.equal(timer.minWidth,'118px');assert.ok(timer.height>=44);}cases.push({state,measures,violations,timer});}report.contexts.push({theme,width,cases});await context.close();console.log(`PASS material ${theme} ${width}`)}assert.equal(report.errors.length,0);assert.equal(report.external.length,0);}catch(error){report.failure=String(error);throw error;}finally{fs.writeFileSync(`${out}/focused-browser-report.json`,JSON.stringify(report,null,2)+'\n');await browser.close()}
