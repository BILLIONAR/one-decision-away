from pathlib import Path
import math, random
root=Path('/workspace/oda-reference-redesign/public/assets/oda/reference-fidelity')

def wrap(name,defs,body):
    text='<svg xmlns="http://www.w3.org/2000/svg" width="960" height="1280" viewBox="0 0 960 1280">\n'
    text+='<!-- Original static procedural ODA illustration; not the unavailable source photograph. No external resources, scripts or animation. -->\n'
    text+='<defs>'+defs+'</defs>\n'+body+'\n</svg>\n'
    (root/name).write_text(text)

# Curved fine leaflets replace broad graphic fans. Each frond has a bowed rib and tapered asymmetric leaves.
rng=random.Random(8617)
def bezier(points,t):
    s=1-t
    x=s*s*s*points[0][0]+3*s*s*t*points[1][0]+3*s*t*t*points[2][0]+t*t*t*points[3][0]
    y=s*s*s*points[0][1]+3*s*s*t*points[1][1]+3*s*t*t*points[2][1]+t*t*t*points[3][1]
    dx=3*s*s*(points[1][0]-points[0][0])+6*s*t*(points[2][0]-points[1][0])+3*t*t*(points[3][0]-points[2][0])
    dy=3*s*s*(points[1][1]-points[0][1])+6*s*t*(points[2][1]-points[1][1])+3*t*t*(points[3][1]-points[2][1])
    length=math.hypot(dx,dy)
    return x,y,dx/length,dy/length

def frond(points,length,opacity=1):
    items=[f'<g opacity="{opacity}">']
    for n in range(1,24):
        t=n/25
        x,y,tx,ty=bezier(points,t);nx,ny=-ty,tx
        leaf_len=length*(math.sin(math.pi*t)**.65)*(1-.45*t)*rng.uniform(.86,1.13)
        for side in [-1,1]:
            ln=leaf_len*rng.uniform(.9,1.1);wide=(5.3-3.4*t)*rng.uniform(.8,1.1)
            ex=x+tx*ln*.48+nx*ln*.79*side;ey=y+ty*ln*.48+ny*ln*.79*side+ln*.11
            c1x=x+tx*ln*.12+nx*ln*.58*side;c1y=y+ty*ln*.12+ny*ln*.58*side
            c2x=x+tx*ln*.22+nx*ln*.25*side;c2y=y+ty*ln*.22+ny*ln*.25*side
            bx=x+tx*wide;by=y+ty*wide
            items.append(f'<path fill="url(#leaf)" d="M{x:.1f} {y:.1f}Q{c1x:.1f} {c1y:.1f} {ex:.1f} {ey:.1f}Q{c2x:.1f} {c2y:.1f} {bx:.1f} {by:.1f}Z"/>')
            if n%3==0:
                items.append(f'<path fill="none" stroke="#64827B" stroke-opacity=".2" stroke-width=".8" d="M{x:.1f} {y:.1f}Q{c1x:.1f} {c1y:.1f} {ex:.1f} {ey:.1f}"/>')
    p=points
    items.append(f'<path fill="none" stroke="#29473F" stroke-width="2.8" d="M{p[0][0]} {p[0][1]}C{p[1][0]} {p[1][1]} {p[2][0]} {p[2][1]} {p[3][0]} {p[3][1]}"/>')
    items.append('</g>');return ''.join(items)

