# Fine foam follows an irregular crest; deeper turquoise layers, scattered flecks and soft reflection add water depth.
rng=random.Random(8663)
ocean_defs='''
<linearGradient id="water" x1=".05" x2=".95" y2="1"><stop stop-color="#245663"/><stop offset=".31" stop-color="#317980"/><stop offset=".62" stop-color="#205962"/><stop offset="1" stop-color="#102E43"/></linearGradient>
<radialGradient id="depth" cx=".3" cy=".35" r=".72"><stop stop-color="#7FBEB9" stop-opacity=".37"/><stop offset=".46" stop-color="#469993" stop-opacity=".18"/><stop offset="1" stop-color="#052333" stop-opacity=".44"/></radialGradient>
<linearGradient id="wave" x1=".1" x2=".8" y2="1"><stop stop-color="#78AEA6" stop-opacity=".55"/><stop offset=".4" stop-color="#2F8D86" stop-opacity=".36"/><stop offset="1" stop-color="#063241" stop-opacity=".4"/></linearGradient>
<filter id="grain" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency=".16 .28" numOctaves="2" seed="4" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
<filter id="foam" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency=".045 .10" numOctaves="2" seed="9" stitchTiles="stitch"/><feColorMatrix values="0 0 0 0 .66 0 0 0 0 .86 0 0 0 0 .81 0 0 0 .4 0"/></filter>
<clipPath id="foamBand"><path d="M-20 630C211 551 308 827 538 735S763 562 980 771L980 891C777 671 713 887 527 888S226 684-20 795Z"/></clipPath>
'''
ocean='<path fill="url(#water)" d="M0 0H960V1280H0Z"/><path fill="url(#depth)" d="M0 0H960V1280H0Z"/>'
ocean+='<path fill="url(#wave)" d="M-20 401C194 320 269 543 474 509S781 338 980 559V694C728 481 676 723 445 648S154 411-20 572Z"/>'
ocean+='<path fill="url(#wave)" d="M-20 637C213 542 310 828 538 735S765 562 980 771V995C726 766 652 1029 404 849S168 685-20 918Z"/>'
ocean+='<path filter="url(#foam)" opacity=".30" clip-path="url(#foamBand)" d="M0 500H960V990H0Z"/>'
for n in range(18):
    parts=[]
    offset=n*4.4
    for k in range(49):
        x=-10+k*21;y=654+102*math.sin(x/132)+42*math.cos(x/77)+offset+rng.uniform(-7,7)
        parts.append(('M' if k==0 else 'L')+f'{x:.1f} {y:.1f}')
    ocean+=f'<path fill="none" stroke="#D5EEE3" stroke-opacity="{.16-(n%4)*.016:.3f}" stroke-width="{.7+(n%3)*.25:.2f}" d="'+''.join(parts)+'"/>'
for n in range(250):
    x=rng.uniform(-5,970);crest=654+102*math.sin(x/132)+42*math.cos(x/77);y=crest+rng.uniform(0,85);r=rng.uniform(.6,2.0)
    ocean+=f'<ellipse fill="#D8F0E5" opacity="{rng.uniform(.10,.27):.2f}" cx="{x:.1f}" cy="{y:.1f}" rx="{r*1.9:.2f}" ry="{r*.55:.2f}" transform="rotate({rng.uniform(-35,35):.1f} {x:.1f} {y:.1f})"/>'
for n in range(32):
    x=rng.uniform(145,765);y=rng.uniform(220,560);span=rng.uniform(10,66)
    ocean+=f'<path fill="none" stroke="#AADBD3" stroke-opacity=".12" stroke-width=".9" d="M{x:.1f} {y:.1f}q{span/2:.1f} -2 {span:.1f} 0"/>'
ocean+='<path fill="#112C3E" fill-opacity=".14" d="M0 0H960V1280H0Z"/><path filter="url(#grain)" opacity=".041" d="M0 0H960V1280H0Z"/>'
wrap('sound-ocean.svg',ocean_defs,ocean)
for name in ['sound-dunes.svg','sound-palms.svg','sound-ocean.svg']:
    print(name,(root/name).stat().st_size)
