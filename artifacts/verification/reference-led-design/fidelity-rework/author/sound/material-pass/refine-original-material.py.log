    yr=657+610*t;cxr=823+141*t*t
    palms+=f'<path fill="none" stroke="#738378" stroke-opacity=".16" stroke-width="1.2" d="M{cxr-7-13*t:.1f} {yr:.1f}q{17+14*t:.1f} 8 {18+22*t:.1f} 0"/>'
left=[((155,580),(85,440),(-90,360),(-230,504)),((155,580),(70,325),(112,262),(171,253)),((155,580),(180,327),(266,268),(330,330)),((155,580),(334,355),(455,420),(466,552)),((155,580),(323,507),(460,611),(473,744)),((155,580),(263,584),(323,730),(319,846)),((155,580),(63,564),(-30,645),(-123,831))]
right=[((825,620),(673,435),(558,439),(532,535)),((825,620),(751,343),(812,318),(870,349)),((825,620),(862,385),(966,374),(1052,452)),((825,620),(1000,479),(1132,540),(1146,672)),((825,620),(971,600),(1038,760),(1029,870)),((825,620),(724,625),(647,744),(663,897))]
for p in left+right:palms+=frond(p,108)
palms+='<path fill="#102C36" fill-opacity=".18" d="M0 0H960V1280H0Z"/><path filter="url(#grain)" opacity=".038" d="M0 0H960V1280H0Z"/>'
