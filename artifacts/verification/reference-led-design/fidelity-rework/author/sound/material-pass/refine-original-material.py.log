<linearGradient id="trunk" x2="1" y2=".2"><stop stop-color="#0C2328"/><stop offset=".55" stop-color="#29443D"/><stop offset=".82" stop-color="#43534A"/><stop offset="1" stop-color="#152E2C"/></linearGradient>
<filter id="grain" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency=".18 .34" numOctaves="2" seed="6" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
