import { createRequire } from 'node:module';import assert from 'node:assert/strict';import fs from 'node:fs';import { getInitialDemoState } from '/workspace/oda-reference-redesign/src/services/repository.ts';
const require=createRequire('/workspace/oda-reference-redesign/package.json');const {chromium}=require('playwright');const AxeBuilder=require('@axe-core/playwright').default;const out='/workspace/scratch/oda-reference-redesign/fidelity-rework/sound';const report={cases:[],errors:[],screenshots:[],external:[],captureReadinessCorrection:'Wait only for the three displayed band images; the fourth Breathe footer has deliberately hidden/lazy art. Initial harness timeout retained separately.'};const browser=await chromium.launch({executablePath:'/usr/bin/chromium'});
try{for(const [locale,theme,width] of [['en','light',390],['en','dark',390],['es','light',320],['tr','dark',320],['en','light',768],['en','light',1440]]){
 const seed=getInitialDemoState();Object.assign(seed.profile,{displayName:'Synthetic fidelity review',locale,theme,onboardingStep:'completed',firstOpenedAt:new Date().toISOString(),soundMuted:false});const context=await browser.newContext({viewport:{width,height:width===1440?1000:844},reducedMotion:'reduce',serviceWorkers:'block'});await context.route('**/*',route=>new URL(route.request().url()).origin==='http://127.0.0.1:4181'?route.continue():(report.external.push(route.request().url()),route.abort()));await context.addInitScript(({seed,locale})=>{localStorage.setItem('one_decision_away_app_data_v1',JSON.stringify(seed));localStorage.setItem('oda_locale',locale)},{seed,locale});const page=await context.newPage();page.on('pageerror',e=>report.errors.push(e.message));await page.goto('http://127.0.0.1:4181/app/sound');await page.locator('.oda-sound').waitFor();await page.evaluate(()=>document.fonts.ready);for(let n=0;n<3&&await page.getByRole('dialog').count();n++)await page.keyboard.press('Escape');assert.equal(await page.locator('.oda-sound-player').count(),0);
 await page.waitForFunction(()=>[...document.querySelectorAll('.oda-sound-tab:not([data-section="breathe"]) img')].every(img=>img.complete&&img.naturalWidth>0));const name=`final-${locale}-${theme}-${width}`;await page.screenshot({path:`${out}/${name}-discovery.png`,animations:'disabled'});report.screenshots.push(`${name}-discovery.png`);
 const initial=await page.evaluate(()=>({width:document.documentElement.clientWidth,scroll:document.documentElement.scrollWidth,artFallbacks:document.querySelectorAll('.oda-sound-scene[data-artwork="owned-fallback"]').length}));assert.ok(initial.scroll<=initial.width+1);assert.equal(initial.artFallbacks,0);await page.locator('.oda-sound-card-button').first().click();await page.locator('.oda-sound-player-timer select').selectOption('');const select=await page.locator('.oda-sound-player-timer select').evaluate(el=>({width:el.getBoundingClientRect().width,minWidth:getComputedStyle(el).minWidth,text:el.options[el.selectedIndex].text,scroll:el.scrollWidth,client:el.clientWidth}));assert.equal(select.minWidth,'118px');assert.ok(select.width>=118);
 const playerGeometry=await page.evaluate(()=>{const rect=document.querySelector('.oda-sound-player-inner').getBoundingClientRect();const nav=document.querySelector('.oda-tabbar').getBoundingClientRect();return {x:rect.x,right:rect.right,bottom:rect.bottom,gap:nav.top-rect.bottom,width:document.documentElement.clientWidth,scroll:document.documentElement.scrollWidth}});assert.ok(playerGeometry.scroll<=playerGeometry.width+1);assert.ok(playerGeometry.x>=0&&playerGeometry.right<=width+1);if(width<768)assert.ok(playerGeometry.gap>=7.9);
 const result=await new AxeBuilder({page}).include('.oda-sound').withTags(['wcag2a','wcag2aa','wcag21a','wcag21aa']).analyze();const violations=result.violations.map(v=>({id:v.id,impact:v.impact,targets:v.nodes.map(n=>n.target)}));assert.equal(violations.filter(v=>['serious','critical'].includes(v.impact)).length,0,JSON.stringify(violations));await page.locator('.oda-sound-panel').evaluate(el=>el.scrollIntoView({block:'start'}));await page.screenshot({path:`${out}/${name}-detail.png`,animations:'disabled'});report.screenshots.push(`${name}-detail.png`);
 await page.locator('.oda-sound-now-panel').evaluate(el=>el.scrollIntoView({block:'start'}));await page.waitForFunction(()=>[...document.querySelectorAll('.oda-sound-now-art img')].every(img=>img.complete&&img.naturalWidth>0));await page.screenshot({path:`${out}/${name}-player.png`,animations:'disabled'});report.screenshots.push(`${name}-player.png`);const paintedArt=await page.locator('.oda-sound-now-art img').evaluate(el=>({naturalWidth:el.naturalWidth,naturalHeight:el.naturalHeight,width:el.getBoundingClientRect().width,height:el.getBoundingClientRect().height,source:el.currentSrc}));assert.ok(paintedArt.naturalWidth>0&&paintedArt.height>=280);report.cases.push({name,initial,select,playerGeometry,violations,paintedArt});await context.close();console.log(`PASS ${name}`)
}assert.equal(report.errors.length,0)}catch(e){report.failure=String(e);throw e}finally{fs.writeFileSync(`${out}/final-targeted-report.json`,JSON.stringify(report,null,2)+'\n');await browser.close()}
