+.oda-sound-card-play { grid-column: 1; grid-row: 1; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; border-radius: 50%; color: var(--fg-muted); background: transparent; }
+.oda-sound-card-button[aria-pressed="true"] .oda-sound-card-play { background: #285E64; color: #FFFFFF; }
+.oda-sound-card-body { grid-column: 2; grid-row: 1; display: flex; min-width: 0; flex-direction: column; gap: .35rem; }
+.oda-sound-card-name { font-size: .93rem; font-weight: 650; line-height: 1.3; letter-spacing: -.015em; color: var(--fg); overflow-wrap: anywhere; }
+.oda-sound-card-description { font-size: .77rem; line-height: 1.5; color: var(--fg); }
+.oda-sound-card-why { font-size: .74rem; line-height: 1.5; color: var(--fg-muted); }
+.oda-sound-card-note { display: inline-flex; align-items: center; gap: .35rem; align-self: flex-start; margin-top: .15rem; padding: .3rem .5rem; border-radius: 12px; font-size: .71rem; font-weight: 600; line-height: 1.45; color: var(--fg); background: var(--accent-soft); }
 .oda-sound-card-note svg { flex: none; }
-.oda-sound-card-pro { position: absolute; bottom: 0; left: 0; right: 0; padding: 3px; background: rgb(16 23 40 / .88); color: #FFFFFF; text-align: center; font-size: .66rem; font-weight: 650; }
+.oda-sound-card-pro { display: none; }
 .oda-sound-hint { display: flex; gap: .5rem; align-items: flex-start; margin-top: 1rem; font-size: .8rem; line-height: 1.55; color: var(--fg-muted); }
 .oda-sound-hint svg { flex: none; margin-top: .15rem; color: var(--accent); }
 
+/* Reference 3: real player state inside a tall cyan-edge atmospheric glass panel. */
+.oda-sound-now-panel { position: relative; margin-top: 1.5rem; padding: 1.6rem 1.1rem 1.3rem; border: 2px solid #45BFC6; border-radius: 30px; overflow: hidden; background: linear-gradient(140deg, #40666B, #1C414A 58%, #283D4A); color: #F1FCFB; box-shadow: inset 0 1px 0 rgb(199 251 242 / .25), 0 18px 44px -24px #163946; }
+.oda-sound-now-heading { position: relative; z-index: 1; }
+.oda-sound-now-heading .oda-kicker { color: #D5EEEB; }
+.oda-sound-now-heading h2 { margin-top: .5rem; font-size: 1.5rem; letter-spacing: -.03em; line-height: 1.15; }
+.oda-sound-now-heading > p:last-child { margin-top: .7rem; max-width: 36ch; font-size: .8rem; line-height: 1.6; color: #E4F4F0; }
+.oda-sound-now-art { width: calc(100% + 2.2rem); height: 300px; margin: 1.4rem -1.1rem 0; border-radius: 0 0 45% 15% / 0 0 18% 6%; }
+.oda-sound-now-art img { object-position: center 65%; mix-blend-mode: luminosity; }
+.oda-sound-now-controls { display: flex; justify-content: space-around; align-items: center; width: min(100%, 270px); margin: -18px auto 0; padding: .7rem; position: relative; border: 1px solid rgb(194 245 239 / .22); border-radius: 26px; background: rgb(50 99 106 / .8); backdrop-filter: blur(14px); color: #D9EEEA; }
+.oda-sound-now-toggle { display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 50%; color: var(--sound-on-cyan); background: var(--sound-cyan); cursor: pointer; box-shadow: 0 0 22px rgb(71 218 217 / .2); }
+.oda-sound-now-toggle:disabled { background: #587C80; color: #E3F0ED; cursor: not-allowed; box-shadow: none; }
+.oda-sound-now-toggle:focus-visible { outline-color: #F1FCFB; }
+.oda-sound-now-note { margin-top: 1rem; font-size: .77rem; line-height: 1.55; text-align: center; color: #DEEFED; }
+
+@media (min-width: 640px) { .oda-sound-tabs { width: 100%; margin-inline: 0; } }
+@media (min-width: 1000px) {
+  .oda-sound-experience { display: grid; grid-template-columns: minmax(0, .88fr) minmax(0, 1fr); align-items: start; gap: 1.5rem; }
+  .oda-sound-intro { right: auto; width: calc((100% - 1.5rem) * .468); }
+  .oda-sound-tabs { position: sticky; top: 24px; }
+  .oda-sound-panel { margin-top: 0; }
+  .oda-sound-panel-cover { min-height: 380px; }
+}
