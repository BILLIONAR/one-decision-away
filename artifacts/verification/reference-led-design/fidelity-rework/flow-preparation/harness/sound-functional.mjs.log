import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { mkdirSync, writeFileSync } from 'node:fs';

const repo = process.env.ODA_QA_REPO;
const require = createRequire(`${repo}/package.json`);
const { chromium } = require('playwright');
const { getInitialDemoState } = await import(`${repo}/src/services/repository.ts`);
const { TIMER_CHOICES } = await import(`${repo}/src/services/soundRoom.ts`);
const { readPersonalRecordFixture } = await import(`${repo}/scripts/qa-personal-record-fixtures.mjs`);
const base = process.env.ODA_QA_URL;
const out = process.env.ODA_QA_OUT;
mkdirSync(out, { recursive: true });
const origin = new URL(base).origin;
const report = { at: new Date().toISOString(), sourceCommit: process.env.ODA_QA_SOURCE_COMMIT, base, synthetic: true, checks: [], cases: [], screenshots: [], errors: [], blockedExternal: [], limits: ['Native Chromium controls and actual synthesizer playback state with synthetic signed-out profiles.', 'Native timer text fit reserves an estimated 20 px for the select arrow; actual PNGs establish visible label fit. No prior composition/height equality requirement.', 'No physical iPhone touch/native iOS or independently listened audio claim. Focus 120-second completion is tested separately through labelled controlled browser clock.'] };
const browser = await chromium.launch({ executablePath: '/usr/bin/chromium' });
report.browser = await browser.version();
let active;
const pass = (name, evidence) => { report.checks.push({ name, evidence }); console.log(`PASS ${name}`); };
const ledger = data => ({ completions: data.completions, transactions: data.transactions, missions: data.missions });
try {
  for (const locale of ['en', 'tr', 'es']) for (const width of [320, 390]) {
    const label = `${locale}-${width}`;
    const seed = getInitialDemoState();
    seed.profile = { ...seed.profile, displayName: 'Synthetic sound regression', onboardingStep: 'completed', locale, theme: 'light', soundMuted: false, nudgesEnabled: false, dailyWisdomEnabled: false };
    const context = await browser.newContext({ viewport: { width, height: 844 }, reducedMotion: 'reduce', serviceWorkers: 'block' });
    await context.route('**/*', route => {
      if (new URL(route.request().url()).origin === origin && ['GET', 'HEAD'].includes(route.request().method())) return route.continue();
      report.blockedExternal.push({ label, url: route.request().url(), method: route.request().method() }); return route.abort();
    });
    await context.addInitScript(({ seed, locale }) => {
      if (!localStorage.getItem('one_decision_away_app_data_v1')) localStorage.setItem('one_decision_away_app_data_v1', JSON.stringify(seed));
      localStorage.setItem('oda_locale', locale); localStorage.setItem('oda_theme', 'light');
    }, { seed, locale });
    const page = await context.newPage(); active = page; page.setDefaultTimeout(8000);
    page.on('pageerror', error => report.errors.push({ label, message: error.message }));
    await page.goto(`${base}/app/sound`);
    await page.getByRole('tablist').waitFor(); await page.evaluate(() => document.fonts.ready);
    assert.equal(await page.locator('.oda-sound-player').count(), 0);
    const before = ledger(await readPersonalRecordFixture(page));
    const card = page.locator('.oda-sound-panel .oda-sound-card-button').first();
    const chosenName = await card.locator('.oda-sound-card-name').innerText();
    await card.click();
    const bar = page.locator('.oda-sound-player');
    const expanded = page.locator('.oda-sound-now-panel');
    await bar.waitFor(); await expanded.waitFor();
    assert.equal(await bar.locator('.oda-sound-player-name').innerText(), chosenName);
    assert.equal(await expanded.locator('h2').innerText(), chosenName);
    assert.equal(await card.getAttribute('aria-pressed'), 'true');
    pass(`${label}: real discovery selection owns both visible player titles and active row`, { chosenName });
    const barToggle = bar.locator('.oda-sound-player-toggle');
    const expandedToggle = expanded.locator('.oda-sound-now-toggle');
    const playingLabel = await barToggle.getAttribute('aria-label');
    assert.equal(await expandedToggle.getAttribute('aria-label'), playingLabel);
    await expandedToggle.click();
    const pausedLabel = await barToggle.getAttribute('aria-label');
    assert.notEqual(pausedLabel, playingLabel);
    assert.equal(await expandedToggle.getAttribute('aria-label'), pausedLabel);
    assert.equal(await card.getAttribute('aria-pressed'), 'false');
    await barToggle.click();
    assert.equal(await barToggle.getAttribute('aria-label'), playingLabel);
    assert.equal(await expandedToggle.getAttribute('aria-label'), playingLabel);
    pass(`${label}: expanded Pause and compact Resume reflect the same actual playback state`);
    const select = bar.locator('.oda-sound-player-timer select');
    const values = await select.locator('option').evaluateAll(options => options.map(option => option.value));
    assert.deepEqual(values, ['', ...TIMER_CHOICES.map(String)]);
    const fit = [];
    for (const value of values) {
      await select.selectOption(value);
      assert.equal(await select.inputValue(), value);
      const measurement = await select.evaluate(el => {
        const css = getComputedStyle(el), rect = el.getBoundingClientRect(), canvas = document.createElement('canvas'), context = canvas.getContext('2d');
        context.font = css.font || `${css.fontWeight} ${css.fontSize} ${css.fontFamily}`;
        const text = el.selectedOptions[0].textContent, textWidth = context.measureText(text).width;
        const reserve = 20, available = rect.width - parseFloat(css.paddingLeft) - parseFloat(css.paddingRight) - parseFloat(css.borderLeftWidth) - parseFloat(css.borderRightWidth) - reserve;
        return { text, value: el.value, width: rect.width, height: rect.height, textWidth, available, nativeArrowReserveEstimate: reserve, fits: textWidth <= available };
      });
      assert.equal(measurement.fits, true, JSON.stringify(measurement));
      assert.ok(measurement.height >= 44); fit.push(measurement);
    }
    pass(`${label}: all real native timer choices and localized no-timer label stay readable and operable`, fit);
    await select.focus(); await page.keyboard.press('Home'); await page.keyboard.press('ArrowDown'); await page.keyboard.press('Enter');
    assert.equal(await select.inputValue(), String(TIMER_CHOICES[0]));
    await page.keyboard.press('End'); await page.keyboard.press('Enter');
    assert.equal(await select.inputValue(), String(TIMER_CHOICES.at(-1)));
    pass(`${label}: native keyboard selects first and final timer choices`);
    await select.selectOption(String(TIMER_CHOICES[0]));
    const status = bar.locator('.oda-sound-player-status');
    assert.match(await status.innerText(), /\d+:\d{2}/);
    await barToggle.click();
    const pausedTime = await status.innerText();
    await page.waitForTimeout(1100);
    assert.equal(await status.innerText(), pausedTime);
    assert.equal(await select.inputValue(), String(TIMER_CHOICES[0]));
    await expandedToggle.click();
    assert.equal(await barToggle.getAttribute('aria-label'), playingLabel);
    assert.equal(await select.inputValue(), String(TIMER_CHOICES[0]));
    await select.selectOption(''); assert.equal(await select.inputValue(), '');
    assert.doesNotMatch(await status.innerText(), /\d+:\d{2}/);
    pass(`${label}: pause freezes countdown, resume retains timer choice and explicit cancellation removes countdown`);
    const volume = bar.locator('.oda-sound-player-volume input');
    await volume.focus(); await page.keyboard.press('Home'); assert.equal(await volume.inputValue(), '0');
    await page.keyboard.press('ArrowRight'); assert.equal(await volume.inputValue(), '0.01');
    pass(`${label}: native volume keyboard preserves zero and real step value`);
    await select.selectOption('');
    const capture = `sound-real-player-${label}.png`;
    await page.screenshot({ path: `${out}/${capture}`, fullPage: false, animations: 'disabled' }); report.screenshots.push(capture);
    assert.deepEqual(ledger(await readPersonalRecordFixture(page)), before);
    pass(`${label}: Sound controls do not manufacture focus completions, rewards or mission changes`);
    const tabs = page.getByRole('tab');
    await tabs.first().focus(); await page.keyboard.press('ArrowRight');
    assert.equal(await tabs.nth(1).getAttribute('aria-selected'), 'true');
    const chosenTab = await tabs.nth(1).getAttribute('data-section');
    await page.reload(); await page.getByRole('tablist').waitFor();
    assert.equal(await page.locator(`[role="tab"][data-section="${chosenTab}"]`).getAttribute('aria-selected'), 'true');
    pass(`${label}: keyboard category selection resumes its saved real tab after reload`, { chosenTab });
    report.cases.push({ label, passed: true }); await context.close();
  }
  assert.deepEqual(report.errors, []); assert.deepEqual(report.blockedExternal, []); report.status = 'passed';
} catch (error) {
  report.status = 'failed'; report.failure = String(error.stack || error); process.exitCode = 1; console.error(report.failure);
  if (active && !active.isClosed()) await active.screenshot({ path: `${out}/failure.png`, fullPage: false }).catch(() => {});
} finally {
  await browser.close(); report.finishedAt = new Date().toISOString(); writeFileSync(`${out}/sound-functional-report.json`, `${JSON.stringify(report, null, 2)}\n`);
  console.log(JSON.stringify({ status: report.status, cases: report.cases.length, checks: report.checks.length, errors: report.errors.length }));
}
