+.oda-courses-fidelity .oda-course-steps { position: relative; isolation: isolate; padding: 12px; border-radius: 16px; gap: 12px; }
+.oda-courses-fidelity .oda-course-steps::before { content: ''; position: absolute; top: 50%; inset-inline: 24px; height: 1px; background: var(--border-strong); z-index: -1; }
