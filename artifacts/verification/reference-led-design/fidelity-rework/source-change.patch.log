+.oda-notebook-fidelity .oda-notebook-calendar > div:first-child button { background: var(--surface); }
+.oda-notebook-fidelity .oda-notebook-entry-list { border-radius: 12px; box-shadow: none; }
+@container oda-notebook (min-width: 850px) {
