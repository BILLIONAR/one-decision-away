+.oda-fidelity-today .oda-fidelity-hero { position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: flex-end; min-height: 450px; padding: 24px; overflow: hidden; border: 1px solid var(--border); border-radius: 18px; background: linear-gradient(155deg, var(--surface) 10%, color-mix(in srgb, var(--tint-blue) 40%, var(--surface)) 52%, var(--surface) 100%); box-shadow: var(--surface-shadow); }
+.oda-fidelity-hero-art { position: absolute; inset: 0 0 auto; height: 300px; padding: 16px; }
+.oda-fidelity-hero-art::before { content: ''; position: absolute; width: 220px; height: 245px; left: 50%; top: 18px; transform: translateX(-50%); border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border)); border-radius: 48% 48% 18% 18%; background: radial-gradient(ellipse at 28% 22%, color-mix(in srgb, var(--surface) 85%, transparent), transparent 65%); box-shadow: inset 0 0 30px color-mix(in srgb, var(--surface) 80%, transparent), 0 18px 32px -25px var(--accent); }
+.oda-fidelity-hero-art .oda-evidence-tree { width: min(100%, 300px); margin: 0 auto; }
+.oda-fidelity-hero-art .oda-evidence-tree img { filter: hue-rotate(185deg) saturate(.65); }
