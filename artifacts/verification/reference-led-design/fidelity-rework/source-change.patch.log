+.oda-notebook-fidelity #notebook-journal-content { height: 220px; min-height: 220px !important; }
+.oda-notebook-fidelity .oda-notebook-editor-actions button { border-radius: 10px; }
+.oda-notebook-fidelity .oda-notebook-archive { padding: 16px; border: 1px solid var(--border); border-radius: 18px; background: var(--surface); }
+.oda-notebook-fidelity .oda-notebook-archive > div:first-child h2 { font-size: .88rem; }
+.oda-notebook-fidelity .oda-notebook-calendar { display: flex; flex-direction: column; gap: 8px; border-radius: 14px; border: 1px solid var(--border); padding: 8px; }
+.oda-notebook-fidelity .oda-notebook-calendar > * { margin-block: 0; }
+.oda-notebook-fidelity .oda-notebook-calendar-scroll-hint { order: 1; }
+.oda-notebook-fidelity .oda-notebook-calendar-scroll { order: 2; }
+.oda-notebook-fidelity .oda-notebook-calendar > p:last-child { order: 3; }
