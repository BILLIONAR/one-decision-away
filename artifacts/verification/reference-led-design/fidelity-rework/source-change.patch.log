+/* Reference 6/7 composition: illustrated vertical modules and compact real evidence. */
+.oda-fidelity-today { --work-ink: var(--fg); --work-muted: var(--fg-muted); --work-subtle: var(--fg-subtle); --work-bg: var(--bg-muted); --work-border: var(--border); --work-accent: var(--accent); --work-on-accent: var(--on-accent); --work-soft: var(--accent-soft); --work-primary: var(--primary-grad); --work-on-primary: var(--on-primary); min-width: 0; container-type: inline-size; container-name: oda-working-today; }
