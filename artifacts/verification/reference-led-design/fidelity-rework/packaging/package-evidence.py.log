root=Path('/workspace/oda-reference-redesign');scratch=Path('/workspace/scratch/oda-reference-redesign/fidelity-rework');dest=root/'artifacts/verification/reference-led-design/fidelity-rework'
dest.mkdir(exist_ok=True);mapping=[]
def copy_file(src,target):
 if not src.is_file():raise FileNotFoundError(src)
 original=target
 if target.suffix in ('.mjs','.py','.tsx','.ts','.diff'):target=target.with_name(target.name+'.log')
 target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(src,target)
 assert src.read_bytes()==target.read_bytes()
 mapping.append({'scratch':str(src.relative_to(scratch)),'review':str(target.relative_to(dest)),'renamed':original!=target})
def tree(src,target,png=True):
 for p in sorted(src.rglob('*')):
  if p.is_file() and (png or p.suffix!='.png'):copy_file(p,target/p.relative_to(src))
tree(scratch/'before',dest/'before')
