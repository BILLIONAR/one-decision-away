import hashlib,json,os,re,subprocess,time
from pathlib import Path
from datetime import datetime,timezone
root=Path('/workspace/oda-reference-redesign');out=Path('/workspace/scratch/oda-reference-redesign/fidelity-rework/final/ssr-boundary-fix')
prior=json.loads((Path('/workspace/scratch/oda-reference-redesign/fidelity-rework/final')/'frozen-build-receipt.json').read_text());paths=[r['file'] for r in prior['source']]
def entry(name):
 data=(root/name).read_bytes();return {'file':name,'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}
head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip();before=[entry(name) for name in paths]
assert head=='d7ed5455fd8a0eaa9372e22bd495f19d7f8cd494'
assert all((root/name).read_bytes()==subprocess.check_output(['git','show',head+':'+name],cwd=root) for name in paths)
env=os.environ.copy();env['VITE_BASE_PATH']='/one-decision-away/';start=time.monotonic();started=datetime.now(timezone.utc).isoformat()
with (out/'aggregate-check.log').open('xb') as log:result=subprocess.run(['npm','run','check'],cwd=root,env=env,stdout=log,stderr=subprocess.STDOUT)
after=[entry(name) for name in paths];raw=(out/'aggregate-check.log').read_bytes();text=raw.decode(errors='replace')
counts={k:int(re.findall(r'^(?:#|ℹ) '+k+r' (\d+)\s*$',text,re.M)[-1]) for k in ('tests','pass','fail')}
build=[entry(str(p.relative_to(root))) for p in sorted((root/'dist').rglob('*')) if p.is_file()]
d={'sourceCommit':head,'startedAtUtc':started,'command':'VITE_BASE_PATH=/one-decision-away/ npm run check','argv':['npm','run','check'],'exitCode':result.returncode,'passed':counts['pass'],'failed':counts['fail'],'elapsedSeconds':round(time.monotonic()-start,3),'log':'aggregate-check.log','logBytes':len(raw),'logSha256':hashlib.sha256(raw).hexdigest(),'sourceFileCount':len(paths),'source':after,'allSourcesMatchCommittedSource':True,'unchangedDuringRun':before==after,'buildFileCount':len(build),'build':build,'cssFileCount':sum(r['file'].endswith('.css') for r in build),'supersedesSourceCommit':prior['sourceCommit'],'reasonForNewRun':'Correct the Journal SSR CSS dependency; the failed37b log is preserved unchanged.','limits':['Synthetic review fixture and Chromium QA. Exact central reference artwork and transferable original JPEG bytes unavailable. Visual acceptance is separate from correctness checks. No deployment.']}
(out/'build-receipt.json').write_text(json.dumps(d,indent=2)+'\n');print(json.dumps({k:v for k,v in d.items() if k not in ('source','build')},indent=2),flush=True)
assert result.returncode==0 and counts['pass']==597 and counts['fail']==0 and before==after
