import hashlib,json,os,subprocess,time
from pathlib import Path
from datetime import datetime,timezone
root=Path('/workspace/oda-reference-redesign');out=Path('/workspace/scratch/oda-reference-redesign/fidelity-rework/final')
prior=json.loads((root/'artifacts/verification/reference-led-design/timer-label-fix/build-receipt.json').read_text())
paths=sorted({r['file'] for r in prior['source']}|{'src/styles/workingSurfaces.css'}|{str(p.relative_to(root)) for p in (root/'public/assets/oda/reference-fidelity').glob('*.svg')})
def entry(name):
 data=(root/name).read_bytes();return {'file':name,'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}
head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip();before=[entry(name) for name in paths]
assert all((root/name).read_bytes()==subprocess.check_output(['git','show',head+':'+name],cwd=root) for name in paths)
env=os.environ.copy();env['VITE_BASE_PATH']='/one-decision-away/';start=time.monotonic();started=datetime.now(timezone.utc).isoformat()
with (out/'frozen-build.log').open('xb') as log:result=subprocess.run(['npm','run','build'],cwd=root,env=env,stdout=log,stderr=subprocess.STDOUT)
after=[entry(name) for name in paths];raw=(out/'frozen-build.log').read_bytes()
build=[entry(str(p.relative_to(root))) for p in sorted((root/'dist').rglob('*')) if p.is_file()]
d={'sourceCommit':head,'startedAtUtc':started,'command':'VITE_BASE_PATH=/one-decision-away/ npm run build','exitCode':result.returncode,'elapsedSeconds':round(time.monotonic()-start,3),'log':'frozen-build.log','logBytes':len(raw),'logSha256':hashlib.sha256(raw).hexdigest(),'sourceFileCount':len(paths),'source':after,'allSourcesMatchCommittedSource':True,'unchangedDuringRun':before==after,'buildFileCount':len(build),'build':build,'limits':['Frozen production build for independent visual review. Synthetic fixtures. Exact reference artwork not included. No deployment.']}
(out/'frozen-build-receipt.json').write_text(json.dumps(d,indent=2)+'\n');print(json.dumps({k:v for k,v in d.items() if k not in ('source','build')},indent=2),flush=True)
assert result.returncode==0 and before==after
