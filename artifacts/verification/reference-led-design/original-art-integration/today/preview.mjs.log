=prefix+'-hero.png';await page.screenshot({path:out+'/'+full,animations:'disabled'});await page.locator('.oda-fidelity-hero').screenshot({path:out+'/'+crop,animations:'disabled'});const files=[full,crop].map(file=>{const bytes=fs.readFileSync(out+'/'+file);return{file,bytes:bytes.length,sha256:hash(bytes)};});const item={theme,width,geometry,requests,files,axe:axe.violations.map(v=>({id:v.id,impact:v.impact,nodes:v.nodes.map(n=>({target:n.target,summary:n.failureSummary}))})),manualContrastLimit:'Axe does not fully establish text contrast over complex scene pixels; native PNG inspection and inherited overlay check are also required.'};report.cases.push(item);console.log(JSON.stringify(item));await context.close();}assert.deepEqual(report.errors,[]);report.status='captured';}catch(error){report.status='failed';report.failure=String(error.stack||error);console.error(report.failure);process.exitCode=1;}finally{await browser.close();fs.writeFileSync(out+'/preview-report.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({status:report.status,cases:report.cases.length,errors:report.errors,failure:report.failure}));}
