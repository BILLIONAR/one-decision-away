import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { mkdirSync, writeFileSync, readFileSync } from 'node:fs';
import { execFileSync } from 'node:child_process';
import { observeNativeAudio, nativeGraphStarts, requireNoGraphRestart } from './native-audio-observer.mjs';
if (process.env.ODA_ORIGINAL_ART_FLOW_GO !== '1') throw new Error('Explicit frozen-build GO required.');
const repo = process.env.ODA_QA_REPO, base = process.env.ODA_QA_URL, out = process.env.ODA_QA_OUT;
const preflight = JSON.parse(readFileSync(process.env.ODA_ART_PREFLIGHT, 'utf8'));
assert.equal(preflight.sourceCommit, process.env.ODA_QA_SOURCE_COMMIT);
assert.equal(preflight.allSourcesMatchCommittedSource, true);
assert.equal(preflight.allBuildFilesMatchParent, true);
assert.equal(execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repo, encoding: 'utf8' }).trim(), process.env.ODA_QA_SOURCE_COMMIT);
assert.equal(execFileSync('git', ['status', '--porcelain'], { cwd: repo, encoding: 'utf8' }).trim(), '');
const require = createRequire(`${repo}/package.json`);
const { chromium } = require('playwright');
const { getInitialDemoState } = await import(`${repo}/src/services/repository.ts`);
const { readPersonalRecordFixture } = await import(`${repo}/scripts/qa-personal-record-fixtures.mjs`);
mkdirSync(out, { recursive: true });
const report = { sourceCommit: process.env.ODA_QA_SOURCE_COMMIT, synthetic: true, viewport: { width: 320, height: 844 }, checks: [], screenshots: [], errors: [], blockedExternal: [], geometry: [], limits: ['One fresh bounded320px native Sound handoff check for the original-art build; prior unrelated suites retain their original source and execution provenance.', 'Native Chromium audio graph observation and real paused display time; no altered audio clock, provider, billing or model operation.', 'No physical device or visual-material approval claim.'] };
const browser = await chromium.launch({ executablePath: '/usr/bin/chromium' });
const context = await browser.newContext({ viewport: report.viewport, reducedMotion: 'reduce', serviceWorkers: 'block' });
const origin = new URL(base).origin;
await context.route('**/*', route => {
  if (new URL(route.request().url()).origin === origin && ['GET', 'HEAD'].includes(route.request().method())) return route.continue();
  report.blockedExternal.push(route.request().url()); return route.abort();
});
const seed = getInitialDemoState();
seed.profile = { ...seed.profile, displayName: 'Synthetic320 CSS clearance QA', locale: 'en', theme: 'light', onboardingStep: 'completed', soundMuted: false, nudgesEnabled: false, dailyWisdomEnabled: false };
await context.addInitScript(({ seed }) => {
  if (!localStorage.getItem('one_decision_away_app_data_v1')) localStorage.setItem('one_decision_away_app_data_v1', JSON.stringify(seed));
  localStorage.setItem('oda_locale', 'en'); localStorage.setItem('oda_theme', 'light');
}, { seed });
await context.addInitScript(observeNativeAudio);
const page = await context.newPage(); page.setDefaultTimeout(8000);
page.on('pageerror', error => report.errors.push(error.message));
const pass = (name, evidence) => { report.checks.push({ name, evidence }); console.log(`PASS ${name}`); };
const capture = async name => { await page.screenshot({ path: `${out}/${name}.png`, animations: 'disabled' }); report.screenshots.push(`${name}.png`); };
const expanded = page.locator('[data-sound-surface="expanded"]');
const mini = page.locator('[data-sound-surface="mini"]');
const control = (surface, name) => surface.locator(`[data-sound-control="${name}"]`);
const centerControls = async () => {
  await expanded.locator('.oda-sound-now-control-surface').evaluate(element => element.scrollIntoView({ block: 'center' }));
  await page.locator('[data-sound-surface="expanded"][data-primary="true"]').waitFor();
  assert.equal(await mini.count(), 0);
};
try {
  await page.goto(`${base}/app/sound`); await page.getByRole('tablist').waitFor(); await page.evaluate(() => document.fonts.ready);
  const before = await readPersonalRecordFixture(page);
  const initial = await page.evaluate(() => {
    const breathe = document.querySelector('[role="tab"][data-section="breathe"] .oda-sound-tab-name').getBoundingClientRect();
    const nav = document.querySelector('.oda-tabbar').getBoundingClientRect();
    return { label: { top: breathe.top, bottom: breathe.bottom }, nav: { top: nav.top, bottom: nav.bottom }, height: innerHeight, width: document.documentElement.clientWidth, scrollWidth: document.documentElement.scrollWidth };
  });
  report.geometry.push({ name: 'initial fold', ...initial });
  assert.ok(initial.label.top >= initial.height - 1, 'Subsequent Breathe label must start beyond initial fold, not become a sliver behind fixed navigation');
  assert.ok(initial.scrollWidth <= initial.width + 1);
  pass('320px initial fold contains no Breathe label sliver behind fixed navigation', initial);
  await capture('sound-initial-clearance-en-320');
  await page.getByRole('tab').first().focus(); await page.keyboard.press('End');
  await page.waitForFunction(() => {
    const label = document.querySelector('[role="tab"][data-section="breathe"] .oda-sound-tab-name').getBoundingClientRect();
    const nav = document.querySelector('.oda-tabbar').getBoundingClientRect();
    return label.top >= 56 && label.bottom <= nav.top;
  });
  assert.equal(await page.getByRole('tab', { selected: true }).getAttribute('data-section'), 'breathe');
  assert.ok(await page.getByRole('button', { name: 'Silent guide', exact: true }).isVisible());
  pass('Subsequent Breathe action stays fully reachable by native End key and clear of fixed navigation');
  await capture('sound-breathe-reached-en-320');
  await page.getByRole('tab', { selected: true }).focus(); await page.keyboard.press('Home');
  const card = page.locator('.oda-sound-panel .oda-sound-card-button').first();
  const chosenName = await card.locator('.oda-sound-card-name').innerText();
  await card.click(); await expanded.waitFor(); await centerControls();
  const graph = await nativeGraphStarts(page); assert.ok(graph.length > 0);
  const boxes = [];
  for (const name of ['toggle', 'volume', 'timer']) {
    const box = await control(expanded, name).boundingBox(); assert.ok(box.width >= 44 && box.height >= 44, JSON.stringify({ name, box })); boxes.push({ name, ...box });
  }
  const volumeLabel = await expanded.locator('.oda-sound-player-volume').boundingBox(); assert.ok(volumeLabel.width >= 68);
  report.geometry.push({ name: 'expanded controls', boxes, volumeLabel });
  pass('Expanded320px range and paired controls meet44px bounds without duplicate mini controls', boxes);
  await control(expanded, 'volume').focus(); await page.keyboard.press('Home'); await page.keyboard.press('ArrowRight');
  assert.equal(await control(expanded, 'volume').inputValue(), '0.01');
  await control(expanded, 'timer').selectOption('10');
  await control(expanded, 'toggle').click();
  const pausedStatus = await expanded.locator('.oda-sound-now-status').innerText(); assert.match(pausedStatus, /\d+:\d{2}/);
  await control(expanded, 'timer').focus(); await page.evaluate(() => window.scrollTo(0, 0)); await mini.waitFor();
  await page.waitForFunction(() => document.activeElement?.closest('[data-sound-surface="mini"]') && document.activeElement?.dataset.soundControl === 'timer');
  assert.equal(await mini.locator('.oda-sound-player-name').innerText(), chosenName);
  assert.equal(await control(mini, 'volume').inputValue(), '0.01'); assert.equal(await control(mini, 'timer').inputValue(), '10');
  assert.equal(await mini.locator('.oda-sound-player-status').innerText(), pausedStatus);
  await capture('sound-mini-paused-en-320');
  await control(mini, 'volume').focus(); await centerControls();
  await page.waitForFunction(() => document.activeElement?.closest('[data-sound-surface="expanded"]') && document.activeElement?.dataset.soundControl === 'volume');
  await page.waitForTimeout(1100);
  assert.equal(await control(expanded, 'volume').inputValue(), '0.01'); assert.equal(await control(expanded, 'timer').inputValue(), '10');
  assert.equal(await expanded.locator('.oda-sound-now-status').innerText(), pausedStatus);
  pass('CSS-wrap handoff preserves track, shared volume, paused countdown and corresponding native focus', await requireNoGraphRestart(page, graph, 'Original-art handoff'));
  await capture('sound-expanded-paused-en-320');
  assert.deepEqual(await readPersonalRecordFixture(page), before); assert.deepEqual(report.errors, []); assert.deepEqual(report.blockedExternal, []);
  pass('Bounded Sound visibility probe leaves all canonical records unchanged and makes no external request');
  report.status = 'passed';
} catch (error) {
  report.status = 'failed'; report.failure = String(error.stack || error); process.exitCode = 1;
  await capture('failure').catch(() => {}); console.error(report.failure);
} finally {
  await browser.close(); report.finishedAt = new Date().toISOString();
  writeFileSync(`${out}/sound-shared-state-report.json`, JSON.stringify(report, null, 2));
}
