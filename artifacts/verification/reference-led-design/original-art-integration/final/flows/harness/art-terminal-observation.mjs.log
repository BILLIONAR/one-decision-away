import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';

// PREP ONLY: this file deliberately refuses execution without a new parent GO,
// a current compiled-build preflight and selectors read from the frozen helper.
if (process.env.ODA_ORIGINAL_ART_FLOW_GO !== '1') throw new Error('Parent frozen-source/build GO required.');
const repo = process.env.ODA_QA_REPO;
const out = process.env.ODA_QA_OUT;
const sourceCommit = process.env.ODA_QA_SOURCE_COMMIT;
const base = process.env.ODA_QA_URL;
const config = JSON.parse(readFileSync(process.env.ODA_ART_FROZEN_CONFIG, 'utf8'));
const preflight = JSON.parse(readFileSync(process.env.ODA_ART_PREFLIGHT, 'utf8'));
assert.equal(config.status, 'bound-to-frozen-source');
assert.equal(config.sourceCommit, sourceCommit);
assert.equal(preflight.sourceCommit, sourceCommit);
assert.equal(preflight.allSourcesMatchCommittedSource, true);
assert.equal(preflight.allBuildFilesMatchParent, true);
assert.equal(execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repo, encoding: 'utf8' }).trim(), sourceCommit);
assert.equal(execFileSync('git', ['status', '--porcelain'], { cwd: repo, encoding: 'utf8' }).trim(), '');
assert.ok(base.endsWith('/#'), 'Supported built app uses the existing hash router.');
const require = createRequire(`${repo}/package.json`);
const { chromium } = require('playwright');
const { getInitialDemoState } = await import(`${repo}/src/services/repository.ts`);
const { readPersonalRecordFixture } = await import(`${repo}/scripts/qa-personal-record-fixtures.mjs`);
const metadata = JSON.parse(readFileSync(new URL('./delivery-metadata.json', import.meta.url), 'utf8'));
const delivery = JSON.parse(readFileSync(new URL('./delivery-runtime-files.json', import.meta.url), 'utf8'));
const manifest = new Map(delivery.map(row => [row.runtimePath, row]));
const scenes = Object.keys(metadata);
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
mkdirSync(out, { recursive: true });
const report = { sourceCommit, synthetic: true, checks: [], contexts: [], failures: [], screenshots: [], limits: ['No original-art browser check was executed during preparation.', 'Controlled local HTTP failures exercise image delivery only; real native audio graph is separately observed.', 'No production state, service worker, account, model, provider, billing or publication operation.', 'No human listening/transcription QA or physical-device claim.'] };
const browser = await chromium.launch({ executablePath: '/usr/bin/chromium' });
const origin = new URL(base).origin;
const pass = (name, evidence) => { report.checks.push({ name, evidence }); console.log(`PASS ${name}`); };
const runtimePath = url => new URL(url).pathname.split('/one-decision-away/')[1];
const assetScene = url => {
  const name = runtimePath(url)?.split('/').at(-1);
  return scenes.find(scene => name?.startsWith(`${scene}-`)) || null;
};
const seed = getInitialDemoState();
seed.profile = { ...seed.profile, displayName: 'Synthetic original-art QA', locale: 'en', theme: 'light', onboardingStep: 'completed', soundMuted: true, nudgesEnabled: false, dailyWisdomEnabled: false };

async function contextFor(label, viewport, blockedPaths = []) {
  const context = await browser.newContext({ viewport, deviceScaleFactor: 1, reducedMotion: 'reduce', serviceWorkers: 'block' });
  const record = { label, viewport, requests: [], responses: [], localFailures: [], external: [], pageErrors: [] };
  report.contexts.push(record);
  const pending = [];
  await context.route('**/*', route => {
    const request = route.request(), url = request.url();
    if (new URL(url).origin !== origin || !['GET', 'HEAD'].includes(request.method())) {
      record.external.push(url); return route.abort();
    }
    record.requests.push({ url, runtimePath: runtimePath(url), resourceType: request.resourceType(), method: request.method() });
    const shouldFail = blockedPaths.some(path => path.endsWith('/*.webp')
      ? runtimePath(url)?.startsWith(path.slice(0, -7)) && runtimePath(url)?.endsWith('.webp')
      : runtimePath(url) === path);
    if (shouldFail) {
      record.localFailures.push(url);
      return route.fulfill({ status: 404, contentType: 'text/plain', body: 'Synthetic local asset missing for QA' });
    }
    return route.continue();
  });
  context.on('response', response => {
    if (!runtimePath(response.url())?.startsWith('assets/oda/original-scenes/')) return;
    pending.push((async () => {
      const bytes = await response.body();
      record.responses.push({ url: response.url(), runtimePath: runtimePath(response.url()), status: response.status(), contentType: response.headers()['content-type'], bytes: bytes.length, sha256: sha(bytes) });
    })().catch(error => record.pageErrors.push(`Response read: ${error.message}`)));
  });
  await context.addInitScript(({ seed }) => {
    if (!localStorage.getItem('one_decision_away_app_data_v1')) localStorage.setItem('one_decision_away_app_data_v1', JSON.stringify(seed));
    localStorage.setItem('oda_locale', 'en'); localStorage.setItem('oda_theme', 'light');
  }, { seed });
  const page = await context.newPage();
  page.setDefaultTimeout(8000);
  page.on('pageerror', error => record.pageErrors.push(error.message));
  const flush = async () => { await Promise.all(pending); };
  return { context, page, record, flush };
}

function verifyNoBulk(record) {
  assert.deepEqual(record.external, []);
  assert.deepEqual(record.pageErrors, []);
  const requested = record.requests.map(item => item.runtimePath || '');
  assert.equal(requested.some(path => /\.(mp3|wav|ogg)(?:$|\?)/i.test(path)), false, 'Decorative route must not download narration/audio without user action.');
  assert.equal(requested.some(path => /(?:oda-(?:dunes-dusk|sound-sculpture|coach-liquid-orb|today-garden-city|foam-teal|palms-twilight)\.png|received\/|original-art.*master)/.test(path)), false, 'Original master must remain scratch-only.');
  const selected = new Set(record.requests.map(item => assetScene(item.url)).filter(Boolean));
  assert.ok(selected.size < scenes.length, 'An initial route must not request all six scene families.');
  return { requestedScenes: [...selected], audioRequests: 0, masterRequests: 0, runtimeSceneBytes: record.responses.filter(item => item.status === 200).reduce((sum, item) => sum + item.bytes, 0) };
}

function verifyResponseBytes(record) {
  for (const row of record.responses.filter(row => row.status === 200)) {
    const expected = manifest.get(row.runtimePath);
    assert.ok(expected, `Unlisted original delivery asset: ${row.runtimePath}`);
    assert.equal(row.bytes, expected.bytes, row.runtimePath);
    assert.equal(row.sha256, expected.sha256, row.runtimePath);
  }
}

async function imageFacts(page, selector) {
  return page.locator(selector).evaluateAll(elements => elements.map(image => {
    const box = image.getBoundingClientRect();
    return { src: image.src, currentSrc: image.currentSrc, srcset: image.srcset, sizes: image.sizes, pictureSizes: image.closest('picture')?.querySelector('source')?.sizes, pictureSrcset: image.closest('picture')?.querySelector('source')?.srcset, complete: image.complete, naturalWidth: image.naturalWidth, naturalHeight: image.naturalHeight, loading: image.loading, decoding: image.decoding, width: box.width, height: box.height, top: box.top, bottom: box.bottom, data: { ...image.dataset } };
  }));
}

async function capture(page, name) {
  await page.screenshot({ path: `${out}/${name}.png`, animations: 'disabled' });
  report.screenshots.push(`${name}.png`);
}

try {
  // Fresh isolated context for every route; no scrolling means this is first-load,
  // not a union of all later user-requested images.
  for (const route of config.routeCases) {
    const fixture = await contextFor(`${route.name}-initial`, route.viewport);
    try {
      await fixture.page.goto(`${base}${route.route}`);
      await fixture.page.locator(route.ready).waitFor();
      await fixture.page.evaluate(() => document.fonts.ready);
      await fixture.page.waitForFunction(selector => [...document.querySelectorAll(selector)].filter(img => {
        const box = img.getBoundingClientRect(); return box.width && box.height && box.top < innerHeight && box.bottom > 0;
      }).every(img => img.complete && img.naturalWidth > 0), route.imageSelector);
      await fixture.flush();
      const facts = await imageFacts(fixture.page, route.imageSelector);
      assert.ok(facts.length > 0, route.name);
      const network = verifyNoBulk(fixture.record);
      assert.ok(network.requestedScenes.every(scene => route.allowedScenes.includes(scene)), JSON.stringify(network));
      verifyResponseBytes(fixture.record);
      for (const image of facts.filter(image => image.top < route.viewport.height && image.bottom > 0 && image.width > 0)) {
        const scene = assetScene(image.currentSrc);
        assert.ok(scene, 'Visible original scene must decode a listed runtime asset.');
        assert.ok(image.complete && image.naturalWidth > 0 && image.naturalHeight > 0);
        // Chromium may reuse an already decoded larger candidate for a smaller
        // same-scene thumbnail. Measure actual unique network cost per scene,
        // rather than claiming that currentSrc must be the smallest candidate.
        assert.ok(image.pictureSizes && image.pictureSrcset, 'Responsive source metadata must exist for decoded WebP.');
      }
      for (const response of fixture.record.responses.filter(row => row.status === 200 && row.runtimePath.endsWith('.webp'))) {
        const scene = assetScene(response.url);
        const consumers = facts.filter(image => assetScene(image.currentSrc) === scene && image.width > 0);
        assert.ok(consumers.length > 0, `Requested scene ${scene} needs an actual rendered consumer`);
        const largestWidth = Math.max(...consumers.map(image => image.width));
        const offered = metadata[scene].sources;
        const desired = offered.find(row => row.width >= largestWidth) || offered.at(-1);
        const requested = offered.find(row => row.src === response.runtimePath);
        assert.ok(requested && requested.width <= desired.width, `Unique network candidate ${requested?.width} exceeds scene ${scene} largest rendered DPR1 width ${largestWidth}; at most ${desired.width}`);
      }
      pass(`${route.name}: fresh route uses decoded responsive listed bytes without bulk audio/master/all-six requests`, { facts, network });
      await capture(fixture.page, `${route.name}-initial`);
    } catch (error) {
      await capture(fixture.page, `${route.name}-failure`).catch(() => {});
      throw error;
    } finally { await fixture.context.close(); }
  }

  // The consumer selector and actual fallback paths must be copied from the
  // frozen production helper/callsite, never invented from visual filenames.
  for (const fallback of config.fallbackCases) {
    const allStages = [fallback.pngPath, fallback.suppliedLegacyPath, fallback.ownedGrowthPath];
    assert.equal(new Set(allStages).size, allStages.length, 'Use a consumer with three distinct fallback stages.');
    const webpPrefix = `assets/oda/original-scenes/${fallback.scene}-`;
    const stages = [
      { label: 'same-scene-png', fail: [webpPrefix + '/*.webp'], expected: fallback.pngPath },
      { label: 'supplied-legacy', fail: [webpPrefix + '/*.webp', fallback.pngPath], expected: fallback.suppliedLegacyPath },
      { label: 'owned-growth', fail: [webpPrefix + '/*.webp', fallback.pngPath, fallback.suppliedLegacyPath], expected: fallback.ownedGrowthPath },
      { label: 'none', fail: [webpPrefix + '/*.webp', ...allStages], expected: null },
    ];
    for (const stage of stages.filter(stage => !fallback.runStages || fallback.runStages.includes(stage.label))) {
      const fixture = await contextFor(`${fallback.name}-${stage.label}`, fallback.viewport, stage.fail);
      try {
        await fixture.page.goto(`${base}${fallback.route}`);
        await fixture.page.locator(fallback.ready).waitFor();
        const before = await readPersonalRecordFixture(fixture.page);
        await fixture.page.locator(fallback.hostSelector).scrollIntoViewIfNeeded();
        if (stage.expected) {
          await fixture.page.waitForFunction(({ selector, path }) => {
            const image = document.querySelector(selector); return image?.complete && image.naturalWidth > 0 && image.currentSrc.endsWith(path);
          }, { selector: fallback.imageSelector, path: stage.expected });
        } else {
          const deadline = Date.now() + 8000;
          while (!fixture.record.localFailures.some(url => runtimePath(url) === fallback.ownedGrowthPath)) {
            assert.ok(Date.now() < deadline, 'Final fallback failure must actually be requested before absence is accepted.');
            await fixture.page.waitForTimeout(25);
          }
          await fixture.page.locator(fallback.imageSelector).waitFor({ state: 'detached' });
        }
        await fixture.flush();
        const failedBefore = fixture.record.localFailures.length;
        await fixture.page.waitForTimeout(2000);
        assert.equal(fixture.record.localFailures.length, failedBefore, 'Finite failure chain must settle without retry loop.');
        const attempted = fixture.record.localFailures.map(runtimePath);
        const countByPath = Object.fromEntries([...new Set(attempted)].map(path => [path, attempted.filter(item => item === path).length]));
        // Multiple real consumers can share a failed asset. Count per consumer is
        // verified against actual frozen helper below; avoid equating network cache
        // deduplication with a semantic single-attempt proof.
        assert.ok(fixture.record.localFailures.length <= fallback.maximumFailureRequests, JSON.stringify(countByPath));
        for (const [path, count] of Object.entries(countByPath)) assert.ok(count <= (path.endsWith('.webp') && path.startsWith(webpPrefix) ? 2 : 1), `Unexpected repeated failure ${path}: ${count}`);
        assert.equal(new Set(attempted).size, 4, 'Terminal chain must use exactly four distinct owned paths.');
        assert.deepEqual(await readPersonalRecordFixture(fixture.page), before);
        verifyNoBulk(fixture.record); verifyResponseBytes(fixture.record);
        const facts = await imageFacts(fixture.page, fallback.imageSelector);
        pass(`${fallback.name}: ${stage.label} fallback settles with canonical records unchanged`, { expected: stage.expected, facts, failedPaths: attempted, countByPath });
        await capture(fixture.page, `${fallback.name}-${stage.label}`);
      } catch (error) {
        await capture(fixture.page, `${fallback.name}-${stage.label}-failure`).catch(() => {});
        throw error;
      } finally { await fixture.context.close(); }
    }
  }
  report.status = 'passed';
} catch (error) {
  report.status = 'failed'; report.failures.push(String(error.stack || error)); process.exitCode = 1;
  console.error(error.stack || error);
} finally {
  await browser.close();
  report.finishedAtUtc = new Date().toISOString();
  writeFileSync(`${out}/original-art-flow-report.json`, JSON.stringify(report, null, 2), { flag: 'wx' });
}
