import fs from 'node:fs';import path from 'node:path';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';import {chromium} from '/workspace/oda-reference-redesign/node_modules/playwright/index.mjs';import {getInitialDemoState} from '/workspace/oda-reference-redesign/src/services/repository.ts';
const repo='/workspace/oda-reference-redesign',source=process.env.ODA_VISUAL_SOURCE,receiptPath=process.env.ODA_VISUAL_RECEIPT,out=process.env.ODA_VISUAL_OUT,base='http://127.0.0.1:4183/one-decision-away/';if(!source||!receiptPath||!out)throw Error('Frozen binding/output required');fs.mkdirSync(out,{recursive:true});const receipt=JSON.parse(fs.readFileSync(receiptPath,'utf8')),hash=b=>createHash('sha256').update(b).digest('hex'),stable=()=>[...receipt.source,...receipt.build].every(f=>fs.statSync(repo+'/'+f.file).size===f.bytes&&hash(fs.readFileSync(repo+'/'+f.file))===f.sha256),r={source,receiptPath,cases:[],errors:[],externalBlocked:[],at:new Date().toISOString(),bytesBefore:stable()};if(receipt.sourceCommit!==source||execFileSync('git',['rev-parse','HEAD'],{cwd:repo}).toString().trim()!==source||!r.bytesBefore)throw Error('Binding mismatch');const browser=await chromium.launch({executablePath:'/usr/bin/chromium'});const matrix=[];for(const locale of ['en','tr','es'])for(const theme of ['light','dark'])for(const width of [320,390,1440])matrix.push({id:`${locale}-${theme}-${width}`,locale,theme,width,height:width===1440?1000:844});if(process.env.ODA_SMOKE)matrix.splice(1);const save=()=>fs.writeFileSync(out+'/report.json',JSON.stringify(r,null,2)+'\n');
const captureText=async(p,q,name,selectors)=>{await p.evaluate(()=>scrollTo(0,0));await p.evaluate(()=>document.fonts.ready);const texts=await p.evaluate(selectors=>selectors.flatMap(selector=>[...document.querySelectorAll(selector)].map(e=>{const s=getComputedStyle(e),b=e.getBoundingClientRect(),fg=s.color.match(/[\d.]+/g).slice(0,3).map(Number);return{selector,text:e.textContent.trim(),foreground:fg,fontSize:parseFloat(s.fontSize),fontWeight:parseFloat(s.fontWeight)||400,threshold:parseFloat(s.fontSize)>=24||(parseFloat(s.fontWeight)>=700&&parseFloat(s.fontSize)>=18.666)?3:4.5,bounds:{x:b.x,y:b.y,width:b.width,height:b.height}}})),selectors);const prefix=q.id+'-'+name,visible=out+'/'+prefix+'.png',background=out+'/'+prefix+'-foreground-transparent-probe.png';await p.screenshot({path:visible,animations:'disabled'});await p.evaluate(selectors=>{for(const sel of selectors)for(const e of document.querySelectorAll(sel)){e.dataset.qaOriginalStyle=e.getAttribute('style')||'';e.style.setProperty('color','transparent','important');e.style.setProperty('text-shadow','none','important')}},selectors);await p.screenshot({path:background,animations:'disabled'});await p.evaluate(selectors=>{for(const sel of selectors)for(const e of document.querySelectorAll(sel)){const old=e.dataset.qaOriginalStyle;e.setAttribute('style',old);delete e.dataset.qaOriginalStyle}},selectors);const metadata=out+'/'+prefix+'-raster-input.json';fs.writeFileSync(metadata,JSON.stringify({visible,background,texts},null,2)+'\n');const measured=JSON.parse(execFileSync('python3',['/workspace/scratch/oda-reference-redesign/original-art-integration/independent-visual/raster-text-contrast.py',metadata],{maxBuffer:2e6}).toString());const item={state:name,visible:{file:path.basename(visible),bytes:fs.statSync(visible).size,sha256:hash(fs.readFileSync(visible))},backgroundProbe:{file:path.basename(background),bytes:fs.statSync(background).size,sha256:hash(fs.readFileSync(background))},texts:measured};q.states.push(item);return item;};
try{for(const q of matrix){const seed=getInitialDemoState();Object.assign(seed.profile,{displayName:'Synthetic art contrast review',onboardingStep:'completed',locale:q.locale,theme:q.theme,soundMuted:true,nudgesEnabled:false,dailyWisdomEnabled:false,focusTabBlinkEnabled:false,focusScreenPulseEnabled:false});seed.missions=[];const c=await browser.newContext({viewport:{width:q.width,height:q.height},reducedMotion:'reduce',serviceWorkers:'block'});await c.route('**/*',route=>{const u=new URL(route.request().url());if(u.origin===new URL(base).origin)return route.continue();r.externalBlocked.push(u.origin+u.pathname);return route.abort()});await c.addInitScript(({seed,locale,theme})=>{localStorage.setItem('one_decision_away_app_data_v1',JSON.stringify(seed));localStorage.setItem('oda_locale',locale);localStorage.setItem('oda_theme',theme)},{seed,locale:q.locale,theme:q.theme});const p=await c.newPage();p.on('pageerror',e=>r.errors.push(e.message));q.states=[];try{await p.goto(base+'#/app/sound');await p.locator('.oda-sound-title').waitFor();await p.evaluate(()=>Promise.all([...document.images].filter(i=>i.loading==='eager').map(i=>i.decode().catch(()=>{}))));await captureText(p,q,'sound-discovery',['.oda-sound-title','[data-section="relax"] .oda-sound-tab-name','[data-section="relax"] .oda-sound-tab-detail','[data-section="sleep"] .oda-sound-tab-name','[data-section="sleep"] .oda-sound-tab-detail','[data-section="focus"] .oda-sound-tab-name','[data-section="focus"] .oda-sound-tab-detail']);await p.goto(base+'#/app');await p.locator('.oda-fidelity-hero').waitFor();await p.locator('[data-original-scene="today-scene"] img').evaluate(i=>i.decode());await captureText(p,q,'today-quote',['.oda-fidelity-hero-copy > .oda-kicker','.oda-fidelity-hero blockquote','.oda-fidelity-hero figcaption']);}catch(e){r.errors.push(q.id+':'+e.stack)}finally{await c.close();r.cases.push(q);save();console.log('DONE '+q.id)}}}finally{await browser.close();r.bytesAfter=stable();r.readersClosed=true;r.completedAt=new Date().toISOString();r.minimums=r.cases.flatMap(q=>q.states.flatMap(s=>s.texts.map(t=>({case:q.id,state:s.state,text:t.text,threshold:t.threshold,minRatio:t.minRatio,coreGlyphSamples:t.coreGlyphSamples,below:t.belowThresholdCorePixels}))));save();console.log(JSON.stringify({cases:r.cases.length,errors:r.errors,below:r.minimums.filter(t=>t.below>0),closed:true}))}
