    await page.waitForFunction(selector => getComputedStyle(document.querySelector(selector)).backgroundColor === 'rgba(8, 19, 28, 0.35)', selector);
    const text = await page.locator(selector).evaluate(el => { const s = getComputedStyle(el); const r = el.getBoundingClientRect(); return { selector: '[data-section="sleep"] .oda-sound-tab-detail', text: el.textContent, foreground: [255, 255, 255], fontSize: parseFloat(s.fontSize), fontWeight: parseFloat(s.fontWeight), threshold: 4.5, bounds: { x: r.x, y: r.y, width: r.width, height: r.height }, background: s.backgroundColor, boxShadow: s.boxShadow }; });
    assert.equal(text.background, 'rgba(8, 19, 28, 0.35)'); assert.ok(after.scroll <= after.width + 1); if (width < 768) { assert.ok(after.tabs[2].y + after.tabs[2].height <= after.nav.y + 1); assert.ok(after.tabs[3].y >= height); }
    const visible = `${name}-visible.png`; const background = `${name}-background-probe.png`;
