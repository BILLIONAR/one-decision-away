    await page.waitForFunction(selector => getComputedStyle(document.querySelector(selector)).backgroundColor === 'rgba(8, 19, 28, 0.35)', selector);
    const geometry = () => page.evaluate(selector => {
      const rect = el => { const r = el.getBoundingClientRect(); return { x: r.x, y: r.y, width: r.width, height: r.height }; };
      return { caption: rect(document.querySelector(selector)), tabs: [...document.querySelectorAll('[role="tab"]')].map(rect), nav: rect(document.querySelector('.oda-tabbar')), width: document.documentElement.clientWidth, scroll: document.documentElement.scrollWidth };
    }, selector);
    const after = await geometry();
    const baselinePaint = await page.addStyleTag({ content: `${selector} { background: transparent !important; box-shadow: none !important; }` });
