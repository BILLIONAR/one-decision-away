import { createRequire } from 'node:module';
import fs from 'node:fs';
import assert from 'node:assert/strict';
import { getInitialDemoState } from '/workspace/oda-reference-redesign/src/services/repository.ts';
const require = createRequire('/workspace/oda-reference-redesign/package.json');
const { chromium } = require('playwright');
const AxeBuilder = require('@axe-core/playwright').default;
const outBase = '/workspace/scratch/oda-reference-redesign/original-art-integration/sound';
const out = process.argv[2] ? `${outBase}/${process.argv[2]}` : outBase;
fs.mkdirSync(out, { recursive: true });
const base = 'http://127.0.0.1:4181';
const report = { at: new Date().toISOString(), contexts: [], errors: [], external: [], limits: ['Actual cloud Chromium synthetic local records and original-art integration preview; no physical device/perceptual audio or final fidelity claim.', 'Intentionally denied local image routes in fallback cases; no security bypass or external network request.'] };
const browser = await chromium.launch({ executablePath: '/usr/bin/chromium' });
report.browser = await browser.version();
const cases = [
  { width: 390, height: 844, theme: 'light' }, { width: 320, height: 844, theme: 'light' },
  { width: 390, height: 844, theme: 'dark' }, { width: 390, height: 568, theme: 'light' },
  { width: 1440, height: 1000, theme: 'light' },
  { width: 390, height: 844, theme: 'light', failure: 'webp-sculpture' },
  { width: 390, height: 844, theme: 'light', failure: 'original-and-dunes-svg' },
];
const images = page => page.locator('.oda-sound-scene picture').evaluateAll(pictures => pictures.filter(picture => picture.getBoundingClientRect().width || picture.querySelector('img')?.getBoundingClientRect().width).map(picture => {
  const img = picture.querySelector('img'); const r = img.getBoundingClientRect(); return { asset: picture.dataset.originalScene, mode: picture.dataset.imageMode, currentSrc: img.currentSrc, naturalWidth: img.naturalWidth, naturalHeight: img.naturalHeight, width: r.width, height: r.height, loading: img.loading, sizes: picture.querySelector('source')?.sizes ?? '', crop: getComputedStyle(img).objectPosition };
}));
async function waitImages(page, selector) { await page.waitForFunction(selector => [...document.querySelectorAll(selector)].every(img => img.complete && img.naturalWidth > 0), selector); }
try {
  for (const config of cases) {
    const { width, height, theme, failure } = config; const name = `${theme}-${width}x${height}${failure ? `-${failure}` : ''}`;
    const record = { name, config, requests: [], responseBytes: [], images: [], screenshots: [] }; report.contexts.push(record);
    const seed = getInitialDemoState(); Object.assign(seed.profile, { displayName: 'Synthetic original-art crop QA', locale: 'en', theme, onboardingStep: 'completed', firstOpenedAt: new Date().toISOString(), soundMuted: false, nudgesEnabled: false, dailyWisdomEnabled: false });
    const context = await browser.newContext({ viewport: { width, height }, reducedMotion: 'reduce', serviceWorkers: 'block' });
    await context.route('**/*', route => {
      const url = new URL(route.request().url());
      if (url.origin !== base) { report.external.push(url.href); return route.abort(); }
      const original = url.pathname.includes('/assets/oda/original-scenes/');
      const denied = failure === 'webp-sculpture' && original && url.pathname.includes('sound-sculpture') && url.pathname.endsWith('.webp') || failure === 'original-and-dunes-svg' && (original || url.pathname.endsWith('/sound-dunes.svg'));
      record.requests.push({ path: url.pathname, denied: Boolean(denied) }); return denied ? route.abort() : route.continue();
    });
    await context.addInitScript(({ seed }) => { localStorage.setItem('one_decision_away_app_data_v1', JSON.stringify(seed)); localStorage.setItem('oda_locale', 'en'); }, { seed });
    const page = await context.newPage(); page.on('pageerror', error => report.errors.push({ name, message: error.message }));
    page.on('response', async response => { if (response.url().includes('/assets/oda/')) record.responseBytes.push({ url: response.url(), status: response.status(), bytes: (await response.body().catch(() => Buffer.alloc(0))).length }); });
    await page.goto(`${base}/app/sound`); await page.locator('.oda-sound').waitFor(); await page.evaluate(() => document.fonts.ready);
    for (let n = 0; n < 3 && await page.getByRole('dialog').count(); n++) await page.keyboard.press('Escape');
    await waitImages(page, '.oda-sound-tab:not([data-section="breathe"]) img');
    record.images.push({ state: 'discovery', images: await images(page) });
    const metrics = await page.evaluate(() => { const nav = document.querySelector('.oda-tabbar').getBoundingClientRect(); const scenes = [...document.querySelectorAll('.oda-sound-tab:not([data-section="breathe"])')].map(el => ({ top: el.getBoundingClientRect().top, bottom: el.getBoundingClientRect().bottom })); const breathe = document.querySelector('[data-section="breathe"]').getBoundingClientRect(); return { width: document.documentElement.clientWidth, scroll: document.documentElement.scrollWidth, navTop: nav.top, scenes, breatheTop: breathe.top }; });
    assert.ok(metrics.scroll <= metrics.width + 1); if (width < 768) { assert.ok(metrics.scenes.at(-1).bottom <= metrics.navTop + 1); assert.ok(metrics.breatheTop >= height); } record.discoveryGeometry = metrics;
    const shot = async suffix => { const file = `${name}-${suffix}.png`; await page.screenshot({ path: `${out}/${file}`, animations: 'disabled' }); record.screenshots.push(file); };
    await shot('discovery');
    if (!failure) { const visibleOriginals = record.images[0].images.filter(item => item.width > 0 && item.height > 0); assert.ok(visibleOriginals.every(item => item.currentSrc.endsWith('.webp'))); assert.equal(record.requests.filter(request => request.path.includes('/assets/oda/original-scenes/') && request.path.endsWith('.png')).length, 0, 'normal original-art first load uses optimized WebP'); }
    await page.locator('.oda-sound-card-button').first().click(); await page.locator('.oda-sound-player').waitFor();
    await page.locator('.oda-sound-panel').evaluate(el => { el.scrollIntoView({ block: 'start' }); window.scrollBy(0, -80); });
    await waitImages(page, '.oda-sound-detail-thumb img'); await shot('detail');
    await page.locator('.oda-sound-now-panel').evaluate(el => { el.scrollIntoView({ block: 'start' }); window.scrollBy(0, -80); });
    await page.locator('.oda-sound-now-control-surface').evaluate(el => { const r = el.getBoundingClientRect(); if (r.top < (innerWidth < 768 ? 64 : 24) || r.bottom > innerHeight - (innerWidth < 768 ? 96 : 24)) el.scrollIntoView({ block: 'center' }); });
    await page.locator('.oda-sound-now-panel[data-primary="true"]').waitFor(); assert.equal(await page.locator('.oda-sound-player').count(), 0);
    await waitImages(page, '.oda-sound-now-art img');
    const art = await page.locator('.oda-sound-now-art picture').evaluate(picture => { const img = picture.querySelector('img'); const r = img.getBoundingClientRect(); return { asset: picture.dataset.originalScene, mode: picture.dataset.imageMode, source: img.currentSrc, naturalWidth: img.naturalWidth, naturalHeight: img.naturalHeight, width: r.width, height: r.height, crop: getComputedStyle(img).objectPosition }; });
    assert.equal(art.asset, 'sound-sculpture'); assert.ok(Math.abs(art.height - Math.min(300, Math.max(180, height * .3))) < 1); record.expandedArtwork = art;
    await shot('expanded');
    const axe = await new AxeBuilder({ page }).include('.oda-sound').withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa']).analyze(); record.axe = axe.violations.map(v => ({ id: v.id, impact: v.impact, nodes: v.nodes.map(n => ({ target: n.target, summary: n.failureSummary })) })); assert.equal(record.axe.length, 0, JSON.stringify(record.axe));
    const expanded = page.locator('[data-sound-surface="expanded"]'); await expanded.locator('[data-sound-control="timer"]').selectOption('10');
    const range = expanded.locator('[data-sound-control="volume"]'); await range.focus(); await page.keyboard.press('Home'); await page.keyboard.press('ArrowRight'); assert.equal(await range.inputValue(), '0.01');
    await page.evaluate(() => window.scrollTo(0, 0)); await page.locator('.oda-sound-player').waitFor(); assert.equal(await page.locator('[data-sound-surface="mini"] [data-sound-control="timer"]').inputValue(), '10'); assert.equal(await page.locator('[data-sound-surface="mini"] [data-sound-control="volume"]').inputValue(), '0.01');
    await waitImages(page, '.oda-sound-player-thumb img'); record.images.push({ state: 'mini', images: await images(page) }); await shot('mini');
    if (failure === 'webp-sculpture') assert.equal(art.mode, 'png');
    if (failure === 'original-and-dunes-svg') { assert.equal(art.mode, 'fallback'); assert.ok(art.source.includes('/delivery/course-covers/')); }
    await context.close(); console.log(`PASS ${name}`);
  }
  assert.equal(report.errors.length, 0); assert.equal(report.external.length, 0);
} catch (error) { report.failure = String(error); throw error; }
finally { fs.writeFileSync(`${out}/crop-browser-report.json`, JSON.stringify(report, null, 2) + '\n'); await browser.close(); }
