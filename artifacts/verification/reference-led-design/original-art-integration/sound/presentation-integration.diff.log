diff --git a/src/styles/sound.css b/src/styles/sound.css
index d070da1..496dc78 100644
--- a/src/styles/sound.css
+++ b/src/styles/sound.css
@@ -1,8 +1,9 @@
-/* SoundRoom reference composition. Original vector scenes are illustrations, not source photographs. */
+/* SoundRoom reference composition with approved original local art and owned scene fallbacks. */
 .oda-sound { --sound-cyan: #58DFDB; --sound-on-cyan: #113B40; position: relative; color: var(--fg); padding-bottom: 9rem; }
 .oda-sound button, .oda-sound select, .oda-sound input { -webkit-tap-highlight-color: transparent; }
 .oda-sound button:focus-visible, .oda-sound select:focus-visible, .oda-sound input:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
 .oda-sound-scene { display: block; position: relative; overflow: hidden; background: #19313C; }
+.oda-sound-scene picture { display: contents; }
 .oda-sound-scene img { display: block; width: 100%; height: 100%; object-fit: cover; }
 .oda-sound-scene[data-scene="night"] img { filter: brightness(.68) saturate(.7); }
 .oda-sound-intro { position: absolute; top: 1.5rem; left: 0; right: 0; z-index: 6; text-align: center; pointer-events: none; }
@@ -23,6 +24,7 @@
 .oda-sound-tab:nth-child(3) { z-index: 2; margin-top: calc(-1 * var(--sound-wave-overlap)); height: var(--sound-scene-span); border-radius: 0 0 28% 62% / 0 0 16% 24%; }
 .oda-sound-tab > .oda-sound-scene { position: absolute; inset: 0; }
 .oda-sound-tab::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(8 19 28 / .08), rgb(8 19 28 / .18) 45%, rgb(8 19 28 / .5)); }
+.oda-sound-tab:nth-child(1)::after { background: linear-gradient(180deg, rgb(8 19 28 / .5), rgb(8 19 28 / .24) 45%, rgb(8 19 28 / .5)); }
 .oda-sound-tab-copy { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; min-height: 0; padding: 1.4rem 1.45rem 2rem; color: #FFFFFF; }
 .oda-sound-tab:nth-child(2) .oda-sound-tab-copy { padding-top: calc(var(--sound-wave-overlap) + .75rem); }
 .oda-sound-tab:nth-child(3) .oda-sound-tab-copy { padding: calc(var(--sound-wave-overlap) + .25rem) 1.45rem .8rem; }
@@ -85,7 +87,7 @@
 .oda-sound-now-heading h2 { margin-top: .5rem; font-size: 1.5rem; letter-spacing: -.03em; line-height: 1.15; }
 .oda-sound-now-heading > p:last-child { margin-top: .7rem; max-width: 36ch; font-size: .8rem; line-height: 1.6; color: #E4F4F0; }
 .oda-sound-now-art { width: calc(100% + 2.2rem); height: clamp(180px, 30svh, 300px); margin: 1.4rem -1.1rem 0; border-radius: 0 0 45% 15% / 0 0 18% 6%; }
-.oda-sound-now-art img { object-position: center 65%; opacity: .92; }
+.oda-sound-now-art img { object-position: center 45%; opacity: .92; }
 .oda-sound-now-control-surface { position: relative; margin: -22px auto 0; padding: .75rem; border: 1px solid rgb(194 245 239 / .22); border-radius: 26px; background: rgb(50 99 106 / .8); backdrop-filter: blur(14px); color: #D9EEEA; }
 .oda-sound-now-controls { display: flex; justify-content: space-around; align-items: center; width: min(100%, 270px); margin-inline: auto; }
 .oda-sound-now-status { margin-block: .4rem .25rem; font-size: .74rem; line-height: 1.4; text-align: center; font-variant-numeric: tabular-nums; color: #DEEFED; }
