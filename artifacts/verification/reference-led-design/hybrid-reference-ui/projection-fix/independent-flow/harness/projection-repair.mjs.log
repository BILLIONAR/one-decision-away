// Preparation only until a new explicit parent source/build GO. No modules,
// source audits or browsers run before admission.
if(process.env.ODA_PROJECTION_REPAIR_GO !== '1') throw new Error('PREP ONLY: new frozen-source/build GO required.');
const repo='/workspace/oda-reference-redesign',base='http://127.0.0.1:4183/one-decision-away/';
const out=process.env.ODA_PROJECTION_QA_OUT,source=process.env.ODA_PROJECTION_SOURCE_COMMIT;
const receiptPath=process.env.ODA_PROJECTION_BUILD_RECEIPT,key='one_decision_away_app_data_v1';
assert.ok(out?.startsWith('/workspace/scratch/oda-reference-redesign/hybrid-reference-ui/projection-repair-qa/'));
assert.match(source||'',/^[0-9a-f]{40}$/);
const receiptBytes=readFileSync(receiptPath),receipt=JSON.parse(receiptBytes);
const sha=b=>createHash('sha256').update(b).digest('hex');
const git=(...args)=>execFileSync('git',args,{cwd:repo,encoding:'utf8'}).trim();
function admission(){
 assert.equal(git('rev-parse','HEAD'),source);assert.equal(git('branch','--show-current'),'design/reference-led-oda');assert.equal(git('status','--porcelain'),'');
 assert.equal(receipt.sourceCommit,source);assert.equal(receipt.exitCode,0);assert.ok(receipt.allSourcesMatchCommittedSource&&receipt.unchangedDuringRun);
 for(const row of [...receipt.source,...receipt.build]){const data=readFileSync(`${repo}/${row.file}`);assert.equal(sha(data),row.sha256,row.file);assert.equal(data.length,row.bytes,row.file);}
 return {sourceCommit:source,clean:true,sourceFiles:receipt.source.length,buildFiles:receipt.build.length,parentReceiptSHA256:sha(receiptBytes),atUtc:new Date().toISOString()};
}
mkdirSync(out,{recursive:true});
const report={task:'Independent narrow saved-course display repair validation',synthetic:true,preflight:admission(),checks:[],cases:[],contexts:[],screenshots:[],errors:[],limits:[
 'Actual compiled local app in isolated synthetic signed-out contexts; no production state, install/build/deploy/provider/account/purchase operation.',
 'Genuine native IDB readwrite transaction is held before native put using bounded native get requests; this amplifies a real pending-save window without claiming its ordinary duration.',
 'Private course draft/optimistic projection may change while pending; only public saved display and committed IDB authority are checked.',
 'Headless bringToFront may not deliver trusted focus; any explicit synthetic focus event is labelled, not represented as genuine focus.',
 'Mobile screenshots are Chromium viewport emulation, not physical iOS testing.'
]};
const response=await fetch(base);assert.equal(response.status,200);const index=Buffer.from(await response.arrayBuffer());assert.equal(sha(index),sha(readFileSync(`${repo}/dist/index.html`)));report.servedIndex={status:200,bytes:index.length,sha256:sha(index)};
const {getInitialDemoState}=await import(pathToFileURL(`${repo}/src/services/repository.ts`));
const {courseCatalogFor}=await import(pathToFileURL(`${repo}/src/data/courseCatalog.ts`));
const course=courseCatalogFor('en').find(c=>c.id==='turning-day');assert.ok(course);const first=course.lessons[0],second=course.lessons[1];
const seed=getInitialDemoState(),now=new Date().toISOString();
seed.profile={...seed.profile,displayName:'Synthetic saved-course repair QA',locale:'en',theme:'light',onboardingStep:'completed',intent:'finish',simpleModeOff:true,soundMuted:true,nudgesEnabled:false,dailyWisdomEnabled:false,reminderAskedAt:now,firstOpenedAt:'2026-01-01T00:00:00Z',lastOpenedAt:now};
seed.courseProgress={version:1,lessons:{[first.id]:{checked:Array(first.practiceCount).fill(true),answer:first.correct,reflection:'Synthetic saved real prerequisites, not completed',completed:false}}};
seed.completions=[];seed.missions=seed.missions.filter(m=>!m.isOneDecision);seed.transactions=seed.transactions.filter(t=>t.kind==='welcome_grant');seed.notebook.entries=[];seed.dreamJournal=[];
report.fixture={courseId:course.id,first,second,initialCompleted:0,alreadySavedPrerequisites:true};
writeFileSync(`${out}/synthetic-seed.json`,JSON.stringify(seed,null,2),{flag:'wx'});
const require=createRequire(`${repo}/package.json`),{chromium}=require('playwright');
const browser=await chromium.launch({executablePath:'/usr/bin/chromium'});report.browser=await browser.version();let active;
const pass=(name,evidence)=>{report.checks.push({name,evidence});console.log(`PASS ${name}`);};
async function create(label,viewport){
 const context=await browser.newContext({viewport,timezoneId:'UTC',reducedMotion:'reduce',serviceWorkers:'block'});
 const record={label,viewport,requests:[],blockedExternal:[],pageErrors:[]};report.contexts.push(record);
 await context.route('**/*',route=>{const r=route.request();if(new URL(r.url()).origin!==new URL(base).origin||!['GET','HEAD'].includes(r.method())){record.blockedExternal.push({url:r.url(),method:r.method(),resourceType:r.resourceType()});return route.abort();}record.requests.push({url:r.url(),method:r.method(),resourceType:r.resourceType()});return route.continue();});
 await context.addInitScript(({seed,key,lessonId,selection})=>{
  if(!localStorage.getItem(key))localStorage.setItem(key,JSON.stringify(seed));localStorage.setItem('oda_locale','en');localStorage.setItem('oda_theme','light');localStorage.setItem('oda_course_selection_v1',selection);
  window.__projectionEvents={focus:[],storage:[]};addEventListener('focus',e=>window.__projectionEvents.focus.push({at:performance.now(),trusted:e.isTrusted}));
  addEventListener('storage',e=>{if(e.key===key)window.__projectionEvents.storage.push({at:performance.now(),completed:JSON.parse(e.newValue)?.courseProgress?.lessons?.[lessonId]?.completed??false});});
  const nativePut=IDBObjectStore.prototype.put,nativeGet=IDBObjectStore.prototype.get;
  const completed=s=>{try{return !!JSON.parse(s.appData)?.courseProgress?.lessons?.[lessonId]?.completed;}catch{return null;}};
  window.__projectionGate={armed:false,phase:'idle',release:null,events:[],nativeMutationPuts:0,reads:0};
  IDBObjectStore.prototype.put=function(value,recordKey){
   const gate=window.__projectionGate;
   if(!gate.armed||gate.phase!=='idle'||this.name!=='record'||recordKey!=='current'||completed(value)!==true)return nativePut.apply(this,arguments);
   gate.phase='held-before-native-put';gate.armed=false;gate.heldAt=performance.now();gate.candidateCompleted=completed(value);
   const store=this,tx=this.transaction,started=performance.now();gate.transactionMode=tx.mode;gate.database=tx.db.name;gate.events.push({phase:gate.phase,at:started});
   tx.addEventListener('complete',()=>{gate.phase='native-transaction-complete';gate.events.push({phase:gate.phase,at:performance.now()});});
   tx.addEventListener('abort',()=>{gate.phase='native-transaction-aborted';gate.events.push({phase:gate.phase,at:performance.now()});});
   const pump=()=>{const request=nativeGet.call(store,'current');request.onsuccess=()=>{gate.reads++;gate.authorityCompleted=completed(request.result);gate.lastAuthorityReadAt=performance.now();if(gate.release==='abort'||performance.now()-started>20000){gate.abortReason=gate.release==='abort'?'controlled abort':'bounded watchdog';tx.abort();return;}if(gate.release==='commit'){gate.nativeMutationPuts++;gate.nativePutAt=performance.now();nativePut.call(store,value,recordKey);return;}pump();};return request;};return pump();
  };
 },{seed,key,lessonId:first.id,selection:course.id});
 return {context,record};
}
async function newPage(context,record,route='/app'){const page=await context.newPage();active=page;page.setDefaultTimeout(8000);page.on('pageerror',e=>{record.pageErrors.push(e.message);report.errors.push(e.message);});await page.goto(`${base}#${route}`);await page.locator('[data-app-route]').waitFor();await page.evaluate(()=>document.fonts.ready);return page;}
async function nav(page,route){await page.goto(`${base}#${route}`);await page.locator(`[data-app-route="${route}"]`).waitFor();}
async function authority(page){return page.evaluate(({key,id})=>new Promise((resolve,reject)=>{const open=indexedDB.open('oda_personal_record_v1',1);open.onerror=()=>reject(String(open.error));open.onsuccess=()=>{const db=open.result,tx=db.transaction('record','readonly'),get=tx.objectStore('record').get('current');tx.oncomplete=()=>{db.close();resolve({completed:!!JSON.parse(get.result.appData)?.courseProgress?.lessons?.[id]?.completed,projectionCompleted:!!JSON.parse(localStorage.getItem(key))?.courseProgress?.lessons?.[id]?.completed});};tx.onabort=()=>{db.close();reject(String(tx.error));};};}),{key,id:first.id});}
async function observe(page){return page.evaluate(({key,id})=>({atUtc:new Date().toISOString(),projectionCompleted:!!JSON.parse(localStorage.getItem(key))?.courseProgress?.lessons?.[id]?.completed,library:Number(document.querySelector('.oda-hybrid-progress [role="progressbar"]')?.getAttribute('aria-valuenow')),libraryMaximum:Number(document.querySelector('.oda-hybrid-progress [role="progressbar"]')?.getAttribute('aria-valuemax')),course:Number(document.querySelector('.oda-hybrid-mission [role="progressbar"]')?.getAttribute('aria-valuenow')),nextTitle:document.querySelector('[data-next-lesson-title]')?.textContent,width:document.documentElement.clientWidth,scrollWidth:document.documentElement.scrollWidth,events:window.__projectionEvents,gate:window.__projectionGate}),{key,id:first.id});}
async function waitToday(page,count){await page.waitForFunction(({count,title})=>Number(document.querySelector('.oda-hybrid-mission [role="progressbar"]')?.getAttribute('aria-valuenow'))===count&&Number(document.querySelector('.oda-hybrid-progress [role="progressbar"]')?.getAttribute('aria-valuenow'))===count&&document.querySelector('[data-next-lesson-title]')?.textContent===title,{count,title:count?second.title:first.title});return observe(page);}
async function capture(page,name){await page.locator('.oda-hybrid-mission').screenshot({path:`${out}/${name}.png`,animations:'disabled'});report.screenshots.push(`${name}.png`);}
async function startMutation(page){await nav(page,'/app/courses');const complete=page.getByRole('button',{name:'Complete lesson',exact:true});await complete.waitFor();assert.ok(await complete.isEnabled());await page.evaluate(()=>{window.__projectionGate.armed=true;});await complete.click();await page.waitForFunction(()=>window.__projectionGate.phase==='held-before-native-put'&&window.__projectionGate.reads>0);const held=await page.evaluate(()=>window.__projectionGate);assert.equal(held.transactionMode,'readwrite');assert.equal(held.nativeMutationPuts,0);assert.equal(held.authorityCompleted,false);return held;}
async function release(page,mode){await page.evaluate(mode=>{window.__projectionGate.release=mode;},mode);await page.waitForFunction(()=>['native-transaction-complete','native-transaction-aborted'].includes(window.__projectionGate.phase));}
async function assertPending(page,writer=page){const samples=[];for(let i=0;i<3;i++){await page.waitForTimeout(150);const state=await observe(page),gate=await writer.evaluate(()=>window.__projectionGate);assert.equal(gate.phase,'held-before-native-put');assert.equal(gate.nativeMutationPuts,0);assert.equal(gate.authorityCompleted,false);assert.equal(state.course,0);assert.equal(state.library,0);assert.equal(state.libraryMaximum,103);assert.equal(state.nextTitle,first.title);assert.ok(state.scrollWidth<=state.width+1);samples.push({state,gate});}return samples;}
try{
 for(const [mode,width] of [['commit',320],['abort',390]]){
  const {context,record}=await create(`same-tab-${mode}-${width}`,{width,height:844});const page=await newPage(context,record);const result={name:`same-tab actual Complete lesson ${mode},${width}px`,baseline:await waitToday(page,0),baselineAuthority:await authority(page)};report.cases.push(result);
  result.held=await startMutation(page);await nav(page,'/app');result.pending=await assertPending(page);await capture(page,`same-tab-${mode}-${width}-pending`);result.pendingAfterScreenshot=await assertPending(page);
  pass(`${width}px pending native save keeps public course0/library0/first title despite optimistic projection`,result.pendingAfterScreenshot);
  await release(page,mode);result.settled=await waitToday(page,mode==='commit'?1:0);result.authority=await authority(page);assert.equal(result.authority.completed,mode==='commit');assert.equal(result.authority.projectionCompleted,mode==='commit');assert.ok(result.settled.scrollWidth<=result.settled.width+1);await capture(page,`same-tab-${mode}-${width}-settled`);
  pass(`${mode} updates only after durable native transaction to ${mode==='commit'?'one/second lesson':'zero/first lesson'}`,{state:result.settled,authority:result.authority});
  await page.reload();await page.locator('[data-app-route]').waitFor();result.reloaded=await waitToday(page,mode==='commit'?1:0);result.reloadedAuthority=await authority(page);assert.equal(result.reloadedAuthority.completed,mode==='commit');pass(`${mode} result survives reload with correct103lesson denominator`,result.reloaded);await context.close();
 }
 const {context,record}=await create('cross-tab-focus-abort',{width:1440,height:1000});const writer=await newPage(context,record),reader=await newPage(context,record);const result={name:'Already mounted cross-tab Today focus while writer pending; abort',baseline:await waitToday(reader,0)};report.cases.push(result);
 await writer.bringToFront();result.held=await startMutation(writer);await reader.waitForFunction(({key,id})=>!!JSON.parse(localStorage.getItem(key))?.courseProgress?.lessons?.[id]?.completed,{key,id:first.id});result.beforeFocus=await observe(reader);await reader.bringToFront();await reader.waitForTimeout(100);result.afterBringToFront=await observe(reader);
 result.trustedFocusObserved=result.afterBringToFront.events.focus.length>result.beforeFocus.events.focus.length&&result.afterBringToFront.events.focus.at(-1).trusted;
 if(!result.trustedFocusObserved){await reader.evaluate(()=>dispatchEvent(new Event('focus')));result.focusCoverage='explicit synthetic window focus event; headless bringToFront delivered no trusted focus';}else result.focusCoverage='trusted browser focus delivered by bringToFront';
 result.pending=await assertPending(reader,writer);await capture(reader,'cross-tab-focus-abort-pending');pass('Already mounted cross-tab public saved progress ignores provisional storage/focus projection',result.pending);
 await release(writer,'abort');result.settled=await waitToday(reader,0);result.authority=await authority(reader);assert.equal(result.authority.completed,false);await capture(reader,'cross-tab-focus-abort-settled');await reader.reload();await reader.locator('[data-app-route]').waitFor();result.reloaded=await waitToday(reader,0);pass('Cross-tab abort/reload keeps canonical zero and real first title',{state:result.reloaded,focusCoverage:result.focusCoverage});await context.close();
 assert.deepEqual(report.errors,[]);report.status='passed';
}catch(error){report.status='failed';report.failure=String(error.stack||error);process.exitCode=1;console.error(report.failure);if(active&&!active.isClosed())await capture(active,'failure').catch(()=>{});}
finally{await browser.close();report.postflight=admission();report.finishedAtUtc=new Date().toISOString();writeFileSync(`${out}/report.json`,JSON.stringify(report,null,2),{flag:'wx'});}
