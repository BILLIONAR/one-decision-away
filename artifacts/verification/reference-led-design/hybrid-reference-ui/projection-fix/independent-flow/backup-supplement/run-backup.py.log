"""Exclusive raw-log runner for one parent-authorized narrow browser attempt."""
from pathlib import Path
import datetime, hashlib, json, os, subprocess, time
root=Path(__file__).parent
out=root/'attempt-01'
out.mkdir(exist_ok=False)
repo='/workspace/oda-reference-redesign'
harness=root/'backup-scope.mjs'
argv=['node','--import','tsx',str(harness)]
env=os.environ.copy()
env.update(ODA_BACKUP_SCOPE_GO='1',ODA_PRIMARY_CASES_PASSED='1',ODA_BACKUP_SCOPE_OUT=str(out))
started=datetime.datetime.now(datetime.timezone.utc).isoformat()
before=time.monotonic()
with (out/'browser.log').open('xb') as log:
    result=subprocess.run(argv,cwd=repo,env=env,stdout=log,stderr=subprocess.STDOUT,check=False)
log=(out/'browser.log').read_bytes()
script=harness.read_bytes()
receipt={'sourceCommit':'d33c0077c549bdf8e61fbf9b8bb20422a768f8e9','argv':argv,'cwd':repo,'startedAtUtc':started,'finishedAtUtc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'elapsedSeconds':time.monotonic()-before,'exitCode':result.returncode,'harness':{'path':str(harness),'bytes':len(script),'sha256':hashlib.sha256(script).hexdigest()},'log':{'path':str(out/'browser.log'),'bytes':len(log),'sha256':hashlib.sha256(log).hexdigest()},'explicitParentPrimaryPassGO':True,'syntheticOnly':True,'notRerunOrReplacement':True,'environmentOverrides':{key:env[key] for key in ['ODA_BACKUP_SCOPE_GO','ODA_PRIMARY_CASES_PASSED','ODA_BACKUP_SCOPE_OUT']}}
with (out/'command-receipt.json').open('x') as f: json.dump(receipt,f,indent=2);f.write('\n')
print(json.dumps(receipt,indent=2))
raise SystemExit(result.returncode)
