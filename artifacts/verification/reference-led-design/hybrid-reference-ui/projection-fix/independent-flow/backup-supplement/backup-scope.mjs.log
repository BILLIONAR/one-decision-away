async function bindServed() {
  const files = receipt.build.filter(row => row.file === 'dist/index.html' || row.file.endsWith('.js') || row.file.endsWith('.css'));
  const served = [];
  // Bounded batches of harmless same-origin GETs, without browser or execution.
  for (let start = 0; start < files.length; start += 8) {
    const batch = await Promise.all(files.slice(start, start + 8).map(async row => {
      const path = row.file.slice('dist/'.length);
      const response = await fetch(base + (path === 'index.html' ? '' : path));
      assert.equal(response.status, 200, path);
      const data = Buffer.from(await response.arrayBuffer());
      const type = response.headers.get('content-type');
      if (path.endsWith('.js')) assert.match(type || '', /(?:javascript|ecmascript)/i, path);
      if (path.endsWith('.css')) assert.match(type || '', /text\/css/i, path);
      assert.equal(data.length, row.bytes, path);
      assert.equal(sha(data), row.sha256, path);
      return {file: row.file, url: response.url, status: response.status, contentType: type, bytes: data.length, sha256: sha(data)};
    }));
    served.push(...batch);
  }
  return {atUtc: new Date().toISOString(), servedFiles: served.length, javascriptFiles: served.filter(row => row.file.endsWith('.js')).length, cssFiles: served.filter(row => row.file.endsWith('.css')).length, files: served};
}
async function authority(page) {
  const result = await page.evaluate(({key, epochKey}) => new Promise((resolve, reject) => {
    const open = indexedDB.open('oda_personal_record_v1', 1);
    open.onerror = () => reject(String(open.error));
    open.onsuccess = () => {
      const db = open.result;
      const tx = db.transaction('record', 'readonly');
      const get = tx.objectStore('record').get('current');
      tx.onabort = () => {db.close(); reject(String(tx.error));};
      tx.oncomplete = () => {
        const raw = get.result?.appData;
        const projectionRaw = localStorage.getItem(key);
        const record = raw ? JSON.parse(raw) : null;
        db.close();
        resolve({raw, projectionRaw, profileId: record?.profile?.id, epoch: record?.[epochKey], courseProgress: record?.courseProgress, record});
      };
    };
  }), {key, epochKey});
  assert.equal(typeof result.raw, 'string');
  assert.equal(result.raw, result.projectionRaw, 'Native IDB appData and local projection are byte-identical after commit');
  return {...result, rawSha256: sha(result.raw), rawBytes: Buffer.byteLength(result.raw)};
}
async function observeReader() {
  return reader.evaluate(({key, epochKey}) => {
    const data = JSON.parse(localStorage.getItem(key));
    return {
      profileId: data.profile.id, epoch: data[epochKey], documentToken: window.__backupScope.documentToken,
      timeOrigin: performance.timeOrigin, route: document.querySelector('[data-app-route]')?.getAttribute('data-app-route'),
      library: Number(document.querySelector('.oda-hybrid-progress [role="progressbar"]')?.getAttribute('aria-valuenow')),
      libraryMaximum: Number(document.querySelector('.oda-hybrid-progress [role="progressbar"]')?.getAttribute('aria-valuemax')),
      course: Number(document.querySelector('.oda-hybrid-mission [role="progressbar"]')?.getAttribute('aria-valuenow')),
      courseMaximum: Number(document.querySelector('.oda-hybrid-mission [role="progressbar"]')?.getAttribute('aria-valuemax')),
      nextTitle: document.querySelector('[data-next-lesson-title]')?.textContent,
      nextGoal: document.querySelector('[data-next-lesson-goal]')?.textContent,
      sameMissionNode: window.__backupScope.missionNode === document.querySelector('.oda-hybrid-mission'),
      sameLibraryNode: window.__backupScope.libraryNode === document.querySelector('.oda-hybrid-progress'),
      storageEvents: window.__backupScope.storageEvents,
      width: document.documentElement.clientWidth, scrollWidth: document.documentElement.scrollWidth,
    };
  }, {key, epochKey});
}
async function waitReader(count, lesson) {
  await reader.waitForFunction(({count, title}) =>
    Number(document.querySelector('.oda-hybrid-progress [role="progressbar"]')?.getAttribute('aria-valuenow')) === count &&
    Number(document.querySelector('.oda-hybrid-mission [role="progressbar"]')?.getAttribute('aria-valuenow')) === count &&
    document.querySelector('[data-next-lesson-title]')?.textContent === title,
  {count, title: lesson.title});
  const view = await observeReader();
  assert.equal(view.nextGoal, lesson.goal);
  assert.equal(view.libraryMaximum, report.fixture.catalogueLessonCount);
  assert.equal(view.courseMaximum, report.fixture.course.lessonCount);
  assert.equal(view.route, '/app');
  assert.equal(view.documentToken, report.readerBaseline.documentToken);
  assert.equal(view.timeOrigin, report.readerBaseline.timeOrigin);
  assert.equal(view.sameMissionNode, true);
  assert.equal(view.sameLibraryNode, true);
  assert.equal(report.readerMainFrameNavigations.length, 1);
  assert.ok(view.scrollWidth <= view.width);
  return view;
}
async function capture(page, name, locator) {
  const path = `${out}/${name}.png`;
  if (locator) await page.locator(locator).screenshot({path, animations: 'disabled'});
  else await page.screenshot({path, fullPage: false, animations: 'disabled'});
  report.screenshots.push(`${name}.png`);
}
