  const chooser = await chooserPromise;
  assert.equal(chooser.isMultiple(), false);
  await chooser.setFiles(file);
  const dialog = writer.getByRole('dialog', {name: 'Review the record to restore', exact: true});
  await dialog.waitFor({state: 'visible'});
  const summary = dialog.locator('dl > div').filter({has: writer.getByText('Completed lessons', {exact: true})});
  assert.equal(await summary.locator('dd').textContent(), String(expectedCompleted));
  assert.equal(await dialog.getByRole('button', {name: 'Replace saved record', exact: true}).isEnabled(), true);
  return dialog;
}
