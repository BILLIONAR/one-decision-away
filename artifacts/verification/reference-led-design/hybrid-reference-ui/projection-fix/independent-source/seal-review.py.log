def git(*args): return subprocess.check_output(['git','-C',str(repo),*args])
def sha(b): return hashlib.sha256(b).hexdigest()
def record(p):
 b=p.read_bytes(); return {'file':str(p),'bytes':len(b),'sha256':sha(b)}
def load(p): return json.loads(p.read_text())
def save(n,d): (out/n).write_text(json.dumps(d,indent=2)+'\n')
def tree(commit):
 result={}
 for line in git('ls-tree','-r','-z',commit).split(b'\0'):
  if not line: continue
  meta,path=line.split(b'\t',1); mode,typ,oid=meta.split()
  result[path.decode()]={'mode':mode.decode(),'type':typ.decode(),'oid':oid.decode()}
 return result
def receipt_log(path,receipt):
 p=pathlib.Path(receipt['log'])
 return p if p.is_absolute() else path.parent/p
