-    return () => { unsubscribe(); window.removeEventListener('focus', onFocus); };
-  }, []);
-  useEffect(() => { setProgress(readCourseProgress()); }, [replacement]);
+    update();
+    return () => { active = false; unsubscribe(); window.removeEventListener('focus', onFocus); };
+  }, [generation]);
   return progress;
 }
