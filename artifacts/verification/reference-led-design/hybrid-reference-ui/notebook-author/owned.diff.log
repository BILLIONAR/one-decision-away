+const tr: typeof en = {
+  quotes: 'Alıntılar', loadingQuotes: 'Kaynaklı metinler açılıyor…',
+  categories: 'Metin kategorileri', all: 'Tümü',
+  faith: 'İnanç', philosophy: 'Felsefe', society: 'Toplum', science: 'Bilim',
+  collection: n => `Kaynaklarıyla birlikte ${n} metin.`,
+  searchQuotes: 'Metin veya kaynak ara', noQuotes: 'Eşleşen metin yok.',
+  clearSearch: 'Aramayı temizle', moreQuotes: 'Daha fazla metin göster',
+  shown: (shown, total) => `${total} metnin ${shown} tanesi`,
+  source: 'Kaynağı oku', translation: 'Çeviri', adaptation: 'Uyarlama',
+  englishQuotes: 'Bu metinler İngilizcedir; gezinme dili İspanyolca olarak kalır.',
+  decorativeArt: 'Görseller dekoratiftir; her kartta kaynak bağlantısı bulunur.',
+  previousWeek: 'Önceki hafta', nextWeek: 'Sonraki hafta', thisWeek: 'Bu hafta',
+  archiveDates: 'Tarihler kayıtlı yazıları filtreler. Yeni yazı bugüne kaydedilir.',
+  newEntry: 'Yeni günlük yazısı', todaysEntry: 'Bugünün yazısı', savedEntry: 'Kayıtlı yazı',
+  entryActions: 'Yazı işlemleri', allEntries: 'Günlük arşivi',
+};
+const es: typeof en = {
+  quotes: 'Citas', loadingQuotes: 'Abriendo textos con fuentes…',
+  categories: 'Categorías de textos', all: 'Todas',
+  faith: 'Fe', philosophy: 'Filosofía', society: 'Sociedad', science: 'Ciencia',
+  collection: n => `${n} textos con sus fuentes.`,
