@@ -0,0 +1,49 @@
+const en = {
+  quotes: 'Quotes', loadingQuotes: 'Opening sourced passages…',
+  categories: 'Passage categories', all: 'All',
+  faith: 'Faith', philosophy: 'Philosophy', society: 'Society', science: 'Science',
+  collection: (n: number) => `${n} passages with their sources.`,
+  searchQuotes: 'Search passages or sources', noQuotes: 'No passages match.',
+  clearSearch: 'Clear search', moreQuotes: 'Show more passages',
+  shown: (shown: number, total: number) => `${shown} of ${total} passages`,
+  source: 'Read source', translation: 'Translation', adaptation: 'Adaptation',
+  englishQuotes: 'These passages are in English; navigation remains in Spanish.',
+  decorativeArt: 'Artwork is decorative; the source is linked on each card.',
+  previousWeek: 'Previous week', nextWeek: 'Next week', thisWeek: 'This week',
+  archiveDates: 'Dates filter saved entries. New writing belongs to today.',
