import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';

export async function admit(label) {
  if (process.env.ODA_HYBRID_FLOW_GO !== '1') throw new Error('PREP ONLY: parent final source/build GO required.');
  const repo = process.env.ODA_QA_REPO, out = process.env.ODA_QA_OUT;
  const commit = process.env.ODA_QA_SOURCE_COMMIT, base = process.env.ODA_QA_URL;
  const config = JSON.parse(readFileSync(process.env.ODA_HYBRID_FROZEN_CONFIG, 'utf8'));
  const preflight = JSON.parse(readFileSync(process.env.ODA_HYBRID_PREFLIGHT, 'utf8'));
  assert.equal(config.status, 'bound-to-frozen-source'); assert.equal(config.sourceCommit, commit);
  assert.equal(preflight.sourceCommit, commit);
  assert.ok(preflight.allSourcesMatchCommittedSource && preflight.allBuildFilesMatchParent);
  assert.equal(execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repo, encoding: 'utf8' }).trim(), commit);
  assert.equal(execFileSync('git', ['status', '--porcelain'], { cwd: repo, encoding: 'utf8' }).trim(), '');
  assert.ok(base.endsWith('/#'));
  const require = createRequire(`${repo}/package.json`), { chromium } = require('playwright');
  const browser = await chromium.launch({ executablePath: '/usr/bin/chromium' });
  const report = { label, sourceCommit: commit, synthetic: true, browser: await browser.version(), checks: [], contexts: [], screenshots: [], errors: [], limits: [
    'Actual frozen compiled local preview in disposable synthetic signed-out contexts; no production/provider/model/account/purchase/native signing operation.',
    'Where browser clock is advanced for119→120, the controlled clock is explicitly synthetic; application timer duration and completion controller remain real.',
    'No claim that behavioral continuity approves the new structure or visual materials, or that all narration received human listening/transcription QA.'
  ] };
  mkdirSync(out, { recursive: true });
  const pass = (name, evidence) => { report.checks.push({ name, evidence }); console.log(`PASS ${name}`); };
  const create = async ({ seed, viewport = { width: 390, height: 844 }, locale = 'en', timezoneId = 'UTC', fixedClock } = {}) => {
    const context = await browser.newContext({ viewport, timezoneId, reducedMotion: 'reduce', serviceWorkers: 'block' });
    const record = { viewport, locale, timezoneId, requests: [], blockedExternal: [], pageErrors: [], courseNavigationIntents: [] };
    report.contexts.push(record);
    await context.route('**/*', route => {
      const request = route.request();
      if (new URL(request.url()).origin !== new URL(base).origin || !['GET', 'HEAD'].includes(request.method())) { record.blockedExternal.push(request.url()); return route.abort(); }
      record.requests.push({ url: request.url(), resourceType: request.resourceType(), method: request.method() }); return route.continue();
    });
    await context.addInitScript(({ seed, locale, intentKey }) => {
      if (!localStorage.getItem('one_decision_away_app_data_v1')) localStorage.setItem('one_decision_away_app_data_v1', JSON.stringify(seed));
      localStorage.setItem('oda_locale', locale); localStorage.setItem('oda_theme', seed.profile.theme);
      const native = Storage.prototype.setItem;
      window.__hybridCourseIntents = [];
      Storage.prototype.setItem = function(key, value) {
        if (this === sessionStorage && key === intentKey) window.__hybridCourseIntents.push(value);
        return native.call(this, key, value);
      };
    }, { seed, locale, intentKey: 'oda_course_navigation_intent_v1' });
    const page = await context.newPage(); page.setDefaultTimeout(8000);
    page.on('pageerror', error => { record.pageErrors.push(error.message); report.errors.push(error.message); });
    if (fixedClock) await page.clock.install({ time: new Date(fixedClock) });
    return { context, page, record };
  };
  const read = page => page.evaluate(() => JSON.parse(localStorage.getItem('one_decision_away_app_data_v1')));
  const waitRecord = async (page, predicate, label = 'canonical commit') => {
    const deadline = Date.now() + 6000;
    do { const data = await read(page); if (predicate(data)) return data; await page.waitForTimeout(50); } while (Date.now() < deadline);
    throw new Error(`Timed out waiting for ${label}`);
  };
  const goto = async (page, route) => { await page.goto(`${base}${route}`); await page.locator('[data-app-route]').waitFor(); await page.evaluate(() => document.fonts.ready); };
  const capture = async (page, name, fullPage = false) => { await page.screenshot({ path: `${out}/${name}.png`, animations: 'disabled', fullPage }); report.screenshots.push(`${name}.png`); };
  const fit = async (page, selector) => {
    const evidence = await page.locator(selector).evaluate(root => { const w = document.documentElement.clientWidth; return { width: w, scrollWidth: document.documentElement.scrollWidth, clipped: [...root.querySelectorAll('button,input,select,textarea')].flatMap(element => { const r = element.getBoundingClientRect(); return r.width > 0 && r.height > 0 && (r.left < -1 || r.right > w + 1) ? [{ tag: element.tagName, label: element.getAttribute('aria-label') || element.textContent, left: r.left, right: r.right }] : []; }) }; });
    assert.ok(evidence.scrollWidth <= evidence.width + 1); assert.deepEqual(evidence.clipped, []); return evidence;
  };
  const close = async status => { await browser.close(); report.status = status; report.finishedAtUtc = new Date().toISOString(); writeFileSync(`${out}/${label}-report.json`, JSON.stringify(report, null, 2), { flag: 'wx' }); };
  return { repo, out, config, browser, report, pass, create, read, waitRecord, goto, capture, fit, close };
}

export const exact = (locator, text) => locator.getByText(text, { exact: true });
export const hashBytes = bytes => createHash('sha256').update(bytes).digest('hex');
