"""Read-only Git/evidence audit. No browser, build, application edit or network."""
import collections
import datetime
import hashlib
import json
from pathlib import Path
import re
import subprocess
from urllib.parse import urlsplit, parse_qs

REPO = Path('/workspace/oda-reference-redesign')
OUT = Path(__file__).parent
FLOW = OUT.parent
ART = Path('/workspace/scratch/oda-reference-redesign/original-art-integration/final/flows')
GUIDANCE = Path('/workspace/scratch/oda-reference-redesign/fidelity-rework/final/ssr-boundary-fix/flows/guidance')
TARGET = 'c2a5e6497f1bed4cf95951375c9aa86872b169a9'
REVS = {
    'c2a': TARGET,
    '5aa': '5aa69ae3f2d722558fb69319babda0c1810b69d2',
    '4bf': '4bf566f17980fe2eaf26e3f20b277e97cad981b9',
    '166d': '166d0427257eabcb159ca8eb7c58fc4228ef3991',
    'd7ed': 'd7ed5455fd8a0eaa9372e22bd495f19d7f8cd494',
}

def git(*args):
    return subprocess.check_output(['git', *args], cwd=REPO)

def sha(data):
    return hashlib.sha256(data).hexdigest()

def receipt(path):
    data = path.read_bytes()
    return {'path': str(path), 'bytes': len(data), 'sha256': sha(data)}

def save(name, value):
    with (OUT / name).open('x') as stream:
        json.dump(value, stream, indent=2, ensure_ascii=False)
        stream.write('\n')

def tree(revision):
    result = {}
    for line in git('ls-tree', '-r', revision).decode().splitlines():
        spec, path = line.split('\t', 1)
        _, kind, oid = spec.split()
        if kind == 'blob':
            result[path] = oid
    return result

head_before = git('rev-parse', 'HEAD').decode().strip()
assert head_before == TARGET, head_before
trees = {key: tree(revision) for key, revision in REVS.items()}
blob_cache = {}

def blob(path):
    if path not in blob_cache:
        blob_cache[path] = git('show', f'{TARGET}:{path}')
    return blob_cache[path]

def file_continuity(path, baselines):
    data = blob(path)
    result = {
        'file': path, 'bytes': len(data), 'sha256': sha(data),
        'gitBlob': trees['c2a'][path],
        'workingFileMatchesFrozenGit': (REPO / path).read_bytes() == data,
        'baselines': {},
    }
    for label in baselines:
        oid = trees[label].get(path)
        equal = oid == result['gitBlob']
        result['baselines'][label] = {
            'commit': REVS[label], 'gitBlob': oid, 'identical': equal,
            'sha256': result['sha256'] if equal else sha(git('show', f'{REVS[label]}:{path}')) if oid else None,
        }
    return result

course = FLOW / 'courses-attempt1'
report = json.loads((course / 'courses-report.json').read_text())
command = json.loads((course / 'command-receipt.json').read_text())
log = receipt(course / 'browser.log')
assert report['sourceCommit'] == TARGET and command['sourceCommit'] == TARGET
assert log['bytes'] == command['log']['bytes'] and log['sha256'] == command['log']['sha256']
assert command['exitCode'] == 1 and report['status'] == 'failed'
assert len(report['checks']) == 9
harness = receipt(Path(command['harness']['path']))
assert harness['sha256'] == command['harness']['sha256'] and harness['bytes'] == command['harness']['bytes']
blocked = [url for context in report['contexts'] for url in context['blockedExternal']]
counts = collections.Counter(blocked)
photo_file = 'src/components/CoursePhoto.tsx'
lesson_file = 'src/data/courseContent/en/procrastination.ts'
photo_source = blob(photo_file).decode()
lesson_source = blob(lesson_file).decode()
source_files = [photo_file, 'src/pages/Courses.tsx', lesson_file, 'src/data/courseContent/photosA.ts']
locations = []
for url, count in sorted(counts.items()):
    parsed = urlsplit(url)
    assert parsed.netloc == 'images.unsplash.com'
    photo_id = parsed.path.removeprefix('/photo-')
    assert photo_id in lesson_source
    assert parse_qs(parsed.query) == {'auto': ['format'], 'fit': ['crop'], 'w': ['600'], 'h': ['338'], 'q': ['70']}
    locations.append({
        'url': url, 'attemptCount': count, 'photoId': photo_id,
        'sourceLocations': [
            {'file': path, 'line': i + 1, 'source': line.strip()}
            for path in [lesson_file, 'src/data/courseContent/photosA.ts']
            for i, line in enumerate(blob(path).decode().splitlines()) if photo_id in line
        ],
        'classification': 'Existing lesson image URL generated by CoursePhoto; external route handler records then aborts it.',
        'methodAndType': 'GET image is inferred from the matching <img> source/srcSet. The original blockedExternal array stores URL only, not method/resourceType.',
    })
assert '<img' in photo_source and '600, 338' in photo_source
route_file = FLOW / 'harness/hybrid-common.mjs'
route_lines = route_file.read_text().splitlines()
assert 'return route.abort()' in route_lines[33]
course_audit = {
    'sourceCommit': TARGET, 'auditKind': 'read-only supporting evidence; no rerun',
    'overallAttemptStatus': 'failed', 'originalExitCode': 1,
    'recordedPassedChecks': report['checks'], 'recordedPassedCheckCount': 9,
    'behavioralVsLayout': 'Seven behavioral checks and two viewport-fit checks; all nine original PASS records are retained.',
    'terminalFailure': report['failure'],
    'blockedAttemptCount': len(blocked), 'uniqueBlockedUrlCount': len(counts),
    'contextBlockedCounts': [len(c['blockedExternal']) for c in report['contexts']],
    'pageErrorCount': sum(len(c['pageErrors']) for c in report['contexts']),
    'urlSourceMapping': locations,
    'routeHandler': {'evidence': receipt(route_file), 'line': 34, 'source': route_lines[33].strip(), 'serviceWorkers': 'blocked by saved context options at line29'},
    'originalEvidence': {'report': receipt(course / 'courses-report.json'), 'commandReceipt': receipt(course / 'command-receipt.json'), 'rawLog': log, 'exactExecutedHarness': harness},
    'sourceContinuity': [file_continuity(path, ['5aa', '4bf']) for path in source_files],
    'conclusion': 'All ten blocked attempts match four existing tracked course photo IDs and the unchanged image URL renderer. The zero-attempt assertion was invalid for these lesson images. This audit preserves the terminal failure and does not turn the attempt into an overall pass.',
    'limits': ['No zero-external-attempt claim.', 'No successful outbound connection, response, photo download or upstream availability claim.', 'The allow/abort route log is evidence of attempted and blocked requests; it does not record outbound response status.', 'No existing report, raw log, receipt or screenshot was edited or replaced.'],
}
save('course-external-audit.json', course_audit)

scene_sources = ['src/components/OriginalSceneImage.tsx', 'src/data/originalSceneAssets.ts']
scene_deliveries = sorted(path for path in trees['c2a'] if path.startswith('public/assets/oda/original-scenes/'))
assert len(scene_deliveries) == 40
assert sum(path.endswith('.webp') for path in scene_deliveries) == 34
assert sum(path.endswith('.png') for path in scene_deliveries) == 6
metadata = blob(scene_sources[1]).decode()
metadata_paths = set(re.findall(r'"src": "([^"]+)"', metadata))
assert {'public/' + path for path in metadata_paths} == set(scene_deliveries)
fallback_assets = ['public/assets/oda/reference-fidelity/coach-liquid-form.svg', 'public/assets/oda/delivery/course-covers/oda-growth-values-640.webp']
narration_controller_files = [
    'src/utils/recordedNarration.ts', 'src/utils/voiceGuide.ts',
    'src/data/englishNarrationAssets.ts', 'src/data/guidedMeditations.ts',
    'src/components/FocusTimerHub.tsx', 'src/components/FocusLockView.tsx',
    'src/utils/routing.ts', 'src/utils/geminiVoice.ts',
    'src/i18n/index.ts', 'src/i18n/guidance.ts',
]
sound_controller_files = [
    'src/services/soundRoom.ts', 'src/services/soundRoomAccess.ts',
    'src/services/soundRoomPlayer.ts', 'src/utils/soundSynthesizer.ts',
    'src/data/soundRoom.ts', 'src/pages/SoundRoom.tsx',
]
narration_payload = sorted(path for path in trees['c2a'] if path.startswith('public/assets/oda/narration/en-US/v1/'))
assert len([path for path in narration_payload if path.endswith('.mp3')]) == 160
groups = {
    'sceneHelperAndMetadata': [file_continuity(path, ['5aa', '4bf', '166d']) for path in scene_sources],
    'scene40DeliveryFiles': [file_continuity(path, ['5aa', '4bf', '166d']) for path in scene_deliveries],
    'testedFallbackAssets': [file_continuity(path, ['5aa', '4bf', '166d']) for path in fallback_assets],
    'narrationControllersAndRecordedInputs': [file_continuity(path, ['5aa', '4bf', 'd7ed']) for path in narration_controller_files],
    'soundControllersAndPresentation': [file_continuity(path, ['5aa', '4bf', '166d']) for path in sound_controller_files],
    'narrationPayloadAndBundleMetadata': [file_continuity(path, ['5aa', '4bf', 'd7ed']) for path in narration_payload],
}
changed = [{'group': group, 'file': row['file'], 'baseline': base} for group, rows in groups.items() for row in rows for base, state in row['baselines'].items() if not state['identical']]
worktree_mismatches = [row['file'] for rows in groups.values() for row in rows if not row['workingFileMatchesFrozenGit']]
guidance_report = json.loads((GUIDANCE / 'lifecycle-report.json').read_text())
guidance_command = json.loads((GUIDANCE / 'command-receipt.json').read_text())
guidance_log = receipt(GUIDANCE / 'browser.log')
assert guidance_log['sha256'] == guidance_command['log']['sha256'] and guidance_log['bytes'] == guidance_command['log']['bytes']
recorded_hash_matches = {path: {'recordedSha256': expected, 'candidateSha256': sha(blob(path)), 'matches': expected == sha(blob(path))} for path, expected in guidance_report['sourceHashes'].items()}
assert all(row['matches'] for row in recorded_hash_matches.values())
prior_suites = []
for root, folder, report_name in [(ART, 'art-attempt3', 'original-art-flow-report.json'), (ART, 'art-terminal-only', 'original-art-flow-report.json'), (ART, 'sound-attempt2', 'sound-shared-state-report.json')]:
    suite = json.loads((root / folder / report_name).read_text())
    cmd = json.loads((root / folder / 'command-receipt.json').read_text())
    actual_log = receipt(root / folder / 'browser.log')
    assert actual_log['sha256'] == cmd['log']['sha256'] and actual_log['bytes'] == cmd['log']['bytes']
    prior_suites.append({'suite': folder, 'testedSourceCommit': suite['sourceCommit'], 'status': suite['status'], 'exitCode': cmd['exitCode'], 'recordedPassedCheckCount': len(suite['checks']), 'checks': [check['name'] for check in suite['checks']], 'report': receipt(root / folder / report_name), 'commandReceipt': receipt(root / folder / 'command-receipt.json'), 'rawLog': actual_log})
head_after = git('rev-parse', 'HEAD').decode().strip()
assert head_after == TARGET
continuity = {
    'sourceCommit': TARGET, 'auditKind': 'read-only supporting file/hash continuity; no runtime execution',
    'createdAtUtc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
    'headBefore': head_before, 'headAfter': head_after,
    'baselineCommits': REVS, 'groups': groups,
    'counts': {group: len(rows) for group, rows in groups.items()},
    'totalDistinctAuditedFiles': len({row['file'] for rows in groups.values() for row in rows}),
    'changedComparedFiles': changed, 'workingFileMismatches': worktree_mismatches,
    'deliveryMapping': {'sceneCount': 6, 'files': 40, 'webp': 34, 'png': 6, 'metadataPathsEqualTrackedDeliverySet': True, 'bytes': sum(row['bytes'] for row in groups['scene40DeliveryFiles'])},
    'narrationPayload': {'mp3Count': 160, 'metadataFileCount': len(narration_payload) - 160, 'mp3Bytes': sum(row['bytes'] for row in groups['narrationPayloadAndBundleMetadata'] if row['file'].endswith('.mp3'))},
    'historicalFocusedSuites': prior_suites,
    'historicalNarrationSuite': {'testedSourceCommit': guidance_command['sourceCommit'], 'originalExitCode': guidance_command['exitCode'], 'recordedPassedCheckCount': len(guidance_report['checks']), 'cases': len(guidance_report['cases']), 'failures': guidance_report['failures'], 'errors': guidance_report['errors'], 'report': receipt(GUIDANCE / 'lifecycle-report.json'), 'commandReceipt': receipt(GUIDANCE / 'command-receipt.json'), 'rawLog': guidance_log, 'recordedControllerHashes': recorded_hash_matches, 'manifestSha256MatchesRecorded': sha(blob('public/assets/oda/narration/en-US/v1/manifest.json')) == guidance_report['assetManifestSHA256']},
    'carryForwardScope': 'Historical finite fallback and narration behavioral evidence is supported by exact unchanged source/input bytes. The fallback source was tested at166d and is unchanged through4bf/5aa/c2a. The narration controller/source hashes and160MP3 payload are unchanged from the actual d7ed test through4bf/5aa/c2a.',
    'limits': ['No fresh browser, fallback, Sound or narration pass on c2a.', 'art-attempt3 remains terminal failed after seven recorded passes; the separate terminal fallback attempt remains separately passed.', 'Historical route image bytes/viewport geometry are not reasserted for the new hybrid layout; updated visual/performance evidence is owned by the parent.', 'Selected controller/source equality is not an exhaustive dependency, compiled-build or served-byte audit.', 'No all-clip human listening/transcription QA claim.', 'No app edits, installations, tests, builds, external network, providers, accounts, publication or deployment.'],
    'readersClosed': True,
}
save('continuity-audit.json', continuity)
assert not changed, changed
assert not worktree_mismatches, worktree_mismatches
save('support-audit-receipt.json', {
    'sourceCommit': TARGET, 'auditSucceeded': True, 'readersClosed': True,
    'artifacts': [receipt(OUT / name) for name in ['audit-evidence.py', 'course-external-audit.json', 'continuity-audit.json']],
    'originalReportsAndLogsUnmodified': True,
})
print(json.dumps({'coursesPassedChecks': 9, 'coursesOverallStatus': 'failed', 'blockedAttempts': len(blocked), 'uniqueUrls': len(counts), 'counts': continuity['counts'], 'totalDistinctAuditedFiles': continuity['totalDistinctAuditedFiles'], 'changedComparedFiles': len(changed), 'workingFileMismatches': len(worktree_mismatches), 'narrationHistoricalChecks': len(guidance_report['checks']), 'narrationHistoricalCases': len(guidance_report['cases']), 'readersClosed': True}))
