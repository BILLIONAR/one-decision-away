const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const report = { at: new Date().toISOString(), base, phase: 'reference-led final built preview', sourceHashes: sourceHashes(), buildFiles: {}, assetManifestSHA256: sha(readFileSync(`${repo}/public/assets/oda/narration/en-US/v1/manifest.json`)), checks: [], failures: [], errors: [], blockedRequests: [], cases: [], screenshots: [], limitations: ['Real cloud Chromium WebAudio MP3 playback nodes with normal HTTP and trusted clicks; no autoplay-policy override or permissions.', 'Audible output and speech naturalness were not independently listened to; source count, offset, gain and native decoding are instrumented evidence.', 'Installed device voice fixtures are explicitly mocked, while recorded playback uses the real decoder and AudioContext.', 'Viewport screenshots are emulation, not real iPhone/native iOS testing.'] };
for (const file of ['index.html', ...readdirSync(`${repo}/dist/assets`).filter(f => f.endsWith('.js')).map(f => `assets/${f}`)]) report.buildFiles[file] = sha(readFileSync(`${repo}/dist/${file}`));
const receiptPath = process.env.ODA_FLOW_BUILD_RECEIPT;
const receiptBytes = readFileSync(receiptPath), receipt = JSON.parse(receiptBytes);
report.sourceCommit = process.env.ODA_QA_SOURCE_COMMIT;
report.selectedCases = [...selectedCases];
report.buildReceipt = { path: receiptPath, sha256: sha(receiptBytes), sourceBaseMain: receipt.sourceBaseMain, branch: receipt.branch, checkExit: receipt.checkExit };
report.buildReceiptReviewedSourcesMatch = Object.entries(report.sourceHashes).every(([file, hash]) => receipt.source.some(entry => entry.file === file && entry.sha256 === hash));
assert.ok(report.buildReceiptReviewedSourcesMatch, 'Reviewed source hashes must match the parent build receipt');
const browser = await launch(); report.browserVersion = browser.version();
let activePage, activeCase;
const verify = (condition, label, evidence = {}) => { assert.ok(condition, `${label}: ${JSON.stringify(evidence)}`); report.checks.push({ case: activeCase, label, ...evidence }); console.log(`PASS ${label}`); };
const endSession = async page => { await page.getByRole('button', { name: 'End early', exact: true }).click(); await page.getByRole('button', { name: 'End session', exact: true }).click(); await page.locator('#focus-lock-viewport').waitFor({ state: 'hidden' }); };
const waitSources = (page, count) => page.waitForFunction(count => window.__guidanceQA.sources.length >= count, count);
const waitMode = (page, mode) => page.waitForFunction(mode => [...document.querySelectorAll('[data-guidance-mode]')].some(e => e.dataset.guidanceMode === mode), mode);
const capture = async (page, file, fullPage = false) => { await page.screenshot({ path: `${out}/${file}.png`, fullPage }); report.screenshots.push(`${file}.png`); };
const selectedCases = new Set(['normal-service-worker-first-load-no-mp3','start-pause-resume-replay-mute-stop','preview-stop-during-delayed-load','notebook-tr-device-locale-preserved','notebook-es-device-locale-preserved']);
async function run(name, options, test) {
  if (!selectedCases.has(name)) return;
  activeCase = name; const begin = Date.now(); let context;
  const evidence = { requests: [], responses: [], pageErrors: [] };
  try {
    context = await browser.newContext({ viewport: { width: options.width || 390, height: options.width === 1440 ? 1000 : 844 }, serviceWorkers: options.serviceWorkers || 'block', reducedMotion: 'reduce' });
    await initApp(context, options.locale || 'en', options.seedValue); await instrument(context, options.voices ?? null);
    await routeSafe(context, report, options.handler);
    const page = await context.newPage(); activePage = page; page.setDefaultTimeout(8000);
    context.on('request', r => { if (r.url().endsWith('.mp3')) evidence.requests.push({ url: r.url(), at: Date.now(), serviceWorker: Boolean(r.serviceWorker?.()) }); });
    page.on('response', async response => {
      if (/\/assets\/[^/]+\.js$/.test(new URL(response.url()).pathname)) {
        try { evidence.responses.push({ url: response.url(), status: response.status(), sha256: sha(await response.body()) }); } catch { /* Navigation can cancel responses. */ }
      }
    });
    page.on('pageerror', e => { evidence.pageErrors.push(e.message); report.errors.push({ case: name, message: e.message }); });
    await test(page, context, evidence);
    evidence.final = await snapshot(page);
    report.cases.push({ name, passed: true, elapsedMs: Date.now() - begin, evidence });
  } catch (error) {
    const failure = { name, error: String(error.stack || error), elapsedMs: Date.now() - begin, evidence };
    report.failures.push(failure); console.error(`FAIL ${name}: ${error.message}`);
    if (activePage && !activePage.isClosed()) {
      try { failure.browserState = await snapshot(activePage); await capture(activePage, `failure-${name.replace(/[^a-z0-9]/gi, '-')}`); } catch {}
    }
  } finally { await context?.close(); activePage = null; save('lifecycle-report', report); }
}
try {
  await run('normal-service-worker-first-load-no-mp3', { serviceWorkers: 'allow' }, async (page, context, evidence) => {
    await gotoFocus(page); await openGuided(page); await page.waitForTimeout(1500);
    evidence.serviceWorkers = await page.evaluate(async () => ({ supported: Boolean(navigator.serviceWorker), registrations: (await navigator.serviceWorker.getRegistrations()).map(r => ({ scope: r.scope, active: r.active?.scriptURL, waiting: r.waiting?.scriptURL, installing: r.installing?.scriptURL })), controller: navigator.serviceWorker.controller?.scriptURL || null }));
    verify(evidence.requests.length === 0, 'Normal service-worker-enabled first use requests zero MP3', { serviceWorkers: evidence.serviceWorkers });
  });
  await run('start-pause-resume-replay-mute-stop', {}, async (page, context, evidence) => {
