    verify(state.sources.length === 0 && state.speech.length === (englishAvailable ? 1 : 0), 'Missing MP3 admits only the requested strict English device fallback', { state });
    if (englishAvailable) verify(state.speech[0].voiceLang === 'en-US' && state.speech[0].lang === 'en-US' && state.speech[0].text === 'Welcome. Find a comfortable position, and let your eyes gently close.', 'Fallback preserves English source text despite Turkish display locale', { utterance: state.speech[0] });
