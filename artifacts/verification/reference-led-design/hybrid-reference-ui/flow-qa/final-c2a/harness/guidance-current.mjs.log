    await openGuided(page); await start(page, 'gm-relax').click(); await waitSources(page, 1);
    let state = await snapshot(page);
    const unique = [...new Set(evidence.requests.map(r => new URL(r.url).pathname.split('/').pop()))];
    verify(unique.length === 3 && unique.every(f => /gm-relax-0[012]\./.test(f)), 'Start fetches only current and next two cues', { unique, requestCount: evidence.requests.length });
    await capture(page, 'lock-recorded-en-390');
    await page.waitForTimeout(300); await page.getByRole('button', { name: 'Pause', exact: true }).click();
    state = await snapshot(page);
    verify(state.sources[0].stopped && state.sources[0].disconnected && state.sources.length === 1, 'Pause stops and disconnects the recorded source');
    await page.waitForTimeout(200); await page.getByRole('button', { name: 'Resume', exact: true }).click(); await waitSources(page, 2);
    state = await snapshot(page);
    verify(state.sources[1].offset > 0 && state.sources[1].offset < state.sources[1].duration, 'Resume starts from measured playback offset', { offset: state.sources[1].offset, duration: state.sources[1].duration });
    await page.getByRole('button', { name: 'Repeat', exact: true }).click(); await waitSources(page, 3); state = await snapshot(page);
    verify(state.sources[1].stopped && state.sources[2].offset === 0, 'Repeat retires the resumed source and restarts the current cue');
    const slider = page.getByRole('slider', { name: 'Voice volume', exact: true }); await slider.focus(); await page.keyboard.press('Home');
    verify(await slider.inputValue() === '0', 'Keyboard Home sets visible voice volume to zero');
    state = await snapshot(page); verify(state.gains[state.sources[2].gainIndex] === 0, 'Volume zero sets the active real GainNode to zero');
    await page.getByRole('button', { name: 'Repeat', exact: true }).click(); await waitSources(page, 4); state = await snapshot(page);
    verify(state.sources[3].gainAtStart === 0 && state.speech.length === 0, 'Muted repeat creates only a gain-zero recorded source', { source: state.sources[3] });
    await slider.focus(); await page.keyboard.press('ArrowRight'); state = await snapshot(page);
    verify(Math.abs(state.gains[state.sources[3].gainIndex] - .05) < 1e-6, 'Keyboard volume update reaches the active recorded GainNode');
    await endSession(page); state = await snapshot(page);
    verify(state.sources.every(s => s.stopped && s.disconnected), 'End session stops and disconnects all started recorded sources');
    const count = state.sources.length; await page.waitForTimeout(350); state = await snapshot(page); verify(state.sources.length === count && state.speech.length === 0, 'No late source or fallback utterance after end');
  });

  for (const action of ['stop', 'switch']) {
    const releases = []; let delayed = true;
    await run(`preview-${action}-during-delayed-load`, { handler: async (route, url) => {
      if (delayed && url.pathname.includes('gm-relax-00.') && url.pathname.endsWith('.mp3')) {
        await new Promise(resolve => releases.push(resolve)); try { await route.continue(); } catch {} return true;
      }
    } }, async (page, context, evidence) => {
      await gotoFocus(page); await openGuided(page); await preview(page, 'gm-relax').click(); await waitMode(page, 'loading');
      await page.waitForFunction(() => window.__guidanceQA.sources.length === 0); verify(releases.length > 0, 'Current recording request is held before decode/start');
      if (action === 'stop') await preview(page, 'gm-relax').click(); else { await preview(page, 'gm-dopamine').click(); await waitSources(page, 1); }
      delayed = false; releases.forEach(release => release()); await page.waitForTimeout(450);
      const state = await snapshot(page);
      verify(state.sources.length === (action === 'switch' ? 1 : 0) && state.speech.length === 0, `${action}: delayed old cue never starts or invokes fallback`, { sources: state.sources, modes: state.modes });
      if (action === 'switch') await preview(page, 'gm-dopamine').click();
    });
    releases.forEach(release => release());
  }

  {
    const releases = []; let delayed = true;
    await run('pause-resume-during-delayed-load', { handler: async (route, url) => {
      if (delayed && url.pathname.includes('gm-relax-00.') && url.pathname.endsWith('.mp3')) {
        await new Promise(resolve => releases.push(resolve)); try { await route.continue(); } catch {} return true;
      }
    } }, async (page, context, evidence) => {
      await gotoFocus(page); await openGuided(page); await start(page, 'gm-relax').click();
      await page.waitForFunction(() => document.querySelector('#focus-lock-viewport [data-guidance-mode]')?.dataset.guidanceMode === 'loading');
      verify(releases.length >= 1, 'Guided current cue load is pending before Pause');
      await page.getByRole('button', { name: 'Pause', exact: true }).click(); delayed = false; releases.forEach(release => release()); await page.waitForTimeout(250);
      let state = await snapshot(page); verify(state.sources.length === 0 && state.speech.length === 0, 'Paused pending load cannot start recorded or device output');
      await page.getByRole('button', { name: 'Resume', exact: true }).click(); await waitSources(page, 1); state = await snapshot(page);
      verify(state.sources[0].offset === 0 && state.sources[0].contextState === 'running' && state.speech.length === 0, 'Resume retries the pending current cue in the real audio context', { requests: evidence.requests, state });
