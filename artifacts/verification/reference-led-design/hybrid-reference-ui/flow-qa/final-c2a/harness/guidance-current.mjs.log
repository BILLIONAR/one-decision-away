    const seedValue = seed(locale); seedValue.notebook.affirmations.push({ id: 'synthetic-guidance-affirmation', text: words, createdAt: '2026-10-02T12:00:00Z', updatedAt: '2026-10-02T12:00:00Z' });
    const nativeLang = locale === 'tr' ? 'tr-TR' : locale === 'es' ? 'es-ES' : 'en-US';
    await run(`notebook-${locale}-device-locale-preserved`, { locale, seedValue, voices: [mockEnglish, mockTurkish, { lang: 'es-ES', name: 'QA Spanish fixture', voiceURI: 'qa-es' }] }, async (page, context, evidence) => {
