    await gotoFocus(page); await openGuided(page); await preview(page, 'gm-relax').click(); await waitSources(page, 1);
    const cacheEntries = await page.evaluate(async () => { const all = []; for (const name of await caches.keys()) if (name.startsWith('oda-narration:')) for (const request of await (await caches.open(name)).keys()) all.push({ name, url: request.url }); return all; });
    verify(cacheEntries.some(e => e.url.includes('gm-relax-00.')), 'First playback writes verified current-cue bytes to native CacheStorage', { cacheEntries });
    await preview(page, 'gm-relax').click(); await context.setOffline(true);
