import assert from 'node:assert/strict';
import { admit } from './hybrid-common.mjs';
import { makeSeed, returningCourseFixture, timerUtcFixture, FIXED_NOW, canonicalDecisionSnapshot } from './fixtures.mjs';
const qa = await admit('remaining-today');
const { getInitialDemoState } = await import(`${qa.repo}/src/services/repository.ts`);
const { courseCatalogFor } = await import(`${qa.repo}/src/data/courseCatalog.ts`);
const { firstRunCopy } = await import(`${qa.repo}/src/i18n/firstRun.ts`);
const seed = () => makeSeed(getInitialDemoState);
let active;
try {
  const gap = timerUtcFixture(seed(), { gapYesterday:true });
  const g = await qa.create({seed:gap.seed, fixedClock:FIXED_NOW}); active=g.page;
  await qa.goto(g.page,'/app'); await g.page.locator('.oda-hybrid-streak-value').waitFor();
  assert.match(await g.page.locator('.oda-hybrid-streak-value').innerText(),/^0\b/);
  const bars=await g.page.locator('[data-focus-day-minutes]').evaluateAll(items=>items.map(i=>({label:i.getAttribute('aria-label'), minutes:Number(i.dataset.focusDayMinutes)})));
  assert.equal(bars.reduce((s,r)=>s+r.minutes,0),35);
  assert.equal(bars.filter(r=>r.minutes>0).length,2);
  qa.pass('Missing UTC yesterday breaks the streak; self/photo today do not bridge the gap and valid repeatable minutes remain',bars);
  await qa.capture(g.page,'today-broken-utc-streak-390'); await g.context.close();

  const course=returningCourseFixture(seed(),courseCatalogFor('en'));
  const c=await qa.create({seed:course.seed, viewport:{width:320,height:844}}); active=c.page;
  await qa.goto(c.page,'/app'); const road=c.page.locator('.oda-course-roadmap--compact'); await road.waitFor();
  const list=road.locator('ol'); const enabled=road.locator('button:not([disabled])');
  assert.equal(await enabled.count(),3); assert.ok(await road.locator('.oda-course-roadmap-cue').isVisible());
  await enabled.first().focus(); await c.page.keyboard.press('Tab'); await c.page.keyboard.press('Tab');
  assert.equal(await c.page.evaluate(()=>document.activeElement?.closest('[data-course-roadmap-lesson]')?.dataset.courseRoadmapLesson),course.current.id);
  const access=await list.evaluate(el=>{const r=el.getBoundingClientRect(), b=document.activeElement.getBoundingClientRect();return {viewport:{left:r.left,right:r.right}, focused:{left:b.left,right:b.right},scrollLeft:el.scrollLeft,scrollWidth:el.scrollWidth,clientWidth:el.clientWidth,documentWidth:document.documentElement.clientWidth,documentScrollWidth:document.documentElement.scrollWidth};});
  assert.ok(access.focused.left>=access.viewport.left-1&&access.focused.right<=access.viewport.right+1);
  assert.ok(access.documentScrollWidth<=access.documentWidth+1);
  assert.ok(await road.locator(`[data-course-roadmap-lesson="${course.future.id}"] button`).isDisabled());
  qa.pass('Compact320 roadmap remains horizontally scrollable: native Tab reaches current lesson fully, future lesson stays disabled and page width is intact',access);
  await qa.capture(c.page,'today-roadmap-native-keyboard-320'); await c.context.close();

  const t=await qa.create({seed:seed(),viewport:{width:390,height:844}}); active=t.page; const p=t.page;
  await qa.goto(p,'/app'); await p.locator('#today-decision-input').fill('Synthetic remaining QA: write one useful sentence');
  await p.getByRole('button',{name:'Set decision',exact:true}).click();
  const initial=await qa.waitRecord(p,d=>d.missions.some(m=>m.isOneDecision&&m.status==='active'));
  const mission=initial.missions.find(m=>m.isOneDecision&&m.status==='active');
  const baseline=canonicalDecisionSnapshot(initial);
  await p.waitForTimeout(1000); assert.equal(await p.getByRole('dialog').count(),0);
  await p.locator('.oda-hybrid-actions .oda-hybrid-action').first().click(); await p.getByRole('dialog').waitFor();
  assert.deepEqual(canonicalDecisionSnapshot(await qa.read(p)),baseline);
  await p.keyboard.press('Escape'); await p.getByRole('dialog').waitFor({state:'hidden'});
  assert.deepEqual(canonicalDecisionSnapshot(await qa.read(p)),baseline);
  qa.pass('New Today decision check opens guarded confirmation; opening and Escape do not complete, reward or add a leaf',baseline);
  await p.getByRole('button',{name:firstRunCopy('en').optionalPlan,exact:true}).click();
  await p.locator('#plan-obstacle').fill('I might reach for my phone');
  await p.locator('#plan-then').fill('I will leave it aside and write one sentence');
  await p.getByRole('button',{name:'Save plan',exact:true}).click();
  await qa.waitRecord(p,d=>d.missions.find(m=>m.id===mission.id)?.plan?.ifThen==='I will leave it aside and write one sentence');
  await p.reload(); await p.locator('[data-app-route]').waitFor(); await p.waitForTimeout(1000);
  assert.equal(await p.getByRole('dialog').count(),0);
  assert.ok((await p.locator('.oda-decision-plan').innerText()).includes('I will leave it aside and write one sentence'));
  qa.pass('Optional planning requires explicit action and retains saved words without automatic modal after reload');
  const beforeTimer=canonicalDecisionSnapshot(await qa.read(p));
  const now=Date.now(); await p.clock.install({time:new Date(now)}); await p.clock.pauseAt(new Date(now+1000));
  await p.getByRole('button',{name:'Start · just 2 minutes',exact:true}).click(); await p.clock.runFor(100);
  assert.ok((await p.getByRole('timer').innerText()).includes('2:00'));
  await p.clock.runFor(118900); assert.ok((await p.getByRole('timer').innerText()).includes('0:01'));
  assert.equal(await p.getByRole('button',{name:'I did it — mark as done',exact:true}).count(),0);
  assert.deepEqual(canonicalDecisionSnapshot(await qa.read(p)),beforeTimer);
  await p.clock.runFor(1000); assert.ok(await p.getByRole('button',{name:'I did it — mark as done',exact:true}).isVisible());
  assert.deepEqual(canonicalDecisionSnapshot(await qa.read(p)),beforeTimer);
  qa.pass('Real120second controller expires only at120 not119; controlled browser clock is synthetic and expiry never auto rewards');
  await qa.capture(p,'today-real-timer-expired-390');
  await p.getByRole('button',{name:'I did it — mark as done',exact:true}).click(); await p.clock.runFor(100);
  assert.deepEqual(canonicalDecisionSnapshot(await qa.read(p)),beforeTimer);
  await p.getByRole('dialog').getByRole('button',{name:'Confirm',exact:true}).evaluate(b=>{b.click();b.click();b.click();});
  const done=await qa.waitRecord(p,d=>d.missions.find(m=>m.id===mission.id)?.status==='completed');
  assert.equal(done.completions.filter(c=>c.missionId===mission.id).length,1);
  assert.equal(done.transactions.filter(t=>t.kind==='one_decision_reward').length,1);
  await p.clock.resume(); await p.reload(); await p.locator('.oda-growth-panel .oda-evidence-tree').waitFor();
  const final=await qa.read(p);
  assert.equal(final.completions.filter(c=>c.missionId===mission.id).length,1);
  assert.equal(final.transactions.filter(t=>t.kind==='one_decision_reward').length,1);
  assert.equal(await p.locator('.oda-growth-panel .oda-evidence-tree').getAttribute('data-kept-count'),'1');
  assert.equal(await p.locator('.oda-growth-panel .oda-evidence-tree').getAttribute('data-leaves'),'1');
  qa.pass('Three rapid confirmation taps keep exactly one completion/reward/leaf after reload',{repeatConfirmClicks:3,canonical:canonicalDecisionSnapshot(final),leaf:1});
  await qa.capture(p,'today-one-kept-leaf-390',true); await t.context.close();
  for(const r of qa.report.contexts){assert.deepEqual(r.pageErrors,[]);assert.deepEqual(r.blockedExternal,[]);}
  await qa.close('passed');
}catch(error){qa.report.failure=String(error.stack||error);process.exitCode=1;if(active&&!active.isClosed())await qa.capture(active,'failure',true).catch(()=>{});console.error(qa.report.failure);await qa.close('failed');}
