 }
+
+/* The hybrid roadmap follows real lessons; its geometry never implies extra curriculum. */
+.oda-course-roadmap { min-width: 0; }
+.oda-course-roadmap-cue { display: flex; align-items: center; gap: 7px; margin: 12px 0; color: var(--fg-muted); font-size: .73rem; line-height: 1.5; }
+.oda-course-roadmap > ol { display: grid; gap: 0; padding: 0; margin: 0; list-style: none; }
+.oda-course-roadmap > ol > li { position: relative; min-width: 0; border: 0; }
+.oda-course-roadmap > ol > li + li { border: 0; }
+.oda-course-roadmap > ol > li:not(:last-child)::after { content: ''; position: absolute; left: 24px; top: 48px; bottom: -4px; width: 1px; background: var(--border-strong); pointer-events: none; }
+.oda-course-roadmap > ol > li > button, .oda-course-roadmap > ol > li > div { display: flex; align-items: flex-start; gap: 12px; min-height: 64px; width: 100%; padding: 12px 4px; text-align: left; border: 0; border-radius: 10px; color: var(--fg); background: transparent; }
+.oda-course-roadmap > ol > li > button { cursor: pointer; }
+.oda-course-roadmap > ol > li > button:hover:not(:disabled) { background: var(--accent-soft); }
+.oda-course-roadmap > ol > li > button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.oda-course-roadmap > ol > li > button:disabled { cursor: not-allowed; color: var(--fg-muted); }
+.oda-course-roadmap-number { position: relative; z-index: 1; display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border-strong); background: var(--surface, var(--bg-elevated)); color: var(--fg); font-size: .9rem; font-weight: 650; }
+.oda-course-roadmap [data-completed="true"] .oda-course-roadmap-number { color: var(--accent); background: var(--accent-soft); border-color: var(--accent); }
+.oda-course-roadmap [data-current="true"] .oda-course-roadmap-number { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
+.oda-course-roadmap-copy { display: grid; gap: 5px; min-width: 0; flex: 1; padding-top: 2px; }
+.oda-course-roadmap-title { color: var(--fg); font-size: .85rem; line-height: 1.45; font-weight: 650; overflow-wrap: anywhere; }
