/* SoundRoom reference composition with approved original local art and owned scene fallbacks. */
.oda-sound { --sound-cyan: #58DFDB; --sound-on-cyan: #113B40; position: relative; color: var(--fg); padding-bottom: 9rem; }
.oda-sound button, .oda-sound select, .oda-sound input { -webkit-tap-highlight-color: transparent; }
.oda-sound button:focus-visible, .oda-sound select:focus-visible, .oda-sound input:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
.oda-sound-scene { display: block; position: relative; overflow: hidden; background: #19313C; }
.oda-sound-scene picture { display: contents; }
.oda-sound-scene img { display: block; width: 100%; height: 100%; object-fit: cover; }
.oda-sound-scene[data-scene="night"] img { filter: brightness(.68) saturate(.7); }
.oda-sound-intro { position: absolute; top: 1.5rem; left: 0; right: 0; z-index: 6; text-align: center; pointer-events: none; }
.oda-sound-title { margin: 0; font-size: .76rem; font-weight: 600; line-height: 1.2; letter-spacing: .12em; text-transform: uppercase; color: #FFFFFF; text-shadow: 0 1px 8px #152536; }
.oda-sound-intro-line { margin-top: .4rem; font-size: .88rem; font-weight: 600; color: var(--fg); }
.oda-sound-lede { margin-top: .4rem; max-width: 65ch; font-size: .76rem; line-height: 1.6; color: var(--fg-muted); }
.oda-sound-experience, .oda-sound-session-column { min-width: 0; }
.oda-sound-about { margin-top: 1.25rem; padding: .15rem 1rem .8rem; border: 1px solid var(--border); border-radius: 17px; background: var(--bg-elevated); }
.oda-sound-about summary { display: flex; align-items: center; gap: .55rem; min-height: 44px; font-size: .8rem; font-weight: 600; cursor: pointer; }
.oda-sound-about summary::marker { content: ''; }

/* One continuous canvas: three full-width scenic bands flow into the dark local breathing action. */
.oda-sound-tabs { --sound-scene-span: max(100px, calc((100vh - 172px) / 3)); --sound-wave-overlap: clamp(32px, 8vh, 76px); display: flex; flex-direction: column; position: relative; isolation: isolate; width: calc(100% + 40px); margin-inline: -20px; border-radius: 30px; overflow: hidden; background: #10232C; }
@supports (height: 100svh) { .oda-sound-tabs { --sound-scene-span: max(100px, calc((100svh - 172px) / 3)); --sound-wave-overlap: clamp(32px, 8svh, 76px); } }
.oda-sound-tab { position: relative; flex: none; width: 100%; min-width: 0; min-height: 0; height: calc(var(--sound-scene-span) + var(--sound-wave-overlap)); border: 0; border-radius: 0; overflow: hidden; scroll-margin-block: 80px 100px; text-align: center; cursor: pointer; }
.oda-sound-tab:nth-child(1) { z-index: 4; border-radius: 0 0 18% 64% / 0 0 20% 40%; }
.oda-sound-tab:nth-child(2) { z-index: 3; margin-top: calc(-1 * var(--sound-wave-overlap)); border-radius: 0 0 65% 16% / 0 0 34% 18%; }
.oda-sound-tab:nth-child(3) { z-index: 2; margin-top: calc(-1 * var(--sound-wave-overlap)); height: var(--sound-scene-span); border-radius: 0 0 28% 62% / 0 0 16% 24%; }
.oda-sound-tab > .oda-sound-scene { position: absolute; inset: 0; }
.oda-sound-tab::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(8 19 28 / .08), rgb(8 19 28 / .18) 45%, rgb(8 19 28 / .5)); }
.oda-sound-tab:nth-child(1)::after { background: linear-gradient(180deg, rgb(8 19 28 / .5), rgb(8 19 28 / .24) 45%, rgb(8 19 28 / .5)); }
.oda-sound-tab-copy { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; min-height: 0; padding: 1.4rem 1.45rem 2rem; color: #FFFFFF; }
.oda-sound-tab:nth-child(2) .oda-sound-tab-copy { padding-top: calc(var(--sound-wave-overlap) + .75rem); }
.oda-sound-tab:nth-child(3) .oda-sound-tab-copy { padding: calc(var(--sound-wave-overlap) + .25rem) 1.45rem .8rem; }
.oda-sound-tab-icon { display: none; }
.oda-sound-tab-name { font-size: clamp(2rem, 9.6vw, 2.65rem); font-weight: 700; line-height: 1.06; letter-spacing: -.045em; text-shadow: 0 2px 16px rgb(0 0 0 / .4); }
.oda-sound-tab-detail { display: block; max-width: 35ch; margin-top: .5rem; font-size: .76rem; line-height: 1.5; color: #FFFFFF; text-shadow: 0 1px 8px #10232C; }
.oda-sound-tab[data-section="sleep"] .oda-sound-tab-detail { background: rgb(8 19 28 / .35); box-shadow: 0 0 0 3px rgb(8 19 28 / .35); }
.oda-sound-tab[aria-selected="true"] .oda-sound-tab-name::after { content: ''; display: block; width: 26px; height: 3px; margin: .45rem auto 0; border-radius: 99px; background: #FFFFFF; }
.oda-sound .oda-sound-tab:focus-visible { outline: none; }
.oda-sound-tab:focus-visible .oda-sound-tab-name { outline: 2px solid #FFFFFF; outline-offset: 8px; border-radius: 4px; }
.oda-sound-tab[data-section="breathe"] { z-index: 1; height: 112px; margin-top: 0; background: #10232C; }
.oda-sound-tab[data-section="breathe"] > .oda-sound-scene, .oda-sound-tab[data-section="breathe"]::after { display: none; }
.oda-sound-tab[data-section="breathe"] .oda-sound-tab-copy { padding: .8rem 1rem 1.25rem; }
.oda-sound-tab[data-section="breathe"] .oda-sound-tab-icon { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; margin-bottom: .35rem; border: 1px solid #53747D; border-radius: 50%; background: #1A3540; }
.oda-sound-tab[data-section="breathe"][aria-selected="true"] .oda-sound-tab-icon { background: #ECF8F5; color: #1B3840; border-color: #ECF8F5; }
.oda-sound-tab[data-section="breathe"] .oda-sound-tab-name { font-size: .83rem; font-weight: 600; letter-spacing: 0; }
.oda-sound-tab[data-section="breathe"] .oda-sound-tab-detail { display: none; }

/* A large dark cover meets a light lesson-style list through one continuous organic edge. */
.oda-sound-panel { min-width: 0; margin-top: 1.5rem; overflow: hidden; border: 1px solid var(--border); border-radius: 30px; background: var(--bg-elevated); box-shadow: var(--surface-shadow); }
.oda-sound-panel-cover { position: relative; isolation: isolate; min-height: 280px; padding: 2.25rem 1.4rem 5.5rem; background: #182D36; text-align: center; color: #FFFFFF; }
.oda-sound-panel-cover > .oda-sound-scene { position: absolute; z-index: -2; inset: 0; }
.oda-sound-panel-cover::after { content: ''; position: absolute; z-index: -1; inset: 0; background: linear-gradient(180deg, rgb(8 20 30 / .55), rgb(8 20 30 / .18) 60%, rgb(8 20 30 / .45)); }
.oda-sound-section-title { margin-block: .4rem .6rem; font-size: clamp(1.7rem, 6.5vw, 2.25rem); line-height: 1.1; letter-spacing: -.035em; }
.oda-sound-section-intro { max-width: 58ch; margin-inline: auto; font-size: .87rem; line-height: 1.65; color: var(--fg-muted); }
.oda-sound-panel-cover .oda-sound-section-intro { max-width: 34ch; color: #FFFFFF; font-size: .81rem; }
.oda-sound-cover-wave { position: absolute; left: 0; bottom: -1px; display: block; width: 100%; height: 78px; fill: var(--bg-elevated); }
.oda-sound-panel-body { position: relative; padding: 0 1.1rem 1.4rem; }
.oda-sound-detail-thumb { position: relative; z-index: 1; width: 120px; height: 140px; margin: -104px auto 0; border: 1px solid rgb(241 252 251 / .42); border-radius: 28px 28px 38px 26px; box-shadow: 0 12px 32px -18px #14202A; }
.oda-sound-detail-credit { margin-top: .95rem; text-align: center; font-size: .74rem; color: var(--fg-muted); }
.oda-sound-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; margin-top: 1.1rem; }
.oda-sound-card { position: relative; min-width: 0; }
.oda-sound-card + .oda-sound-card { border-top: 1px solid var(--border); }
.oda-sound-card-button { position: relative; display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: start; gap: .6rem; width: 100%; min-height: 64px; padding: .7rem 2.9rem .7rem .15rem; border: 0; border-radius: 0; background: transparent; text-align: left; cursor: pointer; transition: background-color 160ms ease; }
.oda-sound-card-button:hover { background: var(--bg-muted); }
.oda-sound-card[data-selected] { background: var(--accent-soft); }
.oda-sound-card-button[aria-pressed="true"] { background: var(--accent-soft); }
.oda-sound-card-media { display: none; }
.oda-sound-card-play { grid-column: 1; grid-row: 1; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; border-radius: 50%; color: var(--fg-muted); background: transparent; }
.oda-sound-card-button[aria-pressed="true"] .oda-sound-card-play { background: #285E64; color: #FFFFFF; }
.oda-sound-card-body { grid-column: 2; grid-row: 1; display: flex; min-width: 0; flex-direction: column; gap: .35rem; }
.oda-sound-card-name { font-size: .93rem; font-weight: 650; line-height: 1.3; letter-spacing: -.015em; color: var(--fg); overflow-wrap: anywhere; }
.oda-sound-card-description { font-size: .77rem; line-height: 1.5; color: var(--fg); }
.oda-sound-card-why { font-size: .74rem; line-height: 1.5; color: var(--fg-muted); }
.oda-sound-card-rationale summary { position: absolute; top: .6rem; right: 0; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; color: var(--fg-muted); cursor: pointer; list-style: none; }
.oda-sound-card-rationale summary::-webkit-details-marker { display: none; }
.oda-sound-card-rationale summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; }
.oda-sound-card-rationale[open] { padding: 0 .8rem .8rem 3.6rem; }
.oda-sound-card-rationale[open] summary { color: var(--accent); background: var(--bg-muted); }
.oda-sound-card-note { display: inline-flex; align-items: center; gap: .35rem; align-self: flex-start; margin-top: .15rem; padding: .3rem .5rem; border-radius: 12px; font-size: .71rem; font-weight: 600; line-height: 1.45; color: var(--fg); background: var(--accent-soft); }
.oda-sound-card-note svg { flex: none; }
.oda-sound-card-pro { display: none; }
.oda-sound-hint { display: flex; gap: .5rem; align-items: flex-start; margin-top: 1rem; font-size: .8rem; line-height: 1.55; color: var(--fg-muted); }
.oda-sound-hint svg { flex: none; margin-top: .15rem; color: var(--accent); }

/* Reference 3: real player state inside a tall cyan-edge atmospheric glass panel. */
.oda-sound-now-panel { position: relative; margin-top: 1.5rem; padding: 1.6rem 1.1rem 1.3rem; border: 2px solid #61C6C7; border-radius: 30px; overflow: hidden; background: radial-gradient(ellipse at 12% 5%, rgb(137 216 201 / .29), transparent 44%), radial-gradient(ellipse at 100% 90%, rgb(156 111 136 / .13), transparent 50%), linear-gradient(140deg, rgb(28 65 71 / .93), rgb(17 48 57 / .96) 58%, rgb(34 54 67 / .95)); color: #F1FCFB; backdrop-filter: blur(18px) saturate(1.15); box-shadow: inset 1px 1px 0 rgb(218 255 247 / .38), inset -1px -1px 0 rgb(9 35 45 / .8), 0 0 18px -9px rgb(71 214 210 / .26), 0 18px 44px -24px #163946; }
.oda-sound-now-panel::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, rgb(226 255 248 / .065), transparent 22%, transparent 67%, rgb(199 232 244 / .025)); }
.oda-sound-now-heading { position: relative; z-index: 1; }
.oda-sound-now-heading .oda-kicker { color: #D5EEEB; }
.oda-sound-now-heading h2 { margin-top: .5rem; font-size: 1.5rem; letter-spacing: -.03em; line-height: 1.15; }
.oda-sound-now-heading > p:last-child { margin-top: .7rem; max-width: 36ch; font-size: .8rem; line-height: 1.6; color: #E4F4F0; }
.oda-sound-now-art { width: calc(100% + 2.2rem); height: clamp(180px, 30svh, 300px); margin: 1.4rem -1.1rem 0; border-radius: 0 0 45% 15% / 0 0 18% 6%; }
.oda-sound-now-art img { object-position: center 45%; opacity: .92; }
.oda-sound-now-control-surface { position: relative; margin: -22px auto 0; padding: .75rem; border: 1px solid rgb(194 245 239 / .22); border-radius: 26px; background: rgb(50 99 106 / .8); backdrop-filter: blur(14px); color: #D9EEEA; }
.oda-sound-now-controls { display: flex; justify-content: space-around; align-items: center; width: min(100%, 270px); margin-inline: auto; }
.oda-sound-now-status { margin-block: .4rem .25rem; font-size: .74rem; line-height: 1.4; text-align: center; font-variant-numeric: tabular-nums; color: #DEEFED; }
.oda-sound-now-control-surface .oda-sound-player-controls { gap: .6rem; flex-wrap: wrap; }
.oda-sound-now-control-surface .oda-sound-player-volume { min-width: 68px; }
.oda-sound-now-control-surface .oda-sound-player-volume input { min-width: 44px; }
.oda-sound-now-control-surface input:focus-visible, .oda-sound-now-control-surface select:focus-visible { outline-color: #D3F7F4; }
.oda-sound-now-toggle { display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 50%; color: var(--sound-on-cyan); background: var(--sound-cyan); cursor: pointer; box-shadow: 0 0 22px rgb(71 218 217 / .2); }
.oda-sound-now-toggle:disabled { background: #587C80; color: #E3F0ED; cursor: not-allowed; box-shadow: none; }
.oda-sound-now-toggle:focus-visible { outline-color: #F1FCFB; }
.oda-sound-now-note { margin-top: 1rem; font-size: .77rem; line-height: 1.55; text-align: center; color: #DEEFED; }

@media (min-width: 640px) { .oda-sound-tabs { width: 100%; margin-inline: 0; } }
@media (min-width: 1000px) {
  .oda-sound-experience { display: grid; grid-template-columns: minmax(0, .88fr) minmax(0, 1fr); align-items: start; gap: 1.5rem; }
  .oda-sound-intro { right: auto; width: calc((100% - 1.5rem) * .468); }
  .oda-sound-tabs { position: sticky; top: 24px; }
  .oda-sound-panel { margin-top: 0; }
  .oda-sound-tabs { --sound-scene-span: max(100px, calc((100svh - 96px) / 3)); }
  .oda-sound-panel-cover { min-height: 320px; }
}
/* Breath timing remains synchronized to the existing audio clock. */
.oda-sound-breathe { display: flex; flex-direction: column; align-items: center; margin-top: 1.25rem; padding: 1.5rem 1rem 1.4rem; border: 1px solid #477B7D; border-radius: 23px; background: radial-gradient(ellipse at 50% 0, #285A62, #15383F 70%); color: #F1FCFB; text-align: center; }
.oda-sound-breathe-stage { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; width: min(260px, 65vw); aspect-ratio: 1; }
.oda-sound-breathe-stage[data-reduced] { aspect-ratio: auto; padding-block: 2.5rem 1.5rem; }
.oda-sound-breathe-circle { position: absolute; inset: 0; border: 1px solid rgb(171 238 230 / .65); border-radius: 50%; background: radial-gradient(circle at 45% 35%, #537E7C, #2B686B 70%, #29515B); box-shadow: 0 0 0 10px rgb(154 229 224 / .07); transform: scale(.6); will-change: transform; }
.oda-sound-breathe-circle[data-active] { animation-name: oda-sound-breath; animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
@keyframes oda-sound-breath { 0% { transform: scale(.6); } 50% { transform: scale(1); } 100% { transform: scale(.6); } }
.oda-sound-breathe-label { position: relative; display: flex; flex-direction: column; align-items: center; gap: .15rem; color: #FFFFFF; }
.oda-sound-breathe-label .oda-display { font-size: 1.6rem; line-height: 1.2; }
.oda-sound-breathe-label[data-reduced] .oda-display { font-size: 2rem; }
.oda-sound-breathe-count { font-size: .85rem; font-variant-numeric: tabular-nums; color: #D5E8E8; }
.oda-sound-breathe-bar { position: relative; display: block; width: 70%; height: 6px; margin-top: 1rem; border-radius: 999px; background: #366169; overflow: hidden; }
.oda-sound-breathe-bar span { display: block; height: 100%; border-radius: inherit; background: var(--sound-cyan); transition: width 200ms linear; }
.oda-sound-breathe-meta { margin-top: 1rem; font-size: .8rem; line-height: 1.5; color: #D5E8E8; }
.oda-sound-breathe-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; margin-top: 1.1rem; }
.oda-sound-breathe-tip { max-width: 44ch; margin-top: 1rem; font-size: .76rem; line-height: 1.55; color: #D5E8E8; }
.oda-sound-primary, .oda-sound-secondary { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 46px; padding: .6rem 1.05rem; border-radius: 999px; font-size: .86rem; font-weight: 650; cursor: pointer; }
.oda-sound-primary { background: var(--sound-cyan); color: var(--sound-on-cyan); }
.oda-sound-secondary { border: 1px solid #91B9BB; color: #F1FCFB; background: transparent; }
.oda-sound-secondary[aria-pressed="true"] { background: #345F68; border-color: #BDE8E5; }
.oda-sound-breathe button:focus-visible { outline-color: #D3F7F4; }

.oda-sound-frequencies { margin-top: 2.25rem; padding-top: 1.75rem; border-top: 1px solid var(--border); }
.oda-sound-honest { display: flex; gap: .7rem; align-items: flex-start; margin-top: 1rem; padding: 1rem; border: 1px solid var(--border); border-radius: 17px; background: var(--accent-soft); }
.oda-sound-honest svg { flex: none; margin-top: .15rem; color: var(--accent); }
.oda-sound-honest p { font-size: .83rem; line-height: 1.65; color: var(--fg); }
.oda-sound-evidence { margin-top: 2rem; padding: 1.2rem; border: 1px solid var(--border); border-radius: 23px; background: var(--bg-elevated); }
.oda-sound-evidence h2 { font-size: 1.25rem; line-height: 1.3; }
.oda-sound-evidence ol { display: grid; gap: .8rem; margin-top: .9rem; padding-left: 1.1rem; list-style: decimal; }
.oda-sound-evidence li { font-size: .8rem; line-height: 1.65; color: var(--fg); padding-left: .2rem; }
.oda-sound-evidence li::marker { color: var(--fg-muted); font-size: .75rem; }
.oda-sound-evidence-note, .oda-sound-safety { margin-top: 1rem; font-size: .77rem; line-height: 1.65; color: var(--fg-muted); }

/* Glass is localized to the real player. There is no fabricated waveform or listening claim. */
.oda-sound-player { position: fixed; z-index: 20; left: .6rem; right: .6rem; bottom: calc(max(14px, env(safe-area-inset-bottom, 0px)) + 74px); }
.oda-sound-player-inner { display: flex; flex-direction: column; gap: .5rem; max-width: 900px; margin-inline: auto; padding: .7rem .75rem; border: 1px solid #608F94; border-radius: 22px; background: linear-gradient(120deg, rgb(23 64 71 / .97), rgb(27 48 61 / .98)); color: #F1FCFB; backdrop-filter: blur(16px); box-shadow: 0 16px 40px -18px rgb(13 35 44 / .7), inset 0 1px 0 rgb(200 248 242 / .15); }
.oda-sound-player-now { display: flex; align-items: center; gap: .7rem; min-width: 0; }
.oda-sound-player-thumb { flex: none; width: 44px; height: 48px; border-radius: 10px 16px 10px 10px; }
.oda-sound-player-text { flex: 1; min-width: 0; }
.oda-sound-player-name { font-size: .87rem; font-weight: 650; line-height: 1.3; overflow-wrap: anywhere; }
.oda-sound-player-status { margin-top: .12rem; font-size: .74rem; line-height: 1.4; color: #D2E6E8; font-variant-numeric: tabular-nums; }
.oda-sound-player-toggle { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 50%; background: var(--sound-cyan); color: var(--sound-on-cyan); cursor: pointer; box-shadow: 0 0 18px rgb(56 222 213 / .15); }
.oda-sound-player-toggle:disabled { background: #52767D; color: #E0EBEC; cursor: not-allowed; box-shadow: none; }
.oda-sound-player-controls { display: flex; align-items: center; gap: .75rem; min-width: 0; }
.oda-sound-player-volume { display: flex; flex: 1; align-items: center; gap: .5rem; min-width: 0; color: #D2E6E8; }
.oda-sound-player-volume svg { flex: none; }
.oda-sound-player-volume input { flex: 1; min-width: 0; width: 100%; height: 44px; accent-color: var(--sound-cyan); cursor: pointer; }
.oda-sound-player-timer { display: flex; flex: none; align-items: center; gap: .35rem; color: #D2E6E8; }
.oda-sound-player-timer svg { flex: none; }
.oda-sound-player-timer select { width: auto; min-width: 118px; max-width: 100%; min-height: 44px; padding: .3rem .4rem; border: 1px solid #71999F; border-radius: 11px; background: #25444F; color: #F1FCFB; font-size: .77rem; cursor: pointer; }
.oda-sound-player button:focus-visible, .oda-sound-player input:focus-visible, .oda-sound-player select:focus-visible { outline-color: #D3F7F4; }

@media (min-width: 768px) {
  .oda-sound { padding-bottom: 7rem; }
  /* AppShell has a 15rem sidebar; align within the remaining page column. */
  .oda-sound-player { left: calc(15rem + 1.25rem); right: 1.25rem; bottom: 1rem; }
  .oda-sound-player-inner { flex-direction: row; align-items: center; gap: 1rem; }
  .oda-sound-player-now { flex: 1; }
  .oda-sound-player-controls { flex: 0 1 320px; }
  .oda-sound-evidence { padding: 1.5rem; }
}
@media (max-width: 359px) {
  .oda-sound-tab-copy { padding-inline: 1rem; }
  .oda-sound-panel-body { padding-inline: .8rem; }
  .oda-sound-player-controls { gap: .5rem; }
}
@media (max-height: 650px) {
  .oda-sound-tab-detail { display: none; }
  .oda-sound-tab-name { font-size: 1.8rem; }
  .oda-sound-tab:nth-child(3) .oda-sound-tab-copy { padding-top: var(--sound-wave-overlap); }
}
/* The subsequent breathing action starts after the initial mobile scene viewport. */
@media (max-width: 767px) {
  .oda-sound-tab[data-section="breathe"] { margin-top: calc(92px + env(safe-area-inset-bottom, 0px)); }
}
/* Sound-only scenic navigation retains all five actual destinations and their labels. */
.oda-reference-app[data-app-route="/app/sound"] .oda-tabbar { border-radius: 33px; border-color: #49666B; background: rgb(15 38 45 / .91); color: #DEEEEA; backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: 0 8px 28px -14px #071E29; }
.oda-reference-app[data-app-route="/app/sound"] .oda-tab { min-height: 44px; min-width: 0; border-radius: 50%; background: transparent; color: #DEEEEA; }
.oda-reference-app[data-app-route="/app/sound"] .oda-tab svg { width: 42px; height: 42px; padding: 10.5px; border-radius: 50%; }
.oda-reference-app[data-app-route="/app/sound"] .oda-tab[aria-current="page"] { color: #FFFFFF; background: transparent; box-shadow: none; }
.oda-reference-app[data-app-route="/app/sound"] .oda-tab[aria-current="page"] svg { color: #153B42; background: #ECF8F5; box-shadow: 0 0 0 3px rgb(170 224 215 / .12); }
.oda-reference-app[data-app-route="/app/sound"] .oda-tab:focus-visible { outline: 2px solid #C8F0E8; outline-offset: -2px; }
@media (prefers-reduced-transparency: reduce) { .oda-reference-app[data-app-route="/app/sound"] .oda-tabbar { background: #142E37; backdrop-filter: none; -webkit-backdrop-filter: none; } }
@media (prefers-reduced-motion: reduce) {
  .oda-sound-tab, .oda-sound-card-button { transition: none; }
  .oda-sound-breathe-circle[data-active] { animation: none; }
  .oda-sound-breathe-bar span { transition: none; }
}
