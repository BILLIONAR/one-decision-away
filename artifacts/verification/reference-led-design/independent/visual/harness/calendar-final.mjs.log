await browser.close();report.sourceAfter=snapshot();verify(JSON.stringify(report.sourceBefore)===JSON.stringify(report.sourceAfter),'Calendar inputs changed during targeted verification');verify(report.errors.length===0,'Page errors',report.errors);report.pass=report.failures.length===0;report.completedAt=new Date().toISOString();fs.writeFileSync(out+'/report.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({pass:report.pass,cases:report.cases.length,screenshots:report.screenshots.length,failures:report.failures}));if(!report.pass)process.exitCode=1;
