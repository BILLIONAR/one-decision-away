  await capture('initial');let wheel=null,keyboard=null,weekend=null;
  if(before.scroll>before.client){const box=await scroll.boundingBox();await page.mouse.move(box.x+box.width/2,box.y+box.height/2);await page.mouse.wheel(160,0);await page.waitForTimeout(150);wheel=await measure();verify(wheel.left>0,`${id}: horizontal wheel`,wheel);await scroll.evaluate(el=>{el.scrollLeft=0;});await scroll.focus();await page.keyboard.press('ArrowRight');await page.waitForTimeout(150);keyboard=await measure();verify(keyboard.left>0&&keyboard.focus&&keyboard.outlineStyle==='solid'&&parseFloat(keyboard.outlineWidth)>=2,`${id}: keyboard/focus`,keyboard);await capture('region-focus');const sunday=page.locator('.oda-notebook-calendar tbody button').nth(3);await sunday.focus();await page.keyboard.press('Enter');weekend={selected:await sunday.getAttribute('aria-pressed'),label:await sunday.getAttribute('aria-label'),region:await measure()};verify(weekend.selected==='true',`${id}: Sunday selection`,weekend);await capture('weekend');}
