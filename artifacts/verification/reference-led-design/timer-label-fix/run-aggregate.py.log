import hashlib,json,os,re,subprocess,time
from pathlib import Path
from datetime import datetime,timezone
root=Path('/workspace/oda-reference-redesign');out=Path('/workspace/scratch/oda-reference-redesign/timer-label-fix')
prior=json.loads((root/'artifacts/verification/evidence-portability/build-receipt.json').read_text())
paths=sorted({r['file'] for r in prior['source']}|{'src/styles/coach.css','src/styles/notebook.css','src/styles/reference.css'})
def entry(name):
 data=(root/name).read_bytes();return {'file':name,'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}
head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip();before=[entry(name) for name in paths]
assert all((root/name).read_bytes()==subprocess.check_output(['git','show',head+':'+name],cwd=root) for name in paths)
env=os.environ.copy();env['VITE_BASE_PATH']='/one-decision-away/';start=time.monotonic();started=datetime.now(timezone.utc).isoformat()
with (out/'aggregate-check.log').open('xb') as log:result=subprocess.run(['npm','run','check'],cwd=root,env=env,stdout=log,stderr=subprocess.STDOUT)
after=[entry(name) for name in paths];raw=(out/'aggregate-check.log').read_bytes();text=raw.decode(errors='replace')
counts={k:int(re.findall(r'^(?:#|ℹ) '+k+r' (\d+)\s*$',text,re.M)[-1]) for k in ('tests','pass','fail')}
build=[entry(str(p.relative_to(root))) for p in sorted((root/'dist').rglob('*')) if p.is_file()]
d={'baseCommit':'68ae8179c875b54ce8f200e34a6148259ae6cad1','sourceCommit':head,'startedAtUtc':started,'command':'VITE_BASE_PATH=/one-decision-away/ npm run check','argv':['npm','run','check'],'exitCode':result.returncode,'passed':counts['pass'],'failed':counts['fail'],'elapsedSeconds':round(time.monotonic()-start,3),'log':'aggregate-check.log','logBytes':len(raw),'logSha256':hashlib.sha256(raw).hexdigest(),'sourceFileCount':len(paths),'source':after,'allSourcesMatchCommittedSource':True,'unchangedDuringRun':before==after,'buildFileCount':len(build),'build':build,'cssFileCount':sum(r['file'].endswith('.css') for r in build),'limits':['New visual changes are intentional under the latest user authorization; compiled appearance is not asserted identical to prior main.','Synthetic browser QA and independent review follow this exact compiled build. No deployment.']}
(out/'build-receipt.json').write_text(json.dumps(d,indent=2)+'\n');print(json.dumps({k:v for k,v in d.items() if k not in ('source','build')},indent=2),flush=True)
assert result.returncode==0 and counts['pass']==597 and counts['fail']==0 and before==after
