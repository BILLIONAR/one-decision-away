    const near=await p.evaluate(()=>{const s=document.querySelector('#notebook-journal-search').getBoundingClientRect(),r=document.querySelector('#notebook-filter-result').getBoundingClientRect(),b=document.querySelector('#notebook-clear-filters').getBoundingClientRect();return{resultGap:r.top-s.bottom,clearGap:b.top-s.bottom,buttonHeight:b.height};});assert.ok(near.resultGap<70&&near.clearGap<70);assert.ok(near.buttonHeight>=44);
    await p.locator('#notebook-journal-search').scrollIntoViewIfNeeded();await capture(p,`notebook-no-match-${tag}`);
    await p.locator('#notebook-clear-filters').click();assert.equal(await p.locator('#notebook-journal-search').inputValue(),'');assert.equal(await p.locator('.oda-hybrid-entry-preview').count(),1);
    await p.locator('.oda-notebook-week-strip button').first().click();assert.equal(await p.locator('#notebook-filter-result').innerText(),w.noMatch);await p.locator('#notebook-clear-filters').click();
    // Scroll only the week region to Sunday, then select it through a real DOM click.
    await p.locator('.oda-notebook-week-region').evaluate(el=>{el.scrollLeft=el.scrollWidth;});await p.locator('.oda-notebook-week-strip button').last().click();
    const selected=await dateVisibility(p,'.oda-notebook-week-strip [aria-pressed="true"]');assert.ok(selected.fullyVisible,JSON.stringify(selected));
    await p.getByRole('button',{name:w.next,exact:true}).click();await p.getByRole('button',{name:w.prev,exact:true}).click();
