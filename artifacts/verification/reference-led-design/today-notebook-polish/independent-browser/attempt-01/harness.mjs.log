    assert.ok(stats.includes(locale==='en'?'1 day streak':locale==='es'?'Racha de 1 día':'1 günlük seri'),stats);
    assert.equal(await p.locator('.oda-hybrid-entry-preview h3').innerText(),'read two pages — NASA on iPhone');
