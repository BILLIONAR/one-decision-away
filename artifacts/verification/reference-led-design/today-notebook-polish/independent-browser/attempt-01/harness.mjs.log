}finally{await c.context.close();}}
async function turkishSearch(){const c=await contextFor({locale:'tr',browserLocale:'en-US',width:320,trSearch:true}),p=c.page;try{await goto(p,'/app/notebook');await p.locator('#notebook-journal-search').waitFor();const before=await readAuthority(p);for(const query of ['iki','ışık']){await p.locator('#notebook-journal-search').fill(query);assert.equal(await p.locator('.oda-hybrid-entry-preview h3').innerText(),'İki sayfa IŞIK');assert.equal(await p.locator('.oda-notebook-entry-list button').count(),1);}assert.deepEqual((await readAuthority(p)).notebook.entries,before.notebook.entries);pass('TR search on English-browser locale matches dotted İ and dotless I without rewriting saved title',{browserLocale:'en-US',queries:['iki','ışık'],savedTitle:'İki sayfa IŞIK'});await capture(p,'notebook-turkish-search-english-browser-320');await c.settleResponses();assert.deepEqual(c.record.pageErrors,[]);}finally{await c.context.close();}}
async function heldPlan(){const c=await contextFor({locale:'en',width:390}),p=c.page;try{await goto(p,'/app');await p.locator('.oda-decision-plan').click();await p.locator('#plan-then').fill('held original NASA on iPhone');const before=await readAuthority(p);await p.evaluate(()=>{const put=IDBObjectStore.prototype.put,get=IDBObjectStore.prototype.get;window.__polishHeld={armed:true,phase:'idle',release:null,reads:0,puts:0};IDBObjectStore.prototype.put=function(value,key){const g=window.__polishHeld;if(!g.armed||this.name!=='record'||key!=='current')return put.call(this,value,key);g.armed=false;g.phase='held-before-native-put';const store=this,tx=this.transaction,start=performance.now();tx.addEventListener('abort',()=>g.phase='native-transaction-aborted');tx.addEventListener('complete',()=>g.phase='native-transaction-complete');const pump=()=>{const req=get.call(store,'current');req.onsuccess=()=>{g.reads++;if(g.release==='abort'||performance.now()-start>20000){tx.abort();return;}if(g.release==='commit'){g.puts++;put.call(store,value,key);return;}pump();};return req;};return pump();};});await p.getByRole('button',{name:'Save plan',exact:true}).click();await p.waitForFunction(()=>window.__polishHeld.phase==='held-before-native-put');assert.equal(await p.getByRole('button',{name:'Cancel',exact:true}).isDisabled(),true);await p.getByRole('button',{name:'Cancel',exact:true}).evaluate(el=>el.click());await p.keyboard.press('Escape');assert.equal(await p.locator('#plan-then').count(),1);const dialog=p.getByRole('dialog');await dialog.click({position:{x:2,y:2}});assert.equal(await p.locator('#plan-then').count(),1);assert.equal(await p.locator('#plan-then').inputValue(),'held original NASA on iPhone');const held=await p.evaluate(()=>window.__polishHeld);assert.equal(held.puts,0);pass('390: held native plan save blocks Cancel/Escape/backdrop and retains sheet draft',{held});await capture(p,'plan-held-save-en-390');await p.evaluate(()=>window.__polishHeld.release='abort');await p.getByRole('alert').filter({hasText:/writing/}).waitFor();assert.equal(await p.locator('#plan-then').inputValue(),'held original NASA on iPhone');assert.deepEqual((await readAuthority(p)).missions,before.missions);assert.equal(await p.getByRole('button',{name:'Save plan',exact:true}).isDisabled(),false);pass('390: genuine held transaction abort retains draft, shows failure and enables retry');await capture(p,'plan-held-abort-en-390');await p.getByRole('button',{name:'Save plan',exact:true}).click();await waitRecord(p,d=>d.missions.find(m=>m.id==='synthetic-polish-decision').plan.ifThen==='held original NASA on iPhone');assert.equal(await p.locator('#plan-then').count(),0);pass('390: retry after held genuine abort commits through native queue');await c.settleResponses();assert.deepEqual(c.record.pageErrors,[]);}finally{await c.context.close();}}
try{
  for(const locale of ['en','tr','es'])for(const width of [1440,390,320])await matrix(locale,width);
  for(const locale of ['en','tr','es'])for(const n of [0,2])await countAndEmpty(locale,n);
  for(const locale of ['en','tr','es']){await failureRetry(locale,locale==='en'?1440:locale==='tr'?390:320,'plan');await failureRetry(locale,locale==='en'?1440:locale==='tr'?390:320,'tomorrow');}
  await turkishSearch();await heldPlan();
  const dark=await contextFor({locale:'en',theme:'dark',width:320});try{await goto(dark.page,'/app/notebook');await dark.page.locator('#notebook-journal-search').waitFor();await dark.page.locator('#notebook-journal-search').fill('dark-no-match');assert.equal(await dark.page.locator('#notebook-filter-result').innerText(),words.en.noMatch);pass('dark-320: no-match action fits',await fit(dark.page,'.oda-notebook'));await capture(dark.page,'notebook-dark-no-match-en-320');await dark.settleResponses();assert.deepEqual(dark.record.pageErrors,[]);}finally{await dark.context.close();}
  // Independent HTTP GET binding of every compiled index/JS/CSS file; no app mutation.
  for(const row of build.filter(r=>r.file==='dist/index.html'||/\.(js|css)$/.test(r.file))){const url=new URL(row.file.slice(5),base).href;const res=await fetch(url);assert.equal(res.status,200,url);const bytes=Buffer.from(await res.arrayBuffer());assert.equal(bytes.length,row.bytes,row.file);assert.equal(sha(bytes),row.sha256,row.file);report.served.push({file:row.file,bytes:bytes.length,sha256:sha(bytes),http200:true,observedInBrowser:seenServed.has(row.file)});}
  report.actualBrowserResponses=[...seenServed.values()];report.postflight=verify();report.status='passed-awaiting-pixel-review';
}catch(error){report.status='failed';report.failure=String(error.stack||error);console.error(report.failure);process.exitCode=1;if(active&&!active.isClosed())await capture(active,'failure',true).catch(()=>{});}
finally{await browser.close();report.finishedAtUtc=new Date().toISOString();report.passCount=report.checks.length;writeFileSync(`${out}/report.json`,JSON.stringify(report,null,2),{flag:'wx'});}
