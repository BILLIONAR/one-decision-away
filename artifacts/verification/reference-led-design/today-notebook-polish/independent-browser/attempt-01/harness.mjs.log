  assert.equal(done.missions.length,before.missions.length);assert.equal(done.completions.length,before.completions.length);assert.equal(done.transactions.length,before.transactions.length);const committed=await readAuthority(p);assert.deepEqual(committed.missions,done.missions);assert.deepEqual(committed.profile.nextDecisionDraft,done.profile.nextDecisionDraft);const after=await p.evaluate(()=>window.__polishNativePut);assert.equal(after.thrown,1);assert.equal(after.successfulCalls,1);
