    const gap=await p.evaluate(()=>{const a=document.querySelector('.oda-notebook-calendar-lead').getBoundingClientRect(),b=document.querySelector('.oda-hybrid-entry-preview').getBoundingClientRect();return{gap:b.top-a.bottom,calendarBottom:a.bottom,previewTop:b.top};});if(width===1440)assert.ok(gap.gap>=11&&gap.gap<=13,JSON.stringify(gap));
    pass(`${tag}: localized singular counts, original journal text and selected/today date visible`,{stats,visibility:vis,gap});
