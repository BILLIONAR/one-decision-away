  const mid=await read(p),authority=await readAuthority(p),native=await p.evaluate(()=>window.__polishNativePut);assert.equal(native.thrown,1);assert.deepEqual(mid.missions,before.missions);assert.deepEqual(mid.profile.nextDecisionDraft,before.profile.nextDecisionDraft);assert.deepEqual(authority.missions,before.missions);assert.deepEqual(authority.profile.nextDecisionDraft,before.profile.nextDecisionDraft);assert.equal(await button.isDisabled(),false);
