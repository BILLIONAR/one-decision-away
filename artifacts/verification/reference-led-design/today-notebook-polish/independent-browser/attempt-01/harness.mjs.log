import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';

// Prep does not open a browser. Run only after root supplies the frozen build GO.
assert.equal(process.env.ODA_POLISH_BROWSER_GO, '1', 'Frozen source/build parent GO required');
const repo = '/workspace/oda-reference-redesign';
const out = process.env.ODA_POLISH_QA_OUT;
const receiptPath = process.env.ODA_POLISH_BUILD_RECEIPT;
const expectedCommit = process.env.ODA_POLISH_SOURCE_COMMIT;
const base = process.env.ODA_POLISH_QA_URL || 'http://127.0.0.1:4193/one-decision-away/';
assert.ok(out && receiptPath && expectedCommit);
assert.equal(new URL(base).hostname, '127.0.0.1');
mkdirSync(out, { recursive: true });
const sha = b => createHash('sha256').update(b).digest('hex');
const receipt = JSON.parse(readFileSync(receiptPath, 'utf8'));
assert.equal(receipt.sourceCommit, expectedCommit);
const source = receipt.source;
const build = receipt.build;
assert.ok(Array.isArray(source) && Array.isArray(build) && source.length > 800 && build.length > 400);
const verify = () => {
  assert.equal(execFileSync('git', ['rev-parse','HEAD'], {cwd:repo,encoding:'utf8'}).trim(), expectedCommit);
  for (const row of [...source,...build]) {
    const bytes=readFileSync(`${repo}/${row.file}`);
    assert.equal(bytes.length,row.bytes,`${row.file} bytes`);
    assert.equal(sha(bytes),row.sha256,`${row.file} hash`);
  }
  return {sourceFiles:source.length,buildFiles:build.length,allExact:true};
};
const report={ sourceCommit:expectedCommit, buildReceipt:{path:receiptPath,bytes:readFileSync(receiptPath).length,sha256:sha(readFileSync(receiptPath))}, base, startedAtUtc:new Date().toISOString(), syntheticData:true, checks:[], screenshots:[], contexts:[], served:[], limits:[
  'Desktop and 390/320 Chromium viewport emulation; not a physical iPhone or native app run.',
  'Fixed synthetic date Saturday 2026-10-03. Native save fault injected at real IDBObjectStore.put; normal compiled app/store/write queue unchanged.',
  'Local GET/HEAD only; external requests aborted and recorded. No accounts, providers, paid services, signing or production operations.',
  'No narration listening/transcription or broader app QA claim.'
]};
report.preflight=verify();
const require=createRequire(`${repo}/package.json`);
const {chromium}=require('playwright');
const browser=await chromium.launch({executablePath:'/usr/bin/chromium'});
report.browser=await browser.version();
const {getInitialDemoState}=await import(`${repo}/src/services/repository.ts`);
const NOW='2026-10-03T12:00:00.000Z', TODAY='2026-10-03';
const rawTitle='read two pages — NASA on iPhone; istanbul ıhlamur.';
const rawPlan='  “start two pages with NASA on iPhone; istanbul ıhlamur.”';
const words={en:{prefix:'Then I will ',noMatch:'No entries match.',clear:'Clear filters',calendar:'Calendar',savePlan:'Save plan',tomorrow:'Save for tomorrow',kept:'1 kept promise',prev:'Previous week',next:'Next week',thisWeek:'This week'},tr:{prefix:'O zaman: ',noMatch:'Eşleşen kayıt yok.',clear:'Filtreleri temizle',calendar:'Takvim',savePlan:'Planı kaydet',tomorrow:'Yarın için kaydet',kept:'1 tutulan söz',prev:'Önceki hafta',next:'Sonraki hafta',thisWeek:'Bu hafta'},es:{prefix:'Entonces: ',noMatch:'Ninguna entrada coincide.',clear:'Borrar filtros',calendar:'Calendario',savePlan:'Guardar plan',tomorrow:'Guardar para mañana',kept:'1 promesa cumplida',prev:'Semana anterior',next:'Semana siguiente',thisWeek:'Esta semana'}};
const pass=(name,evidence)=>{report.checks.push({name,evidence});console.log(`PASS ${name}`);};
function seed(locale='en',theme='light',n=1,completed=false,withPlan=true) {
  const d=getInitialDemoState();
  d.profile={...d.profile,displayName:'Synthetic polish QA',locale,theme,onboardingStep:'completed',simpleModeOff:true,soundMuted:true,nudgesEnabled:false,dailyWisdomEnabled:false,reminderAskedAt:NOW,firstOpenedAt:'2026-01-01T00:00:00Z',lastOpenedAt:NOW};
  d.lastActiveDateKey=TODAY;d.lastDailyResetTimestamp=NOW;d.dreamJournal=[];d.completions=[];
  d.missions=d.missions.filter(m=>!m.isOneDecision);
  d.missions.push({id:'synthetic-polish-decision',userId:d.profile.id,title:rawTitle,type:'daily_quest',area:'Mindset',difficulty:'easy',isOneDecision:true,status:completed?'completed':'active',createdAt:NOW,scheduledFor:TODAY,...completed?{completedAt:NOW}:{},...withPlan?{plan:{obstacle:'the iPhone calls; NASA waits',ifThen:rawPlan,plannedAt:NOW}}:{}});
  if(completed)d.completions.push({id:'synthetic-polish-completion',userId:d.profile.id,missionId:'synthetic-polish-decision',completedAt:NOW,method:'self',rewardAmount:0,streakBonus:0});
  d.notebook.entries=Array.from({length:n},(_,i)=>({id:`synthetic-polish-entry-${i}`,kind:'journal',title:i?'istanbul ıhlamur — NASA on iPhone':'read two pages — NASA on iPhone',content:`original saved lowercase content ${i}; NASA on iPhone.`,dateKey:i?'2026-10-02':TODAY,createdAt:i?'2026-10-02T10:00:00Z':NOW,updatedAt:NOW,mood:'focused'}));
  d.notebook.activityDays=Array.from({length:n},(_,i)=>({dateKey:i?'2026-10-02':TODAY,rewardAmount:0}));
  return d;
}
const seenServed=new Map();let active;
async function contextFor({locale='en',theme='light',width=390,n=1,completed=false,withPlan=true,browserLocale,trSearch=false}={}) {
  const context=await browser.newContext({viewport:{width,height:width===1440?1000:844},timezoneId:'UTC',locale:browserLocale||(locale==='tr'?'tr-TR':locale==='es'?'es-ES':'en-US'),reducedMotion:'reduce',serviceWorkers:'block'});
  const record={locale,theme,width,requests:[],blockedExternal:[],pageErrors:[],dialogs:[]};report.contexts.push(record);
  await context.route('**/*',route=>{const req=route.request();if(new URL(req.url()).origin!==new URL(base).origin||!['GET','HEAD'].includes(req.method())){record.blockedExternal.push({url:req.url(),method:req.method(),resourceType:req.resourceType()});return route.abort();}record.requests.push({url:req.url(),resourceType:req.resourceType()});return route.continue();});
  const d=seed(locale,theme,n,completed,withPlan);if(trSearch)d.notebook.entries[0].title='İki sayfa IŞIK';
  await context.addInitScript(({d,locale,theme})=>{if(!localStorage.getItem('one_decision_away_app_data_v1'))localStorage.setItem('one_decision_away_app_data_v1',JSON.stringify(d));localStorage.setItem('oda_locale',locale);localStorage.setItem('oda_theme',theme);},{d,locale,theme});
  const page=await context.newPage();active=page;page.setDefaultTimeout(7000);
  page.on('pageerror',e=>record.pageErrors.push(e.message));
  page.on('dialog',async dialog=>{record.dialogs.push({type:dialog.type(),message:dialog.message()});await dialog.dismiss();});
  const responseTasks=[];
  page.on('response',response=>{const path=new URL(response.url()).pathname;const rel=path.slice(new URL(base).pathname.length);const file=rel?`dist/${decodeURIComponent(rel)}`:'dist/index.html';const expected=build.find(r=>r.file===file);if(expected&&(/\.(js|css)$/.test(file)||file==='dist/index.html'))responseTasks.push((async()=>{const bytes=await response.body();assert.equal(response.status(),200,file);assert.equal(bytes.length,expected.bytes,file);assert.equal(sha(bytes),expected.sha256,file);seenServed.set(file,{file,bytes:bytes.length,sha256:sha(bytes),actualObservedResponse:true});})());});
  await page.clock.install({time:new Date(NOW)});
  return {context,page,record,settleResponses:async()=>{await Promise.all(responseTasks);}};
}
async function goto(page,path){await page.goto(`${base}#${path}`);await page.locator('[data-app-route]').waitFor();await page.evaluate(()=>document.fonts.ready);}
async function capture(page,name,fullPage=false){const path=`${out}/${name}.png`;await page.screenshot({path,animations:'disabled',fullPage});report.screenshots.push({file:`${name}.png`,bytes:readFileSync(path).length,sha256:sha(readFileSync(path)),pixelInspection:'pending'});}
const read=page=>page.evaluate(()=>JSON.parse(localStorage.getItem('one_decision_away_app_data_v1')));
const readAuthority=page=>page.evaluate(async()=>navigator.locks.request('oda-data-writes',async()=>{const db=await new Promise((resolve,reject)=>{const req=indexedDB.open('oda_personal_record_v1',1);req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);});try{return await new Promise((resolve,reject)=>{const tx=db.transaction('record','readonly'),req=tx.objectStore('record').get('current');tx.oncomplete=()=>resolve(JSON.parse((req.result?.pendingPrevious||req.result).appData));tx.onabort=()=>reject(tx.error);});}finally{db.close();}}));
async function waitRecord(page,predicate){for(let i=0;i<120;i++){const r=await read(page);if(predicate(r))return r;await page.waitForTimeout(50);}throw new Error('Canonical record condition timed out');}
async function fit(page,selector){const e=await page.locator(selector).evaluate(root=>{const w=document.documentElement.clientWidth;return{width:w,scrollWidth:document.documentElement.scrollWidth,clipped:[...root.querySelectorAll('button,input,textarea,select,summary')].filter(el=>!el.closest('[hidden]')).flatMap(el=>{const r=el.getBoundingClientRect();if(!r.width||!r.height)return[];const scroll=el.closest('.oda-notebook-week-region,.oda-notebook-calendar-scroll');return!scroll&&(r.left<-.5||r.right>w+.5)?[{text:el.getAttribute('aria-label')||el.textContent,left:r.left,right:r.right}]:[];})};});assert.ok(e.scrollWidth<=e.width+1,JSON.stringify(e));assert.deepEqual(e.clipped,[]);return e;}
async function dateVisibility(page,selector){return page.locator(selector).evaluate(el=>{const region=el.closest('.oda-notebook-week-region'),a=el.getBoundingClientRect(),r=region.getBoundingClientRect();return{button:{left:a.left,right:a.right,width:a.width,height:a.height},region:{left:r.left,right:r.right,scrollLeft:region.scrollLeft},fullyVisible:a.left>=r.left-.5&&a.right<=r.right+.5,y:window.scrollY};});}
