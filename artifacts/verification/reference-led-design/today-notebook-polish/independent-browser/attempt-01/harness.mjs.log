    assert.equal(await p.locator('#notebook-journal-title').inputValue(),titleDraft);assert.equal(await p.locator('#notebook-journal-content').inputValue(),contentDraft);assert.deepEqual((await read(p)).notebook.entries,before.notebook.entries);assert.equal(c.record.dialogs.length,0);
