async function countAndEmpty(locale,n){const c=await contextFor({locale,width:390,n}),p=c.page;try{await goto(p,'/app/notebook');await p.locator('#notebook-journal-search').waitFor();const stats=await p.locator('.oda-notebook-stat-values').innerText();const expected=locale==='en'?`${n} days written`:locale==='es'?`${n} días escritos`:`${n} gün yazıldı`;assert.ok(stats.includes(expected),stats);if(!n){assert.equal(await p.locator('.oda-hybrid-entry-preview').count(),0);assert.equal(await p.locator('.oda-notebook-entry-list').count(),0);await p.locator('#notebook-journal-search').fill('no-entry');assert.equal(await p.locator('#notebook-filter-result').innerText(),words[locale].noMatch);await p.locator('#notebook-clear-filters').click();assert.equal(await p.locator('#notebook-journal-search').inputValue(),'');await capture(p,`notebook-empty-${locale}-390`);}pass(`${locale}: ${n} writing-day count${!n?' and empty/reset':''}`,{stats});await c.settleResponses();assert.deepEqual(c.record.pageErrors,[]);}finally{await c.context.close();}}
async function injectFault(page){await page.evaluate(()=>{const original=IDBObjectStore.prototype.put;window.__polishNativePut={armed:true,thrown:0,successfulCalls:0};IDBObjectStore.prototype.put=function(value,key){if(this.name==='record'&&key==='current'){if(window.__polishNativePut.armed){window.__polishNativePut.armed=false;window.__polishNativePut.thrown++;throw new DOMException('Synthetic independent QA native put failure','QuotaExceededError');}window.__polishNativePut.successfulCalls++;}return original.call(this,value,key);};});}
