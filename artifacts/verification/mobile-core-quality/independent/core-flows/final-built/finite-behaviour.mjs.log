import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { writeFileSync } from 'node:fs';
const repo='/workspace/oda-mobile-core-quality',out='/tmp/oda-mobile-quality-browser/final-built',base='http://127.0.0.1:4313/one-decision-away/#';
const require=createRequire(`${repo}/package.json`);const {chromium}=require('playwright');
const {getInitialDemoState}=await import(`${repo}/src/services/repository.ts`);
const {coursesFor}=await import(`${repo}/src/data/courses.ts`);
const key='one_decision_away_app_data_v1',course=coursesFor('en').find(c=>c.id==='procrastination');
const report={cases:[],checks:[],pageErrors:[],externalBlocked:0};
const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--no-sandbox']});
async function fixture(width,complete){
 const context=await browser.newContext({viewport:{width,height:width===320?740:844},serviceWorkers:'block',reducedMotion:'reduce'});
 await context.route('**/*',r=>new URL(r.request().url()).origin===new URL(base).origin?r.continue():(report.externalBlocked++,r.abort()));
 const seed=getInitialDemoState();if(complete)seed.profile={...seed.profile,onboardingStep:'completed',locale:'en',displayName:'Synthetic flow review',theme:'light',simpleModeOff:true};
 await context.addInitScript(({seed,key})=>{if(!localStorage.getItem(key))localStorage.setItem(key,JSON.stringify(seed));localStorage.setItem('oda_locale','en')},{seed,key});
 const page=await context.newPage();page.on('pageerror',e=>report.pageErrors.push(e.message));return{page,context};
}
async function capture(page,label){const path=`${out}/${label}.png`;await page.screenshot({path});report.cases.push({label,path,active:await page.evaluate(()=>({tag:document.activeElement.tagName,id:document.activeElement.id,text:document.activeElement.textContent?.slice(0,120)}))});}
try{
 for(const width of [320,390]){
  const{page,context}=await fixture(width,false);await page.goto(`${base}/app`);await page.getByRole('button',{name:'Skip the demo',exact:true}).click();
  await page.locator('#onboarding-name').fill('Synthetic first use');await page.getByRole('button',{name:'Continue',exact:true}).click();
  await page.getByRole('radio').first().focus();await page.keyboard.press('ArrowRight');assert.equal(await page.getByRole('radio',{checked:true}).count(),1);
  await page.getByRole('button',{name:'Continue',exact:true}).click();await page.getByRole('button',{name:'Skip for now',exact:true}).click();
  await page.locator('#onboarding-decision').fill('Read two pages');await page.reload();await page.locator('#onboarding-decision').waitFor();assert.equal(await page.locator('#onboarding-decision').inputValue(),'Read two pages');
  await capture(page,`onboarding-final-${width}`);await page.getByRole('button',{name:'Start my day',exact:true}).click();await page.locator('.oda-decision-action').waitFor();await page.waitForTimeout(850);assert.equal(await page.getByRole('dialog').count(),0);
  await page.clock.install();await page.locator('.oda-decision-action').click();await page.getByRole('dialog').waitFor();await page.clock.fastForward(120100);await page.getByRole('button',{name:'I did it — mark as done',exact:true}).waitFor();
  const record=await page.evaluate(key=>JSON.parse(localStorage.getItem(key)),key);assert.equal(record.completions.length,0);await capture(page,`two-minute-finished-${width}`);
  await page.keyboard.press('Escape');report.checks.push(`${width}: fresh onboarding radio keys, draft reload, no auto obstacle modal, 120s expiry without automatic completion`);await context.close();
 }
 const{page,context}=await fixture(320,true);await page.goto(`${base}/app/courses`);await page.locator('[data-course-id=procrastination]').click();await page.locator('#course-start-lesson').click();await page.locator('.oda-course-lesson-title').waitFor();
 for(const box of await page.locator('.oda-course-practice input[type=checkbox]').all())await box.check();await page.locator(`input[name="answer-${course.lessons[0].id}"]`).nth(course.lessons[0].correct).check();
 const finish=page.getByRole('button',{name:'Complete lesson',exact:true});await finish.focus();await capture(page,'course-complete-focused-320');await page.keyboard.press('Enter');await page.getByRole('button',{name:'Go to the next lesson',exact:true}).waitFor();
 await capture(page,'course-complete-after-320');await page.keyboard.press('Tab');await capture(page,'course-complete-tab-320');
 report.checks.push('320: course first lesson actual practice/quiz completion succeeds; focus evidence captured');
 await page.getByRole('button',{name:'Go to the next lesson',exact:true}).click();await page.locator('.oda-course-step[aria-current=step]').waitFor();assert.equal(await page.locator('.oda-course-step[aria-current=step]').innerText(),'2');await capture(page,'course-lesson2-320');
 await page.reload();await page.locator('.oda-course-lesson-title').waitFor();assert.equal(await page.locator('.oda-course-lesson-title').textContent(),course.lessons[1].title);report.checks.push('320: actual next lesson and returning saved lesson2 survive reload');await context.close();
 report.status='complete';
}catch(e){report.status='failed';report.failure=String(e.stack||e);console.error(e);process.exitCode=1}
finally{writeFileSync(`${out}/finite-behaviour-report.json`,JSON.stringify(report,null,2));await browser.close()}
