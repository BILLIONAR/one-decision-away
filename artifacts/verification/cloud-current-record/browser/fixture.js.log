  var drafts = [
    // 60 distinct Quran passages. Reflection/adaptation labels are intentional.
    q("2:177", "Bakara", "Let faith reach the person in need. Integrity joins belief with generosity, promises kept, and patience when life becomes difficult.", "\u0130nanc\u0131n ihtiya\xE7 sahibine kadar ula\u015Fs\u0131n. \u0130yilik; inanmay\u0131, payla\u015Fmay\u0131, verdi\u011Fin s\xF6z\xFC tutmay\u0131 ve zor g\xFCnlerde sabr\u0131 ayn\u0131 hayatta bulu\u015Fturur.", ["faith", "courage"]),
    q("2:261", "Bakara", "Picture a seed opening into many ears of grain. Giving for God is a hopeful act whose worth exceeds the handful you release.", "Bir tanenin nice ba\u015Fa\u011Fa d\xF6n\xFC\u015Ft\xFC\u011F\xFCn\xFC d\xFC\u015F\xFCn. Allah r\u0131zas\u0131 i\xE7in payla\u015F\u0131rken, elinden \xE7\u0131kan miktardan daha geni\u015F bir hayra niyet et.", ["generosity", "hope"]),
    q("2:262", "Bakara", "After helping someone, protect the gift from reminders and humiliation. Let the person keep their dignity along with what you gave.", "Birine yard\u0131m ettikten sonra iyili\u011Fini ba\u015F\u0131na kakma. Verdi\u011Fin \u015Fey onun ihtiyac\u0131n\u0131 kar\u015F\u0131las\u0131n; ard\u0131ndan gelen s\xF6zlerin onurunu incitmesin.", ["compassion"]),
    q("2:267", "Bakara", "Give something you would gladly receive yourself. Generosity deserves care in the quality of the gift, not merely its existence.", "Kendin g\xF6n\xFCl rahatl\u0131\u011F\u0131yla kabul etmeyece\u011Fin \u015Feyi ba\u015Fkas\u0131na sunma. Payla\u015F\u0131rken se\xE7ti\u011Fin \u015Feyin niteli\u011Fine de \xF6zen g\xF6ster; muhatab\u0131n buna de\u011Fer.", ["generosity"]),
    q("2:271", "Bakara", "A quiet gift can protect someone from exposure. When helping, consider the comfort of the person receiving, not the audience watching.", "Sessizce yap\u0131lan yard\u0131m, ihtiya\xE7 sahibinin mahremiyetini koruyabilir. \u0130yili\u011Fin g\xF6r\xFClmesini d\xFC\u015F\xFCn\xFCrken, yard\u0131m etti\u011Fin ki\u015Finin nas\u0131l hissedece\u011Fini de g\xF6zet.", ["compassion"]),
    q("2:280", "Bakara", "When a debtor is struggling, give them breathing room. Sometimes the most merciful use of your power is allowing another person more time.", "Bor\xE7lu zor durumdaysa ona nefes alacak zaman tan\u0131. Bazen elindeki imk\xE2n\u0131 en g\xFCzel kullan\u0131\u015F\u0131n, bir insan\u0131 s\u0131k\u0131\u015Ft\u0131rmaktan vazge\xE7mendir.", ["mercy"]),
    q("2:256", "Bakara", "Faith cannot be forced into a heart. Keep room for conscience, and let conviction grow through understanding rather than pressure.", "\u0130nanc\u0131 bir kalbe zorla yerle\u015Ftiremezsin. Vicdana alan a\xE7; kanaatin bask\u0131yla de\u011Fil, anlay\u0131\u015Fla ve insan\u0131n kendi y\xF6neli\u015Fiyle k\xF6k salmas\u0131na sayg\u0131 duy.", ["faith"]),
    q("2:269", "Bakara", "Wisdom is a generous gift. Make room to reflect on what you learn, so knowledge can become sound judgment.", "Hikmet b\xFCy\xFCk bir hay\u0131rd\u0131r. \xD6\u011Frendiklerini yaln\u0131zca biriktirme; \xFCzerinde d\xFC\u015F\xFCnmeye de vakit ay\u0131r ki bilgin, isabetli bir anlay\u0131\u015Fa d\xF6n\xFC\u015Febilsin.", ["wisdom"]),
    q("2:148", "Bakara", "People turn in different directions. Put your energy into competing in goodness; let your next step bring a real benefit.", "\u0130nsanlar farkl\u0131 y\xF6nlere d\xF6nerken sen hay\u0131rda yar\u0131\u015Fmaya y\xF6nel. Enerjini yaln\u0131z k\u0131yaslamaya harcama; s\u0131radaki ad\u0131m\u0131n bir iyili\u011Fe dokunsun.", ["action"]),
    q("2:201", "Bakara", "Ask for goodness in this life and the next. Your prayer can hold both present responsibilities and a horizon beyond them.", "Duan bu d\xFCnyadaki iyili\u011Fi de ahiretteki iyili\u011Fi de ku\u015Fats\u0131n. Bug\xFCn\xFCn sorumlulu\u011Funu \xFCstlenirken daha geni\u015F bir ufku hat\u0131r\u0131nda tut.", ["prayer"]),
    q("3:92", "\xC2l-i \u0130mr\xE2n", "Sharing reaches deeper when you give from what you love. Notice what you hold most tightly, and make generosity a sincere choice.", "Payla\u015Fmak, sevdi\u011Fin \u015Feyden verdi\u011Finde derinle\u015Fir. Elinde en s\u0131k\u0131 tuttu\u011Fun nimeti d\xFC\u015F\xFCn; c\xF6mertli\u011Fin yaln\u0131zca artanlardan ibaret kalmas\u0131n.", ["generosity"]),
    q("4:36", "Nis\xE2", "Look beyond your closest circle. The distant neighbour and the traveller also belong within the reach of your kindness.", "\u0130yili\u011Finin \xE7evresini geni\u015Flet. Yak\u0131nlar\u0131n kadar uzak kom\u015Funun ve yolda kalan\u0131n da h\xE2lini g\xF6zet; merhametin tan\u0131d\u0131k y\xFCzlerde son bulmas\u0131n.", ["community"]),
    q("4:58", "Nis\xE2", "Return what has been entrusted to you to its rightful owner. Reliability gives everyday faith a shape others can depend on.", "Sana emanet edileni sahibine hakk\u0131yla teslim et. G\xFCvenilirli\u011Fin, ba\u015Fkas\u0131n\u0131n sana g\xF6n\xFCl rahatl\u0131\u011F\u0131yla dayanabilmesini sa\u011Flayan g\xFCnl\xFCk bir sorumluluktur.", ["integrity"]),
    q("4:86", "Nis\xE2", "When someone greets you, answer with equal warmth or more. A small welcome is an opportunity to strengthen human connection.", "Sana verilen sel\xE2m\u0131 ayn\u0131 g\xFCzellikle, m\xFCmk\xFCnse daha g\xFCzeliyle kar\u015F\u0131la. K\xFC\xE7\xFCk bir kar\u015F\u0131la\u015Fmay\u0131, aran\u0131zdaki ba\u011F\u0131 g\xFC\xE7lendirecek s\u0131cakl\u0131\u011Fa d\xF6n\xFC\u015Ft\xFCr.", ["connection"]),
    q("4:135", "Nis\xE2", "Tell the truth even when it challenges your own advantage. Justice asks you to see beyond wealth, family loyalty, and personal preference.", "Do\u011Fruyu s\xF6ylemek kendi \xE7\u0131kar\u0131na dokunsa da adaleti g\xF6zet. Yak\u0131nl\u0131k, zenginlik veya yoksulluk; bir insan\u0131n hakk\u0131n\u0131 g\xF6rmene perde olmas\u0131n.", ["courage", "justice"]),
    q("4:29", "Nis\xE2", "Let your dealings rest on genuine consent. Earning well includes respecting the rights and willingness of the other person.", "Kazanc\u0131nda kar\u015F\u0131l\u0131kl\u0131 r\u0131zay\u0131 ve hakkaniyeti g\xF6zet. Bir al\u0131\u015Fveri\u015Fin sana yarar sa\u011Flamas\u0131, kar\u015F\u0131ndaki insan\u0131n hakk\u0131n\u0131 \xF6nemsiz k\u0131lmaz.", ["integrity"]),
    q("4:32", "Nis\xE2", "Do not turn another person\u2019s gifts into resentment. Recognize your own effort and ask God for bounty without envying their share.", "Ba\u015Fkas\u0131na verilen nimeti k\u0131skan\xE7l\u0131\u011Fa d\xF6n\xFC\u015Ft\xFCrme. Kendi eme\u011Finin hakk\u0131n\u0131 g\xF6zet; Allah\u2019\u0131n l\xFCtfunu isterken ba\u015Fkas\u0131n\u0131n nasibine dar\u0131lma.", ["gratitude"]),
    q("5:2", "M\xE2ide", "Choose your companions in action by what you are building together. Help one another toward goodness, never toward harm or hostility.", "Birlikte neye hizmet etti\u011Finize bak. \u0130yilikte ve sorumlulukta birbirinize destek olun; dayan\u0131\u015Fman\u0131z ba\u015Fkas\u0131na zarar vermenin arac\u0131na d\xF6n\xFC\u015Fmesin.", ["community", "action"]),
    q("5:32", "M\xE2ide", "Remember the immense worth of a single human life. An act that protects one person deserves your attention and effort.", "Bir insan\u0131n hayat\u0131n\u0131 koruman\u0131n ne b\xFCy\xFCk bir de\u011Fer ta\u015F\u0131d\u0131\u011F\u0131n\u0131 hat\u0131rla. Tek bir ki\u015Fiye uzanan yard\u0131m\u0131n\u0131, yaln\u0131z bir ki\u015Fi diye k\xFC\xE7\xFCmseme.", ["compassion"]),
    q("6:141", "En\u2018\xE2m", "At harvest time, remember the share that should reach others. Let the moment you receive also become a moment of responsibility.", "Eme\u011Finin meyvesini toplarken ba\u015Fkas\u0131na ula\u015Fmas\u0131 gereken pay\u0131 unutma. Elinin doldu\u011Fu g\xFCn, payla\u015Fma sorumlulu\u011Funun da hat\u0131rland\u0131\u011F\u0131 bir g\xFCn olsun.", ["gratitude", "generosity"]),
    q("6:152", "En\u2018\xE2m", "Give full measure and speak fairly even about someone close to you. Care for another person\u2019s rights in the smallest details.", "\xD6l\xE7\xFCy\xFC eksiltme; s\xF6z s\xF6ylerken yak\u0131n\u0131n\u0131 da adaletle de\u011Ferlendir. Ba\u015Fkas\u0131n\u0131n hakk\u0131na g\xF6sterdi\u011Fin \xF6zen, k\xFC\xE7\xFCk ayr\u0131nt\u0131larda da belli olsun.", ["justice"]),
    q("7:31", "A\u2018r\xE2f", "Enjoy what nourishes you without waste. Receiving a blessing with care includes knowing when enough has been served.", "Seni besleyen nimetlerden yararlan; israf etme. Sofradaki \u015F\xFCkr\xFCn, yeterli olan\u0131 fark etmende ve artan\u0131 ziyan etmemende de g\xF6r\xFCns\xFCn.", ["gratitude"]),
    q("7:56", "A\u2018r\xE2f", "Do not undo the good order around you. Turn to God with humility and hope, and be among those who care for what is entrusted to them.", "D\xFCzelmi\u015F olan\u0131 bozma. Rabbine sayg\u0131 ve \xFCmitle y\xF6nelirken \xE7evrendeki iyili\u011Fi korumaya da niyet et; elin onarmaya al\u0131\u015Fs\u0131n.", ["hope", "care"]),
    q("7:199", "A\u2018r\xE2f", "Choose a generous manner and avoid being pulled into ignorant quarrels. You can encourage what is right without answering every provocation.", "Ho\u015Fg\xF6r\xFCl\xFC davran, iyiyi hat\u0131rlat; cahilce bir \xE7eki\u015Fmenin i\xE7ine s\xFCr\xFCklenme. Her k\u0131\u015Fk\u0131rtmaya cevap vermeden de do\u011Fruya sahip \xE7\u0131kabilirsin.", ["calm"]),
    q("7:204", "A\u2018r\xE2f", "When the Quran is recited, offer it your listening. Let a moment of quiet attention become part of how you receive its message.", "Kur\u2019an okunurken dinlemeye yer a\xE7. Bir an durup dikkatini toplaman, duydu\u011Fun mesaj\u0131 anlamaya y\xF6neli\u015Finin ve ona g\xF6sterdi\u011Fin sayg\u0131n\u0131n par\xE7as\u0131 olsun.", ["faith", "attention"]),
    q("10:101", "Y\xFBnus", "Look carefully at the heavens and the earth. Let wonder lead you beyond a passing glance into attentive observation.", "G\xF6klere ve yery\xFCz\xFCne dikkatle bak. Merak\u0131n, \u015F\xF6yle bir g\xF6z gezdirmekle kalmas\u0131n; g\xF6rd\xFC\u011F\xFCn \u015Fey \xFCzerinde dur, anlamaya a\xE7\u0131k ol.", ["curiosity"]),
    q("11:114", "H\xFBd", "A mistake need not become your only story. Return to prayer and good action; give the next moment a different direction.", "Bir hatan\u0131n ard\u0131ndan yaln\u0131zca pi\u015Fmanl\u0131\u011F\u0131n i\xE7inde kalma. Namaza ve iyi davran\u0131\u015Fa d\xF6n; \xF6n\xFCndeki ana farkl\u0131 bir y\xF6n vermeyi se\xE7.", ["hope", "renewal"]),
    q("12:86", "Y\xFBsuf", "Jacob brought his grief to God. You can name your sorrow in prayer without pretending your heart is unhurt.", "Yakup, kederini Allah\u2019a a\xE7t\u0131. Sen de duanda h\xFCzn\xFCn\xFC dile getirebilirsin; Rabbine y\xF6nelmek i\xE7in incinmemi\u015F gibi g\xF6r\xFCnmen gerekmez.", ["hope", "prayer"]),
    q("12:92", "Y\xFBsuf", "Joseph met his brothers with a path beyond reproach. Where reconciliation is possible, leave room for mercy instead of endlessly replaying blame.", "Yusuf\u2019un karde\u015Flerine a\xE7t\u0131\u011F\u0131 merhamet kap\u0131s\u0131n\u0131 d\xFC\u015F\xFCn. Bar\u0131\u015Fman\u0131n m\xFCmk\xFCn oldu\u011Fu yerde, ayn\u0131 su\xE7lamay\u0131 yeniden s\xF6ylemek yerine affa alan a\xE7.", ["mercy"]),
    q("14:24-25", "\u0130br\xE2h\xEEm", "A wholesome word is pictured as a rooted tree bearing fruit. Choose words with depth, so their benefit can outlast the moment.", "G\xFCzel s\xF6z, k\xF6k\xFC sa\u011Flam ve meyve veren bir a\u011Faca benzetilir. S\xF6z\xFCn\xFC \xF6zenle se\xE7; faydas\u0131, s\xF6ylendi\u011Fi an\u0131n \xF6tesine uzanabilsin.", ["wisdom"]),
    q("16:125", "Nahl", "Invite with wisdom and considerate counsel. In disagreement, seek the best manner of conversation rather than the sharpest way to win.", "Hikmetle ve g\xFCzel \xF6\u011F\xFCtle davet et. Bir anla\u015Fmazl\u0131kta yaln\u0131zca \xFCst\xFCn gelmeyi d\xFC\u015F\xFCnme; konu\u015Fman\u0131n en incelikli ve yap\u0131c\u0131 yolunu ara.", ["communication"]),
    q("16:43", "Nahl", "When you do not know, ask those who know the subject. A sincere question opens a door that pretending to know keeps closed.", "Bilmedi\u011Finde, konuyu bilenlere sor. Bilir gibi g\xF6r\xFCnme kayg\u0131s\u0131n\u0131 b\u0131rak; samimi bir soru, \xF6\u011Frenmek i\xE7in a\xE7t\u0131\u011F\u0131n bir kap\u0131 olabilir.", ["courage", "learning"]),
    q("17:23-24", "\u0130sr\xE2", "Meet your parents\u2019 old age with a gentle voice. Remember the care that raised you, and make space for tenderness in return.", "Anne baban\u0131n ya\u015Fl\u0131l\u0131\u011F\u0131n\u0131 yumu\u015Fak bir sesle kar\u015F\u0131la. Seni b\xFCy\xFCten eme\u011Fi hat\u0131rla; cevab\u0131nda, davran\u0131\u015F\u0131nda ve duanda \u015Fefkate yer ver.", ["compassion"]),
    q("17:28", "\u0130sr\xE2", "When you cannot offer material help, offer a considerate answer. Limited means do not require a cold heart or a harsh refusal.", "Yard\u0131m edecek imk\xE2n\u0131n olmad\u0131\u011F\u0131nda bile g\xF6n\xFCl al\u0131c\u0131 bir cevap verebilirsin. Elinin darl\u0131\u011F\u0131, s\xF6z\xFCn\xFCn sert olmas\u0131n\u0131 gerektirmez.", ["kindness"]),
    q("17:29", "\u0130sr\xE2", "Let generosity stay in balance. Neither close your hand completely nor empty it so recklessly that you neglect your responsibilities.", "C\xF6mertli\u011Finde dengeyi koru. Elini b\xFCt\xFCn\xFCyle kapatma; fakat sorumluluklar\u0131n\u0131 yerine getiremeyecek kadar \xF6l\xE7\xFCs\xFCzce da\u011F\u0131tmay\u0131 da iyilik sanma.", ["balance"]),
    q("17:34", "\u0130sr\xE2", "Treat a promise as something you will answer for. Before giving your word, consider whether you can carry its responsibility.", "Verdi\u011Fin s\xF6z\xFCn sorumlulu\u011Funu hat\u0131rla. Birine umut vermeden \xF6nce, o s\xF6z\xFC yerine getirmek i\xE7in ger\xE7ekten ne \xFCstlenece\u011Fini d\xFC\u015F\xFCn.", ["integrity"]),
    q("17:36", "\u0130sr\xE2", "Do not follow a claim without knowledge. Your hearing, sight, and judgment deserve more care than a hurried assumption.", "Bilgin olmayan bir iddian\u0131n pe\u015Fine hemen d\xFC\u015Fme. Duydu\u011Funu, g\xF6rd\xFC\u011F\xFCn\xFC ve vard\u0131\u011F\u0131n h\xFCkm\xFC dikkatle de\u011Ferlendir; acele bir varsay\u0131m\u0131 ger\xE7ek yerine koyma.", ["discernment"]),
    q("18:23-24", "Kehf", "Plan tomorrow with humility before God. Intention can be clear while the future remains beyond your complete command.", "Yar\u0131n i\xE7in niyetini belirlerken Allah\u2019\u0131n dilemesini hat\u0131rla. Plan\u0131n a\xE7\u0131k olabilir; gelece\u011Fin b\xFCt\xFCn\xFCyle elinde olmad\u0131\u011F\u0131n\u0131 kabul etmek de tevekk\xFCl\xFCn bir par\xE7as\u0131d\u0131r.", ["uncertainty", "faith"]),
    q("18:28", "Kehf", "Stay close to people whose devotion is sincere. Do not let the shine of status make you overlook a faithful heart.", "Samimiyetle Rabbine y\xF6nelen insanlarla ba\u011F\u0131n\u0131 koru. G\xF6steri\u015Fin ve mevkinin par\u0131lt\u0131s\u0131, i\xE7ten bir kalbin de\u011Ferini g\xF6z\xFCnden ka\xE7\u0131rmas\u0131n.", ["connection"]),
    q("18:46", "Kehf", "Possessions and family adorn this life, but lasting goodness offers a deeper hope. Give some attention to what your actions leave behind.", "Mal ve evlat d\xFCnya hayat\u0131n\u0131n s\xFCs\xFCd\xFCr; kal\u0131c\u0131 iyi i\u015Fler ise daha derin bir umut ta\u015F\u0131r. Bug\xFCn ard\u0131ndan nas\u0131l bir iyilik b\u0131rakabilece\u011Fini d\xFC\u015F\xFCn.", ["hope", "purpose"]),
    q("18:66", "Kehf", "Moses asked permission to follow and learn. A willing learner can approach another person with curiosity, respect, and no need to appear complete.", "Musa, \xF6\u011Frenmek i\xE7in yol arkada\u015Fl\u0131\u011F\u0131 istedi. Sen de her \u015Feyi biliyor g\xF6r\xFCnmek zorunda de\u011Filsin; merakla, sayg\u0131yla ve \xF6\u011Frenmeye g\xF6n\xFCll\xFC bir kalple yakla\u015F.", ["courage", "learning"]),
    q("19:25", "Meryem", "Mary was asked to shake the palm tree. In a difficult hour, remember that receiving help and making an effort can stand together.", "Meryem\u2019e hurma a\u011Fac\u0131n\u0131 silkelemesi s\xF6ylendi. Zor bir anda, yard\u0131m beklemekle elinden gelen gayreti g\xF6stermek ayn\u0131 kalpte bir arada bulunabilir.", ["courage", "action"]),
    q("20:25-28", "T\xE2h\xE2", "Before a difficult conversation, remember Moses\u2019 prayer for an open heart and clear speech. Ask for ease in the task and understanding between people.", "Zor bir konu\u015Fmadan \xF6nce Musa\u2019n\u0131n duas\u0131n\u0131 hat\u0131rla: g\xF6n\xFCl geni\u015Fli\u011Fi, i\u015Fte kolayl\u0131k ve anla\u015F\u0131l\u0131r bir dil. S\xF6z\xFCn\xFCn kar\u015F\u0131ya ula\u015Fmas\u0131na niyet et.", ["fear", "prayer"]),
    q("21:83", "Enbiy\xE2", "Job named his suffering while remembering God\u2019s mercy. Pain can be spoken honestly; it need not erase the language of trust.", "Eyyub, derdini dile getirirken Rabbini merhametiyle and\u0131. Ac\u0131n\u0131 d\xFCr\xFCst\xE7e s\xF6yle; zorlan\u0131yor olman, g\xFCvenle dua etmene engel de\u011Fildir.", ["hope", "faith"]),
    q("21:107", "Enbiy\xE2", "Remember the Prophet\u2019s mission as mercy to the worlds. Let the faith you carry make your presence gentler for other living beings.", "Peygamberin \xE2lemlere rahmet olu\u015Funu hat\u0131rla. Ta\u015F\u0131d\u0131\u011F\u0131n inan\xE7, yan\u0131nda bulunan canl\u0131lar\u0131n daha \xE7ok \u015Fefkat ve merhamet g\xF6rmesine vesile olsun.", ["mercy"]),
    q("22:46", "Hac", "Travel with a heart willing to understand. Seeing places matters more when you also listen and learn from what happened there.", "Yery\xFCz\xFCnde gezerken yaln\u0131z manzaraya bakma. Ya\u015Fananlar\u0131 dinleyen ve ibret almaya a\xE7\u0131k bir kalple y\xFCr\xFC; g\xF6rd\xFCklerin anlay\u0131\u015F\u0131n\u0131 da geni\u015Fletsin.", ["reflection"]),
    q("23:1-3", "M\xFC\u2019min\xFBn", "Give prayer a collected heart, and step away from empty talk. Some space in your day is better filled with presence than noise.", "Namaz\u0131na g\xF6n\xFCl huzuruyla y\xF6nelmeye \xE7al\u0131\u015F; bo\u015F s\xF6zden uzakla\u015F. G\xFCn\xFCn\xFCn baz\u0131 aral\u0131klar\u0131n\u0131 g\xFCr\xFClt\xFCyle doldurmak yerine dikkatini ve kalbini toplamak i\xE7in ay\u0131r.", ["attention", "faith"]),
    q("24:27", "N\xFBr", "Ask permission before entering another person\u2019s space. A respectful greeting begins with recognizing that welcome cannot be assumed.", "Ba\u015Fkas\u0131n\u0131n alan\u0131na girerken izin iste ve sel\xE2m ver. Yak\u0131nl\u0131k, s\u0131n\u0131rlar\u0131 yok saymak de\u011Fildir; sayg\u0131n, kar\u015F\u0131 taraf\u0131n rahatl\u0131\u011F\u0131n\u0131 g\xF6zetmekle ba\u015Flar.", ["respect"]),
    q("25:72", "Furk\xE2n", "Do not lend your presence to false witness. When empty hostility surrounds you, keep your dignity as you pass beyond it.", "Yalanc\u0131 tan\u0131kl\u0131\u011Fa ortak olma. Bo\u015F ve incitici bir ortamdan ge\xE7erken vakar\u0131n\u0131 koru; oradaki her s\xF6ze kat\u0131lmak zorunda de\u011Filsin.", ["courage", "integrity"]),
    q("25:74", "Furk\xE2n", "Pray for the people closest to you to be a source of joy. Aspire to offer an example of goodness they can trust.", "Sevdiklerinin g\xF6z ayd\u0131nl\u0131\u011F\u0131n olmas\u0131 i\xE7in dua et. Ayn\u0131 zamanda sen de g\xFCven veren bir iyilik \xF6rne\u011Fi olmaya niyet et.", ["prayer", "connection"]),
    q("26:80", "\u015Euar\xE2", "Abraham remembered God as the giver of healing. In illness, a prayer for recovery can hold your vulnerability and your hope together.", "\u0130brahim, hastaland\u0131\u011F\u0131nda \u015Fifay\u0131 Rabbinden bildi. Hastal\u0131k an\u0131nda \u015Fifa i\xE7in dua etmek, k\u0131r\u0131lganl\u0131\u011F\u0131n\u0131 ve umudunu ayn\u0131 anda dile getirmene imk\xE2n verir.", ["hope", "prayer"]),
    q("27:19", "Neml", "Ask for the ability to recognize blessings and use them well. Gratitude reaches from what you received to the good you choose to do.", "Nimeti fark etmeyi ve onunla hay\u0131rl\u0131 i\u015Fler yapmay\u0131 dile. \u015E\xFCkr\xFCn, yaln\u0131z ald\u0131klar\u0131n\u0131 anmakta kalmas\u0131n; se\xE7ti\u011Fin davran\u0131\u015Flarda da kar\u015F\u0131l\u0131k bulsun.", ["gratitude", "action"]),
    q("28:24", "Kasas", "Moses helped, then rested in the shade and acknowledged his need before God. Service, rest, and a humble prayer can belong to the same day.", "Musa yard\u0131m etti, sonra g\xF6lgeye \xE7ekilip Rabbine muhta\xE7l\u0131\u011F\u0131n\u0131 a\xE7t\u0131. Senin g\xFCn\xFCnde de iyilik, dinlenme ve i\xE7ten bir dua yan yana bulunabilir.", ["hope", "prayer"]),
    q("29:20", "Ankeb\xFBt", "Go out and consider how creation began. Let movement through the world become an invitation to investigate, not merely to pass by.", "Yery\xFCz\xFCnde dola\u015F ve yarat\u0131l\u0131\u015F\u0131n ba\u015Flang\u0131c\u0131 \xFCzerine d\xFC\u015F\xFCn. Yolculu\u011Fun yaln\u0131z yer de\u011Fi\u015Ftirmek olmas\u0131n; g\xF6zlem yapmaya ve ara\u015Ft\u0131rmaya da kap\u0131 a\xE7s\u0131n.", ["curiosity", "action"]),
    q("30:21", "R\xFBm", "A close bond can hold affection, mercy, and rest. Bring these qualities into the relationship you hope will give you peace.", "Yak\u0131n bir ba\u011Fda sevgi, merhamet ve huzur bir arada b\xFCy\xFCyebilir. Huzur bekledi\u011Fin ili\u015Fkiye, sen de \u015Fefkatle ve anlay\u0131\u015Fla katk\u0131da bulun.", ["connection"]),
    q("30:22", "R\xFBm", "Different languages and colours are signs worth contemplating. Meet human variety with curiosity and respect rather than a demand for sameness.", "Dillerin ve renklerin farkl\u0131l\u0131\u011F\u0131n\u0131 bir ayet olarak d\xFC\u015F\xFCn. \u0130nsanlar\u0131n \xE7e\u015Fitlili\u011Fine sayg\u0131 ve merakla yakla\u015F; herkesin sana benzemesini bekleme.", ["community"]),
    q("30:50", "R\xFBm", "Notice the earth becoming alive after its barrenness. Let this sign of mercy make room in your reflection for renewal.", "Kurumu\u015F topra\u011F\u0131n yeniden canlan\u0131\u015F\u0131na dikkat et. Rahmetin bu eserini d\xFC\u015F\xFCn\xFCrken, zihninde yaln\u0131z t\xFCkeni\u015Fe de\u011Fil yenilenmeye de yer a\xE7.", ["hope", "renewal"]),
    q("31:19", "Lokm\xE2n", "Keep your pace measured and your voice gentle. You do not need to fill a space with noise to stand in it with purpose.", "Y\xFCr\xFCy\xFC\u015F\xFCnde \xF6l\xE7\xFCy\xFC, sesinde yumu\u015Fakl\u0131\u011F\u0131 koru. Bir yerde kararl\u0131 bi\xE7imde bulunmak i\xE7in o yeri g\xFCr\xFClt\xFCnle doldurman gerekmez.", ["calm"]),
    q("49:11", "Hucur\xE2t", "Do not make someone the target of ridicule or a hurtful name. Their worth may be greater than the judgment you formed too quickly.", "Bir insan\u0131 alay\u0131n\u0131n veya k\u0131r\u0131c\u0131 bir lakab\u0131n hedefi yapma. Onun de\u011Ferini, aceleyle verdi\u011Fin h\xFCk\xFCmden daha b\xFCy\xFCk g\xF6rmeye a\xE7\u0131k ol.", ["respect"]),
    q("49:12", "Hucur\xE2t", "Protect another person\u2019s privacy, including when they are absent. Refuse suspicion, prying, and gossip a place in the conversation you shape.", "\u0130nsanlar\u0131n mahremiyetini, yanlar\u0131nda olmad\u0131klar\u0131 zaman da koru. Konu\u015Fmana y\xF6n verirken k\xF6t\xFC zanna, gizli ara\u015Ft\u0131rmaya ve g\u0131ybete kap\u0131 a\xE7ma.", ["integrity"]),
    // 25 hadith passages, with exact collection references.
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "11", "When an ethical choice leaves you doubtful, prefer the course whose rightness is clear. A clean decision is worth more than a convenient excuse.", "Ahlaki bir se\xE7im i\xE7ine ku\u015Fku d\xFC\u015F\xFCrd\xFC\u011F\xFCnde, do\u011Frulu\u011Fundan emin oldu\u011Fun yola y\xF6nel. \u0130\xE7ini rahatlatan d\xFCr\xFCst bir tercih, kullan\u0131\u015Fl\u0131 bir bahaneden de\u011Ferlidir.", ["discernment"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "12", "Leave aside what needlessly draws you into other people\u2019s affairs. Care for the responsibilities that genuinely belong to you.", "Seni gereksiz yere ba\u015Fkalar\u0131n\u0131n i\u015Fine s\xFCr\xFCkleyen u\u011Fra\u015Flar\u0131 b\u0131rak. Sana ger\xE7ekten d\xFC\u015Fen sorumluluklara \xF6zen g\xF6ster; ilgini faydal\u0131 olabilece\u011Fin yere ta\u015F\u0131.", ["attention"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "13", "Wish another person the good you wish yourself. Let their opportunity become something you welcome, not something you must diminish.", "Kendin i\xE7in arzu etti\u011Fin iyili\u011Fi karde\u015Fin i\xE7in de iste. Ona a\xE7\u0131lan bir imk\xE2n\u0131 k\xFC\xE7\xFCltmek yerine g\xF6n\xFClden kar\u015F\u0131lamaya \xE7al\u0131\u015F.", ["generosity"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "15", "Make your guest feel honoured and your neighbour respected. Faith has an everyday expression in how safely people can be near you.", "Misafirine ikram et, kom\u015Funun hakk\u0131n\u0131 g\xF6zet. \u0130nanc\u0131n\u0131n g\xFCndelik hayattaki kar\u015F\u0131l\u0131\u011F\u0131, insanlar\u0131n yan\u0131nda g\xF6rd\xFC\u011F\xFC sayg\u0131da ve \xF6zeninde de belirginle\u015Fsin.", ["hospitality"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "21", "Let your declaration of belief be followed by an upright course. When your direction becomes blurred, return to the honesty you chose.", "\u0130nand\u0131\u011F\u0131n\u0131 s\xF6yleyi\u015Finin ard\u0131ndan dosdo\u011Fru bir yol tut. Y\xF6n\xFCn bulan\u0131kla\u015Ft\u0131\u011F\u0131nda, benimsedi\u011Fin d\xFCr\xFCstl\xFC\u011Fe yeniden d\xF6n ve davran\u0131\u015Flar\u0131n\u0131 onunla hizala.", ["faith", "courage"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "23", "Purification belongs to faith, and patience offers illumination. Give care to both your outer cleanliness and the way you carry difficulty.", "Temizli\u011Fi iman hayat\u0131n\u0131n bir par\xE7as\u0131 olarak g\xF6zet; sabr\u0131 ayd\u0131nlat\u0131c\u0131 bir g\xFC\xE7 olarak hat\u0131rla. D\u0131\u015F\u0131na g\xF6sterdi\u011Fin \xF6zen, zorlu\u011Fu ta\u015F\u0131y\u0131\u015F\u0131na da ula\u015Fs\u0131n.", ["faith"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "24", "Do not oppress one another. When you have power in a situation, remember that the other person\u2019s vulnerability increases your responsibility.", "Birbirinize zulmetmeyin. Bir durumda g\xFCc\xFC elinde tuttu\u011Funda, kar\u015F\u0131ndaki ki\u015Finin k\u0131r\u0131lganl\u0131\u011F\u0131n\u0131n senin sorumlulu\u011Funu art\u0131rd\u0131\u011F\u0131n\u0131 hat\u0131rla.", ["justice"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "25", "A lack of wealth does not close every door of giving. Remembrance, encouraging good, and resisting harm also belong to a generous life.", "Maddi imk\xE2n\u0131n azl\u0131\u011F\u0131 b\xFCt\xFCn hay\u0131r kap\u0131lar\u0131n\u0131 kapatmaz. Zikir, iyili\u011Fi te\u015Fvik etmek ve k\xF6t\xFCl\xFCkten sak\u0131nd\u0131rmak da payla\u015Fabildi\u011Fin de\u011Ferler aras\u0131ndad\u0131r.", ["hope", "generosity"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "26", "Help reconcile two people, carry a burden, or remove an obstacle from the road. Ordinary movements can become acts of charity.", "\u0130ki ki\u015Finin aras\u0131n\u0131 bul, bir y\xFCk\xFC ta\u015F\u0131maya yard\u0131m et veya yoldaki engeli kald\u0131r. G\xFCndelik hareketlerin de sadakaya d\xF6n\xFC\u015Febilece\u011Fini hat\u0131rla.", ["action"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "27", "Goodness includes the character you bring to a situation. Notice the conduct you would feel uneasy about exposing to others.", "\u0130yilik, bir duruma ta\u015F\u0131d\u0131\u011F\u0131n g\xFCzel ahlakla da ilgilidir. \u0130nsanlar\u0131n g\xF6rmesini istemeyece\u011Fin bir davran\u0131\u015F\u0131n i\xE7ine d\xFC\u015Ferken durup kendini yokla.", ["conscience"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "32", "Do not answer injury by creating another injury. Seek a remedy that protects rights without continuing the chain of harm.", "Bir zarara kar\u015F\u0131l\u0131k verirken yeni bir zarar \xFCretme. Hakk\u0131n\u0131 koruyan, fakat incinmeyi ba\u015Fkas\u0131na ta\u015F\u0131mayan bir \xE7\xF6z\xFCm yolu ara.", ["restraint"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "34", "Do not become indifferent to wrongdoing. According to your ability, work against it, speak truthfully, or at least refuse to approve it inwardly.", "Yanl\u0131\u015Fa kar\u015F\u0131 duyars\u0131zla\u015Fma. G\xFCc\xFCn \xF6l\xE7\xFCs\xFCnde onu d\xFCzeltmeye \xE7al\u0131\u015F, do\u011Fruyu dile getir; buna imk\xE2n bulamad\u0131\u011F\u0131nda bile kalben onaylama.", ["courage", "action"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "35", "Do not build your relationships on envy, contempt, or turning away. Treat a fellow person\u2019s dignity as something to guard.", "\u0130li\u015Fkilerini k\u0131skan\xE7l\u0131k, k\xFC\xE7\xFCmseme ve y\xFCz \xE7evirme \xFCzerine kurma. Bir insan\u0131n onurunu, incitebilece\u011Fin bir yer de\u011Fil koruyaca\u011F\u0131n bir de\u011Fer olarak g\xF6r.", ["community"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "36", "Ease one burden for someone in distress. Being there for another person is itself a way of seeking God\u2019s help.", "S\u0131k\u0131nt\u0131da olan birinin y\xFCk\xFCn\xFC hafiflet. Allah\u2019\u0131n yard\u0131m\u0131n\u0131 ararken, sen de bir insana destek olabilece\u011Fin imk\xE2n\u0131 dikkatle g\xF6zet.", ["hope", "service"]),
    h("Nawawi 40", "Nevev\xEE K\u0131rk Hadis", "39", "Mistakes, forgetfulness, and coercion are not the same as deliberate wrongdoing. Let that distinction temper the harshness of your self-judgment.", "Hata, unutma ve zorlanma; bile isteye yap\u0131lan k\xF6t\xFCl\xFCkle ayn\u0131 de\u011Fildir. Kendini de\u011Ferlendirirken bu ayr\u0131m\u0131 hat\u0131rla, h\xFCkm\xFCnde merhamete de yer ver.", ["hope", "self-compassion"]),
    h("Bukhari", "Buh\xE2r\xEE", "5027", "Give time to learning the Quran and helping someone else learn it. Understanding can become a shared act of service.", "Kur\u2019an\u2019\u0131 \xF6\u011Frenmeye ve bir ba\u015Fkas\u0131n\u0131n \xF6\u011Frenmesine destek olmaya vakit ay\u0131r. \xD6\u011Frencilikle \xF6\u011Fretme gayreti, ayn\u0131 hay\u0131r yolunda bulu\u015Fabilir.", ["learning"]),
    h("Bukhari", "Buh\xE2r\xEE", "6011", "A caring community resembles one body: another person\u2019s pain is not irrelevant to the rest. Let compassion interrupt your indifference.", "Merhametli bir toplulu\u011Fu tek bir beden gibi d\xFC\u015F\xFCn: birinin ac\u0131s\u0131 di\u011Ferlerinden kopuk de\u011Fildir. \u015Eefkatin, al\u0131\u015F\u0131lm\u0131\u015F kay\u0131ts\u0131zl\u0131\u011F\u0131n\u0131 kesintiye u\u011Frats\u0131n.", ["community"]),
    h("Bukhari", "Buh\xE2r\xEE", "5353", "Sustaining a widow or someone in poverty is deeply valued work. Quiet, practical care can carry the weight of great devotion.", "Yoksulun ve dul kalm\u0131\u015F ki\u015Finin ge\xE7imine destek olmak \xE7ok k\u0131ymetli bir emektir. Sessizce \xFCstlendi\u011Fin somut bak\u0131m\u0131n de\u011Ferini k\xFC\xE7\xFCmseme.", ["service"]),
    h("Bukhari", "Buh\xE2r\xEE", "2363", "A thirsty animal is worthy of your compassion. Remember the person who drew water for a dog, and notice the need within reach.", "Susam\u0131\u015F bir hayvan da merhametine lay\u0131kt\u0131r. K\xF6pe\u011Fe su veren ki\u015Finin anlat\u0131s\u0131n\u0131 hat\u0131rla; hemen yak\u0131n\u0131ndaki bir canl\u0131n\u0131n ihtiyac\u0131n\u0131 fark et.", ["compassion", "action"]),
    h("Bukhari", "Buh\xE2r\xEE", "1975", "Your body, eyes, and family have rights over you. Devotion should not make you forget sleep, rest, and those who share your life.", "Bedeninin, g\xF6zlerinin ve ailenin \xFCzerinde hakk\u0131 var. Gayretin; uykuyu, dinlenmeyi ve hayat\u0131n\u0131 payla\u015Ft\u0131\u011F\u0131n insanlar\u0131 b\xFCt\xFCn\xFCyle unutturmas\u0131n.", ["balance"]),
    h("Bukhari", "Buh\xE2r\xEE", "2444", "Helping someone who is doing wrong can mean stopping their wrongdoing. Loyalty need not become permission for injustice.", "Yanl\u0131\u015F yapan birine yard\u0131m\u0131n, onu zulm\xFCnden al\u0131koymak olabilir. Ba\u011Fl\u0131l\u0131\u011F\u0131n\u0131 her davran\u0131\u015F\u0131 onaylamak sanma; gerekti\u011Finde iyilik i\xE7in s\u0131n\u0131r koy.", ["courage", "justice"]),
    h("Muslim", "M\xFCslim", "2593", "Gentleness has a worth that harshness cannot provide. Try a considerate approach before assuming pressure is the only way forward.", "Yumu\u015Fakl\u0131\u011F\u0131n, sertli\u011Fin sa\u011Flayamayaca\u011F\u0131 bir de\u011Feri vard\u0131r. \u0130lerlemenin tek yolunu bask\u0131 sanmadan \xF6nce, incelikli bir yakla\u015F\u0131m\u0131 dene.", ["kindness"]),
    h("Muslim", "M\xFCslim", "2564c", "Your appearance and possessions are not the measure of your standing before God. Attend to the heart and actions beneath what others see.", "Allah kat\u0131ndaki de\u011Ferini yaln\u0131z g\xF6r\xFCn\xFC\u015F\xFCnle ve mal\u0131nla \xF6l\xE7me. \u0130nsanlar\u0131n g\xF6rd\xFC\u011F\xFC y\xFCz\xFCn alt\u0131nda kalan kalbine ve yapt\u0131\u011F\u0131n i\u015Flere \xF6zen g\xF6ster.", ["self-worth"]),
    h("Muslim", "M\xFCslim", "2664", "Seek what benefits you and ask God for help. After an outcome, do not let endless if-only thoughts consume the strength needed for what comes next.", "Sana faydal\u0131 olana gayret et ve Allah\u2019tan yard\u0131m iste. Sonu\xE7tan sonra bitmeyen ke\u015Fkelerin, bundan sonras\u0131 i\xE7in gereken g\xFCc\xFCn\xFC t\xFCketmesine izin verme.", ["courage", "uncertainty"]),
    h("Muslim", "M\xFCslim", "2588", "Do not mistake forgiveness for humiliation or humility for worthlessness. A generous character has a dignity that display cannot supply.", "Affetmeyi a\u015Fa\u011F\u0131lanmak, tevazuyu de\u011Fersizle\u015Fmek sanma. Ba\u011F\u0131\u015Flay\u0131c\u0131 ve al\xE7ak g\xF6n\xFCll\xFC bir duru\u015Fun, g\xF6steri\u015Fle elde edilmeyen bir izzeti vard\u0131r.", ["courage", "self-worth"]),
    // 20 distinct reflections from Marcus Aurelius.
    marcus("4.3", "4.four", "You can take a short retreat within your own reflection. Return to a few steady principles, then meet the world again with a clearer mind.", "K\u0131sa bir s\xFCre kendi i\xE7ine \xE7ekil. Dayand\u0131\u011F\u0131n birka\xE7 sa\u011Flam ilkeyi hat\u0131rla; ard\u0131ndan d\xFCnyaya daha toplu bir zihinle yeniden d\xF6n.", ["fear", "calm"]),
    marcus("4.12", "4.four", "Stay willing to revise a judgment when a better reason appears. A change made for truth is a form of steadiness, not a loss of direction.", "Daha iyi bir gerek\xE7e g\xF6rd\xFC\u011F\xFCnde h\xFCkm\xFCn\xFC yenilemeye a\xE7\u0131k ol. Do\u011Fru i\xE7in fikir de\u011Fi\u015Ftirmek, y\xF6n\xFCn\xFC kaybetti\u011Fin anlam\u0131na gelmez.", ["courage", "learning"]),
    marcus("4.20", "4.four", "An emerald does not become less beautiful when nobody praises it. Let your work have a value that applause does not have to create.", "Bir z\xFCmr\xFCt, kimse \xF6vmedi\u011Finde g\xFCzelli\u011Fini kaybetmez. Eme\u011Finin de\u011Ferini yaln\u0131z alk\u0131\u015Fla \xF6l\xE7me; yapt\u0131\u011F\u0131n i\u015Fin kendi niteli\u011Fine de g\xFCven.", ["fear", "self-worth"]),
    marcus("4.24", "4.four", "Ask whether each demand is truly necessary. Fewer needless actions and thoughts can leave more room for the work that actually matters.", "\xD6n\xFCndeki her talebin ger\xE7ekten gerekli olup olmad\u0131\u011F\u0131n\u0131 d\xFC\u015F\xFCn. Gereksiz u\u011Fra\u015Flar azald\u0131\u011F\u0131nda, \xF6nemli olana daha sakin ve \xF6zenli yakla\u015Fabilirsin.", ["fear", "calm"]),
    marcus("4.31", "4.four", "Respect the craft you have learned, however modest it appears. Give it your care without turning yourself into anyone\u2019s master or servant.", "\xD6\u011Frendi\u011Fin beceri sana m\xFCtevaz\u0131 g\xF6r\xFCnse de ona sahip \xE7\u0131k. \u0130\u015Fine \xF6zen g\xF6sterirken kimseye h\xFCkmetmeye veya kendini ezdirmeye ihtiya\xE7 duyma.", ["courage", "self-worth"]),
    marcus("4.49", "4.four", "Picture a headland holding steady as waves arrive. A difficult event can meet a response that preserves your fairness and composure.", "Dalgalarla kar\u015F\u0131la\u015Fan sa\u011Flam bir k\u0131y\u0131y\u0131 d\xFC\u015F\xFCn. Zor bir olay\u0131n i\xE7inde, adaletini ve s\xFCk\xFBnetini koruyacak bir duru\u015F arayabilirsin.", ["fear", "courage"]),
    marcus("6.6", "6.six", "Do not let a wrongdoer teach you how to become like them. Keep the character you want, even while responding to what happened.", "Sana yanl\u0131\u015F yapan ki\u015Finin davran\u0131\u015F\u0131, senin karakterinin \xF6\u011Fretmeni olmas\u0131n. Olanlara kar\u015F\u0131l\u0131k verirken nas\u0131l biri kalmak istedi\u011Fini hat\u0131rla.", ["courage", "integrity"]),
    marcus("6.11", "6.six", "Losing your balance for a moment does not require remaining unsettled. Return to yourself; the practice of returning strengthens your steadiness.", "Bir an sars\u0131lman, b\xFCt\xFCn g\xFCn da\u011F\u0131n\u0131k kalman\u0131 gerektirmez. Kendine yeniden d\xF6n; toparlanmay\u0131 tekrarlad\u0131k\xE7a dengenle kurdu\u011Fun ili\u015Fki g\xFC\xE7lenir.", ["fear", "renewal"]),
    marcus("6.19", "6.six", "Do not declare something impossible simply because it is difficult for you now. Examine what human ability and practice can actually reach.", "\u015Eu anda sana zor gelen bir \u015Feyi hemen imk\xE2ns\u0131z ilan etme. \u0130nsan becerisinin ve \xE7al\u0131\u015Fman\u0131n ger\xE7ekte nereye ula\u015Fabildi\u011Fine bak.", ["courage", "hope"]),
    marcus("6.20", "6.six", "After an injury in training, caution need not become hatred. Protect yourself where necessary without letting every encounter become a battle.", "Bir antrenmanda incindi\u011Finde tedbir al\u0131rs\u0131n; mutlaka d\xFC\u015Fman edinmen gerekmez. Kendini korurken her kar\u015F\u0131la\u015Fmay\u0131 bir sava\u015Fa d\xF6n\xFC\u015Ft\xFCrmemeye \xE7al\u0131\u015F.", ["fear", "boundaries"]),
    marcus("6.26", "6.six", "Even your name is written one letter at a time. Approach a difficult duty through its actual parts, without adopting the surrounding agitation.", "Ad\u0131n bile harf harf yaz\u0131l\u0131r. Zor bir i\u015Fi olu\u015Fturan ger\xE7ek par\xE7alara bak; \xE7evrendeki tela\u015F\u0131 \xFCstlenmeden s\u0131rayla ilerlemeye \xE7al\u0131\u015F.", ["fear", "action"]),
    marcus("6.30", "6.six", "Do not let a position of power dye your character. Keep your manner simple, just, and kind as your responsibilities grow.", "Bir mevkinin karakterini boyamas\u0131na izin verme. Sorumlulu\u011Fun b\xFCy\xFCrken de sadeli\u011Fini, adalet duygunu ve insanlara g\xF6sterdi\u011Fin inceli\u011Fi koru.", ["integrity"]),
    marcus("6.48", "6.six", "Recall a friend\u2019s courage, another\u2019s generosity, another\u2019s modesty. Real examples of goodness can renew your willingness to practise it.", "Bir dostunun cesaretini, bir ba\u015Fkas\u0131n\u0131n c\xF6mertli\u011Fini, di\u011Ferinin tevazuunu hat\u0131rla. G\xF6rd\xFC\u011F\xFCn somut iyilik \xF6rnekleri, senin de gayretini tazeleyebilir.", ["hope", "connection"]),
    marcus("6.53", "6.six", "Listen closely enough to enter the speaker\u2019s meaning. Understanding another person calls for a little less preparation of your own reply.", "Konu\u015Fan\u0131n ne demek istedi\u011Fini anlayacak kadar dikkatle dinle. Kendi cevab\u0131n\u0131 haz\u0131rlamaya biraz ara vermek, ba\u015Fka bir zihne yakla\u015Fman\u0131 sa\u011Flar.", ["listening"]),
    marcus("8.1", "8.eight", "You cannot rewrite how your earlier life appeared. You can still choose the character of the life that remains, without waiting for a perfect reputation.", "Ge\xE7mi\u015F hayat\u0131n\u0131n ba\u015Fkalar\u0131na nas\u0131l g\xF6r\xFCnd\xFC\u011F\xFCn\xFC yeniden yazamazs\u0131n. Kusursuz bir itibar beklemeden, bundan sonras\u0131n\u0131 nas\u0131l ya\u015Fayaca\u011F\u0131na \xF6zen g\xF6sterebilirsin.", ["fear", "renewal"]),
    marcus("8.11", "8.eight", "When something intimidates you, examine what it actually consists of, what causes it, and how long it lasts. Precision can loosen its vague authority.", "Bir \u015Fey g\xF6z\xFCn\xFC korkuttu\u011Funda, onun neyden olu\u015Ftu\u011Funa, nedenlerine ve s\xFCresine bak. Belirsiz bir b\xFCy\xFCkl\xFCk yerine somut ayr\u0131nt\u0131lar g\xF6rmeye \xE7al\u0131\u015F.", ["fear", "discernment"]),
    marcus("8.36", "8.eight", "Do not gather every possible hardship of a lifetime into this moment. Look at the difficulty actually present and respond to that.", "Bir \xF6mr\xFCn b\xFCt\xFCn muhtemel s\u0131k\u0131nt\u0131lar\u0131n\u0131 \u015Fu ana y\u0131\u011Fma. \xD6n\xFCnde ger\xE7ekten bulunan g\xFC\xE7l\xFC\u011Fe bak; kar\u015F\u0131l\u0131\u011F\u0131n\u0131 \xF6nce ona vermeye \xE7al\u0131\u015F.", ["fear", "uncertainty"]),
    marcus("8.50", "8.eight", "If the cucumber is bitter, put it aside; if the path has thorns, step around them. A practical response need not await an explanation of everything.", "Salatal\u0131k ac\u0131ysa b\u0131rak, yolda diken varsa \xE7evresinden ge\xE7. Uygulanabilir bir \xE7\xF6z\xFCm i\xE7in her \u015Feyin nedenini b\xFCt\xFCn\xFCyle a\xE7\u0131klaman gerekmeyebilir.", ["fear", "action"]),
    marcus("8.51", "8.eight", "Keep actions purposeful and speech clear. A crowded inner life need not pull you into hurried movements in every direction.", "Yapt\u0131klar\u0131nda ama\xE7, s\xF6ylediklerinde a\xE7\u0131kl\u0131k ara. \u0130\xE7inin kalabal\u0131k olu\u015Fu seni her y\xF6ne savuran acele hareketlere d\xF6n\xFC\u015Fmek zorunda de\u011Fil.", ["fear", "calm"]),
    marcus("8.59", "8.eight", "People exist in relation to one another. When someone falls short, consider whether patient teaching or patient understanding is possible.", "\u0130nsanlar birbirleriyle ili\u015Fki i\xE7inde ya\u015Far. Birinin eksi\u011Fiyle kar\u015F\u0131la\u015Ft\u0131\u011F\u0131nda, sab\u0131rla anlatman\u0131n veya anlay\u0131\u015F g\xF6stermenin m\xFCmk\xFCn olup olmad\u0131\u011F\u0131n\u0131 d\xFC\u015F\xFCn.", ["community"]),
    // 15 different sections of Epictetus, with practical rather than punitive wording.
    epictetus("4", "Before entering a busy place, expect ordinary interruptions. Prepare both to do your task and to preserve the manner you want to bring to it.", "Kalabal\u0131k bir i\u015Fe girmeden \xF6nce ola\u011Fan aksilikleri hesaba kat. Hem i\u015Fini yapmaya hem de orada korumak istedi\u011Fin tavra haz\u0131rlan.", ["fear", "preparation"]),
    epictetus("6", "A fine possession is not your own achievement of character. Take satisfaction in the judgment and conduct that are truly yours to practise.", "G\xFCzel bir e\u015Fyaya sahip olmak, tek ba\u015F\u0131na karakter ba\u015Far\u0131n de\u011Fildir. Kendi pay\u0131n olan muhakemeye ve davran\u0131\u015Fa g\xF6sterdi\u011Fin \xF6zenle de memnuniyet duy.", ["self-worth"]),
    epictetus("10", "Meet each challenge by asking which capacity it calls for: endurance, restraint, or patience. Name the strength you can bring before deciding you have none.", "Bir g\xFC\xE7l\xFCkle kar\u015F\u0131la\u015F\u0131nca hangi yetene\u011Fine ihtiya\xE7 oldu\u011Funu sor: dayan\u0131kl\u0131l\u0131k m\u0131, \xF6l\xE7\xFC m\xFC, sab\u0131r m\u0131? G\xFCc\xFCn yok demeden \xF6nce kullanabilece\u011Fin g\xFCc\xFC tan\u0131.", ["fear", "courage"]),
    epictetus("12", "When a little oil spills, notice the price of making it a great disturbance. Practise accepting small losses without surrendering all your peace.", "Biraz ya\u011F d\xF6k\xFCld\xFC\u011F\xFCnde, bunu b\xFCy\xFCk bir huzursuzlu\u011Fa \xE7evirmenin bedelini fark et. K\xFC\xE7\xFCk kay\u0131plarda b\xFCt\xFCn s\xFCk\xFBnetinden vazge\xE7memeyi dene.", ["fear", "calm"]),
    epictetus("13", "Learning may make you look inexperienced. Allow that stage; protecting the appearance of knowing can prevent the work of becoming capable.", "\xD6\u011Frenirken acemi g\xF6r\xFCnebilirsin. O evreye izin ver; her \u015Feyi biliyor g\xF6r\xFCnmeye \xE7al\u0131\u015Fmak, ger\xE7ekten beceri kazanman\u0131n \xF6n\xFCn\xFC kapatabilir.", ["courage", "learning"]),
    epictetus("15", "At a banquet, receive what reaches you without grabbing what has not. Practise a patient, measured relationship with opportunities and possessions.", "Bir sofrada sana uzanan\u0131 \xF6l\xE7\xFCyle al, hen\xFCz gelene uzan\u0131p \xE7eki\u015Ftirme. \u0130mk\xE2nlarla ili\u015Fkinin acele ve kapma duygusuyla y\xF6netilmesine izin verme.", ["patience"]),
    epictetus("17", "An actor may not choose the length of the role. Give care to how you perform the part now entrusted to you.", "Oyuncu rol\xFCn\xFCn uzunlu\u011Funu her zaman se\xE7emez. Sen de \xF6n\xFCne gelen pay\u0131n b\xFCy\xFCkl\xFC\u011F\xFCne tak\u0131l\u0131p kalmadan, onu nas\u0131l \xFCstlendi\u011Fine \xF6zen g\xF6ster.", ["uncertainty", "courage"]),
    epictetus("20", "Between an insult and your reply, allow a little time. That pause can help you choose a response instead of merely continuing the provocation.", "Bir hakaretle cevab\u0131n aras\u0131na biraz zaman koy. O k\u0131sa ara, k\u0131\u015Fk\u0131rtmay\u0131 s\xFCrd\xFCrmek yerine nas\u0131l kar\u015F\u0131l\u0131k verece\u011Fini se\xE7mene yard\u0131m edebilir.", ["fear", "calm"]),
    epictetus("24", "You need not purchase influence at the cost of integrity. Being a trustworthy friend and citizen is already a meaningful contribution.", "N\xFCfuz kazanmak i\xE7in d\xFCr\xFCstl\xFC\u011F\xFCn\xFC bedel olarak vermen gerekmez. G\xFCvenilir bir dost ve sorumluluk sahibi bir insan olmak da de\u011Ferli bir katk\u0131d\u0131r.", ["courage", "self-worth"]),
    epictetus("25", "An invitation may have a price in flattery or time. When you decline that price, remember what you kept as well as what you missed.", "Bir davetin bedeli bazen dalkavukluk veya s\xFCrekli ilgi olabilir. O bedeli \xF6demedi\u011Finde, ka\xE7\u0131rd\u0131\u011F\u0131n kadar korudu\u011Fun \u015Feyi de hat\u0131rla.", ["fear", "boundaries"]),
    epictetus("28", "Do not give every passing insult unlimited access to your attention. Guard your judgment as deliberately as you would guard your physical space.", "Her gelip ge\xE7en hakarete dikkatinin tamam\u0131n\u0131 teslim etme. Fiziksel alan\u0131n\u0131 g\xF6zetti\u011Fin gibi, zihnine hangi s\xF6z\xFC ta\u015F\u0131d\u0131\u011F\u0131na da \xF6zen g\xF6ster.", ["fear", "boundaries"]),
    epictetus("29", "Before choosing the contest, understand its training and costs. Let informed commitment support the enthusiasm that first drew you toward the goal.", "Bir yar\u0131\u015Fa girmeden \xF6nce gerektirdi\u011Fi haz\u0131rl\u0131\u011F\u0131 ve bedelleri \xF6\u011Fren. Hedefe duydu\u011Fun ilk hevesi, ne \xFCstlendi\u011Fini bilen bir kararl\u0131l\u0131kla destekle.", ["courage", "preparation"]),
    epictetus("35", "If careful judgment shows an action is right, do not abandon it merely because others may misunderstand. Examine the act, then face mistaken criticism.", "Dikkatli de\u011Ferlendirmen bir davran\u0131\u015F\u0131n do\u011Fru oldu\u011Funu g\xF6steriyorsa, yaln\u0131z yanl\u0131\u015F anla\u015F\u0131lmaktan korktu\u011Fun i\xE7in vazge\xE7me. \xD6nce davran\u0131\u015F\u0131 incele, sonra ele\u015Ftiriyi kar\u015F\u0131la.", ["fear", "courage"]),
    epictetus("43", "A relationship may offer more than one handle: the injury, or the bond you share. Consider which way of holding it allows a wiser response.", "Bir ili\u015Fkiyi yaln\u0131z incindi\u011Fin yerden tutmak zorunda de\u011Filsin. Aran\u0131zdaki ba\u011F\u0131 da d\xFC\u015F\xFCn; hangi bak\u0131\u015F\u0131n daha bilgece bir kar\u015F\u0131l\u0131\u011Fa imk\xE2n verdi\u011Fini ara.", ["perspective"]),
    epictetus("45", "Describe what you observed before adding a judgment of character. Knowing the action is not the same as knowing the reason behind it.", "Birinin karakteri hakk\u0131nda h\xFCk\xFCm vermeden \xF6nce, ger\xE7ekten ne g\xF6rd\xFC\u011F\xFCn\xFC tarif et. Davran\u0131\u015F\u0131 g\xF6rmekle, arkas\u0131ndaki nedeni bilmek ayn\u0131 \u015Fey de\u011Fildir.", ["discernment"]),
    // 10 distinct arguments from Aristotle.
    aristotle("3.2", "3.iii", "A wish alone is not a choice. A considered choice concerns an action you can take, so bring your desire into a decision you can carry out.", "Dilemek tek ba\u015F\u0131na se\xE7im yapmak de\u011Fildir. D\xFC\u015F\xFCn\xFClm\xFC\u015F bir se\xE7im, yapabilece\u011Fin bir eylemle ilgilidir; iste\u011Fini \xFCstlenebilece\u011Fin bir karara yakla\u015Ft\u0131r.", ["action"]),
    aristotle("3.3", "3.iii", "For a difficult decision, consult others and trace the available means. Begin with the step that your reasoning has brought within reach.", "Zor bir kararda ba\u015Fkalar\u0131n\u0131n g\xF6r\xFC\u015F\xFCne ba\u015Fvur ve m\xFCmk\xFCn yollar\u0131 incele. D\xFC\u015F\xFCnmenin sonunda eri\u015Filebilir h\xE2le gelen ilk i\u015Fle ba\u015Flamay\u0131 dene.", ["uncertainty", "action"]),
    aristotle("3.4", "3.iii", "What looks pleasant is not always what serves you well. Examine the apparent good before allowing it to decide your direction.", "Ho\u015F g\xF6r\xFCnen her \u015Fey sana ger\xE7ekten iyi gelmeyebilir. Y\xF6n\xFCn\xFC belirlemesine izin vermeden \xF6nce, \xE7ekici buldu\u011Fun \u015Feyin de\u011Ferini sorgula.", ["discernment"]),
    aristotle("3.6", "3.iii", "Fear is not automatically a defect. Some fears protect what deserves care; examine what you fear before judging yourself for feeling it.", "Korku duyman kendili\u011Finden bir kusur de\u011Fildir. Baz\u0131 korkular \xF6zen g\xF6stermeye de\u011Fer olan\u0131 korur; kendini yarg\u0131lamadan \xF6nce neyden korktu\u011Funa bak.", ["fear", "self-compassion"]),
    aristotle("3.7", "3.iii", "Courage considers the real danger, the right time, and a worthy purpose. It asks for proportionate action, not a performance of fearlessness.", "Cesaret; ger\xE7ek tehlikeyi, do\u011Fru zaman\u0131 ve de\u011Ferli bir amac\u0131 birlikte g\xF6zetir. Korkusuz g\xF6r\xFCnmeye \xE7al\u0131\u015Fmaktan \xF6nce, duruma uygun davranmay\u0131 ara.", ["fear", "courage"]),
    aristotle("3.8", "3.iii", "Experience can make a danger less confusing, while anger can imitate courage. Build informed confidence without letting excitement make the decision for you.", "Deneyim, tehlikeyi daha anla\u015F\u0131l\u0131r k\u0131labilir; \xF6fke ise cesarete benzeyebilir. Karar\u0131n\u0131 heyecana b\u0131rakmadan, bilgiyle desteklenen bir g\xFCven geli\u015Ftir.", ["fear", "courage"]),
    aristotle("3.9", "3.iii", "A courageous act may still be painful. Its worth can lie in the good it protects, even when the experience itself is not pleasant.", "Cesur bir davran\u0131\u015F yine de zor ve ac\u0131 verici olabilir. Ya\u015Fad\u0131\u011F\u0131n an ho\u015F olmasa bile, korudu\u011Fun de\u011Fer o davran\u0131\u015F\u0131 anlaml\u0131 k\u0131labilir.", ["fear", "courage"]),
    aristotle("6.5", "6.vi", "Practical wisdom asks what serves a good life as a whole. Do not let cleverness about one advantage replace care for the wider picture.", "Pratik bilgelik, hayat\u0131n b\xFCt\xFCn\xFCne neyin iyi gelece\u011Fini sorar. Tek bir avantaj\u0131 elde etme becerin, daha geni\u015F resmi g\xF6zetmenin yerini almas\u0131n.", ["wisdom"]),
    aristotle("6.7", "6.vi", "General knowledge needs attention to the particular situation. Before applying a rule, look closely at the person and circumstances before you.", "Genel bilgi, somut duruma dikkatle yakla\u015Fmaya ihtiya\xE7 duyar. Bir kural\u0131 uygulamadan \xF6nce, \xF6n\xFCndeki insan\u0131 ve ko\u015Fullar\u0131 yak\u0131ndan anlamaya \xE7al\u0131\u015F.", ["discernment"]),
    aristotle("8.3", "8.viii", "A lasting friendship wishes the other person well for their own sake. Give the bond more care than the usefulness you receive from it.", "Kal\u0131c\u0131 dostluk, \xF6tekinin iyili\u011Fini onun kendisi i\xE7in ister. Aran\u0131zdaki ba\u011F\u0131, yaln\u0131zca ondan ald\u0131\u011F\u0131n faydayla \xF6l\xE7meden beslemeye \xE7al\u0131\u015F.", ["friendship"]),
    // 15 passages from the Analects; chapter 1.4 is explicitly attributed to Zengzi.
    confucius("1.1", "There is a quiet pleasure in learning and returning to what you learned. Let practice be an experience you can enjoy, not merely an exam to pass.", "\xD6\u011Frenmenin ve \xF6\u011Frendi\u011Fine yeniden d\xF6nmenin sakin bir sevinci vard\u0131r. \xC7al\u0131\u015Fman\u0131 yaln\u0131z ge\xE7ilecek bir s\u0131nav olarak de\u011Fil, tad\u0131na var\u0131lacak bir u\u011Fra\u015F olarak da g\xF6r.", ["learning"]),
    p("Zengzi", "Zengzi", "Analects", "Konu\u015Fmalar", "1.4", "https://www.gutenberg.org/cache/epub/3330/pg3330-images.html", "At day\u2019s end, examine your reliability to others, sincerity with friends, and practice of what you learned. Reflection becomes useful when it asks something specific.", "G\xFCn biterken ba\u015Fkalar\u0131na kar\u015F\u0131 g\xFCvenilirli\u011Fini, dostlar\u0131na samimiyetini ve \xF6\u011Frendiklerini uygulay\u0131\u015F\u0131n\u0131 d\xFC\u015F\xFCn. Kendine belirli sorular sormak, muhasebeni daha anlaml\u0131 k\u0131lar.", ["reflection"]),
    confucius("7.10", "Choose companions who prepare carefully before acting. Recklessness is not the same as courage; resolve can include respect for the danger.", "Harekete ge\xE7meden \xF6nce dikkatle haz\u0131rlanan insanlarla yol al. Pervas\u0131zl\u0131\u011F\u0131 cesaret sanma; kararl\u0131 bir duru\u015F, tehlikeyi ciddiye almay\u0131 da i\xE7erebilir.", ["fear", "courage"]),
    confucius("1.16", "When recognition feels scarce, turn some attention toward understanding others. Being known is not the only meaningful direction for your curiosity.", "Yeterince tan\u0131nmad\u0131\u011F\u0131n\u0131 hissetti\u011Finde, insanlar\u0131 tan\u0131maya da dikkat ay\u0131r. Merak\u0131n\u0131n tek y\xF6n\xFC ba\u015Fkalar\u0131n\u0131n seni nas\u0131l g\xF6rd\xFC\u011F\xFC olmas\u0131n.", ["fear", "connection"]),
    confucius("2.11", "Return to earlier knowledge with fresh questions. Reviewing what you already know can open the way to an understanding you did not have before.", "Eski bilgine yeni sorularla d\xF6n. Bildi\u011Fini g\xF6zden ge\xE7irmek, yaln\u0131z tekrar de\u011Fildir; daha \xF6nce g\xF6remedi\u011Fin bir anlay\u0131\u015F\u0131n kap\u0131s\u0131n\u0131 a\xE7abilir.", ["learning"]),
    confucius("2.15", "Let study and reflection correct one another. Reading without thought leaves understanding thin; thinking without learning can lose its bearings.", "\xD6\u011Frenmeyle d\xFC\u015F\xFCnmenin birbirini beslemesine izin ver. \xDCzerinde durmad\u0131\u011F\u0131n bilgi y\xFCzeyde kalabilir; \xF6\u011Frenmeyle s\u0131namad\u0131\u011F\u0131n d\xFC\u015F\xFCnce ise y\xF6n\xFCn\xFC \u015Fa\u015F\u0131rabilir.", ["learning"]),
    confucius("2.17", "Knowing includes being honest about what you do not know. Say so plainly; uncertainty acknowledged is a sounder beginning than confidence performed.", "Bilmek, bilmedi\u011Fini d\xFCr\xFCst\xE7e kabul etmeyi de i\xE7erir. A\xE7\u0131k\xE7a s\xF6yle; kabul edilmi\u015F bir belirsizlik, sergilenen yapay bir g\xFCvenden daha sa\u011Flam bir ba\u015Flang\u0131\xE7t\u0131r.", ["uncertainty", "courage"]),
    confucius("4.17", "When you see admirable conduct, consider learning from it. When you see a fault, also ask whether a trace of it needs attention in yourself.", "G\xFCzel bir davran\u0131\u015F g\xF6rd\xFC\u011F\xFCnde ondan \xF6\u011Frenmeyi d\xFC\u015F\xFCn. Bir kusur g\xF6rd\xFC\u011F\xFCnde ise kendinde benzer bir izin olup olmad\u0131\u011F\u0131n\u0131 da yokla.", ["reflection"]),
    confucius("6.18", "Knowing a subject is one stage; loving it and finding joy in it deepen the relationship. Make room for what draws your curiosity back.", "Bir konuyu bilmek bir a\u015Famad\u0131r; onu sevmek ve ondan sevin\xE7 duymak ba\u011F\u0131 derinle\u015Ftirir. Merak\u0131n\u0131 yeniden \xE7a\u011F\u0131ran taraf\u0131na da zaman ay\u0131r.", ["curiosity"]),
    confucius("7.21", "Among the people walking beside you, there is something to learn. Choose a good quality to practise and a poor example to avoid.", "Yan\u0131nda y\xFCr\xFCyen insanlarda \xF6\u011Frenebilece\u011Fin bir \u015Fey vard\u0131r. Birinin iyi y\xF6n\xFCn\xFC \xF6rnek al; yanl\u0131\u015F buldu\u011Fun davran\u0131\u015Ftan da kendine bir ders \xE7\u0131kar.", ["learning", "community"]),
    confucius("9.27", "Winter reveals the lasting green of pine and cypress. A difficult season can make steadfast qualities visible that easy weather left unnoticed.", "K\u0131\u015F geldi\u011Finde \xE7am\u0131n ve servinin ye\u015Fili daha belirginle\u015Fir. Zor bir d\xF6nem, rahat g\xFCnlerde fark edilmeyen sa\u011Flam niteliklerini g\xF6r\xFCn\xFCr k\u0131labilir.", ["hope", "courage"]),
    confucius("12.4", "When fear troubles you, examine whether your conduct gives your conscience reason for reproach. An honest inner review can support a steadier stance.", "Korku seni s\u0131k\u0131\u015Ft\u0131rd\u0131\u011F\u0131nda, davran\u0131\u015Flar\u0131nda vicdan\u0131n\u0131 rahats\u0131z eden bir \u015Fey olup olmad\u0131\u011F\u0131n\u0131 d\xFC\u015F\xFCn. D\xFCr\xFCst bir i\xE7 de\u011Ferlendirme, daha sa\u011Flam durmana yard\u0131mc\u0131 olabilir.", ["fear", "conscience"]),
    confucius("13.23", "Harmony does not require everyone to be identical. You can remain in respectful relationship while keeping an honest difference of view.", "Uyum, herkesin ayn\u0131 d\xFC\u015F\xFCnmesini gerektirmez. G\xF6r\xFC\u015F ayr\u0131l\u0131\u011F\u0131n\u0131 d\xFCr\xFCst\xE7e korurken sayg\u0131l\u0131 bir ili\u015Fki i\xE7inde kalmay\u0131 da \xF6\u011Frenebilirsin.", ["courage", "community"]),
    confucius("15.20", "Bring your standard of conduct back to what you ask of yourself. Responsibility becomes clearer when it is not always directed at someone else.", "Davran\u0131\u015F \xF6l\xE7\xFCn\xFC, kendinden ne bekledi\u011Fine de \xE7evir. Sorumlulu\u011Fu s\xFCrekli ba\u015Fkas\u0131na y\xF6neltmedi\u011Finde, sana d\xFC\u015Fen pay daha a\xE7\u0131k g\xF6r\xFCn\xFCr.", ["responsibility"]),
    confucius("15.29", "The deeper mistake is to leave a recognized mistake uncorrected. Once you can see it, give yourself permission to repair it.", "As\u0131l b\xFCy\xFCyen yanl\u0131\u015F, fark etti\u011Fin hatay\u0131 d\xFCzeltmeden b\u0131rakmand\u0131r. G\xF6rebildi\u011Fin anda onarmaya y\xF6nel; de\u011Fi\u015Fmek i\xE7in kendine izin ver.", ["courage", "renewal"]),
    // Five different images from Laozi; none repeats the existing thousand-mile line.
    lao("8", "Water benefits what surrounds it without demanding the highest place. Seek a useful contribution without needing every room to recognise your rank.", "Su, en y\xFCksek yeri istemeden \xE7evresindekileri besler. Her ortamda mevkinin tan\u0131nmas\u0131na ihtiya\xE7 duymadan, faydal\u0131 bir katk\u0131 sunman\u0131n yolunu ara.", ["humility"]),
    lao("11", "A vessel is useful because it has room inside. Leave some unfilled space in your day; capacity also depends on what you do not crowd in.", "Bir kap, i\xE7indeki bo\u015Fluk sayesinde kullan\u0131labilir. G\xFCn\xFCnde doldurmad\u0131\u011F\u0131n bir alan b\u0131rak; ta\u015F\u0131ma kapasiten, her aral\u0131\u011F\u0131 doldurmamana da ba\u011Fl\u0131d\u0131r.", ["calm"]),
    lao("15", "Muddy water clears when it is allowed to settle. When your thinking is stirred up, pause before forcing a conclusion.", "Bulan\u0131k su, durulmas\u0131na izin verildi\u011Finde berrakla\u015F\u0131r. Zihnin kar\u0131\u015Ft\u0131\u011F\u0131nda hemen bir sonu\xE7 \xE7\u0131karmaya zorlama; d\xFC\u015F\xFCncelerinin yat\u0131\u015Fmas\u0131na biraz zaman tan\u0131.", ["fear", "calm"]),
    lao("23", "A fierce wind does not last all morning, nor a sudden rain all day. Do not take the intensity of a moment as its permanence.", "\u015Eiddetli r\xFCzg\xE2r b\xFCt\xFCn sabah, ani ya\u011Fmur b\xFCt\xFCn g\xFCn s\xFCrmez. \u0130\xE7inden ge\xE7ti\u011Fin bir an\u0131n yo\u011Funlu\u011Funu, onun sonsuza kadar s\xFCrece\u011Fi san\u0131s\u0131yla kar\u0131\u015Ft\u0131rma.", ["fear", "hope"]),
    lao("24", "Standing on tiptoe does not make a stable stance. Let your effort find a sustainable posture instead of straining to appear taller.", "Parmak ucunda durmak sa\u011Flam bir duru\u015F sa\u011Flamaz. Daha b\xFCy\xFCk g\xF6r\xFCnmek i\xE7in s\xFCrekli gerilmek yerine, gayretini ta\u015F\u0131yabilece\u011Fin bir denge bul.", ["fear", "balance"])
  ];
  var FAITH_QUOTES = drafts.map((quote, index) => ({
    id: `faith-${String(index + 1).padStart(3, "0")}`,
    ...quote
  }));

  // src/data/quoteExpansionThinkers.ts
  init_define_import_meta_env();
  var nextId = 1;
  function passages(author, book, bookTr, sourceUrl, category, rows) {
    return rows.map(([reference, text2, tr2, courage]) => ({
      id: `thinker-${String(nextId++).padStart(3, "0")}`,
      text: text2,
      tr: tr2,
      source: `${author} \u2014 ${book}`,
      sourceTr: `${author} \u2014 ${bookTr}`,
      sourceUrl,
      reference,
      category,
      kind: "adaptation",
      ...courage ? { tags: ["courage", "fear"] } : {}
    }));
  }
  var THINKER_QUOTES = [
    ...passages("John Dewey", "How We Think", "Nas\u0131l D\xFC\u015F\xFCn\xFCr\xFCz", "https://www.gutenberg.org/cache/epub/37423/pg37423-images.html", "society", [
      ["I, \xA74: perplexity as the origin of thought", "Being puzzled need not end your inquiry. The very thing that unsettles you can give your thinking a question worth pursuing.", "Kafan\u0131n kar\u0131\u015Fmas\u0131 ara\u015Ft\u0131rman\u0131n sonu de\u011Fildir. Seni huzursuz eden \u015Fey, d\xFC\u015F\xFCncene pe\u015Finden gitmeye de\u011Fer bir soru verebilir.", true],
      ["VI, step 2: defining the difficulty", "Before a complicated situation overwhelms you, look closely enough to name the actual difficulty. A clear problem gives inquiry a direction.", "Karma\u015F\u0131k bir durum g\xF6z\xFCnde b\xFCy\xFCmeden, as\u0131l g\xFC\xE7l\xFC\u011F\xFCn ad\u0131n\u0131 koyacak kadar dikkatle bak. A\xE7\u0131k bir sorun, ara\u015Ft\u0131rmaya y\xF6n verir.", true],
      ["I, \xA74: suspended judgment", "You may leave a question open while you gather evidence. Enduring uncertainty is sometimes the honest work that understanding requires.", "Kan\u0131t toplarken bir soruyu a\xE7\u0131k b\u0131rakabilirsin. Belirsizli\u011Fe dayanmak, bazen anlaman\u0131n gerektirdi\u011Fi d\xFCr\xFCst eme\u011Fin ta kendisidir.", true],
      ["VI, step 3: alternative suggestions", "Give a difficult question more than one possible answer. Keeping alternatives alive protects you from mistaking the first idea for the only way.", "Zor bir soruya birden fazla yan\u0131t d\xFC\u015F\xFCn. Se\xE7enekleri a\xE7\u0131k tutmak, ilk fikri tek \xE7\u0131k\u0131\u015F yolu sanman\u0131 \xF6nler.", true],
      ["VI, step 5: experimental testing", "Let a small experiment question your prediction. What actually happens can guide you more reliably than how convincing the prediction first sounded.", "K\xFC\xE7\xFCk bir deneme, tahminini s\u0131nas\u0131n. Ger\xE7ekte olanlar, tahmininin ba\u015Fta ne kadar ikna edici g\xF6r\xFCnd\xFC\u011F\xFCnden daha sa\u011Flam yol g\xF6sterebilir."],
      ["VI, step 5: revising conclusions", "A conclusion can serve you today and still be revised tomorrow. New evidence is an invitation to understand more, not a personal defeat.", "Bir sonu\xE7 bug\xFCn i\u015Fine yaray\u0131p yar\u0131n de\u011Fi\u015Febilir. Yeni kan\u0131t, ki\u015Fisel bir yenilgi de\u011Fil, daha iyi anlama davetidir.", true],
      ["III, \xA71: curiosity and new contacts", "Let curiosity bring you into contact with unfamiliar things. A mind that explores has more experience to draw upon when a difficulty arrives.", "Merak\u0131n seni yabanc\u0131 oldu\u011Fun \u015Feylerle tan\u0131\u015Ft\u0131rs\u0131n. Ke\u015Ffeden bir zihin, g\xFC\xE7l\xFCk geldi\u011Finde ba\u015Fvurabilece\u011Fi daha \xE7ok deneyim biriktirir."],
      ["III, \xA71: intellectual curiosity", "Do not put a worthwhile question away merely because you have asked it. Carry it with you and notice what might help answer it.", "De\u011Ferli bir soruyu yaln\u0131zca sormu\u015F olmakla rafa kald\u0131rma. Onu akl\u0131nda ta\u015F\u0131; yan\u0131t\u0131na katk\u0131 sunabilecek \u015Feyleri fark et."],
      ["III, \xA71: protecting wonder", "Protect the wonder that routine can wear down. Familiarity need not close your eyes to a fresh question about an ordinary thing.", "Al\u0131\u015Fkanl\u0131\u011F\u0131n k\xF6reltebildi\u011Fi hayret duygunu koru. Bir \u015Feye a\u015Fina olmak, onun hakk\u0131nda yeni bir soru sormana engel olmas\u0131n."],
      ["III, \xA72: depth rather than speed of suggestion", "A quick answer is not the only sign of ability. Give a question time to sink in; depth can matter more than speed.", "Yetenek yaln\u0131zca h\u0131zl\u0131 cevap vermek de\u011Fildir. Sorunun i\xE7ine i\u015Flemesine zaman tan\u0131; d\xFC\u015F\xFCncenin derinli\u011Fi h\u0131z\u0131ndan daha de\u011Ferli olabilir.", true],
      ["I, \xA71: consecutive reflective thought", "Allow one sound thought to prepare the next. Understanding grows when your ideas support one another instead of merely crowding your mind.", "Sa\u011Flam bir d\xFC\u015F\xFCnce bir sonrakine zemin haz\u0131rlas\u0131n. Fikirlerin zihninde y\u0131\u011F\u0131lmak yerine birbirini destekledi\u011Finde anlay\u0131\u015F\u0131n da derinle\u015Fir."],
      ["I, \xA71: grounds and consequences of belief", "Ask both what supports your belief and where it leads. Caring about these two questions makes conviction more thoughtful and responsible.", "D\xFC\u015F\xFCnceni neyin destekledi\u011Fini ve seni nereye g\xF6t\xFCrd\xFC\u011F\xFCn\xFC birlikte sor. Bu iki soruyu \xF6nemsemek, kanaatini daha bilin\xE7li ve sorumlu k\u0131lar."],
      ["I, \xA74: drawing on analogous experience", "When a problem feels shapeless, recall a situation you have already understood. A useful resemblance can turn confusion into a tentative plan.", "Bir sorun belirsiz g\xF6r\xFCn\xFCyorsa daha \xF6nce anlad\u0131\u011F\u0131n benzer bir durumu hat\u0131rla. \u0130\u015Fe yarayan bir benzerlik, karma\u015Fadan taslak bir plan \xE7\u0131karabilir.", true],
      ["XVI: balance of playfulness and seriousness", "You can be playful with possibilities and serious about finding truth. Curiosity and care belong together in a mind that keeps growing.", "Olas\u0131l\u0131klarla \xF6zg\xFCrce oynarken ger\xE7e\u011Fi ciddiyetle arayabilirsin. B\xFCy\xFCmeyi s\xFCrd\xFCren bir zihinde merak ve \xF6zen birbirine e\u015Flik eder."],
      ["XVI: enriching the present", "Attend to what makes this present experience meaningful. The present can hold rich possibilities without being swallowed by worry about distant results.", "\u015Eu an ya\u015Fad\u0131\u011F\u0131n deneyimi anlaml\u0131 k\u0131lan \u015Feye dikkat et. Bug\xFCn, uzak sonu\xE7lar\u0131n kayg\u0131s\u0131na kap\u0131lmadan da zengin olas\u0131l\u0131klar ta\u015F\u0131yabilir.", true],
      ["XVI: work, drudgery, and valued ends", "An unappealing task can borrow meaning from a purpose you value. Remember what it serves while you are doing it.", "S\u0131k\u0131c\u0131 g\xF6r\xFCnen bir i\u015F, de\u011Fer verdi\u011Fin ama\xE7tan anlam alabilir. Onu yaparken neye hizmet etti\u011Fini yeniden hat\u0131rla."],
      ["XV: responsibility for a reasonable case", "Give your own idea a fair explanation instead of waiting to guess the approved answer. Taking responsibility for your reasons strengthens independent thought.", "Onaylanacak cevab\u0131 tahmin etmeyi beklemek yerine kendi fikrini gerek\xE7elendir. Nedenlerinin sorumlulu\u011Funu almak, ba\u011F\u0131ms\u0131z d\xFC\u015F\xFCnceni g\xFC\xE7lendirir.", true],
      ["XV: stopping and thinking", "Leave a pause in which thought can gather itself. Reflection needs a little freedom from the demands that keep pulling you elsewhere.", "D\xFC\u015F\xFCncenin toparlanabilece\u011Fi bir duraklamaya yer a\xE7. D\xFC\u015F\xFCnmek, seni ba\u015Fka y\xF6ne \xE7eken taleplerden bir s\xFCre uzakla\u015Fmay\u0131 gerektirir."],
      ["VI, step 3: enterprising and cautious inference", "Exploring a possibility takes a small intellectual leap. You can be adventurous in asking and careful in checking at the same time.", "Bir olas\u0131l\u0131\u011F\u0131 ara\u015Ft\u0131rmak k\xFC\xE7\xFCk bir zihinsel s\u0131\xE7rama ister. Soru sorarken giri\u015Fken, yan\u0131t\u0131 denetlerken dikkatli olabilirsin; bu ikisi birbiriyle uyumludur.", true],
      ["IV: skill acquired with intelligence", "Practice a skill with understanding, not only repetition. When you know what your action means, you can use it more intelligently in new situations.", "Bir beceriyi yaln\u0131zca tekrarla de\u011Fil, anlayarak \xE7al\u0131\u015F. Yapt\u0131\u011F\u0131n\u0131n anlam\u0131n\u0131 bildi\u011Finde onu yeni durumlarda daha bilin\xE7li kullanabilirsin."]
    ]),
    ...passages("William James", "Talks to Teachers and Students", "\xD6\u011Fretmenlere ve \xD6\u011Frencilere Konu\u015Fmalar", "https://www.gutenberg.org/files/16287/16287-h/16287-h.htm", "science", [
      ["VIII: virtues as habits", "Courage is among the qualities that can become habitual. It is worth noticing the everyday occasions on which you already practice it.", "Cesaret de al\u0131\u015Fkanl\u0131k kazanabilen niteliklerdendir. G\xFCnl\xFCk hayat\u0131nda onu zaten kulland\u0131\u011F\u0131n k\xFC\xE7\xFCk anlar\u0131 fark etmeye de\u011Fer.", true],
      ["VIII: freeing higher powers through useful routines", "Settle the ordinary details of your day into useful routines. Your mind then has more room for the work that truly requires judgment.", "G\xFCn\xFCn s\u0131radan ayr\u0131nt\u0131lar\u0131n\u0131 i\u015Fe yarayan bir d\xFCzene yerle\u015Ftir. B\xF6ylece zihninde ger\xE7ekten de\u011Ferlendirme isteyen i\u015Flere daha fazla yer a\xE7\u0131l\u0131r."],
      ["VIII: supporting a new resolution", "Surround a new resolution with practical support: suitable circumstances, helpful commitments, and people who make the new direction easier to follow.", "Yeni karar\u0131n\u0131n \xE7evresine somut destekler kur: uygun ko\u015Fullar, yard\u0131mc\u0131 sorumluluklar ve se\xE7ti\u011Fin y\xF6nde ilerlemeyi kolayla\u015Ft\u0131ran insanlar olsun."],
      ["VIII: daily exercise of effort", "Practice meeting a manageable difficulty before a demanding day arrives. Familiarity with effort can help you stand more steadily when courage is needed.", "Zorlu g\xFCn gelmeden, ba\u015F edebilece\u011Fin bir g\xFC\xE7l\xFCkle \xE7al\u0131\u015F. \xC7abaya al\u0131\u015Fmak, cesaret gerekti\u011Finde daha sa\u011Flam durmana yard\u0131mc\u0131 olabilir.", true],
      ["VIII: new motives and new habits", "Old habits do not make a new life impossible. A lasting new motive can reorganize what you repeatedly choose to do.", "Eski al\u0131\u015Fkanl\u0131klar\u0131n, yeni bir hayat\u0131 imk\xE2ns\u0131z k\u0131lmaz. Kal\u0131c\u0131 bir yeni ama\xE7, tekrar tekrar se\xE7ti\u011Fin davran\u0131\u015Flar\u0131 yeniden d\xFCzenleyebilir.", true],
      ["VIII: competence develops through particulars", "The details of learning may feel ordinary while your judgment is quietly improving. Do not demand the final shape of your ability too soon.", "\xD6\u011Frenmenin ayr\u0131nt\u0131lar\u0131 s\u0131radan g\xF6r\xFCn\xFCrken de\u011Ferlendirme g\xFCc\xFCn sessizce geli\u015Febilir. Yetene\u011Finin son bi\xE7imini kendinden hemen bekleme.", true],
      ["VII: the spectacle of effort", "Another person\u2019s wholehearted effort can awaken effort in you. Seek company whose way of working makes you want to take part.", "Bir ba\u015Fkas\u0131n\u0131n i\xE7ten \xE7abas\u0131 senin \xE7aban\u0131 da uyand\u0131rabilir. \xC7al\u0131\u015Fma bi\xE7imi sana kat\u0131lma iste\u011Fi veren insanlara yak\u0131n dur."],
      ["XI: attention and new aspects", "If your attention wanders, ask a fresh question about the subject. A new angle can make a familiar task interesting again.", "Dikkatin da\u011F\u0131l\u0131yorsa konuya yeni bir soru sor. Farkl\u0131 bir a\xE7\u0131, al\u0131\u015Ft\u0131\u011F\u0131n i\u015Fi yeniden ilgi \xE7ekici hale getirebilir."],
      ["XI: the dot experiment", "Look more closely instead of merely staring harder. Asking about shape, distance, or relation gives attention something definite to do.", "Yaln\u0131zca daha s\u0131k\u0131 odaklanmaya \xE7al\u0131\u015Fmak yerine ayr\u0131nt\u0131lara bak. Bi\xE7imi, uzakl\u0131\u011F\u0131 veya ili\u015Fkileri sormak, dikkatine somut bir i\u015F verir."],
      ["The Gospel of Relaxation: action and feeling", "When fear is present, consider the action still within your control. A deliberate act of courage can come before the feeling of courage.", "Korku varken h\xE2l\xE2 kontrol edebildi\u011Fin davran\u0131\u015F\u0131 d\xFC\u015F\xFCn. Bilin\xE7li bir cesaret davran\u0131\u015F\u0131, kendini cesur hissetmenden \xF6nce gelebilir.", true],
      ["The Gospel of Relaxation: restraint before regretted words", "Pause before the hurtful word escapes. Regulating what you express can give an agitated feeling room to become calmer.", "K\u0131r\u0131c\u0131 s\xF6z a\u011Fz\u0131ndan \xE7\u0131kmadan durakla. D\u0131\u015Far\u0131ya yans\u0131tt\u0131\u011F\u0131n davran\u0131\u015F\u0131 d\xFCzenlemek, kabaran duygunun sakinle\u015Fmesine alan a\xE7abilir.", true],
      ["The Gospel of Relaxation: kindness in conduct", "A friendly question or a shared laugh can soften an unfriendly relationship. Sometimes warmth begins in what you do together.", "\u0130\xE7ten bir soru ya da birlikte g\xFClmek, so\u011Fuk bir ili\u015Fkiyi yumu\u015Fatabilir. Bazen yak\u0131nl\u0131k, birlikte yapt\u0131\u011F\u0131n\u0131z k\xFC\xE7\xFCk bir \u015Feyle ba\u015Flar."],
      ["The Gospel of Relaxation: calm as an ideal", "You need not admire hurry as a sign of importance. Calm, dignity, and ease are also qualities a working life can cultivate.", "Tela\u015F\u0131 \xF6nem g\xF6stergesi saymak zorunda de\u011Filsin. \xC7al\u0131\u015Fan bir hayat\u0131n i\xE7inde sakinlik, vakar ve rahatl\u0131k da geli\u015Ftirilebilir.", true],
      ["The Gospel of Relaxation: example and imitation", "Your calm manner can offer someone else a model. A quieter way of meeting the day may travel farther than you notice.", "Sakin tavr\u0131n bir ba\u015Fkas\u0131na \xF6rnek olabilir. G\xFCn\xFC daha huzurlu kar\u015F\u0131lama bi\xE7imin, sen fark etmeden \xE7evrene yay\u0131labilir."],
      ["The Gospel of Relaxation: execution after decision", "Once you have considered your plan, let execution have your attention. Continually rehearsing the outcome can interrupt the work itself.", "Plan\u0131n\u0131 de\u011Ferlendirdikten sonra dikkatini uygulamaya ver. Sonucu zihninde durmadan prova etmek, yapmakta oldu\u011Fun i\u015Fi kesintiye u\u011Fratabilir.", true],
      ["The Gospel of Relaxation: preparation and spontaneity", "Know your subject well, then leave room for a natural response. Preparation can support spontaneity instead of making every moment rigid.", "Konuna iyi haz\u0131rlan, ard\u0131ndan do\u011Fal davranmaya yer b\u0131rak. Haz\u0131rl\u0131k, her an\u0131 kat\u0131la\u015Ft\u0131rmak yerine kendili\u011Findenli\u011Fi destekleyebilir.", true],
      ["On a Certain Blindness: limitations of outside judgment", "A life that looks unremarkable from outside may hold deep meaning within. Meet another person with curiosity before deciding what matters to them.", "D\u0131\u015Far\u0131dan s\u0131radan g\xF6r\xFCnen bir hayat, i\xE7inde derin anlamlar ta\u015F\u0131yabilir. Bir insan i\xE7in neyin de\u011Ferli oldu\u011Funa karar vermeden \xF6nce onu merakla dinle."],
      ["What Makes a Life Significant: heroism in common toil", "Courage is present in ordinary labor as well as famous adventures. Look with respect at the patient work that keeps daily life going.", "Cesaret, \xFCnl\xFC ser\xFCvenlerde oldu\u011Fu kadar s\u0131radan emekte de vard\u0131r. G\xFCnl\xFCk hayat\u0131 ayakta tutan sab\u0131rl\u0131 i\u015Fe sayg\u0131yla bak.", true],
      ["What Makes a Life Significant: ideals joined to endurance", "An ideal gains living significance when someone bears effort for it. Let what you value meet the patience and care of your actual day.", "Bir ideal, u\u011Frunda emek verildi\u011Finde ya\u015Fayan bir anlam kazan\u0131r. De\u011Fer verdi\u011Fin \u015Fey, g\xFCn\xFCn\xFCn sabr\u0131 ve \xF6zeniyle bulu\u015Fsun."],
      ["What Makes a Life Significant: meaning across circumstances", "Meaning can be alive in circumstances unlike your own. Remembering this can soften the fear and hostility with which people sometimes meet one another.", "Anlam, seninkinden farkl\u0131 ko\u015Fullarda da ya\u015Fayabilir. Bunu hat\u0131rlamak, insanlar\u0131n birbirine duydu\u011Fu korkuyu ve sertli\u011Fi yumu\u015Fatabilir.", true]
    ]),
    ...passages("Charles Darwin", "Autobiography", "Otobiyografi", "https://www.gutenberg.org/cache/epub/2010/pg2010-images.html", "science", [
      ["Work on the Origin: observations contrary to a theory", "Write down the observation that challenges your preferred explanation. Giving inconvenient evidence a place is a strength of honest inquiry.", "Sevdi\u011Fin a\xE7\u0131klamaya kar\u015F\u0131 \xE7\u0131kan g\xF6zlemi de yaz. Ho\u015Funa gitmeyen kan\u0131ta yer vermek, d\xFCr\xFCst ara\u015Ft\u0131rman\u0131n g\xFC\xE7l\xFC yan\u0131d\u0131r.", true],
      ["Work on the Origin: reducing the manuscript", "A smaller, carefully chosen account can carry an idea farther than an enormous one. Give your strongest evidence space to be understood.", "\xD6zenle se\xE7ilmi\u015F k\u0131sa bir anlat\u0131m, fikri dev bir metinden daha uza\u011Fa ta\u015F\u0131yabilir. En g\xFC\xE7l\xFC kan\u0131tlar\u0131n\u0131n anla\u015F\u0131lmas\u0131na alan a\xE7."],
      ["Work on the Origin: criticism and conscientious work", "When criticism hurts, remember the care you actually gave the work. Others\u2019 judgments do not erase the honest effort you know you made.", "Ele\u015Ftiri can\u0131n\u0131 ac\u0131tt\u0131\u011F\u0131nda i\u015Fine verdi\u011Fin ger\xE7ek \xF6zeni hat\u0131rla. Ba\u015Fkalar\u0131n\u0131n yarg\u0131lar\u0131, ortaya koydu\u011Funu bildi\u011Fin d\xFCr\xFCst eme\u011Fi silemez.", true],
      ["Work on the Origin: avoiding unproductive controversy", "Not every disagreement deserves your working hours. You may leave an unproductive controversy and return to the question you came to investigate.", "Her anla\u015Fmazl\u0131k \xE7al\u0131\u015Fma saatlerini hak etmez. Verimsiz bir tart\u0131\u015Fmadan ayr\u0131l\u0131p ara\u015Ft\u0131rmak i\xE7in yola \xE7\u0131kt\u0131\u011F\u0131n soruya d\xF6nebilirsin.", true],
      ["Orchids: a focused contribution", "Choose one part of a large subject and study it carefully. A well-made contribution can invite others to carry the inquiry beyond you.", "B\xFCy\xFCk bir konunun bir b\xF6l\xFCm\xFCn\xFC se\xE7 ve \xF6zenle incele. \u0130yi yap\u0131lm\u0131\u015F bir katk\u0131, ba\u015Fkalar\u0131n\u0131 ara\u015Ft\u0131rmay\u0131 daha ileri ta\u015F\u0131maya davet edebilir."],
      ["Earthworms: returning to an old question", "An old question may still deserve your attention. Returning to it after many years can connect today\u2019s curiosity with work you once began.", "Eski bir soru h\xE2l\xE2 dikkatini hak ediyor olabilir. Y\u0131llar sonra ona d\xF6nmek, bug\xFCnk\xFC merak\u0131n\u0131 bir zamanlar ba\u015Flad\u0131\u011F\u0131n i\u015Fe ba\u011Flayabilir."],
      ["Reflections on writing: difficulty and clarity", "Struggling to express an idea clearly can reveal a weakness in the reasoning. Revision is also a way of discovering what you truly mean.", "Bir fikri a\xE7\u0131k anlatmakta zorlanmak, d\xFC\u015F\xFCncedeki bir bo\u015Flu\u011Fu g\xF6sterebilir. D\xFCzeltmek, ger\xE7ekten ne demek istedi\u011Fini ke\u015Ffetmenin de bir yoludur."],
      ["Reflections on writing: rough draft before correction", "Let the rough draft be rough, then revise with care. Trying to perfect every sentence before writing it can obstruct the thought taking shape.", "\u0130lk tasla\u011F\u0131n kusurlu olmas\u0131na izin ver; sonra \xF6zenle d\xFCzelt. Her c\xFCmleyi yazmadan kusursuzla\u015Ft\u0131rmaya \xE7al\u0131\u015Fmak, d\xFC\u015F\xFCncenin bi\xE7imlenmesini engelleyebilir.", true],
      ["Reflections on writing: expanding an outline", "Begin a large piece of writing with a few guiding headings. Expand and rearrange them until the material finds a shape you can follow.", "B\xFCy\xFCk bir yaz\u0131ya birka\xE7 yol g\xF6sterici ba\u015Fl\u0131kla yakla\u015F. Malzeme izleyebilece\u011Fin bir bi\xE7im bulana kadar ba\u015Fl\u0131klar\u0131 geni\u015Flet ve yeniden d\xFCzenle."],
      ["Working methods: classified notes and indexes", "Keep your observations where you can find them again. A modest system of notes lets past effort become available for a new question.", "G\xF6zlemlerini yeniden bulabilece\u011Fin yerde sakla. M\xFCtevaz\u0131 bir not d\xFCzeni, ge\xE7mi\u015Fteki eme\u011Fini yeni bir soru i\xE7in kullan\u0131labilir k\u0131lar."],
      ["Reflections on aesthetic tastes", "Give poetry, music, or beauty an actual place in your life. An interest you value also needs occasions on which to be enjoyed.", "\u015Eiire, m\xFCzi\u011Fe ya da g\xFCzelli\u011Fe hayat\u0131nda ger\xE7ek bir yer a\xE7. De\u011Fer verdi\u011Fin bir ilginin, ya\u015Fanaca\u011F\u0131 zamanlara da ihtiyac\u0131 vard\u0131r."],
      ["Self-assessment: speed of understanding", "Understanding slowly need not keep you from useful work. Careful observation and sustained interest can matter alongside quickness of mind.", "Yava\u015F anlamak, de\u011Ferli i\u015F yapmana engel olmak zorunda de\u011Fildir. Dikkatli g\xF6zlem ve kal\u0131c\u0131 ilgi de zihnin h\u0131z\u0131 kadar \xF6nem ta\u015F\u0131yabilir.", true],
      ["Self-assessment: noticing what escapes attention", "Something easily overlooked may be worth examining closely. The desire to understand ordinary observations can sustain a meaningful scientific life.", "Kolayca g\xF6zden ka\xE7an bir \u015Fey, yak\u0131ndan incelenmeye de\u011Fer olabilir. S\u0131radan g\xF6zlemleri anlama iste\u011Fi, anlaml\u0131 bir bilim hayat\u0131n\u0131 besleyebilir."],
      ["Self-assessment: relinquishing a cherished hypothesis", "You may care deeply about an explanation and still release it when the evidence changes. Loyalty to inquiry can be stronger than attachment to an answer.", "Bir a\xE7\u0131klamay\u0131 \xE7ok sevip kan\u0131t de\u011Fi\u015Fti\u011Finde yine de b\u0131rakabilirsin. Ara\u015Ft\u0131rmaya ba\u011Fl\u0131l\u0131k, bir cevaba duydu\u011Fun ba\u011Fl\u0131l\u0131ktan daha g\xFC\xE7l\xFC olabilir.", true],
      ["Self-assessment: excessive skepticism can deter experiments", "Let caution examine a possibility without closing the door too early. Some useful experiments are lost when doubt prevents the attempt altogether.", "Temkin, bir olas\u0131l\u0131\u011F\u0131 incelesin ama kap\u0131y\u0131 erkenden kapatmas\u0131n. Ku\u015Fku denemeyi t\xFCm\xFCyle \xF6nledi\u011Finde i\u015Fe yarayabilecek ara\u015Ft\u0131rmalar da kaybolabilir.", true]
    ]),
    ...passages("Jane Addams", "Democracy and Social Ethics", "Demokrasi ve Toplumsal Etik", "https://www.gutenberg.org/files/15487/15487-h/15487-h.htm", "society", [
      ["I: a contemporary standard of responsibility", "What counted as enough yesterday may not meet today\u2019s responsibility. Let your sense of duty grow with your understanding of other people\u2019s lives.", "D\xFCn yeterli olan, bug\xFCn\xFCn sorumlulu\u011Funa yetmeyebilir. G\xF6rev anlay\u0131\u015F\u0131n, ba\u015Fkalar\u0131n\u0131n hayat\u0131n\u0131 anlad\u0131k\xE7a b\xFCy\xFCs\xFCn."],
      ["I: social obligation beyond the household", "Care can reach beyond the people already close to you. Notice one human need outside your familiar circle and consider your part in answering it.", "\xD6zenin, zaten yak\u0131n oldu\u011Fun insanlar\u0131n \xF6tesine uzanabilir. Al\u0131\u015Ft\u0131\u011F\u0131n \xE7evrenin d\u0131\u015F\u0131ndaki bir ihtiyac\u0131 fark et; kar\u015F\u0131lanmas\u0131ndaki pay\u0131n\u0131 d\xFC\u015F\xFCn."],
      ["I: shared experience as a source of social motive", "If you want a wider purpose, seek a wider acquaintance with life. Shared experience can give responsibility a warmth that abstract rules cannot supply.", "Daha geni\u015F bir ama\xE7 ar\u0131yorsan hayat\u0131 daha geni\u015F tan\u0131. Payla\u015F\u0131lan deneyim, sorumlulu\u011Fa soyut kurallar\u0131n veremedi\u011Fi bir s\u0131cakl\u0131k katabilir."],
      ["I: processes as well as results", "A generous aim also needs a fitting method. Pay attention to how you help, because a good intention alone does not settle the outcome.", "C\xF6mert bir ama\xE7, uygun bir y\xF6ntem de ister. Nas\u0131l yard\u0131m etti\u011Fine dikkat et; iyi niyet tek ba\u015F\u0131na sonucu belirlemez."],
      ["I: seeing the size of one another\u2019s burdens", "Walk close enough to others to see what they carry. Understanding a burden begins with leaving the comfort of a distant judgment.", "\u0130nsanlar\u0131n ta\u015F\u0131d\u0131\u011F\u0131 y\xFCk\xFC g\xF6rebilecek kadar yanlar\u0131na yakla\u015F. Bir y\xFCk\xFC anlamak, uzaktan h\xFCk\xFCm vermenin rahatl\u0131\u011F\u0131ndan \xE7\u0131kmakla ba\u015Flar."],
      ["I: experience as a corrective to social opinions", "Let real contact with people\u2019s lives correct your opinions about them. Even a modest effort to help is judged more wisely from up close.", "\u0130nsanlar\u0131n hayat\u0131yla ger\xE7ek temas, onlar hakk\u0131ndaki g\xF6r\xFC\u015Flerini d\xFCzeltsin. Yard\u0131m i\xE7in g\xF6sterilen m\xFCtevaz\u0131 bir \xE7aba bile yak\u0131ndan bak\u0131nca daha isabetli de\u011Ferlendirilir."],
      ["I: imagination and understanding another\u2019s experience", "Use imagination to approach an experience you have not lived. The ability to picture another life can soften the hardness of your response.", "Ya\u015Famad\u0131\u011F\u0131n bir deneyime yakla\u015Fmak i\xE7in hayal g\xFCc\xFCn\xFC kullan. Ba\u015Fkas\u0131n\u0131n hayat\u0131n\u0131 zihninde canland\u0131rabilmek, tepkindeki sertli\u011Fi yumu\u015Fatabilir."],
      ["I: narrow circles and the scope of ethics", "Keep your circle from becoming a wall. Respect grows richer when it makes room for people unlike those you already understand.", "\xC7evrenin bir duvara d\xF6n\xFC\u015Fmesine izin verme. Sayg\u0131, zaten anlad\u0131\u011F\u0131n insanlardan farkl\u0131 olanlara da yer a\xE7t\u0131\u011F\u0131nda zenginle\u015Fir."],
      ["II: charitable effort and unequal standards", "Help without treating good fortune as proof of greater worth. A person\u2019s need does not place their dignity below yours.", "\u0130yi ko\u015Fullarda ya\u015Famay\u0131 \xFCst\xFCnl\xFCk kan\u0131t\u0131 saymadan yard\u0131m et. Bir insan\u0131n ihtiya\xE7 i\xE7inde olmas\u0131, onurunu seninkinden a\u015Fa\u011F\u0131ya koymaz."],
      ["VI: education grounded in actual work", "Your everyday work contains material for learning. Ask what knowledge would give the actions you already perform a larger meaning.", "Her g\xFCn yapt\u0131\u011F\u0131n i\u015Fte \xF6\u011Frenilecek malzeme vard\u0131r. Zaten yapt\u0131\u011F\u0131n davran\u0131\u015Flara hangi bilginin daha geni\u015F anlam kataca\u011F\u0131n\u0131 sor."],
      ["VI: tools as a social inheritance", "The tools in your hands carry earlier people\u2019s work. Understanding that inheritance can connect your daily task to a longer human story.", "Elindeki ara\xE7lar, senden \xF6nceki insanlar\u0131n eme\u011Fini ta\u015F\u0131r. Bu miras\u0131 anlamak, g\xFCnl\xFCk i\u015Fini daha uzun bir insanl\u0131k hik\xE2yesine ba\u011Flayabilir."],
      ["VI: road builders and a shared purpose", "People doing different parts of a task need to understand the whole. Shared purpose grows when everyone can see where the work is going.", "Bir i\u015Fin farkl\u0131 par\xE7alar\u0131n\u0131 yapanlar b\xFCt\xFCn\xFC de anlamaya ihtiya\xE7 duyar. Herkes i\u015Fin nereye gitti\u011Fini g\xF6rd\xFC\u011F\xFCnde ortak ama\xE7 g\xFC\xE7lenir."],
      ["VI: education as an offset to over-specialization", "A narrow occupation need not become a narrow life. Give yourself knowledge that helps you participate as a thoughtful member of society.", "Dar bir uzmanl\u0131k, dar bir hayata d\xF6n\xFC\u015Fmek zorunda de\u011Fildir. Topluma bilin\xE7li bi\xE7imde kat\u0131lman\u0131 sa\u011Flayan bilgilere kendinde yer a\xE7."],
      ["VII: interconnected ethical development", "The moral life of a community connects its different parts. What we excuse for ourselves can shape what becomes acceptable around us.", "Bir toplumun ahlaki hayat\u0131, farkl\u0131 kesimlerini birbirine ba\u011Flar. Kendimiz i\xE7in mazur g\xF6rd\xFCklerimiz, \xE7evremizde kabul edilir olan\u0131 da bi\xE7imlendirebilir."],
      ["VII: the educative power of responsibility", "Trust people with a meaningful share of responsibility. Taking part in meeting a real need can itself become an education.", "\u0130nsanlara anlaml\u0131 bir sorumluluk pay\u0131 ver. Ger\xE7ek bir ihtiyac\u0131n kar\u015F\u0131lanmas\u0131na kat\u0131lmak, ba\u015Fl\u0131 ba\u015F\u0131na bir \xF6\u011Frenme deneyimi olabilir."]
    ]),
    ...passages("W. E. B. Du Bois", "The Souls of Black Folk", "Siyah Halk\u0131n Ruhlar\u0131", "https://www.gutenberg.org/files/408/408-h/408-h.htm", "society", [
      ["I: double consciousness and the wish for an undivided self", "Do not let a contemptuous gaze become your only measure of yourself. A person deserves room to live without disowning their own inheritance.", "Seni k\xFC\xE7\xFCmseyen bak\u0131\u015F, kendini \xF6l\xE7t\xFC\u011F\xFCn tek \xF6l\xE7\xFC olmas\u0131n. \u0130nsan, kendi k\xF6klerini ink\xE2r etmeden ya\u015Fayabilece\u011Fi bir alan\u0131 hak eder.", true],
      ["I: work, culture, and liberty together", "Work, learning, and freedom can support one another. A fuller life need not sacrifice the growth of the mind to the demands of earning.", "Emek, \xF6\u011Frenme ve \xF6zg\xFCrl\xFCk birbirini destekleyebilir. Daha b\xFCt\xFCnl\xFCkl\xFC bir hayat, ge\xE7im u\u011Fruna zihnin geli\u015Fiminden vazge\xE7mek zorunda de\u011Fildir."],
      ["V: foundations of knowledge", "Build learning on foundations deep enough to support it. Haste in laying those foundations can leave an impressive name standing over fragile work.", "\xD6\u011Frenmeni ta\u015F\u0131yacak kadar derin temeller kur. Temeli aceleye getirmek, g\xF6steri\u015Fli bir ad\u0131n alt\u0131nda k\u0131r\u0131lgan bir i\u015F b\u0131rakabilir."],
      ["V: the university and real life", "Let growing knowledge meet the problems of actual life. Education gains purpose when understanding helps us respond more wisely to the world around us.", "Geli\u015Fen bilgi, ger\xE7ek hayat\u0131n sorunlar\u0131yla bulu\u015Fsun. Anlamak, \xE7evremize daha bilin\xE7li kar\u015F\u0131l\u0131k vermemizi sa\u011Flad\u0131\u011F\u0131nda e\u011Fitim ama\xE7 kazan\u0131r."],
      ["VI: teachers and the contact of living souls", "A teacher gives more than information when they offer sincere companionship. Learning can grow through the human connection of working and hoping together.", "Bir \xF6\u011Fretmen i\xE7ten bir yak\u0131nl\u0131k sundu\u011Funda bilgiden fazlas\u0131n\u0131 verir. \xD6\u011Frenme, birlikte \xE7al\u0131\u015Fman\u0131n ve umut etmenin insani ba\u011F\u0131yla b\xFCy\xFCyebilir."],
      ["VI: respect for the sovereign human soul", "Make room for a person to think and work in their own way. An unfamiliar inner life may offer everyone a perspective they lacked.", "Bir insan\u0131n kendi yolunca d\xFC\u015F\xFCn\xFCp \xE7al\u0131\u015Fmas\u0131na yer a\xE7. Tan\u0131mad\u0131\u011F\u0131n bir i\xE7 d\xFCnya, herkese eksik kalan bir bak\u0131\u015F sunabilir."],
      ["VI: cooperative striving toward a larger civilization", "Past wrongs deserve recognition, while the future also needs our effort. A shared commitment to a larger human life can give that effort direction.", "Ge\xE7mi\u015Fteki haks\u0131zl\u0131klar g\xF6r\xFClmeyi hak eder; gelecek de eme\u011Fimizi bekler. Daha insanca bir hayata ortak ba\u011Fl\u0131l\u0131k, bu eme\u011Fe y\xF6n verebilir."],
      ["XIV: hope within the Sorrow Songs", "Sorrow and hope can inhabit the same song. Even wounded voices can keep alive a faith that people will one day be judged by who they are, not how they look.", "H\xFCz\xFCn ve umut ayn\u0131 ezgide ya\u015Fayabilir. Yaral\u0131 sesler de insanlar\u0131n bir g\xFCn g\xF6r\xFCn\xFC\u015F\xFCyle de\u011Fil, \xF6z\xFCyle de\u011Ferlendirilece\u011Fine duyulan inanc\u0131 diri tutabilir.", true],
      ["XIV: uncertainty about the limits of human development", "Do not turn today\u2019s unequal opportunities into a verdict on human possibility. We do not know enough to declare another people\u2019s future closed.", "Bug\xFCn\xFCn e\u015Fitsiz f\u0131rsatlar\u0131n\u0131 insan\u0131n imk\xE2nlar\u0131 hakk\u0131nda son h\xFCkme \xE7evirme. Ba\u015Fka insanlar\u0131n gelece\u011Fini kapatacak kadar \xE7ok \u015Fey bilmiyoruz.", true],
      ["XIV: the gifts of story, labor, and spirit", "A community contributes through its stories, its labor, and its moral voice. Recognizing those gifts is part of seeing one another fully.", "Bir topluluk hik\xE2yeleriyle, eme\u011Fiyle ve ahlaki sesiyle katk\u0131da bulunur. Bu arma\u011Fanlar\u0131 tan\u0131mak, birbirimizi b\xFCt\xFCn\xFCyle g\xF6rmenin bir par\xE7as\u0131d\u0131r."]
    ]),
    ...passages("Michael Faraday", "The Chemical History of a Candle", "Bir Mumun Kimyasal Tarihi", "https://www.gutenberg.org/cache/epub/14474/pg14474-images.html", "science", [
      ["Lecture I: a candle as an entrance to natural philosophy", "An ordinary object can open a serious inquiry. You do not always need a novel subject to discover how richly the world is connected.", "S\u0131radan bir nesne, ciddi bir ara\u015Ft\u0131rman\u0131n kap\u0131s\u0131n\u0131 a\xE7abilir. D\xFCnyan\u0131n zengin ba\u011Flant\u0131lar\u0131n\u0131 ke\u015Ffetmek i\xE7in her zaman yepyeni bir konu gerekmez."],
      ["Lecture I: speaking familiarly to young listeners", "Knowledge can speak simply without losing its seriousness. Meeting a learner where they are is a generous part of explaining well.", "Bilgi, ciddiyetini kaybetmeden sade konu\u015Fabilir. \xD6\u011Frenenin bulundu\u011Fu yere yakla\u015Fmak, iyi anlatman\u0131n c\xF6mert bir par\xE7as\u0131d\u0131r."],
      ["Lecture I: irregular candle burning as instruction", "An unexpected result deserves investigation before dismissal. The irregular behavior of a simple candle can reveal something a perfect performance would hide.", "Beklenmedik sonu\xE7, g\xF6zden \xE7\u0131kar\u0131lmadan \xF6nce incelenmeyi hak eder. Basit bir mumun d\xFCzensiz yan\u0131\u015F\u0131 bile kusursuz g\xF6r\xFCn\xFCm\xFCn gizledi\u011Fi bir \u015Feyi g\xF6sterebilir."],
      ["Lecture I: asking why a new result occurs", "When something new happens, turn surprise into a question about its cause. Let wonder lead you toward an explanation you can examine.", "Yeni bir \u015Fey oldu\u011Funda \u015Fa\u015Fk\u0131nl\u0131\u011F\u0131n\u0131 nedenini ara\u015Ft\u0131ran bir soruya \xE7evir. Hayretin, inceleyebilece\u011Fin bir a\xE7\u0131klamaya do\u011Fru seni g\xF6t\xFCrs\xFCn."],
      ["Lecture I: the name of capillary attraction", "An unfamiliar scientific name need not stop you. Look at the action it describes; understanding a phenomenon matters more than being impressed by its label.", "Yabanc\u0131 bir bilimsel ad seni durdurmas\u0131n. Anlatt\u0131\u011F\u0131 i\u015Fleyi\u015Fe bak; olay\u0131 anlamak, etiketinden etkilenmekten daha de\u011Ferlidir.", true],
      ["Lecture I: rapidly changing shapes of flame", "What appears to happen all at once may be a quick succession of events. Patient observation can distinguish what a first glance blends together.", "Ayn\u0131 anda oluyor gibi g\xF6r\xFCnen \u015Fey, h\u0131zla art arda geli\u015Fen olaylar olabilir. Sab\u0131rl\u0131 g\xF6zlem, ilk bak\u0131\u015F\u0131n birle\u015Ftirdi\u011Fini ay\u0131rt edebilir."],
      ["Lecture II: following the products of combustion", "Ask where the material goes when a familiar change occurs. Following the process can turn a disappearing candle into a lesson in careful explanation.", "Tan\u0131d\u0131k bir de\u011Fi\u015Fimde maddenin nereye gitti\u011Fini sor. S\xFCreci izlemek, t\xFCkenen bir mumu bile dikkatli a\xE7\u0131klama kurman\u0131n dersine \xE7evirebilir."],
      ["Lecture V: weighing air and checking the balance again", "Give a surprising measurement a check you can repeat. Returning the apparatus to its starting condition helps show what your experiment has established.", "\u015Ea\u015F\u0131rt\u0131c\u0131 bir \xF6l\xE7\xFCm\xFC tekrarlanabilir bi\xE7imde denetle. D\xFCzene\u011Fi ba\u015Flang\u0131\xE7 ko\u015Fuluna d\xF6nd\xFCrmek, deneyinin neyi ortaya koydu\u011Funu anlamaya yard\u0131m eder."],
      ["Lecture VI: simplifying the steps of demonstration", "Explain a difficult process through steps that can be followed. A simple demonstration can make the reasoning visible instead of asking for blind acceptance.", "Zor bir s\xFCreci izlenebilir ad\u0131mlarla a\xE7\u0131kla. Sade bir g\xF6sterim, k\xF6r\xFC k\xF6r\xFCne kabul istemek yerine d\xFC\u015F\xFCncenin nas\u0131l ilerledi\u011Fini g\xF6r\xFCn\xFCr k\u0131labilir."],
      ["Lecture VI: relations between animal and plant life", "Attend to the connections between forms of life. The relations among air, plants, and animals remind us that our existence is not isolated.", "Canl\u0131l\u0131k bi\xE7imleri aras\u0131ndaki ba\u011Flara dikkat et. Hava, bitkiler ve hayvanlar aras\u0131ndaki ili\u015Fkiler, varl\u0131\u011F\u0131m\u0131z\u0131n tek ba\u015F\u0131na olmad\u0131\u011F\u0131n\u0131 hat\u0131rlat\u0131r."]
    ]),
    ...passages("Henri Poincar\xE9", "The Foundations of Science", "Bilimin Temelleri", "https://www.gutenberg.org/files/39713/39713-h/39713-h.htm", "science", [
      ["Science and Method, Introduction: finite time and choice", "You cannot observe everything, and you do not have to. Choosing a worthwhile question is part of doing careful work with the time available.", "Her \u015Feyi g\xF6zlemleyemezsin; buna mecbur da de\u011Filsin. De\u011Ferli bir soru se\xE7mek, elindeki zamanla \xF6zenli \xE7al\u0131\u015Fman\u0131n bir par\xE7as\u0131d\u0131r."],
      ["Science and Method, Introduction: errors of instruments and senses", "Remember that observation has limits. Allowing for the imperfections of your tools makes your conclusions more careful, not your work less valuable.", "G\xF6zlemin s\u0131n\u0131rlar\u0131 oldu\u011Funu hat\u0131rla. Ara\xE7lar\u0131n\u0131n kusurlar\u0131n\u0131 hesaba katmak, i\u015Fini de\u011Fersizle\u015Ftirmez; sonu\xE7lar\u0131n\u0131 daha dikkatli kurman\u0131 sa\u011Flar."],
      ["Science and Method, Introduction: historical development of new ideas", "An unfamiliar idea can become less intimidating when you trace how it arose. Its history may supply the steps that a finished explanation leaves hidden.", "Yabanc\u0131 bir fikir, nas\u0131l do\u011Fdu\u011Funu izledi\u011Finde daha az \xFCrk\xFCt\xFCc\xFC gelebilir. Tarihi, haz\u0131r a\xE7\u0131klaman\u0131n gizledi\u011Fi ara ad\u0131mlar\u0131 g\xF6r\xFCn\xFCr k\u0131labilir.", true],
      ["Science and Method, Introduction: geodesy and a new decimal", "A small gain in accuracy may contain enormous care. Respect the patient work behind the detail that looks insignificant from a distance.", "Do\u011Frulukta k\xFC\xE7\xFCk bir art\u0131\u015F, b\xFCy\xFCk bir \xF6zen ta\u015F\u0131yabilir. Uzaktan \xF6nemsiz g\xF6r\xFCnen ayr\u0131nt\u0131n\u0131n arkas\u0131ndaki sab\u0131rl\u0131 eme\u011Fe sayg\u0131 duy."],
      ["Science and Method, I.1: discovery before practical application", "A question need not promise an immediate reward to deserve study. Knowledge pursued with curiosity can later make unforeseen work possible.", "Bir soru, ara\u015Ft\u0131r\u0131lmaya de\u011Fer olmak i\xE7in hemen \xF6d\xFCl vaat etmek zorunda de\u011Fildir. Merakla aranan bilgi, sonradan \xF6ng\xF6r\xFClmemi\u015F i\u015Fleri m\xFCmk\xFCn k\u0131labilir."],
      ["Science and Method, I.1: facts that can serve repeatedly", "Look for an understanding that can help you more than once. Recognizing a recurring relation gives one experience value beyond its original setting.", "Sana birden fazla kez yard\u0131m edebilecek bir anlay\u0131\u015F ara. Tekrarlanan bir ili\u015Fkiyi fark etmek, deneyime ilk ba\u011Flam\u0131n\u0131n \xF6tesinde de\u011Fer kazand\u0131r\u0131r."],
      ["Science and Method, I.1: exceptions after a rule is established", "Once a pattern seems familiar, notice the case that does not fit. An exception may teach what another confirmation can no longer show.", "Bir \xF6r\xFCnt\xFC tan\u0131d\u0131k hale geldi\u011Finde ona uymayan durumu fark et. Bir istisna, yeni bir do\u011Frulaman\u0131n art\u0131k g\xF6steremedi\u011Fini \xF6\u011Fretebilir."],
      ["Science and Method, I.1: distant phenomena illuminate nearby ones", "Studying something far from your immediate concerns can sharpen your view of home. A distant example sometimes makes a nearby difficulty clearer.", "G\xFCnl\xFCk ilgilerinden uzak bir konuyu incelemek, yak\u0131n\u0131na bak\u0131\u015F\u0131n\u0131 keskinle\u015Ftirebilir. Uzak bir \xF6rnek, bazen yan\u0131 ba\u015F\u0131ndaki g\xFC\xE7l\xFC\u011F\xFC daha anla\u015F\u0131l\u0131r k\u0131lar."],
      ["Science and Method, I.1: likeness beneath apparent divergence", "Look for a relationship beneath the differences. Things that first seem unrelated can reveal a common structure when considered with care.", "Farkl\u0131l\u0131klar\u0131n alt\u0131nda bir ili\u015Fki ara. \u0130lk bak\u0131\u015Fta ilgisiz g\xF6r\xFCnen \u015Feyler, \xF6zenle d\xFC\u015F\xFCn\xFCld\xFC\u011F\xFCnde ortak bir yap\u0131 g\xF6sterebilir."],
      ["Science and Hypothesis, IX: facts and the house of science", "Collected facts need an intelligible arrangement. As stones need structure to become a house, information needs relationships to become understanding.", "Toplanan bilgiler anla\u015F\u0131l\u0131r bir d\xFCzene ihtiya\xE7 duyar. Ta\u015Flar\u0131n eve d\xF6n\xFC\u015Fmek i\xE7in yap\u0131ya ihtiyac\u0131 oldu\u011Fu gibi, bilgi de anlay\u0131\u015Fa d\xF6n\xFC\u015Fmek i\xE7in ba\u011Flara ihtiya\xE7 duyar."],
      ["Science and Method, I.1: delight in the beauty of nature", "Let the beauty of an intelligible world sustain your curiosity. The pleasure of understanding can accompany work whose rewards are not immediately visible.", "Anla\u015F\u0131labilir bir d\xFCnyan\u0131n g\xFCzelli\u011Fi merak\u0131n\u0131 beslesin. Anlaman\u0131n sevinci, kar\u015F\u0131l\u0131\u011F\u0131 hemen g\xF6r\xFCnmeyen bir \xE7al\u0131\u015Fmaya da e\u015Flik edebilir."],
      ["Science and Method, I.3: invention as discernment and choice", "Creating involves choosing among possibilities, not simply producing more of them. Give attention to the combination that reveals something useful.", "Yaratmak, yaln\u0131zca daha \xE7ok olas\u0131l\u0131k \xFCretmek de\u011Fil, aralar\u0131ndan se\xE7im yapmakt\u0131r. \u0130\u015Fe yarayan bir \u015Feyi a\xE7\u0131\u011Fa \xE7\u0131karan birle\u015Fime dikkat ver."],
      ["Science and Method, I.3: fertile combinations from distant domains", "A fruitful idea may join elements from distant fields. Explore the connection carefully; difference is promising when it reveals a real relationship.", "Verimli bir fikir, uzak alanlardan gelen \xF6\u011Feleri birle\u015Ftirebilir. Ba\u011Flant\u0131y\u0131 dikkatle ara\u015Ft\u0131r; farkl\u0131l\u0131k, ger\xE7ek bir ili\u015Fkiyi g\xF6sterdi\u011Finde umut vericidir."],
      ["Science and Method, I.3: fifteen days without a result", "Several days without a result need not settle the value of an inquiry. Difficult discovery can include long stretches with little visible progress.", "G\xFCnlerce sonu\xE7 alamamak, ara\u015Ft\u0131rman\u0131n de\u011Ferini kesinle\u015Ftirmez. Zor bir ke\u015Ffin i\xE7inde g\xF6r\xFCn\xFCr ilerlemenin az oldu\u011Fu uzun d\xF6nemler bulunabilir.", true],
      ["Science and Method, I.3: the seaside interruption", "After sustained effort, a change of surroundings can make room for a new connection. Returning with a different perspective is still part of inquiry.", "Yo\u011Fun \xE7aban\u0131n ard\u0131ndan ortam de\u011Fi\u015Fikli\u011Fi, yeni bir ba\u011Flant\u0131ya yer a\xE7abilir. Farkl\u0131 bir bak\u0131\u015Fla geri d\xF6nmek de ara\u015Ft\u0131rman\u0131n par\xE7as\u0131d\u0131r."],
      ["Science and Method, I.3: effort clarifying the remaining difficulty", "An attempt may be useful because it shows exactly what remains difficult. A clearer obstacle is itself information for the next stage of work.", "Bir giri\u015Fim, neyin h\xE2l\xE2 zor oldu\u011Funu g\xF6sterdi\u011Fi i\xE7in yararl\u0131 olabilir. Engeli daha a\xE7\u0131k g\xF6rmek, \xE7al\u0131\u015Fman\u0131n sonraki a\u015Famas\u0131 i\xE7in bilgidir.", true],
      ["Science and Method, I.3: preparation preceding inspiration", "An apparently sudden insight may have a long preparation behind it. Do not discount earlier effort merely because its usefulness was hidden at the time.", "Ans\u0131z\u0131n gelen bir kavray\u0131\u015F\u0131n arkas\u0131nda uzun bir haz\u0131rl\u0131k olabilir. Yarar\u0131 o s\u0131rada g\xF6r\xFCnmedi diye \xF6nceki eme\u011Fini de\u011Fersiz sayma."],
      ["Science and Method, I.3: verification after certainty", "A powerful feeling of certainty is still worth checking. Verification can protect a promising idea from the mistakes that excitement overlooks.", "G\xFC\xE7l\xFC bir kesinlik hissi de denetlenmeye de\u011Fer. Do\u011Frulama, umut veren fikri heyecan\u0131n g\xF6zden ka\xE7\u0131rd\u0131\u011F\u0131 hatalardan koruyabilir."],
      ["Science and Method, I.3: deliberate work after inspiration", "Give an insight the patient work of arrangement and explanation. The moment of discovery is followed by the task of making it understandable.", "Bir kavray\u0131\u015Fa d\xFCzenleme ve a\xE7\u0131klaman\u0131n sab\u0131rl\u0131 eme\u011Fini ver. Ke\u015Fif an\u0131n\u0131, onu anla\u015F\u0131l\u0131r k\u0131lma g\xF6revi izler."],
      ["Science and Method, I.3: harmony as an aid to the mind", "Seek an arrangement in which the whole and its details can be grasped together. Clarity can be both useful and beautiful.", "B\xFCt\xFCn\xFCn ve ayr\u0131nt\u0131lar\u0131n birlikte kavranabildi\u011Fi bir d\xFCzen ara. A\xE7\u0131kl\u0131k, ayn\u0131 anda hem yararl\u0131 hem g\xFCzel olabilir."]
    ]),
    ...passages("John Stuart Mill", "On Liberty", "\xD6zg\xFCrl\xFCk \xDCzerine", "https://www.gutenberg.org/files/34901/34901-h/34901-h.htm", "society", [
      ["II: hearing an opposing case from its advocates", "Hear a different view from someone who sincerely holds it. Understanding their strongest reasons can deepen your understanding of your own.", "Farkl\u0131 bir g\xF6r\xFC\u015F\xFC, ona i\xE7tenlikle inanan birinden dinle. En g\xFC\xE7l\xFC gerek\xE7elerini anlamak, kendi d\xFC\u015F\xFCnceni kavray\u0131\u015F\u0131n\u0131 da derinle\u015Ftirebilir."],
      ["II: living truth rather than unexamined assent", "Keep an important conviction alive by understanding its reasons. Repeating familiar words is not the same as knowing why they matter.", "\xD6nemli bir kanaatini gerek\xE7elerini anlayarak canl\u0131 tut. Tan\u0131d\u0131k s\xF6zleri tekrarlamak, neden \xF6nemli olduklar\u0131n\u0131 bilmekle ayn\u0131 \u015Fey de\u011Fildir."],
      ["II: partial truths in opposing opinions", "An opposing opinion may carry a part of the truth you missed. You can learn from that part without accepting everything around it.", "Kar\u015F\u0131t bir g\xF6r\xFC\u015F, g\xF6zden ka\xE7\u0131rd\u0131\u011F\u0131n bir do\u011Fru par\xE7as\u0131n\u0131 ta\u015F\u0131yabilir. \xC7evresindeki her \u015Feyi kabul etmeden o par\xE7adan \xF6\u011Frenebilirsin."],
      ["II: correcting and completing one\u2019s opinion", "The habit of correcting a judgment can make it more trustworthy. You do not need to pretend infallibility in order to think responsibly.", "Bir yarg\u0131y\u0131 d\xFCzeltme al\u0131\u015Fkanl\u0131\u011F\u0131, onu daha g\xFCvenilir k\u0131labilir. Sorumlulukla d\xFC\u015F\xFCnmek i\xE7in yan\u0131lmazm\u0131\u015F gibi davranman gerekmez.", true],
      ["II: opportunity for truth to reach us", "Leave a channel through which a better explanation can reach you. Keeping inquiry open is a practical form of intellectual humility.", "Daha iyi bir a\xE7\u0131klaman\u0131n sana ula\u015Fabilece\u011Fi bir yol a\xE7\u0131k b\u0131rak. Ara\u015Ft\u0131rmay\u0131 a\xE7\u0131k tutmak, d\xFC\u015F\xFCncede al\xE7akg\xF6n\xFCll\xFCl\xFC\u011F\xFCn somut bir bi\xE7imidir."],
      ["III: experiments in living", "Different ways of living can teach us what human life allows. Give a harmless unfamiliar choice room to show what it can become.", "Farkl\u0131 ya\u015Fama bi\xE7imleri, insan hayat\u0131n\u0131n imk\xE2nlar\u0131n\u0131 \xF6\u011Fretebilir. Zarar\u0131 olmayan al\u0131\u015F\u0131lmad\u0131k bir se\xE7ime, neye d\xF6n\xFC\u015Febilece\u011Fini g\xF6stermesi i\xE7in alan a\xE7.", true],
      ["III: interpreting inherited experience", "Learn from earlier experience while asking whether it fits your circumstances. Respect for a tradition can include thoughtful judgment about its application.", "\xD6nceki deneyimlerden \xF6\u011Frenirken kendi ko\u015Fullar\u0131na uyup uymad\u0131\u011F\u0131n\u0131 sor. Bir gelene\u011Fe sayg\u0131, onun uygulan\u0131\u015F\u0131n\u0131 bilin\xE7le de\u011Ferlendirmeyi de i\xE7erebilir."],
      ["III: choice exercises human faculties", "Choosing deliberately exercises capacities that imitation leaves unused. Bring perception, judgment, and your own considered preference into a decision that concerns your life.", "Bilin\xE7li se\xE7im, taklidin kullanmad\u0131\u011F\u0131 yetileri \xE7al\u0131\u015Ft\u0131r\u0131r. Hayat\u0131n\u0131 ilgilendiren bir karara g\xF6zlemini, de\u011Ferlendirmelerini ve d\xFC\u015F\xFCn\xFClm\xFC\u015F tercihini kat."],
      ["III: choosing one\u2019s own plan of life", "Give your life plan your own serious consideration. Observing, weighing, deciding, and holding to a considered choice are all parts of becoming capable.", "Hayat plan\u0131n\u0131 kendi ciddi de\u011Ferlendirmenle kur. G\xF6zlemlemek, tartmak, karar vermek ve d\xFC\u015F\xFCn\xFClm\xFC\u015F se\xE7imine ba\u011Fl\u0131 kalmak, yetkinle\u015Fmenin par\xE7alar\u0131d\u0131r."],
      ["III: human nature as a growing tree", "Your development need not fit a single mechanical pattern. A living person, like a growing tree, needs room to unfold in more than one direction.", "Geli\u015Fimin tek bir mekanik kal\u0131ba s\u0131\u011Fmak zorunda de\u011Fildir. Ya\u015Fayan insan, b\xFCy\xFCyen bir a\u011Fa\xE7 gibi farkl\u0131 y\xF6nlerde geli\u015Fecek alana ihtiya\xE7 duyar."],
      ["III: strong feeling and cultivated conscience", "Strong feelings can become material for a love of goodness and for self-command. Cultivating them thoughtfully matters more than treating all intensity as a fault.", "G\xFC\xE7l\xFC duygular, iyili\u011Fe duyulan sevgiye ve \xF6zdenetime kaynak olabilir. Her yo\u011Funlu\u011Fu kusur saymak yerine duygular\u0131 bilin\xE7le geli\u015Ftirmek \xF6nemlidir."],
      ["III: choosing under the pressure of conformity", "Alongside asking what people expect, ask what lets your better capacities grow. Fear of appearing different need not answer every personal question for you.", "\u0130nsanlar\u0131n beklentisini sorarken iyi yanlar\u0131n\u0131 neyin geli\u015Ftirdi\u011Fini de sor. Farkl\u0131 g\xF6r\xFCnme korkusu, her ki\u015Fisel soruyu senin yerine cevaplamas\u0131n.", true],
      ["III: originality opening people\u2019s eyes", "An original contribution may reveal a possibility others could not yet see. Its unfamiliarity alone is not evidence that it has no value.", "\xD6zg\xFCn bir katk\u0131, ba\u015Fkalar\u0131n\u0131n hen\xFCz g\xF6remedi\u011Fi bir imk\xE2n\u0131 g\xF6sterebilir. Al\u0131\u015F\u0131lmad\u0131k olmas\u0131, tek ba\u015F\u0131na de\u011Fersizli\u011Finin kan\u0131t\u0131 de\u011Fildir.", true],
      ["III: pointing out a way without compelling others", "You can offer a new direction without forcing others to follow. A useful example respects the freedom of the people it hopes to influence.", "Ba\u015Fkalar\u0131n\u0131 zorlamadan yeni bir y\xF6n g\xF6sterebilirsin. Yararl\u0131 bir \xF6rnek, etkilemeyi umdu\u011Fu insanlar\u0131n \xF6zg\xFCrl\xFC\u011F\xFCne sayg\u0131 duyar."],
      ["III: different conditions for different people\u2019s development", "The conditions that help another person flourish may not suit you. Take your own needs seriously when choosing a sustainable way of living.", "Bir ba\u015Fkas\u0131n\u0131 geli\u015Ftiren ko\u015Fullar sana uymayabilir. S\xFCrd\xFCrebilece\u011Fin bir ya\u015Fama bi\xE7imi se\xE7erken kendi ihtiya\xE7lar\u0131n\u0131 da ciddiye al."]
    ]),
    ...passages("Peter Kropotkin", "Mutual Aid", "Kar\u015F\u0131l\u0131kl\u0131 Yard\u0131mla\u015Fma", "https://www.gutenberg.org/cache/epub/4341/pg4341-images.html", "society", [
      ["VIII: associations for study and research", "A shared interest can become a small community of learning. Gathering to study is also a way of making mutual support part of ordinary life.", "Ortak bir ilgi, k\xFC\xE7\xFCk bir \xF6\u011Frenme toplulu\u011Funa d\xF6n\xFC\u015Febilir. \xC7al\u0131\u015Fmak i\xE7in bulu\u015Fmak, kar\u015F\u0131l\u0131kl\u0131 deste\u011Fi g\xFCnl\xFCk hayat\u0131n par\xE7as\u0131 yapman\u0131n da yoludur."],
      ["VIII: clubs for the shared enjoyment of life", "Shared enjoyment can grow into lasting friendship. A simple activity done together may become a place where people feel welcome and supported.", "Payla\u015F\u0131lan sevin\xE7, kal\u0131c\u0131 dostlu\u011Fa d\xF6n\xFC\u015Febilir. Birlikte yap\u0131lan basit bir etkinlik, insanlar\u0131n kendini kabul edilmi\u015F ve desteklenmi\u015F hissetti\u011Fi bir alan olabilir."],
      ["VIII: naturalists across occupations and social positions", "Curiosity about nature can put an expert and an amateur beside one another. A common question can begin a relationship beyond differences of status.", "Do\u011Faya duyulan merak, uzmanla merakl\u0131y\u0131 yan yana getirebilir. Ortak bir soru, konum farkl\u0131l\u0131klar\u0131n\u0131n \xF6tesinde bir ili\u015Fkinin ba\u015Flang\u0131c\u0131 olabilir."],
      ["VIII: intellectual associations in remote towns", "A small circle of readers or learners can connect a distant place with the wider world. Intellectual life does not belong only to great centers.", "K\xFC\xE7\xFCk bir okuma veya \xF6\u011Frenme \xE7evresi, uzak bir yeri d\xFCnyaya ba\u011Flayabilir. D\xFC\u015F\xFCnce hayat\u0131 yaln\u0131zca b\xFCy\xFCk merkezlere ait de\u011Fildir."],
      ["VIII: the unambitious voluntary work behind associations", "Much that sustains a community is quiet, voluntary work. Notice the people who prepare, organize, and help without making themselves the center.", "Bir toplulu\u011Fu ya\u015Fatan i\u015Flerin \xE7o\u011Fu sessiz ve g\xF6n\xFCll\xFCd\xFCr. Kendini merkeze koymadan haz\u0131rlayan, d\xFCzenleyen ve yard\u0131m eden insanlar\u0131 fark et."],
      ["VIII: educational societies as support for teachers", "Those who help others learn also need support. A circle of colleagues can make demanding service less lonely and more resourceful.", "Ba\u015Fkalar\u0131n\u0131n \xF6\u011Frenmesine yard\u0131m edenlerin de deste\u011Fe ihtiyac\u0131 vard\u0131r. Bir meslekta\u015F \xE7evresi, zorlay\u0131c\u0131 hizmeti daha az yaln\u0131z ve daha donan\u0131ml\u0131 k\u0131labilir."],
      ["VIII: children protecting one another in neighborhood play", "Care is visible even in children watching out for one another. Mutual protection can begin with noticing a risk and speaking in time.", "Birbirini g\xF6zeten \xE7ocuklarda bile \xF6zen g\xF6r\xFCn\xFCr. Kar\u015F\u0131l\u0131kl\u0131 koruma, bir riski fark edip zaman\u0131nda seslenmekle ba\u015Flayabilir."],
      ["VIII: neighbors supporting mothers and children", "Support can take the shape of a meal, a household task, or time given to a child. Ordinary help makes care concrete.", "Destek, bir \xF6\u011F\xFCn yemek, evde yap\u0131lan bir i\u015F veya bir \xE7ocu\u011Fa ayr\u0131lan zaman olabilir. S\u0131radan yard\u0131m, \xF6zeni somutla\u015Ft\u0131r\u0131r."],
      ["VII: shared agricultural machinery", "Some useful tools remain out of reach alone but become possible through association. Pooling resources can open a practical opportunity for everyone involved.", "Baz\u0131 yararl\u0131 ara\xE7lara tek ba\u015F\u0131na ula\u015F\u0131lamazken birlikte ula\u015F\u0131labilir. Kaynaklar\u0131 birle\u015Ftirmek, kat\u0131lan herkes i\xE7in somut bir imk\xE2n a\xE7abilir."],
      ["VII: communal cultivation for people in need", "A common task can welcome different kinds of contribution. What people produce together can then support someone who has less to give.", "Ortak bir i\u015F, farkl\u0131 katk\u0131lara yer a\xE7abilir. Birlikte \xFCretilen \u015Fey, verecek imk\xE2n\u0131 daha az olan birini de destekleyebilir."],
      ["VII: testing improved cultivation on a small shared plot", "A community can try a new method on a modest scale before adopting it widely. Learning together can make improvement both practical and shared.", "Bir topluluk, yeni y\xF6ntemi yayg\u0131nla\u015Ft\u0131rmadan \xF6nce k\xFC\xE7\xFCk \xF6l\xE7ekte deneyebilir. Birlikte \xF6\u011Frenmek, geli\u015Fimi hem uygulanabilir hem ortak hale getirebilir."],
      ["VIII: international associations and personal contact", "Working with people across boundaries can weaken inherited distance. Real acquaintance gives solidarity something firmer than a slogan to stand on.", "S\u0131n\u0131rlar\u0131n \xF6tesindeki insanlarla \xE7al\u0131\u015Fmak, devral\u0131nan uzakl\u0131\u011F\u0131 azaltabilir. Ger\xE7ek tan\u0131\u015F\u0131kl\u0131k, dayan\u0131\u015Fmaya bir slogandan daha sa\u011Flam dayanak verir."],
      ["Conclusion: progressive individual self-assertion", "Cooperation need not erase personal initiative. There is room both for mutual support and for a person resisting customs that prevent their development.", "\u0130\u015Fbirli\u011Fi, ki\u015Fisel giri\u015Fimi silmek zorunda de\u011Fildir. Hem kar\u015F\u0131l\u0131kl\u0131 deste\u011Fe hem insan\u0131n geli\u015Fimini engelleyen al\u0131\u015Fkanl\u0131klara kar\u015F\u0131 \xE7\u0131kmas\u0131na yer vard\u0131r."],
      ["Conclusion: widening the circle of mutual aid", "Let concern expand beyond the circle in which it first grew. The same impulse that supports a neighbor can reach toward a wider human fellowship.", "\u0130lgin, ilk b\xFCy\xFCd\xFC\u011F\xFC \xE7evrenin \xF6tesine uzans\u0131n. Kom\u015Fuyu destekleyen ayn\u0131 y\xF6neli\u015F, daha geni\u015F bir insanl\u0131k karde\u015Fli\u011Fine ula\u015Fabilir."],
      ["Conclusion: giving beyond strict reciprocity", "Kindness can go beyond keeping accounts of what is owed. Freely offering more than you expect back gives mutual care a generous form.", "\u0130yilik, kimin ne bor\xE7lu oldu\u011Funun hesab\u0131n\u0131 a\u015Fabilir. Kar\u015F\u0131l\u0131\u011F\u0131nda bekledi\u011Finden fazlas\u0131n\u0131 g\xF6n\xFCll\xFC sunmak, kar\u015F\u0131l\u0131kl\u0131 \xF6zene c\xF6mert bir bi\xE7im verir."]
    ]),
    ...passages("Florence Nightingale", "Notes on Nursing", "Hem\u015Firelik \xDCzerine Notlar", "https://www.gutenberg.org/cache/epub/17366/pg17366-images.html", "science", [
      ["XII: encouragement without minimizing suffering", "Don\u2019t try to cheer someone by making light of what they face. Honest company respects what they know, and real good news helps more than hopeful talk.", "Birini, kar\u015F\u0131 kar\u015F\u0131ya oldu\u011Fu durumu hafife alarak ne\u015Felendirmeye \xE7al\u0131\u015Fma. D\xFCr\xFCst bir yak\u0131nl\u0131k onun bildi\u011Fine sayg\u0131 duyar; ger\xE7ek bir iyi haber, umut dolu s\xF6zlerden daha \xE7ok iyi gelir.", true],
      ["XII: a real benevolent act rather than repeated advice", "A true account of help that worked can refresh a weary listener. Sometimes an example of kindness is more welcome than another piece of advice.", "Ger\xE7ekten i\u015Fe yarayan bir yard\u0131m\u0131n hik\xE2yesi, yorgun bir dinleyiciyi canland\u0131rabilir. Bazen iyilik \xF6rne\u011Fi, yeni bir \xF6\u011F\xFCtten daha ho\u015F kar\u015F\u0131lan\u0131r."],
      ["XII: interested presence rather than absence of mind", "Be interested in the person in front of you. Warm company asks for attention, not an endless supply of instruction or solemn words.", "Kar\u015F\u0131ndaki insanla ger\xE7ekten ilgilen. S\u0131cak bir arkada\u015Fl\u0131k, bitmeyen \xF6\u011F\xFCtler veya a\u011F\u0131r s\xF6zler de\u011Fil, dikkatini ister."],
      ["III: communicating absence and return", "When someone depends on you, tell them clearly what to expect. A considerate explanation can spare them the burden of unnecessary uncertainty.", "Birisi sana g\xFCveniyorsa ne bekleyebilece\u011Fini a\xE7\u0131k\xE7a s\xF6yle. D\xFC\u015F\xFCnceli bir a\xE7\u0131klama, onu gereksiz belirsizli\u011Fin y\xFCk\xFCnden koruyabilir.", true],
      ["V: variety, color, and beautiful objects", "Do not dismiss a small source of beauty as unimportant. A flower or a pleasant view may matter deeply to someone whose world has become narrow.", "K\xFC\xE7\xFCk bir g\xFCzellik kayna\u011F\u0131n\u0131 \xF6nemsiz sayma. Bir \xE7i\xE7ek veya ho\u015F bir manzara, d\xFCnyas\u0131 daralm\u0131\u015F biri i\xE7in derin de\u011Fer ta\u015F\u0131yabilir."],
      ["XIII: facts rather than casual opinions", "Describe what you actually noticed before offering a general judgment. Specific observations give another person something more useful than a confident impression.", "Genel bir yarg\u0131 sunmadan \xF6nce ger\xE7ekten fark etti\u011Fini anlat. Somut g\xF6zlemler, kar\u015F\u0131ndakine kendinden emin bir izlenimden daha yararl\u0131 bilgi verir."],
      ["XIII: leading questions and misleading answers", "Ask a question that leaves room for the real answer. If your wording supplies the conclusion, you may miss what the other person needs to tell you.", "Ger\xE7ek cevaba yer b\u0131rakan bir soru sor. S\xF6zlerin sonucu pe\u015Finen veriyorsa kar\u015F\u0131ndakinin anlatmas\u0131 gereken \u015Feyi ka\xE7\u0131rabilirsin."],
      ["XIII: learning what and how to observe", "Attention becomes more useful when you learn what changes matter. Care includes improving your ability to notice, not merely intending to be helpful.", "Hangi de\u011Fi\u015Fikliklerin \xF6nemli oldu\u011Funu \xF6\u011Frendi\u011Finde dikkatin daha yararl\u0131 olur. \xD6zen, yard\u0131m niyetinin yan\u0131nda fark etme becerini geli\u015Ftirmeyi de i\xE7erir."],
      ["XIII: observation for practical purposes", "Let noticing lead to appropriate action. Seeing that something needs to change is only part of the responsibility of caring.", "Fark etmek, uygun bir davran\u0131\u015Fa yol a\xE7s\u0131n. Bir \u015Feyin de\u011Fi\u015Fmesi gerekti\u011Fini g\xF6rmek, \xF6zen g\xF6stermenin sorumlulu\u011Funun yaln\u0131zca bir b\xF6l\xFCm\xFCd\xFCr."],
      ["XIII, note 33: observation, memory, and truthful reporting", "Wanting to be truthful does not make every memory accurate. Admit what you did not observe instead of filling the gap with imagination.", "Do\u011Fruyu s\xF6ylemek istemek, her hat\u0131ray\u0131 do\u011Fru k\u0131lmaz. Bo\u015Flu\u011Fu hayalinle doldurmak yerine g\xF6zlemlemedi\u011Fin \u015Feyi kabul et."]
    ])
  ];

