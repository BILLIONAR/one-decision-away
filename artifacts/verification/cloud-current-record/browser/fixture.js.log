  function script(durationMinutes, lines) {
    const total = durationMinutes * 60;
    const raw = lines.reduce((acc, [gap]) => acc + gap, 0);
    const firstGap = lines[0]?.[0] ?? 0;
    const scale = raw > firstGap ? (total - 15 - firstGap) / (raw - firstGap) : 1;
    let t2 = 0;
    return lines.map(([gap, text2], i) => {
      t2 += i === 0 ? gap : Math.round(gap * scale);
      return { atSeconds: t2, text: text2 };
    });
  }
