  var SCIENCE_QUOTES_MORE = [
    ...series(1, "Richard Feynman \xB7 The Feynman Lectures III.1", "Richard Feynman \xB7 Fizik Dersleri III.1", "https://www.feynmanlectures.caltech.edu/III_01.html", "quantum", [
      ["1\u20134: individual electron detections", "A detector records electrons as individual events. Repeating the experiment reveals a distribution that no single click could show.", "Dedekt\xF6r, elektronlar\u0131 tek tek olaylar olarak kaydeder. Deney tekrarland\u0131k\xE7a ortaya \xE7\u0131kan da\u011F\u0131l\u0131m, tek bir t\u0131klaman\u0131n g\xF6steremedi\u011Fi kuantum davran\u0131\u015F\u0131n\u0131 g\xF6r\xFCn\xFCr k\u0131lar.", "experiment", "probability"],
      ["1\u20135: interference with both slits open", "Opening two paths for an electron changes the interference pattern. The outcome cannot be reconstructed by simply adding the separate one-path probabilities.", "Elektron i\xE7in iki yolun a\xE7\u0131k olmas\u0131 giri\u015Fim desenini de\u011Fi\u015Ftirir. Sonucu anlamak, yollar ayr\u0131 ayr\u0131 a\xE7\u0131kken bulunan olas\u0131l\u0131klar\u0131 yaln\u0131zca toplamaktan fazlas\u0131n\u0131 gerektirir.", "interference"],
      ["1\u20136: recording which-path information", "A physical interaction that reveals an electron\u2019s path can remove interference. Quantum measurement involves an apparatus interacting with a system.", "Elektronun hangi yoldan ge\xE7ti\u011Fini a\xE7\u0131\u011Fa \xE7\u0131karan fiziksel etkile\u015Fim, giri\u015Fim desenini ortadan kald\u0131rabilir. Kuantum \xF6l\xE7\xFCm\xFC, bir d\xFCzenekle incelenen sistem aras\u0131ndaki somut etkile\u015Fimi i\xE7erir.", "measurement"]
    ]),
    ...series(4, "Richard Feynman \xB7 The Feynman Lectures III.2", "Richard Feynman \xB7 Fizik Dersleri III.2", "https://www.feynmanlectures.caltech.edu/III_02.html", "quantum", [
      ["2\u20131 and 2\u20132: wave packets and uncertainty", "A localized quantum wave needs a spread of wavelengths. Position and momentum therefore cannot both have arbitrarily narrow distributions in the same state.", "Kuantum dalgas\u0131n\u0131 dar bir b\xF6lgeye toplamak, farkl\u0131 dalga boylar\u0131n\u0131 gerektirir. Bu nedenle ayn\u0131 durumda konum ve momentum da\u011F\u0131l\u0131mlar\u0131 birlikte s\u0131n\u0131rs\u0131z bi\xE7imde daralt\u0131lamaz.", "uncertainty"],
      ["2\u20132: narrowing the slit widens diffraction", "A narrower slit localizes a particle more tightly, while widening its outgoing diffraction pattern. Better localization comes with a wider spread of transverse momentum.", "Yar\u0131\u011F\u0131 daraltmak par\xE7ac\u0131\u011F\u0131n ge\xE7ti\u011Fi yeri daha s\u0131k\u0131 s\u0131n\u0131rlar; \xE7\u0131k\u0131\u015Ftaki k\u0131r\u0131n\u0131m deseni ise geni\u015Fler. Konumdaki daralma, yanal momentumun daha geni\u015F da\u011F\u0131lmas\u0131yla birlikte g\xF6r\xFCl\xFCr.", "uncertainty", "diffraction"],
      ["2\u20134: estimating atomic size", "Squeezing an electron toward the nucleus raises the kinetic-energy cost of confinement. Quantum mechanics helps explain why an atom has a finite size.", "Elektronu \xE7ekirde\u011Fin \xE7evresinde giderek daha dar bir alana s\u0131k\u0131\u015Ft\u0131rmak, kinetik enerji bedelini y\xFCkseltir. Kuantum mekani\u011Fi, atomun neden belirli bir b\xFCy\xFCkl\xFC\u011F\xFC oldu\u011Funu a\xE7\u0131klar.", "atoms", "energy"]
    ]),
    ...series(7, "Richard Feynman \xB7 The Feynman Lectures III.3", "Richard Feynman \xB7 Fizik Dersleri III.3", "https://www.feynmanlectures.caltech.edu/III_03.html", "quantum", [
      ["3\u20131: modulus squared of an amplitude", "Quantum theory first calculates a probability amplitude. Its squared magnitude gives the probability of a specified outcome, linking abstract mathematics to countable events.", "Kuantum kuram\u0131 \xF6nce bir olas\u0131l\u0131k genli\u011Fi hesaplar. Bu genli\u011Fin b\xFCy\xFCkl\xFC\u011F\xFCn\xFCn karesi, belirli sonucun olas\u0131l\u0131\u011F\u0131n\u0131 verir; soyut matematik b\xF6ylece say\u0131labilen deney sonu\xE7lar\u0131na ba\u011Flan\u0131r.", "probability"],
      ["3\u20131: multiplying amplitudes for successive events", "For a specified sequence of quantum events, the corresponding amplitudes multiply. A complicated process can be analyzed through the successive stages that compose it.", "Belirli bir kuantum olaylar\u0131 dizisinde, a\u015Famalar\u0131n olas\u0131l\u0131k genlikleri \xE7arp\u0131l\u0131r. Karma\u015F\u0131k bir s\xFCre\xE7, onu olu\u015Fturan ard\u0131\u015F\u0131k ad\u0131mlar dikkatle tan\u0131mland\u0131\u011F\u0131nda matematiksel olarak incelenebilir.", "learning"],
      ["3\u20131: summing amplitudes over alternative routes", "Indistinguishable alternative routes contribute amplitudes that can reinforce or cancel. Quantum prediction must retain their relative phases, not just the sizes of their probabilities.", "Ay\u0131rt edilemeyen alternatif yollar\u0131n genlikleri birbirini g\xFC\xE7lendirebilir veya s\xF6nd\xFCrebilir. Kuantum tahmini yaparken yaln\u0131zca olas\u0131l\u0131klar\u0131n b\xFCy\xFCkl\xFCklerini bilmek yetmez; genliklerin birbirine g\xF6re fazlar\u0131 da hesaba kat\u0131l\u0131r.", "superposition"]
    ]),
    ...series(10, "DOE Office of Science \xB7 Quantum Mechanics", "DOE Bilim Ofisi \xB7 Kuantum Mekani\u011Fi", "https://www.energy.gov/science/doe-explainsquantum-mechanics", "quantum", [
      ["Bound electron energy levels", "An electron bound in an atom has allowed energy levels. Atomic energy changes follow this discrete structure, rather than every value being available.", "Bir atoma ba\u011Fl\u0131 elektronun izin verilen enerji d\xFCzeyleri vard\u0131r. Atomun enerji de\u011Fi\u015Fimlerini anlamak, her de\u011Ferin m\xFCmk\xFCn oldu\u011Funu varsaymak yerine bu kesikli yap\u0131y\u0131 tan\u0131may\u0131 gerektirir.", "atoms"],
      ["Hydrogen orbitals: spatial probability", "An atomic orbital describes where an electron may be detected. It is a probability pattern, not a tiny planet\u2019s track around a nucleus.", "Atomdaki orbital, elektronun nerelerde bulunabilece\u011Fine ili\u015Fkin bir olas\u0131l\u0131k desenidir. \xC7ekirde\u011Fin \xE7evresinde \xE7izilmi\u015F k\xFC\xE7\xFCk bir gezegen yolu de\u011Fildir; atomu anlamak i\xE7in farkl\u0131 bir tasvir gerekir.", "atoms", "probability"],
      ["Quantum mechanics in everyday devices", "Lasers, LEDs and transistors grew from understanding quantum behavior. Questions about tiny particles became tools that now sit in the palm of a hand.", "Lazerler, LED\u2019ler ve transist\xF6rler kuantum davran\u0131\u015F\u0131n\u0131 anlamam\u0131zla geli\u015Fti. \xC7ok k\xFC\xE7\xFCk par\xE7ac\u0131klar hakk\u0131nda sorulan sorular, bug\xFCn avucumuzda ta\u015F\u0131d\u0131\u011F\u0131m\u0131z cihazlar\u0131n \xE7al\u0131\u015Fmas\u0131n\u0131 sa\u011Flayan somut bilgiye d\xF6n\xFC\u015Ft\xFC.", "curiosity", "technology"]
    ]),
    ...series(13, "DOE Office of Science \xB7 Quantum Networks", "DOE Bilim Ofisi \xB7 Kuantum A\u011Flar\u0131", "https://www.energy.gov/science/doe-explainsquantum-networks", "quantum", [
      ["No-cloning of an arbitrary unknown quantum state", "An arbitrary unknown quantum state cannot be copied perfectly. Quantum communication therefore needs methods different from the ordinary amplification of a classical signal.", "Bilinmeyen herhangi bir kuantum durumunun kusursuz kopyas\u0131 \xE7\u0131kar\u0131lamaz. Bu \xF6zellik, kuantum ileti\u015Fiminde s\u0131radan bir sinyali y\xFCkseltmekten farkl\u0131 y\xF6ntemler geli\u015Ftirmeyi gerektiren temel s\u0131n\u0131rlamalardan biridir.", "no-cloning"],
      ["Encoding information in photon polarization", "A photon\u2019s polarization can carry quantum information. Designing a communication channel begins by connecting a measurable physical property with a carefully defined encoding.", "Bir fotonun kutuplanmas\u0131, kuantum bilgisinin ta\u015F\u0131y\u0131c\u0131s\u0131 olabilir. Bir ileti\u015Fim kanal\u0131 kurmak, \xF6l\xE7\xFClebilir bir fiziksel \xF6zelli\u011Fi \xF6zenle tan\u0131mlanm\u0131\u015F bir bilgi koduyla ili\u015Fkilendirmekle ba\u015Flar.", "photons"],
      ["Complementary classical and quantum networks", "Quantum networks complement classical networks. Combining their different strengths can support communication tasks that neither kind of network handles equally well alone.", "Kuantum a\u011Flar\u0131 ile klasik a\u011Flar birbirini tamamlayabilir. Farkl\u0131 yeteneklerini ayn\u0131 sistemde bulu\u015Fturmak, tek bir a\u011F t\xFCr\xFCn\xFCn kendi ba\u015F\u0131na ayn\u0131 \xF6l\xE7\xFCde iyi kar\u015F\u0131layamad\u0131\u011F\u0131 ihtiya\xE7lara yan\u0131t verebilir.", "technology"]
    ]),
    ...series(16, "DOE Office of Science \xB7 Quantum Computing", "DOE Bilim Ofisi \xB7 Kuantum Hesaplama", "https://www.energy.gov/science/doe-explainsquantum-computing", "quantum", [
      ["Simulating inherently quantum physical systems", "Quantum computers may help calculate molecular behavior that is difficult to simulate classically. Understanding nature can also suggest a new kind of instrument for studying it.", "Kuantum bilgisayarlar\u0131, klasik y\xF6ntemlerle hesaplanmas\u0131 zor molek\xFCler davran\u0131\u015Flar\u0131 incelemeye yard\u0131mc\u0131 olabilir. Do\u011Fay\u0131 anlamak, onu ara\u015Ft\u0131rmak i\xE7in kullan\u0131labilecek yeni ara\xE7lar\u0131n tasar\u0131m\u0131na da ilham verir.", "simulation", "curiosity"],
      ["Prospective optimization applications", "Some quantum algorithms investigate how to select useful solutions from large sets of possibilities. Their value depends on the problem and the algorithm, not a universal speed promise.", "Baz\u0131 kuantum algoritmalar\u0131, geni\u015F se\xE7enek k\xFCmelerinden yararl\u0131 \xE7\xF6z\xFCmler se\xE7meyi ara\u015Ft\u0131r\u0131r. Ba\u015Far\u0131, sorunun yap\u0131s\u0131na ve kullan\u0131lan algoritmaya ba\u011Fl\u0131d\u0131r; her i\u015F i\xE7in ayn\u0131 h\u0131z \xFCst\xFCnl\xFC\u011F\xFC beklenmez.", "algorithms"],
      ["Research in hardware, control and software", "Useful quantum computing requires more than qubits. Hardware, precise control and software must develop together so that physical possibilities become dependable calculations.", "Yararl\u0131 kuantum hesaplama, yaln\u0131zca k\xFCbit \xFCretmekle kurulmaz. Donan\u0131m\u0131n, hassas kontrol\xFCn ve yaz\u0131l\u0131m\u0131n birlikte geli\u015Fmesi gerekir; fiziksel olanaklar ancak b\xF6yle g\xFCvenilir hesaplamalara d\xF6n\xFC\u015Febilir.", "cooperation", "technology"]
    ]),
    ...series(19, "NIST \xB7 Quantum Computing Explained", "NIST \xB7 Kuantum Hesaplama A\xE7\u0131klamas\u0131", "https://www.nist.gov/quantum-information-science/quantum-computing-explained", "quantum", [
      ["Measurement extracts limited information from superposition", "Superposition does not let a computer read every possible answer at once. An algorithm must arrange the final measurement to reveal useful information.", "S\xFCperpozisyon, bilgisayar\u0131n b\xFCt\xFCn olas\u0131 cevaplar\u0131 ayn\u0131 anda okuyabilmesini sa\u011Flamaz. Bir kuantum algoritmas\u0131, son \xF6l\xE7\xFCm\xFCn i\u015Fe yarayan bilgiyi ortaya \xE7\u0131karmas\u0131n\u0131 sa\u011Flayacak \u015Fekilde tasarlanmal\u0131d\u0131r.", "superposition", "measurement"],
      ["Environmental disturbances and qubit errors", "A stray field or a temperature fluctuation can disrupt a qubit. Preserving quantum information is an engineering task of shielding, control and error management.", "Ba\u015F\u0131bo\u015F bir alan ya da s\u0131cakl\u0131k dalgalanmas\u0131, bir k\xFCbitin durumunu bozabilir. Kuantum bilgisini korumak; yal\u0131t\u0131m, hassas kontrol ve hata y\xF6netimi isteyen somut bir m\xFChendislik i\u015Fidir.", "decoherence"],
      ["Ion and superconducting implementations", "Quantum bits can be built from trapped ions or superconducting circuits. Different implementations exchange speed, stability and manufacturing advantages; no single design wins every comparison.", "Kuantum bitleri tuzaklanm\u0131\u015F iyonlardan veya s\xFCperiletken devrelerden kurulabilir. Farkl\u0131 tasar\u0131mlar h\u0131z, kararl\u0131l\u0131k ve \xFCretim a\xE7\u0131s\u0131ndan farkl\u0131 \xFCst\xFCnl\xFCkler sunar; kar\u015F\u0131la\u015Ft\u0131rma tek bir \xF6zelli\u011Fe indirgenemez.", "qubits"]
    ]),
    ...series(22, "Royal Swedish Academy of Sciences \xB7 Physics 2022", "\u0130sve\xE7 Kraliyet Bilimler Akademisi \xB7 2022 Fizik", "https://www.nobelprize.org/prizes/physics/2022/popular-information/", "quantum", [
      ["Bell inequalities and entangled-photon experiments", "Bell tests compare measured correlations with limits imposed by local hidden-variable models. Entangled photons let researchers test a foundational question using experimental numbers.", "Bell testleri, \xF6l\xE7\xFClen ba\u011F\u0131nt\u0131lar\u0131 yerel gizli de\u011Fi\u015Fken modellerinin s\u0131n\u0131rlar\u0131yla kar\u015F\u0131la\u015Ft\u0131r\u0131r. Dolan\u0131k fotonlar sayesinde do\u011Fan\u0131n nas\u0131l \xE7al\u0131\u015Ft\u0131\u011F\u0131na ili\u015Fkin temel bir soru, deneysel say\u0131larla s\u0131nanabilir.", "entanglement", "evidence"],
      ["Quantum teleportation transfers a state", "Quantum teleportation transfers an unknown quantum state while the original is lost. The achievement concerns quantum information, rather than transporting a material object.", "Kuantum \u0131\u015F\u0131nlamas\u0131, bilinmeyen bir kuantum durumunu aktar\u0131rken \xF6zg\xFCn durumun kaybolmas\u0131n\u0131 i\xE7erir. Burada aktar\u0131lan, bir cismin kendisi de\u011Fil, ba\u015Fka bir sistemde yeniden beliren kuantum bilgisidir.", "entanglement", "teleportation"],
      ["Entanglement swapping demonstrated in 1998", "Entanglement swapping can link particles that never directly interacted. Joint measurements on their partners create new connections in the quantum description of the system.", "Dolan\u0131kl\u0131k takas\u0131, do\u011Frudan etkile\u015Fmemi\u015F par\xE7ac\u0131klar\u0131 dolan\u0131k h\xE2le getirebilir. E\u015Fleri \xFCzerinde yap\u0131lan ortak \xF6l\xE7\xFCm, sistemin kuantum tan\u0131m\u0131nda yeni bir ba\u011Flant\u0131 olu\u015Fturman\u0131n deneysel yolunu sa\u011Flar.", "entanglement"]
    ]),
    ...series(25, "Royal Swedish Academy of Sciences \xB7 Physics 2012", "\u0130sve\xE7 Kraliyet Bilimler Akademisi \xB7 2012 Fizik", "https://www.nobelprize.org/prizes/physics/2012/press-release/", "quantum", [
      ["Wineland: light controlling trapped ions", "David Wineland\u2019s group used light to control trapped ions. Isolating a single charged atom made delicate quantum behavior accessible to carefully designed experiments.", "David Wineland\u2019\u0131n ekibi, tuzaklanm\u0131\u015F iyonlar\u0131 \u0131\u015F\u0131kla kontrol etti. Tek bir y\xFCkl\xFC atomu \xE7evresinden yeterince ay\u0131rabilmek, hassas kuantum davran\u0131\u015Flar\u0131n\u0131 \xF6zenle tasarlanm\u0131\u015F deneylerle incelemeyi m\xFCmk\xFCn k\u0131ld\u0131.", "atoms", "experiment"],
      ["Haroche: atoms probing trapped photons", "Serge Haroche sent atoms through a trap to probe photons. Exchanging the usual roles of light and matter opened another route to measuring individual quantum systems.", "Serge Haroche, tuzaklanm\u0131\u015F fotonlar\u0131 incelemek i\xE7in i\xE7lerinden atomlar ge\xE7irdi. I\u015F\u0131k ve maddenin al\u0131\u015F\u0131ld\u0131k rollerini de\u011Fi\u015Ftiren bu d\xFCzenek, tekil kuantum sistemlerini \xF6l\xE7menin ba\u015Fka bir yolunu a\xE7t\u0131.", "photons", "measurement"],
      ["Measuring individual particles without destroying them", "Quantum experiments can observe individual particles without simply absorbing them. Designing the interaction carefully changes what can be learned while preserving the particle for further study.", "Kuantum deneyleri, tekil par\xE7ac\u0131klar\u0131 onlar\u0131 do\u011Frudan so\u011Furmadan da g\xF6zlemleyebilir. Etkile\u015Fimi dikkatle tasarlamak, par\xE7ac\u0131\u011F\u0131 sonraki incelemeler i\xE7in korurken hangi bilgilerin elde edilebilece\u011Fini de\u011Fi\u015Ftirir.", "measurement"]
    ]),
    ...series(28, "Royal Swedish Academy of Sciences \xB7 Bose\u2013Einstein Condensation", "\u0130sve\xE7 Kraliyet Bilimler Akademisi \xB7 Bose\u2013Einstein Yo\u011Fu\u015Fmas\u0131", "https://www.nobelprize.org/uploads/2018/06/advanced-physicsprize2001.pdf", "quantum", [
      ["Dilute gases: macroscopic occupation of a quantum state", "At sufficiently low temperatures, many bosonic atoms can occupy one quantum state. Bose\u2013Einstein condensation lets researchers study quantum behavior across a whole atomic cloud.", "Yeterince d\xFC\u015F\xFCk s\u0131cakl\u0131kta \xE7ok say\u0131da bozonik atom ayn\u0131 kuantum durumunu payla\u015Fabilir. Bose\u2013Einstein yo\u011Fu\u015Fmas\u0131, kuantum davran\u0131\u015F\u0131n\u0131 b\xFCt\xFCn bir atom bulutu \xF6l\xE7e\u011Finde inceleme olana\u011F\u0131 sa\u011Flar.", "atoms", "condensate"],
      ["Interference between expanding condensates", "Two expanding condensates can produce interference fringes. Their overlap makes the coherence of matter waves visible, connecting a quantum calculation with an observable pattern.", "Geni\u015Fleyerek birbiriyle \xF6rt\xFC\u015Fen iki yo\u011Fu\u015Fuk, giri\u015Fim \xE7izgileri olu\u015Fturabilir. Bu desen, madde dalgalar\u0131n\u0131n e\u015Fevrelili\u011Fini g\xF6zlemlenebilir h\xE2le getirir; kuantum hesab\u0131 deneyde g\xF6r\xFClen belirgin bir iz kazan\u0131r.", "interference", "matter"],
      ["Outcoupling coherent atoms: atom laser", "An atom laser emits coherent matter waves from a condensate. Its beam contains atoms rather than photons, extending a familiar optical idea into matter.", "Atom lazeri, bir yo\u011Fu\u015Fuktan e\u015Fevreli madde dalgalar\u0131 \xE7\u0131kar\u0131r. Demetinde fotonlar yerine atomlar bulunur; \u0131\u015F\u0131kla tan\u0131nan bir fikir, b\xF6ylece maddenin kuantum davran\u0131\u015F\u0131nda yeni kar\u015F\u0131l\u0131k bulur.", "atoms", "technology"]
    ]),
    ...series(31, "Royal Swedish Academy of Sciences \xB7 Physics 1997", "\u0130sve\xE7 Kraliyet Bilimler Akademisi \xB7 1997 Fizik", "https://www.nobelprize.org/prizes/physics/1997/press-release/", "quantum", [
      ["Opposing laser beams slow atoms", "Light can cool atoms when photon momentum opposes their motion. A laser becomes a brake when its frequency and direction are chosen for the task.", "Fotonlar\u0131n momentumu atomlar\u0131n hareketine kar\u015F\u0131 y\xF6nlendirildi\u011Finde \u0131\u015F\u0131k, atomlar\u0131 so\u011Futabilir. Frekans\u0131 ve y\xF6n\xFC uygun se\xE7ilen bir lazer, atomik \xF6l\xE7ekte bir fren g\xF6revi g\xF6rebilir.", "atoms", "cooling"],
      ["Optical molasses and the need for a trap", "Slowing atoms is different from trapping them. Optical molasses reduced their motion, but magnetic and optical forces were needed to keep the cloud in place.", "Atomlar\u0131 yava\u015Flatmak ile ayn\u0131 yerde tutmak farkl\u0131 i\u015Flerdir. Optik melas hareketi azaltt\u0131; bulutu yerinde korumak i\xE7in manyetik ve optik kuvvetlerin birlikte kullan\u0131lmas\u0131 gerekti.", "atoms", "experiment"],
      ["Phillips measured temperatures below the Doppler limit", "Phillips found atoms colder than a simplified model allowed. More detailed atomic structure explained the result, showing how an unexpected measurement can improve theory.", "Phillips, basitle\u015Ftirilmi\u015F modelin \xF6ng\xF6rd\xFC\u011F\xFCnden daha so\u011Fuk atomlar \xF6l\xE7t\xFC. Atom yap\u0131s\u0131n\u0131n ayr\u0131nt\u0131lar\u0131 sonucu a\xE7\u0131klad\u0131; beklenmeyen bir \xF6l\xE7\xFCm, kuram\u0131n daha incelikli kurulmas\u0131na yol a\xE7t\u0131.", "atoms", "evidence"]
    ]),
    ...series(34, "DOE Office of Science \xB7 Superconductivity", "DOE Bilim Ofisi \xB7 S\xFCperiletkenlik", "https://www.energy.gov/science/doe-explainssuperconductivity", "quantum", [
      ["Zero DC resistance below a critical temperature", "Below a critical temperature, a superconductor carries direct current without electrical resistance. A change in conditions reveals a collective behavior absent from the ordinary material.", "Kritik s\u0131cakl\u0131\u011F\u0131n alt\u0131nda bir s\xFCperiletken, do\u011Fru ak\u0131m\u0131 elektriksel diren\xE7 olmadan ta\u015F\u0131r. Ko\u015Fullar\u0131n de\u011Fi\u015Fmesi, malzemenin ola\u011Fan h\xE2linde g\xF6r\xFClmeyen ortak bir kuantum davran\u0131\u015F\u0131n\u0131 ortaya \xE7\u0131kar\u0131r.", "energy", "materials"],
      ["BCS theory: electron pairing through lattice vibrations", "In conventional superconductors, lattice vibrations help electrons form Cooper pairs. Their collective quantum state explains resistance-free flow that independent-electron pictures cannot capture.", "Geleneksel s\xFCperiletkenlerde, kristal titre\u015Fimleri elektronlar\u0131n Cooper \xE7iftleri olu\u015Fturmas\u0131na yard\u0131mc\u0131 olur. \xC7iftlerin ortak kuantum durumu, elektronlar\u0131 birbirinden ba\u011F\u0131ms\u0131z d\xFC\u015F\xFCnerek a\xE7\u0131klanamayan diren\xE7siz ak\u0131\u015F\u0131n temelini olu\u015Fturur.", "matter", "electrons"],
      ["Critical current limits superconducting behavior", "Superconductivity has operating limits: too much current can destroy it. A remarkable material still needs its temperature, current and surroundings kept within suitable conditions.", "S\xFCperiletkenli\u011Fin \xE7al\u0131\u015Fma s\u0131n\u0131rlar\u0131 vard\u0131r; fazla ak\u0131m bu durumu bozabilir. Ola\u011Fan\xFCst\xFC bir malzemeden yararlanmak, s\u0131cakl\u0131\u011F\u0131n\u0131, ak\u0131m\u0131n\u0131 ve \xE7evresini uygun ko\u015Fullar i\xE7inde tutmay\u0131 gerektirir.", "energy", "engineering"]
    ]),
    ...series(37, "Royal Swedish Academy of Sciences \xB7 Chemistry 2023", "\u0130sve\xE7 Kraliyet Bilimler Akademisi \xB7 2023 Kimya", "https://www.nobelprize.org/prizes/chemistry/2023/press-release/", "quantum", [
      ["Quantum-dot size determines optical properties", "For quantum dots, size helps determine color. At the nanoscale, changing dimensions can alter optical properties even when the underlying chemical material stays the same.", "Kuantum noktalar\u0131nda boyut, rengin belirlenmesinde rol oynar. Nano\xF6l\xE7ekte bir par\xE7ac\u0131\u011F\u0131n \xF6l\xE7\xFClerini de\u011Fi\u015Ftirmek, ayn\u0131 kimyasal malzemenin \u0131\u015F\u0131kla etkile\u015Fimini de\u011Fi\u015Ftirebilir; k\xFC\xE7\xFCkl\xFCk burada fiziksel bir de\u011Fi\u015Fkendir.", "matter", "quantum-dots"],
      ["Brus observed size-dependent effects in a fluid", "Louis Brus demonstrated size-dependent quantum effects in particles suspended in liquid. An effect found in glass could also be studied in a different material setting.", "Louis Brus, s\u0131v\u0131da as\u0131l\u0131 par\xE7ac\u0131klarda boyuta ba\u011Fl\u0131 kuantum etkilerini g\xF6sterdi. Cam i\xE7inde g\xF6r\xFClen bir olgunun ba\u015Fka bir ortamda da incelenebilmesi, ara\u015Ft\u0131rman\u0131n deneysel alan\u0131n\u0131 geni\u015Fletti.", "experiment", "quantum-dots"],
      ["Bawendi improved quantum-dot chemical synthesis in 1993", "Moungi Bawendi improved quantum-dot synthesis so researchers could obtain high-quality particles. Controlling how a material is made can be as decisive as discovering its properties.", "Moungi Bawendi, y\xFCksek nitelikli kuantum noktalar\u0131 \xFCretmeyi sa\u011Flayan sentez y\xF6ntemini geli\u015Ftirdi. Bir malzemenin nas\u0131l \xFCretildi\u011Fini kontrol etmek, \xF6zelliklerini ke\u015Ffetmek kadar belirleyici bir bilimsel ad\u0131m olabilir.", "engineering", "quantum-dots"]
    ]),
    ...series(40, "Richard Feynman \xB7 The Feynman Lectures III.4", "Richard Feynman \xB7 Fizik Dersleri III.4", "https://www.feynmanlectures.caltech.edu/III_04.html", "quantum", [
      ["4\u20131: indistinguishability of identical particles", "Identical quantum particles cannot be given lasting individual labels within an experiment. Exchanging them must be included in the calculation of possible outcomes.", "\xD6zde\u015F kuantum par\xE7ac\u0131klar\u0131na, deney boyunca onlar\u0131 kesin olarak ay\u0131ran kal\u0131c\u0131 etiketler verilemez. Yer de\u011Fi\u015Ftirmeleri, olas\u0131 sonu\xE7lar\u0131 hesaplarken g\xF6z \xF6n\xFCnde bulundurulmas\u0131 gereken temel bir \xF6zelliktir.", "particles"],
      ["4\u20137: fermions and the exclusion principle", "Two identical fermions cannot occupy the same quantum state. This exclusion principle helps account for the arrangement of electrons and the structure of matter.", "\u0130ki \xF6zde\u015F fermiyon ayn\u0131 kuantum durumunu dolduramaz. Bu d\u0131\u015Farlama ilkesi, elektronlar\u0131n atomlarda nas\u0131l yerle\u015Fti\u011Fini ve maddenin yap\u0131s\u0131n\u0131n neden b\xF6yle kuruldu\u011Funu anlaman\u0131n temel ta\u015Flar\u0131ndan biridir.", "atoms", "matter"],
      ["4\u20134: photons and induced emission", "Photons are bosons, and an occupied mode can favor further emission into that mode. The existing photon population enters the calculation of emission probability.", "Fotonlar bozondur; dolu bir \u0131\u015F\u0131k modu, ayn\u0131 moda yeni yay\u0131m\u0131 g\xFC\xE7lendirebilir. Ortamda bulunan foton say\u0131s\u0131, yeni bir fotonun yay\u0131lma olas\u0131l\u0131\u011F\u0131n\u0131 hesaplaman\u0131n par\xE7as\u0131 olur.", "photons", "quantum-statistics"]
    ]),
    ...series(43, "U.S. EIA \xB7 Laws of Energy", "ABD Enerji Bilgi \u0130daresi \xB7 Enerji Yasalar\u0131", "https://www.eia.gov/energyexplained/what-is-energy/laws-of-energy.php", "energy", [
      ["Conservation during energy transformations", "Using energy changes its form rather than making it vanish. Following those transformations helps explain what a machine receives, delivers and releases into its surroundings.", "Enerjiyi kullanmak, onu yok etmek yerine bi\xE7imini de\u011Fi\u015Ftirmektir. Bu d\xF6n\xFC\u015F\xFCmleri izlemek, bir makinenin ne ald\u0131\u011F\u0131n\u0131, ne \xFCretti\u011Fini ve \xE7evresine ne aktard\u0131\u011F\u0131n\u0131 anlamay\u0131 sa\u011Flar.", "conservation"],
      ["Photovoltaic conversion of radiant energy", "A solar cell converts incoming radiant energy into electrical energy. The sunlight reaching a roof can enter a measurable chain of physical transformations.", "Bir g\xFCne\u015F h\xFCcresi, kendisine ula\u015Fan \u0131\u015F\u0131n\u0131m enerjisini elektrik enerjisine d\xF6n\xFC\u015Ft\xFCr\xFCr. \xC7at\u0131na d\xFC\u015Fen g\xFCn \u0131\u015F\u0131\u011F\u0131, \xF6l\xE7\xFClebilen ve ad\u0131mlar\u0131 izlenebilen bir fiziksel d\xF6n\xFC\u015F\xFCm zincirine kat\u0131labilir.", "solar"],
      ["Useful output and efficiency", "Efficiency compares useful output with energy supplied. Tracking where the rest goes helps engineers improve a device without pretending that energy appears from nowhere.", "Verimlilik, yararl\u0131 \xE7\u0131kt\u0131y\u0131 sa\u011Flanan enerjiyle kar\u015F\u0131la\u015Ft\u0131r\u0131r. Geri kalan\u0131n nereye aktar\u0131ld\u0131\u011F\u0131n\u0131 izlemek, m\xFChendislerin enerjiyi yoktan \xFCretmeden bir cihaz\u0131n i\u015Fleyi\u015Fini daha iyi h\xE2le getirmesine yard\u0131mc\u0131 olur.", "engineering"]
    ]),
    ...series(46, "U.S. EIA \xB7 Forms of Energy", "ABD Enerji Bilgi \u0130daresi \xB7 Enerji Bi\xE7imleri", "https://www.eia.gov/energyexplained/what-is-energy/forms-of-energy.php", "energy", [
      ["Elastic energy in springs and bands", "A compressed spring stores energy through deformation. Its apparently motionless state can conceal the capacity to produce movement when the constraint is released.", "S\u0131k\u0131\u015Ft\u0131r\u0131lm\u0131\u015F bir yay, bi\xE7imindeki de\u011Fi\u015Fim sayesinde enerji depolar. D\u0131\u015Far\u0131dan hareketsiz g\xF6r\xFCnse bile, \xFCzerindeki k\u0131s\u0131t kald\u0131r\u0131ld\u0131\u011F\u0131nda hareket olu\u015Fturabilecek fiziksel bir kapasiteyi i\xE7inde ta\u015F\u0131r.", "potential"],
      ["Gravitational energy and descending water", "Water descending through a turbine converts gravitational potential energy into motion. Hydropower makes a difference in height part of an electricity-producing process.", "Bir t\xFCrbinden a\u015Fa\u011F\u0131 do\u011Fru akan su, yer\xE7ekimsel potansiyel enerjisini harekete d\xF6n\xFC\u015Ft\xFCr\xFCr. Hidroelektrik \xFCretiminde y\xFCkseklik fark\u0131, elektrik sa\u011Flayan s\xFCrecin somut bir par\xE7as\u0131 h\xE2line gelir.", "gravity"],
      ["Sound transports energy through matter", "Sound carries energy through a material by compressions and rarefactions. An ordinary conversation depends on organized vibrations traveling between a speaker and a listener.", "Ses, bir ortam\u0131n s\u0131k\u0131\u015Fma ve seyrelmeleriyle enerji ta\u015F\u0131r. G\xFCndelik bir konu\u015Fma bile, konu\u015Fan ile dinleyen aras\u0131nda ilerleyen d\xFCzenli titre\u015Fimler sayesinde fiziksel olarak m\xFCmk\xFCn olur.", "waves"]
    ]),
    ...series(49, "DOE Office of Science \xB7 Fusion Reactions", "DOE Bilim Ofisi \xB7 F\xFCzyon Tepkimeleri", "https://www.energy.gov/science/doe-explainsfusion-reactions", "energy", [
      ["Fusion powers the Sun and other stars", "The Sun shines because nuclear fusion releases energy in its interior. The light of an ordinary morning begins with interactions among tiny atomic nuclei.", "G\xFCne\u015F, i\xE7indeki n\xFCkleer f\xFCzyonun a\xE7\u0131\u011Fa \xE7\u0131kard\u0131\u011F\u0131 enerjiyle parlar. S\u0131radan bir sabah\u0131n \u0131\u015F\u0131\u011F\u0131, y\u0131ld\u0131z\u0131n derinliklerinde ger\xE7ekle\u015Fen \xE7ok k\xFC\xE7\xFCk atom \xE7ekirdekleri aras\u0131ndaki etkile\u015Fimlerden do\u011Far.", "fusion", "curiosity"],
      ["Mass difference and energy release", "In an energy-releasing fusion reaction, the products have less total rest mass than the starting particles. The difference appears as released energy, preserving the mass-energy account.", "Enerji a\xE7\u0131\u011Fa \xE7\u0131karan f\xFCzyonda, \xFCr\xFCnlerin toplam durgun k\xFCtlesi ba\u015Flang\u0131\xE7taki par\xE7ac\u0131klar\u0131nkinden k\xFC\xE7\xFCkt\xFCr. Aradaki fark a\xE7\u0131\u011Fa \xE7\u0131kan enerjiye kar\u015F\u0131l\u0131k gelir; k\xFCtle ve enerji hesab\u0131 birlikte tutulur.", "matter", "mass-energy"],
      ["Deuterium\u2013tritium reaction products", "Deuterium and tritium can fuse into a helium nucleus and a neutron. Researchers study this reaction because its energy release and required conditions make it a practical research target.", "D\xF6teryum ile trityum birle\u015Ferek bir helyum \xE7ekirde\u011Fi ve n\xF6tron olu\u015Fturabilir. A\xE7\u0131\u011Fa \xE7\u0131kan enerji ve gereken ko\u015Fullar, bu tepkimeyi f\xFCzyon ara\u015Ft\u0131rmalar\u0131n\u0131n \xF6nemli hedeflerinden biri yapar.", "fusion", "experiment"]
    ]),
    ...series(52, "DOE Office of Science \xB7 Isotopes", "DOE Bilim Ofisi \xB7 \u0130zotoplar", "https://www.energy.gov/science/doe-explainsisotopes", "matter", [
      ["Same proton number, different neutron number", "Isotopes share an element\u2019s proton count but differ in neutrons. A small change inside the nucleus can create important differences within one chemical family.", "\u0130zotoplar\u0131n proton say\u0131s\u0131 ayn\u0131, n\xF6tron say\u0131s\u0131 farkl\u0131d\u0131r. \xC7ekirde\u011Fin i\xE7indeki bu k\xFC\xE7\xFCk de\u011Fi\u015Fiklik, ayn\u0131 kimyasal elementin \xFCyeleri aras\u0131nda kararl\u0131l\u0131k bak\u0131m\u0131ndan \xF6nemli farklar ortaya \xE7\u0131karabilir.", "atoms"],
      ["Carbon-14 decay and radiocarbon dating", "Carbon-14 decays with a characteristic half-life. Measuring how much remains lets researchers estimate the age of suitable organic remains through a physical clock within matter.", "Karbonun radyoaktif izotopu karbon-14, belirli bir yar\u0131 \xF6m\xFCrle bozunur. Kalan miktar\u0131 \xF6l\xE7mek, uygun organik kal\u0131nt\u0131lar\u0131n ya\u015F\u0131n\u0131 maddenin i\xE7indeki fiziksel bir saatten yararlanarak tahmin etmeyi sa\u011Flar.", "measurement"],
      ["Hydrogen isotope names and neutron counts", "Hydrogen, deuterium and tritium differ in their neutron counts. Even the simplest element has a richer nuclear family than its single place in the periodic table suggests.", "Hidrojenin d\xF6teryum ve trityum izotoplar\u0131 farkl\u0131 say\u0131da n\xF6tron ta\u015F\u0131r. En basit elementin bile, periyodik tablodaki tek bir kutunun ilk bak\u0131\u015Fta d\xFC\u015F\xFCnd\xFCrd\xFC\u011F\xFCnden daha zengin bir \xE7ekirdek ailesi vard\u0131r.", "curiosity"]
    ]),
    ...series(55, "DOE Office of Science \xB7 Nucleosynthesis", "DOE Bilim Ofisi \xB7 N\xFCkleosentez", "https://www.energy.gov/science/doe-explainsnucleosynthesis", "matter", [
      ["Light nuclei in the first minutes of the universe", "The early universe produced light nuclei, including hydrogen and helium. The material from which later stars formed already carried a history of cooling and nuclear reactions.", "Evrenin ilk d\xF6neminde hidrojen ve helyum gibi hafif \xE7ekirdekler olu\u015Ftu. Daha sonra y\u0131ld\u0131zlar\u0131 kuran madde, so\u011Fuman\u0131n ve n\xFCkleer tepkimelerin izlerini ta\u015F\u0131yan bir ge\xE7mi\u015Fe sahipti.", "cosmos"],
      ["Stellar reactions form heavier elements", "Stars build many heavier nuclei through nuclear reactions. The periodic table records a history of cosmic processes, not merely a collection of laboratory names.", "Y\u0131ld\u0131zlar\u0131n i\xE7indeki n\xFCkleer tepkimeler, daha a\u011F\u0131r pek \xE7ok \xE7ekirde\u011Fin olu\u015Fmas\u0131n\u0131 sa\u011Flar. Periyodik tablo yaln\u0131zca laboratuvar adlar\u0131n\u0131 de\u011Fil, evrende ya\u015Fanm\u0131\u015F uzun bir madde tarihini de yans\u0131t\u0131r.", "stars"],
      ["Neutron-rich environments and heavy-element production", "Neutron-star mergers can produce heavy elements such as gold. Studying these distant events helps explain the origins of materials people can hold in their hands.", "N\xF6tron y\u0131ld\u0131z\u0131 birle\u015Fmeleri, alt\u0131n gibi a\u011F\u0131r elementlerin olu\u015Fmas\u0131na katk\u0131 verebilir. \xC7ok uzak olaylar\u0131 ara\u015Ft\u0131rmak, elimizde tutabildi\u011Fimiz maddelerin k\xF6kenini anlamaya uzanan somut bir bilimsel yoldur.", "curiosity"]
    ]),
    ...series(58, "DOE Office of Science \xB7 Quarks and Gluons", "DOE Bilim Ofisi \xB7 Kuarklar ve Gluonlar", "https://www.energy.gov/science/doe-explainsquarks-and-gluons", "matter", [
      ["Quarks and gluons within composite particles", "Protons and neutrons have internal structure: quarks interact through gluons. Looking beneath an apparently simple building block reveals another level of physical organization.", "Proton ve n\xF6tronlar\u0131n i\xE7 yap\u0131s\u0131nda, gluonlar arac\u0131l\u0131\u011F\u0131yla etkile\u015Fen kuarklar bulunur. Basit g\xF6r\xFCnen bir yap\u0131ta\u015F\u0131n\u0131n i\xE7ine bakmak, maddenin \xF6rg\xFCtlenmesinde ba\u015Fka bir fiziksel katman\u0131 ortaya \xE7\u0131kar\u0131r.", "particles"],
      ["Interactions account for most proton and neutron mass", "Most proton and neutron mass comes from quark\u2013gluon dynamics. A particle\u2019s mass is therefore not explained by adding the rest masses of its constituent quarks alone.", "Proton ve n\xF6tron k\xFCtlesinin b\xFCy\xFCk b\xF6l\xFCm\xFC kuarklarla gluonlar\u0131n dinami\u011Finden kaynaklan\u0131r. Bu par\xE7ac\u0131klar\u0131n k\xFCtlesini anlamak i\xE7in, i\xE7lerindeki kuarklar\u0131n durgun k\xFCtlelerini toplamak tek ba\u015F\u0131na yeterli de\u011Fildir.", "energy", "mass-energy"],
      ["Quark\u2013gluon plasma in collider experiments", "Heavy-ion experiments create quark\u2013gluon plasma under extreme conditions. Laboratory collisions offer a way to investigate a state of matter associated with the universe\u2019s earliest moments.", "A\u011F\u0131r iyon deneyleri, a\u015F\u0131r\u0131 ko\u015Fullar alt\u0131nda kuark-gluon plazmas\u0131 olu\u015Fturur. Laboratuvardaki \xE7arp\u0131\u015Fmalar, evrenin en erken d\xF6nemleriyle ili\u015Fkili bir madde h\xE2lini incelemek i\xE7in deneysel bir pencere a\xE7ar.", "experiment"]
    ]),
    ...series(61, "DOE Office of Science \xB7 Plasma", "DOE Bilim Ofisi \xB7 Plazma", "https://www.energy.gov/science/doe-explainsplasma", "matter", [
      ["Free electrons and ions distinguish plasma", "Plasma contains free electrons and ions, giving it collective electrical behavior unlike an ordinary neutral gas. Familiar matter can behave differently when its charges become mobile.", "Plazma, serbest elektronlarla iyonlar i\xE7erir; bu y\xFCzden s\u0131radan n\xF6tr gazlardan farkl\u0131 elektriksel davran\u0131\u015Flar g\xF6sterir. Maddenin y\xFCkleri hareket \xF6zg\xFCrl\xFC\u011F\xFC kazand\u0131\u011F\u0131nda, ortak davran\u0131\u015F\u0131 da belirgin bi\xE7imde de\u011Fi\u015Fir.", "plasma"],
      ["Low-temperature plasma can be only partly ionized", "Not every plasma is scorching throughout. In low-temperature plasmas, partial ionization allows energetic electrons to coexist with much cooler gas, widening the range of possible applications.", "Her plazman\u0131n b\xFCt\xFCn\xFCyle kavurucu olmas\u0131 gerekmez. D\xFC\u015F\xFCk s\u0131cakl\u0131kl\u0131 plazmalarda, k\u0131smi iyonla\u015Fma sayesinde enerjik elektronlarla \xE7ok daha serin gaz birlikte bulunabilir; bu fark uygulama olanaklar\u0131n\u0131 geni\u015Fletir.", "plasma"],
      ["Plasma research and semiconductor manufacturing", "Plasma research helps control semiconductor manufacturing at very small scales. Understanding a state common in stars can also improve the devices used in everyday life.", "Plazma ara\u015Ft\u0131rmalar\u0131, yar\u0131iletken \xFCretimini \xE7ok k\xFC\xE7\xFCk \xF6l\xE7eklerde kontrol etmeye yard\u0131mc\u0131 olur. Y\u0131ld\u0131zlarda yayg\u0131n olan bir madde h\xE2lini anlamak, g\xFCnl\xFCk ya\u015Fam\u0131m\u0131zdaki cihazlar\u0131n yap\u0131m\u0131n\u0131 da geli\u015Ftirebilir.", "plasma", "technology"]
    ]),
    ...series(64, "U.S. Department of Energy \xB7 How Particle Accelerators Work", "ABD Enerji Bakanl\u0131\u011F\u0131 \xB7 Par\xE7ac\u0131k H\u0131zland\u0131r\u0131c\u0131lar\u0131", "https://www.energy.gov/articles/how-particle-accelerators-work", "experiment", [
      ["Electric acceleration and magnetic steering", "Accelerators use electric fields to increase particle energy and magnetic fields to steer the beam. Gaining speed and choosing direction are separate physical jobs.", "H\u0131zland\u0131r\u0131c\u0131lar, par\xE7ac\u0131k enerjisini art\u0131rmak i\xE7in elektrik alanlar\u0131n\u0131, demeti y\xF6nlendirmek i\xE7in manyetik alanlar\u0131 kullan\u0131r. H\u0131z kazand\u0131rmak ile y\xF6n se\xE7mek, bu d\xFCzeneklerde ayr\u0131 fiziksel g\xF6revlerdir.", "energy"],
      ["Vacuum beam pipes reduce unwanted collisions", "A beam travels through a vacuum so that air and dust do not constantly obstruct it. Preparing the environment is part of making a precise experiment possible.", "Par\xE7ac\u0131k demeti, hava ve tozla s\xFCrekli \xE7arp\u0131\u015Fmamas\u0131 i\xE7in vakum i\xE7inde ilerler. Deneyin \xE7evresini haz\u0131rlamak, hassas bir \xF6l\xE7\xFCm\xFC m\xFCmk\xFCn k\u0131lan i\u015Fin ayr\u0131lmaz bir par\xE7as\u0131d\u0131r.", "engineering"],
      ["Linear and circular accelerator layouts", "Linear accelerators send particles along a straight path; circular machines repeatedly bend their course. Different layouts give experimenters different ways to arrange beams and targets.", "Do\u011Frusal h\u0131zland\u0131r\u0131c\u0131lar par\xE7ac\u0131klar\u0131 d\xFCz bir yolda ilerletir; dairesel makineler yollar\u0131n\u0131 tekrar tekrar b\xFCker. Farkl\u0131 d\xFCzenler, ara\u015Ft\u0131rmac\u0131lara demetleri ve hedefleri kurmak i\xE7in farkl\u0131 olanaklar sunar.", "technology"]
    ]),
    ...series(67, "DOE Office of Science \xB7 Batteries", "DOE Bilim Ofisi \xB7 Bataryalar", "https://www.energy.gov/science/doe-explainsbatteries", "energy", [
      ["Chemical potential stores electrical input", "A rechargeable battery stores supplied electrical energy as chemical potential. Charging and using a device connect chemistry with an electrical circuit through controlled transformations.", "\u015Earj edilebilir bir batarya, verilen elektrik enerjisini kimyasal potansiyel bi\xE7iminde depolar. Cihaz\u0131 \u015Farj etmek ve kullanmak, kimyay\u0131 kontroll\xFC d\xF6n\xFC\u015F\xFCmler arac\u0131l\u0131\u011F\u0131yla elektrik devresine ba\u011Flar.", "storage"],
      ["Electrons outside, ions inside", "In a working battery, electrons move through the external circuit while ions move through the electrolyte. Coordinated charge transport keeps the electrical process going.", "\xC7al\u0131\u015Fan bir bataryada elektronlar d\u0131\u015F devreden, iyonlar ise elektrolitin i\xE7inden ilerler. Farkl\u0131 yollardaki bu e\u015Fg\xFCd\xFCml\xFC y\xFCk hareketi, elektriksel s\xFCrecin devam etmesini sa\u011Flar.", "matter"],
      ["Incomplete reversibility changes battery materials", "Battery reactions do not reverse perfectly in every cycle. Small structural and chemical changes accumulate, so studying aging is essential to designing longer-lasting storage.", "Batarya tepkimeleri her \xE7evrimde kusursuz bi\xE7imde geri d\xF6nmez. K\xFC\xE7\xFCk yap\u0131sal ve kimyasal de\u011Fi\u015Fiklikler birikir; ya\u015Flanmay\u0131 incelemek, daha uzun \xF6m\xFCrl\xFC enerji depolama sistemleri tasarlaman\u0131n temelidir.", "research"]
    ]),
    ...series(70, "DOE Office of Science \xB7 Catalysts", "DOE Bilim Ofisi \xB7 Kataliz\xF6rler", "https://www.energy.gov/science/doe-explainscatalysts", "experiment", [
      ["Lower activation-energy pathways", "A catalyst speeds a reaction by providing a lower activation-energy pathway. Chemistry can change the route a process takes without requiring more force or heat.", "Bir kataliz\xF6r, etkinle\u015Fme enerjisi daha d\xFC\u015F\xFCk bir yol sa\u011Flayarak tepkimeyi h\u0131zland\u0131r\u0131r. Kimya, daha fazla \u0131s\u0131 vermek yerine s\xFCrecin izledi\u011Fi yolu de\u011Fi\u015Ftirmeyi m\xFCmk\xFCn k\u0131lar.", "energy", "chemistry"],
      ["Selectivity reduces unwanted by-products", "A useful catalyst can favor a desired product over competing by-products. Improving a reaction means controlling what it produces as well as how quickly it runs.", "Yararl\u0131 bir kataliz\xF6r, istenen \xFCr\xFCn\xFCn olu\u015Fmas\u0131n\u0131 yan \xFCr\xFCnlere g\xF6re art\u0131rabilir. Bir tepkimeyi geli\u015Ftirmek, yaln\u0131zca h\u0131z\u0131n\u0131 de\u011Fil, sonunda ne \xFCretti\u011Fini de kontrol etmeyi gerektirir.", "chemistry"],
      ["Yeast enzymes as everyday catalysts", "The yeast used in bread contains enzymes that catalyze chemical changes. A familiar kitchen process carries examples of the same reaction principles explored in laboratories.", "Ekmek yap\u0131m\u0131nda kullan\u0131lan maya, kimyasal de\u011Fi\u015Fimleri h\u0131zland\u0131ran enzimler i\xE7erir. Mutfakta tan\u0131d\u0131k gelen bir s\xFCre\xE7, laboratuvarlarda incelenen tepkime ilkelerinin g\xFCnl\xFCk ya\u015Fam i\xE7indeki \xF6rneklerini ta\u015F\u0131r.", "curiosity", "chemistry"]
    ]),
    ...series(73, "Marie Curie \xB7 Radium and Radioactivity (1904)", "Marie Curie \xB7 Radyum ve Radyoaktiflik (1904)", "https://history.aip.org/exhibits/curie/article.htm", "research", [
      ["Measuring radiation through air conductivity", "Curie compared radiation by measuring air conductivity instead of relying only on photographic plates. Changing the measurement method turned an invisible effect into comparable data.", "Curie, \u0131\u015F\u0131n\u0131m\u0131 yaln\u0131zca foto\u011Fraf plakalar\u0131yla de\u011Fil, havan\u0131n iletkenli\u011Fini \xF6l\xE7erek kar\u015F\u0131la\u015Ft\u0131rd\u0131. \xD6l\xE7\xFCm y\xF6ntemini de\u011Fi\u015Ftirmek, g\xF6r\xFCnmeyen bir etkiyi kar\u015F\u0131la\u015Ft\u0131r\u0131labilir verilere d\xF6n\xFC\u015Ft\xFCren yarat\u0131c\u0131 bir ara\u015Ft\u0131rma ad\u0131m\u0131yd\u0131.", "measurement", "curiosity"],
      ["Borrowing rare-element samples from chemists", "Curie asked other chemists for rare samples to broaden her investigation. Knowledge advanced through materials and expertise that no single laboratory could supply alone.", "Curie, ara\u015Ft\u0131rmas\u0131n\u0131 geni\u015Fletmek i\xE7in ba\u015Fka kimyac\u0131lardan nadir \xF6rnekler istedi. Bilgi, tek bir laboratuvar\u0131n kendi ba\u015F\u0131na sa\u011Flayamayaca\u011F\u0131 malzemelerin ve uzmanl\u0131\u011F\u0131n payla\u015F\u0131lmas\u0131yla daha geni\u015F bir zeminde ilerledi.", "cooperation"],
      ["Repeated crystallization and industrial assistance", "Isolating radium required repeated crystallization and help beyond the original laboratory. A promising observation became a discovery through patient separation, equipment and practical support.", "Radyumu ay\u0131rmak, tekrarlanan kristallendirme i\u015Flemleriyle laboratuvar d\u0131\u015F\u0131ndan gelen deste\u011Fi gerektirdi. Umut verici g\xF6zlem; sab\u0131rl\u0131 ay\u0131rma \xE7al\u0131\u015Fmalar\u0131, ara\xE7lar ve somut yard\u0131mlarla do\u011Frulanm\u0131\u015F bir ke\u015Ffe d\xF6n\xFC\u015Ft\xFC.", "persistence"]
    ]),
    ...series(76, "Tu Youyou \xB7 Nobel Autobiography", "Tu Youyou \xB7 Nobel \xD6zya\u015Fam\xF6yk\xFCs\xFC", "https://www.nobelprize.org/prizes/medicine/2015/tu/biographical/", "research", [
      ["Training in extraction solvents and phytochemistry", "Tu Youyou\u2019s training connected plant knowledge with extraction and chemical analysis. Learning how to investigate a material gave her questions a practical experimental foundation.", "Tu Youyou\u2019nun e\u011Fitimi, bitki bilgisini \xF6z\xFCtleme ve kimyasal \xE7\xF6z\xFCmlemeyle bulu\u015Fturdu. Bir malzemeyi nas\u0131l ara\u015Ft\u0131raca\u011F\u0131n\u0131 \xF6\u011Frenmek, sordu\u011Fu sorulara uygulamal\u0131 ve deneysel bir temel kazand\u0131rd\u0131.", "learning"],
      ["Collecting and circulating research leads in 1969", "Tu gathered historical prescriptions and shared a selected collection with other research groups. Organizing possible leads made a large search more accessible to collective investigation.", "Tu, tarih\xEE re\xE7eteleri toplay\u0131p se\xE7ilmi\u015F bir derlemeyi ba\u015Fka ara\u015Ft\u0131rma gruplar\u0131yla payla\u015Ft\u0131. Olas\u0131 ipu\xE7lar\u0131n\u0131 d\xFCzenlemek, geni\u015F bir arama alan\u0131n\u0131 birlikte ara\u015Ft\u0131r\u0131labilir h\xE2le getiren somut bir katk\u0131yd\u0131.", "cooperation"],
      ["Revisiting a text suggested lower-temperature extraction", "After inconsistent results, Tu revisited an old description and questioned the extraction temperature. A specific change in technique opened a route that repeated unsuccessful attempts had missed.", "Tutars\u0131z sonu\xE7lar\u0131n ard\u0131ndan Tu, eski bir anlat\u0131ma d\xF6n\xFCp \xF6z\xFCtleme s\u0131cakl\u0131\u011F\u0131n\u0131 sorgulad\u0131. Y\xF6ntemdeki belirli bir de\u011Fi\u015Fiklik, \xF6nceki ba\u015Far\u0131s\u0131z denemelerin a\xE7amad\u0131\u011F\u0131 yeni bir ara\u015Ft\u0131rma yolu olu\u015Fturdu.", "persistence", "experimentation"]
    ]),
    ...series(79, "Aziz Sancar \xB7 Nobel Autobiography", "Aziz Sancar \xB7 Nobel \xD6zya\u015Fam\xF6yk\xFCs\xFC", "https://www.nobelprize.org/prizes/chemistry/2015/sancar/biographical/", "research", [
      ["Developing a method from information across fields", "Sancar describes an early experiment that required combining information from unrelated fields. His growth as a researcher came through making a new method actually work.", "Sancar, erken bir deneyinde farkl\u0131 alanlardan bilgi toplayarak yeni bir y\xF6ntem kurdu\u011Funu anlat\u0131r. Ara\u015Ft\u0131rmac\u0131 olarak geli\u015Fimi, bu y\xF6ntemi ger\xE7ekten \xE7al\u0131\u015F\u0131r h\xE2le getirme \xE7abas\u0131ndan beslendi.", "learning", "persistence"],
      ["Rupp\u2019s suggestions and nearly a year refining maxicells", "Dean Rupp\u2019s suggestions helped Sancar refine the maxicell method through nearly a year of work. Scientific independence can develop alongside serious attention to another researcher\u2019s advice.", "Dean Rupp\u2019\u0131n \xF6nerileri, Sancar\u2019\u0131n maxicell y\xF6ntemini yakla\u015F\u0131k bir y\u0131ll\u0131k \xE7al\u0131\u015Fmayla geli\u015Ftirmesine yard\u0131m etti. Bilimsel ba\u011F\u0131ms\u0131zl\u0131k, ba\u015Fka bir ara\u015Ft\u0131rmac\u0131n\u0131n katk\u0131s\u0131n\u0131 ciddiyetle de\u011Ferlendirmekle birlikte b\xFCy\xFCyebilir.", "cooperation"],
      ["Using maxicells to identify and purify repair proteins", "Once maxicells worked, Sancar used the method to identify and purify DNA-repair proteins. Building a useful tool enabled questions that had previously been difficult to approach.", "Maxicell y\xF6ntemi \xE7al\u0131\u015F\u0131nca Sancar, DNA onar\u0131m proteinlerini belirlemek ve safla\u015Ft\u0131rmak i\xE7in onu kulland\u0131. Yararl\u0131 bir ara\xE7 kurmak, daha \xF6nce yakla\u015F\u0131lmas\u0131 g\xFC\xE7 sorular\u0131 ara\u015Ft\u0131r\u0131labilir h\xE2le getirdi.", "tools", "action"]
    ]),
    ...series(82, "Venkatraman Ramakrishnan \xB7 Nobel Autobiography", "Venkatraman Ramakrishnan \xB7 Nobel \xD6zya\u015Fam\xF6yk\xFCs\xFC", "https://www.nobelprize.org/prizes/chemistry/2009/ramakrishnan/biographical/", "research", [
      ["Returning to undergraduate biology after a physics doctorate", "After a physics doctorate, Ramakrishnan returned to biology classes and laboratory rotations. Becoming a beginner again gave his new research direction the foundation it needed.", "Fizik doktoras\u0131ndan sonra Ramakrishnan, biyoloji derslerine ve laboratuvar \xE7al\u0131\u015Fmalar\u0131na d\xF6nd\xFC. Yeniden \xF6\u011Frenci olmay\u0131 kabul etmesi, se\xE7ti\u011Fi yeni ara\u015Ft\u0131rma y\xF6n\xFCne ihtiya\xE7 duydu\u011Fu sa\u011Flam temeli kazand\u0131rd\u0131.", "courage", "learning"],
      ["Stephen White encouraged crystallographic research", "Stephen White encouraged Ramakrishnan to investigate ribosomal proteins through crystallography. A colleague\u2019s invitation helped turn an unfamiliar technique into a productive part of his research.", "Stephen White, Ramakrishnan\u2019\u0131 ribozomal proteinleri kristalografiyle incelemeye te\u015Fvik etti. Bir meslekta\u015F\u0131n daveti, yabanc\u0131 bir tekni\u011Fin ara\u015Ft\u0131rmas\u0131nda \xFCretken bir yere sahip olmas\u0131na yard\u0131m etti.", "cooperation"],
      ["From attending a crystallography course to teaching it", "Ramakrishnan later taught in a crystallography course he had once attended. Developing and sharing methods turned a place of learning into a place of contribution.", "Ramakrishnan, \xF6nce \xF6\u011Frenci olarak kat\u0131ld\u0131\u011F\u0131 kristalografi dersinde daha sonra ders verdi. Y\xF6ntem geli\u015Ftirip payla\u015Fmak, \xF6\u011Frenmek i\xE7in girdi\u011Fi bir ortam\u0131 katk\u0131 sundu\u011Fu yere d\xF6n\xFC\u015Ft\xFCrd\xFC.", "learning", "teaching"]
    ]),
    ...series(85, "Serge Haroche \xB7 Nobel Autobiography", "Serge Haroche \xB7 Nobel \xD6zya\u015Fam\xF6yk\xFCs\xFC", "https://www.nobelprize.org/prizes/physics/2012/haroche/biographical/", "research", [
      ["Preparing lectures suggested new experiments", "Haroche found that explaining subtle physics clearly sometimes suggested new experiments. Teaching became a way to sharpen questions and discover what a demonstration should test.", "Haroche, incelikli fizi\u011Fi a\xE7\u0131k anlatmaya \xE7al\u0131\u015F\u0131rken bazen yeni deney fikirleri buldu. Ders haz\u0131rlamak, sorular\u0131 keskinle\u015Ftiren ve bir g\xF6sterimin neyi s\u0131namas\u0131 gerekti\u011Fini belirginle\u015Ftiren bir \xE7al\u0131\u015Fma oldu.", "teaching"],
      ["A better cavity enabled long-planned experiments in 2006", "An improved cavity finally let Haroche\u2019s group perform experiments imagined years earlier. Advancing the instrument was essential to bringing carefully developed theoretical proposals into the laboratory.", "Daha iyi bir kavite, Haroche\u2019un ekibinin y\u0131llar \xF6nce tasarlad\u0131\u011F\u0131 deneyleri sonunda ger\xE7ekle\u015Ftirmesini sa\u011Flad\u0131. Arac\u0131 geli\u015Ftirmek, \xF6zenle haz\u0131rlanm\u0131\u015F kuramsal \xF6nerileri laboratuvara ta\u015F\u0131man\u0131n gerekli bir par\xE7as\u0131yd\u0131.", "persistence", "tools"],
      ["Joint book with Jean-Michel Raimond connected approaches", "Haroche and Jean-Michel Raimond spent years connecting cavity experiments with related quantum systems in a book. Sustained collaboration made separate approaches part of a coherent account.", "Haroche ile Jean-Michel Raimond, kavite deneylerini ilgili kuantum sistemleriyle ili\u015Fkilendiren bir kitap \xFCzerinde y\u0131llarca \xE7al\u0131\u015Ft\u0131. S\xFCregelen i\u015Fbirli\u011Fi, ayr\u0131 yakla\u015F\u0131mlar\u0131 tutarl\u0131 bir anlat\u0131da bulu\u015Fturdu.", "cooperation"]
    ]),
    ...series(88, "Esther Takeuchi \xB7 First-Person Science, DOE", "Esther Takeuchi \xB7 DOE Birinci A\u011F\u0131zdan Bilim", "https://www.energy.gov/science/articles/first-person-science-esther-takeuchi-batteries", "research", [
      ["Battery research connects atomic and everyday scales", "Takeuchi studies batteries across scales, from electron motion to years of operation. Understanding a practical object requires connecting fast microscopic events with its long working life.", "Takeuchi, bataryalar\u0131 elektron hareketinden y\u0131llarca kullan\u0131ma kadar uzanan \xF6l\xE7eklerde inceler. Kullan\u0131\u015Fl\u0131 bir nesneyi anlamak, \xE7ok h\u0131zl\u0131 mikroskobik olaylar\u0131 uzun \xE7al\u0131\u015Fma \xF6mr\xFCyle ili\u015Fkilendirmeyi gerektirir.", "energy", "curiosity"],
      ["Initial performance reversed after repeated cycling", "Takeuchi\u2019s team found that an initially better material deteriorated after repeated cycling. Continuing the experiment revealed a limitation that early success alone would have hidden.", "Takeuchi\u2019nin ekibi, ba\u015Flang\u0131\xE7ta daha iyi \xE7al\u0131\u015Fan malzemenin tekrarlanan \xE7evrimlerde geriledi\u011Fini g\xF6rd\xFC. Deneyi s\xFCrd\xFCrmek, ilk ba\u015Far\u0131n\u0131n tek ba\u015F\u0131na g\xF6r\xFCnmez b\u0131rakaca\u011F\u0131 \xF6nemli bir s\u0131n\u0131r\u0131 a\xE7\u0131\u011Fa \xE7\u0131kard\u0131.", "evidence"],
      ["Operando measurements preserve the working environment", "Instead of only opening a used battery, Takeuchi\u2019s group measured it while operating. Studying the system in action preserved conditions that dismantling could change.", "Takeuchi\u2019nin grubu, kullan\u0131lm\u0131\u015F bataryay\u0131 yaln\u0131zca s\xF6k\xFCp incelemek yerine \xE7al\u0131\u015F\u0131rken \xF6l\xE7t\xFC. Sistemi i\u015F ba\u015F\u0131nda g\xF6zlemlemek, par\xE7alar\u0131na ay\u0131rman\u0131n de\u011Fi\u015Ftirebilece\u011Fi ko\u015Fullar\u0131 koruyarak yeni bilgiler elde etmelerini sa\u011Flad\u0131.", "measurement"]
    ]),
    ...series(91, "Jos\xE9 Rodriguez \xB7 DOE, Using X-Rays to Probe Catalysts", "Jos\xE9 Rodriguez \xB7 DOE, Kataliz\xF6rleri X I\u015F\u0131nlar\u0131yla \u0130ncelemek", "https://www.energy.gov/science/using-x-rays-probe-mystery-catalysts", "research", [
      ["Following active sites during chemical transformations", "Rodriguez studies catalysts as their active sites change during reactions. Seeing a material at work can explain behavior that a static description leaves unresolved.", "Rodriguez, kataliz\xF6rlerin etkin b\xF6lgelerini tepkime s\u0131ras\u0131nda de\u011Fi\u015Firken inceler. Malzemeyi \xE7al\u0131\u015F\u0131rken g\xF6rmek, dura\u011Fan bir tasvirin a\xE7\u0131klayamad\u0131\u011F\u0131 davran\u0131\u015Flar\u0131 anlamak i\xE7in ara\u015Ft\u0131rmaya farkl\u0131 bir bak\u0131\u015F a\xE7\u0131s\u0131 kazand\u0131r\u0131r.", "chemistry"],
      ["Adapting vacuum chambers for controlled X-ray studies", "Rodriguez\u2019s team adapted specialized vacuum chambers for controlled X-ray studies. Reusing an instrument in a new setting helped connect structural, electronic and chemical measurements.", "Rodriguez\u2019in ekibi, \xF6zel vakum odalar\u0131n\u0131 kontroll\xFC X \u0131\u015F\u0131n\u0131 \xE7al\u0131\u015Fmalar\u0131na uyarlad\u0131. Bir arac\u0131 yeni ba\u011Flamda kullanmak, yap\u0131sal, elektronik ve kimyasal \xF6l\xE7\xFCmleri ayn\u0131 ara\u015Ft\u0131rmada bulu\u015Fturmaya yard\u0131mc\u0131 oldu.", "tools"],
      ["Mentoring trainees alongside instrument development", "Rodriguez combines instrument development with mentoring young researchers. A laboratory\u2019s contribution includes people who gain the skills to ask and investigate the next questions.", "Rodriguez, ara\xE7 geli\u015Ftirmeyi gen\xE7 ara\u015Ft\u0131rmac\u0131lara rehberlikle birlikte y\xFCr\xFCt\xFCr. Bir laboratuvar\u0131n katk\u0131s\u0131, sonraki sorular\u0131 sorabilecek ve inceleyebilecek becerileri kazanan insanlarda da ya\u015Famaya devam eder.", "cooperation", "teaching"]
    ]),
    ...series(94, "Frances H. Arnold \xB7 Innovation by Evolution, Nobel Lecture", "Frances H. Arnold \xB7 Evrimle Yenilik, Nobel Konu\u015Fmas\u0131", "https://www.nobelprize.org/uploads/2018/10/arnold-lecture.pdf", "research", [
      ["Replacing detailed design with directed evolution", "Arnold used directed evolution when detailed enzyme design was too difficult. Changing the research strategy let selection and experiment explore possibilities that prediction alone could not master.", "Arnold, ayr\u0131nt\u0131l\u0131 enzim tasar\u0131m\u0131 \xE7ok g\xFC\xE7 oldu\u011Funda y\xF6nlendirilmi\u015F evrimden yararland\u0131. Ara\u015Ft\u0131rma stratejisini de\u011Fi\u015Ftirmek, yaln\u0131zca tahminle y\xF6netilemeyen olas\u0131l\u0131klar\u0131 deney ve se\xE7ilim yoluyla incelemeyi m\xFCmk\xFCn k\u0131ld\u0131.", "adaptability"],
      ["Successive generations accumulated improvements", "Arnold\u2019s experiments accumulated useful changes across successive generations of enzymes. Each round supplied material for the next, making improvement a process of testing and selection.", "Arnold\u2019\u0131n deneyleri, yararl\u0131 de\u011Fi\u015Fiklikleri ard\u0131\u015F\u0131k enzim ku\u015Faklar\u0131nda biriktirdi. Her tur bir sonrakine malzeme sa\u011Flad\u0131; geli\u015Fme, \xF6l\xE7\xFClen sonu\xE7lara dayanan bir s\u0131nama ve se\xE7me s\xFCreci olarak kuruldu.", "persistence"],
      ["Beneficial mutations beyond the immediate catalytic site", "Useful enzyme mutations appeared outside the obvious catalytic center. Arnold\u2019s results showed that performance can depend on parts whose contribution is not immediately apparent.", "Yararl\u0131 enzim de\u011Fi\u015Fiklikleri, yaln\u0131zca belirgin katalitik merkezde ortaya \xE7\u0131kmad\u0131. Arnold\u2019\u0131n sonu\xE7lar\u0131, i\u015Fleyi\u015Fin katk\u0131s\u0131 ilk bak\u0131\u015Fta anla\u015F\u0131lmayan b\xF6lgelere de ba\u011Fl\u0131 olabilece\u011Fini deneysel olarak g\xF6sterdi.", "curiosity"]
    ]),
    ...series(97, "Nobel Committee for Physiology or Medicine \xB7 2023 Background", "Nobel Fizyoloji veya T\u0131p Komitesi \xB7 2023 A\xE7\u0131klamas\u0131", "https://www.nobelprize.org/prizes/medicine/2023/press-release/", "research", [
      ["Karik\xF3 and Weissman combined RNA and immunology interests", "Karik\xF3 and Weissman joined different research interests around one question: how RNA interacts with immunity. Their collaboration made complementary expertise useful against a shared experimental obstacle.", "Karik\xF3 ile Weissman, farkl\u0131 ara\u015Ft\u0131rma ilgilerini RNA\u2019n\u0131n ba\u011F\u0131\u015F\u0131kl\u0131kla etkile\u015Fimi sorusunda bulu\u015Fturdu. \u0130\u015Fbirlikleri, birbirini tamamlayan uzmanl\u0131klar\u0131 ortak bir deneysel engeli anlamak i\xE7in kullan\u0131labilir h\xE2le getirdi.", "cooperation"],
      ["Comparing RNA types and modified bases", "Comparing different forms of RNA helped Karik\xF3 and Weissman identify the importance of modified bases. A carefully chosen comparison exposed a detail with major consequences.", "Farkl\u0131 RNA bi\xE7imlerini kar\u015F\u0131la\u015Ft\u0131rmak, Karik\xF3 ile Weissman\u2019\u0131n de\u011Fi\u015Ftirilmi\u015F bazlar\u0131n \xF6nemini belirlemesine yard\u0131m etti. \xD6zenle se\xE7ilen bir kar\u015F\u0131la\u015Ft\u0131rma, b\xFCy\xFCk sonu\xE7lar do\u011Furan k\xFC\xE7\xFCk bir ayr\u0131nt\u0131y\u0131 a\xE7\u0131\u011Fa \xE7\u0131kard\u0131.", "evidence"],
      ["Further studies in 2008 and 2010 tested protein production", "Karik\xF3 and Weissman continued beyond their first finding to study protein production. Follow-up experiments established additional effects instead of treating an initial breakthrough as the final answer.", "Karik\xF3 ile Weissman, ilk bulgunun ard\u0131ndan protein \xFCretimini incelemeyi s\xFCrd\xFCrd\xFC. Takip deneyleri ek etkileri ortaya koydu; ba\u015Flang\u0131\xE7taki ilerleme, sorulacak b\xFCt\xFCn sorular\u0131n sonu say\u0131lmad\u0131.", "persistence"]
    ]),
    ...series(100, "Ahmed Zewail \xB7 Nobel Lecture, 1999", "Ahmed Zewail \xB7 Nobel Konu\u015Fmas\u0131, 1999", "https://www.nobelprize.org/uploads/2018/06/zewail-lecture.pdf", "research", [
      ["Acknowledging the international femtochemistry research team", "Zewail credited the international team behind decades of femtochemistry research. A scientific achievement can carry the patient contributions of many students, visitors and colleagues.", "Zewail, femtokimya \xE7al\u0131\u015Fmalar\u0131n\u0131n arkas\u0131ndaki uluslararas\u0131 ekibin katk\u0131lar\u0131n\u0131 anlatt\u0131. Bir bilimsel ba\u015Far\u0131, \xE7ok say\u0131da \xF6\u011Frencinin, konuk ara\u015Ft\u0131rmac\u0131n\u0131n ve meslekta\u015F\u0131n y\u0131llara yay\u0131lan sab\u0131rl\u0131 eme\u011Fini i\xE7inde ta\u015F\u0131yabilir.", "cooperation"]
    ])
  ];

  // src/data/quoteExpansionPhilosophyMore.ts
  init_define_import_meta_env();
  function readings(key, author, authorTr, book, bookTr, sourceUrl, rows, islamic = false) {
    return rows.map(([reference, tr2, text2, tags], index) => ({
      id: `philosophy-more-${key}-${String(index + 1).padStart(2, "0")}`,
      tr: tr2,
      text: text2,
      source: `${author} \u2014 ${book}`,
      sourceTr: `${authorTr} \u2014 ${bookTr}`,
      sourceUrl,
      reference,
      category: "philosophy",
      kind: "adaptation",
      tags: [...islamic ? ["islamic-philosophy"] : [], ...tags]
    }));
  }
  var PHILOSOPHY_QUOTES_MORE = [
    ...readings("ghazali-confessions", "Al-Ghazali", "Gaz\xE2l\xEE", "Deliverance from Error (Field, 1909)", "el-Munk\u0131z mine\u2019d-Dal\xE2l (Field, 1909)", "https://www.gutenberg.org/files/58977/58977-h/58977-h.htm", [
      ["Search for Truth: inherited beliefs", "\xC7ocuklu\u011Fundan beri duydu\u011Fun bir d\xFC\u015F\xFCncenin sende k\xF6k salmas\u0131 do\u011Fald\u0131r. \u015Eimdi ona kendi anlay\u0131\u015F\u0131nla yakla\u015F; neye, hangi gerek\xE7eyle inand\u0131\u011F\u0131n\u0131 ara\u015Ft\u0131rmak, inanc\u0131na kar\u015F\u0131 de\u011Fil onun sorumlulu\u011Funu \xFCstlenmeye do\u011Fru bir ad\u0131m olabilir.", "An inherited belief can feel inseparable from you. Returning to its grounds with your own understanding can be an act of responsibility toward your faith and the life you build around it.", ["faith", "self", "courage"]],
      ["The Subterfuges of the Sophists: the moving shadow", "G\xF6z\xFCn\xFCn \xF6n\xFCndeki g\xF6lge bile, anl\u0131k bak\u0131\u015F\u0131n yakalayamad\u0131\u011F\u0131 bir de\u011Fi\u015Fim ta\u015F\u0131yabilir. \u0130lk izlenimine biraz zaman ver; kendini ve d\xFCnyay\u0131 tek bir g\xF6r\xFCnt\xFCn\xFCn i\xE7ine hapsetmeden, yeniden bakmaya a\xE7\u0131k ol.", "Even a shadow changes while a glance calls it still. Give an impression time before allowing it to settle your understanding of yourself or the world.", ["self", "perspective", "patience"]],
      ["Philosophy: understanding a discipline before refuting it", "Kar\u015F\u0131 \xE7\u0131kt\u0131\u011F\u0131n fikri yaln\u0131z zay\u0131f yan\u0131ndan tan\u0131yorsan, hen\xFCz b\xFCt\xFCn\xFCn\xFC g\xF6rmemi\u015F olabilirsin. \u0130tiraz\u0131n\u0131 g\xFC\xE7lendirmek i\xE7in \xF6nce onu ciddi bi\xE7imde \xF6\u011Fren; anlamaya ay\u0131rd\u0131\u011F\u0131n emek, kendi d\xFC\u015F\xFCncene de sa\u011Flaml\u0131k kazand\u0131rs\u0131n.", "An argument deserves to be understood at its strongest before you challenge it. Learning its discipline carefully can make your disagreement more responsible and your own position better grounded.", ["humility", "learning", "reason"]],
      ["Divisions of the Philosophic Sciences: mathematics and religious belief", "\u0130nanc\u0131n\u0131 koruma iste\u011Fin, do\u011Fru bir hesab\u0131 ya da a\xE7\u0131k bir kan\u0131t\u0131 reddetmeyi gerektirmez. Hangi sorunun hangi bilgiyle yan\u0131tland\u0131\u011F\u0131n\u0131 ay\u0131rt etmek, zihninde gereksiz bir \xE7at\u0131\u015Fman\u0131n b\xFCy\xFCmesini \xF6nleyebilir.", "You need not reject a sound calculation to protect your faith. Distinguishing the questions different disciplines answer can prevent an unnecessary conflict from taking root in your mind.", ["faith", "reason", "discernment"]],
      ["Divisions of the Philosophic Sciences: truth and the identity of its speaker", "Bir d\xFC\u015F\xFCnceyi yaln\u0131z s\xF6yleyen ki\u015Fiye duydu\u011Fun yak\u0131nl\u0131kla tartma. Sevmedi\u011Fin birinden gelen do\u011Fruyu da inceleyebilmek, benli\u011Finin taraf tutma iste\u011Finden bir ad\u0131m uzakla\u015F\u0131p hakikate daha adil yakla\u015Fmana yard\u0131m eder.", "Your feelings about a speaker need not decide the worth of an idea. Examining a truth from someone you dislike gives understanding a chance beyond personal allegiance.", ["ego", "truth", "humility"]],
      ["The Aim of Scholastic Theology: different remedies for different seekers", "Sana iyi gelmeyen bir d\xFC\u015F\xFCnme yolu, ba\u015Fkas\u0131n\u0131n aray\u0131\u015F\u0131na ger\xE7ekten yard\u0131mc\u0131 olmu\u015F olabilir. Kendi tecr\xFCbeni herkesin \xF6l\xE7\xFCs\xFC yapmadan anlat; farkl\u0131 ihtiya\xE7lar\u0131 kabul etmek, kendi yolunu se\xE7me hakk\u0131n\u0131 da korur.", "A path that did not help your inquiry may have helped someone else. Describe your experience without turning it into a universal measure for every seeker.", ["self", "difference", "compassion"]],
      ["Sufism: examining the motive behind teaching and reputation", "Yapt\u0131\u011F\u0131n i\u015Fin de\u011Feri kadar, seni ona ba\u011Flayan niyete de bak. Gaz\xE2l\xEE\u2019nin kendi \u015F\xF6hret arzusunu sorgulamas\u0131, d\u0131\u015Far\u0131dan ba\u015Far\u0131l\u0131 g\xF6r\xFCn\xFCrken i\xE7eride y\xF6n\xFCn\xFC yeniden se\xE7ebilece\u011Fini hat\u0131rlatan cesur bir duraklamad\u0131r.", "Consider the motive that keeps you in a respected role. Al-Ghazali\u2019s scrutiny of his own ambition offers a pause in which outward success can be reconsidered from within.", ["ego", "intention", "courage"]],
      ["Sufism: hesitation between leaving Baghdad and worldly attachment", "Bir de\u011Fi\u015Fimi istemekle ona haz\u0131r hissetmek ayn\u0131 anda gelmeyebilir. Gaz\xE2l\xEE\u2019nin uzun teredd\xFCd\xFCn\xFC d\xFC\u015F\xFCn; karars\u0131zl\u0131\u011F\u0131n\u0131 hemen karakter kusuru saymadan, seni tutan ba\u011F\u0131 d\xFCr\xFCst\xE7e tan\u0131maya ve se\xE7imini olgunla\u015Ft\u0131rmaya \xE7al\u0131\u015F.", "Wanting a change and feeling ready can arrive at different times. Al-Ghazali\u2019s prolonged hesitation invites an honest look at attachment without reducing uncertainty to a defect of character.", ["fear", "courage", "self"]]
    ], true),
    ...readings("ghazali-ihya", "Al-Ghazali", "Gaz\xE2l\xEE", "Ihya Ulum al-Din (Nawab Ali selections, 1921)", "\u0130hy\xE2 (Nawab Ali se\xE7kisi, 1921)", "https://www.gutenberg.org/files/73140/73140-h/73140-h.htm", [
      ["I, The Nature of Man: knowledge, appetite and will", "\u0130lk iste\u011Fin, verebilece\u011Fin tek karar de\u011Fildir. Gaz\xE2l\xEE\u2019nin irade anlay\u0131\u015F\u0131nda sonu\xE7lar\u0131 d\xFC\u015F\xFCnerek iyiyi se\xE7meye yer vard\u0131r; bug\xFCn g\xFC\xE7l\xFC bir d\xFCrt\xFCn\xFCn yan\u0131nda, neyi ger\xE7ekten onaylad\u0131\u011F\u0131n\u0131 da kendine sor.", "Your first impulse is not your only possible decision. Al-Ghazali distinguishes appetite from a will informed by consequences; ask what you can thoughtfully endorse alongside what you immediately want.", ["will", "self", "action"]],
      ["I, The Nature of Man: the body as the soul\u2019s vehicle", "\u0130\xE7 d\xFCnyan\u0131 geli\u015Ftirmek isterken bedenini \xF6nemsiz bir y\xFCk sayma. Gaz\xE2l\xEE\u2019nin yolculuk benzetmesinde ta\u015F\u0131t\u0131n da bak\u0131ma ihtiyac\u0131 vard\u0131r; \xF6\u011Frenmeye ve ibadete ay\u0131rd\u0131\u011F\u0131n \xF6zen, g\xFCnl\xFCk bak\u0131m\u0131na da uzanabilir.", "Inner development need not make bodily care seem trivial. In Al-Ghazali\u2019s journey metaphor the vehicle matters too; let everyday care support the attention you bring to learning and worship.", ["self", "care", "balance"]],
      ["III, Pride and Vanity: comparison and the claim to superiority", "Kendinde bir iyilik g\xF6rmen, ba\u015Fkas\u0131n\u0131 a\u015Fa\u011F\u0131da g\xF6rmeni gerektirmez. Gaz\xE2l\xEE\u2019nin kibir \xE7\xF6z\xFCmlemesinde sorun, de\u011Feri \xFCst\xFCnl\xFCk yar\u0131\u015F\u0131na \xE7evirmektir; yetene\u011Fini fark ederken kar\u015F\u0131ndakinin e\u015Fit insanl\u0131k de\u011Ferine de yer b\u0131rak.", "Recognizing something good in yourself need not place another person beneath you. Al-Ghazali\u2019s account of pride questions the ranking impulse that turns a gift into a claim to superiority.", ["ego", "dignity", "humility"]],
      ["III, Pride and Vanity: the inability to receive advice", "Bir uyar\u0131 duydu\u011Funda hemen itibar\u0131n\u0131 savunmak isteyebilirsin. \xD6nce i\xE7inde i\u015Fe yarayan bir \u015Fey olup olmad\u0131\u011F\u0131n\u0131 dinle; kendini her an hakl\u0131 g\xF6stermek zorunda kalmamak, benli\u011Fine beklemedi\u011Fin bir ferahl\u0131k verebilir.", "A correction can make you rush to protect your standing. Listen for what it offers before defending yourself; freedom from constant self-justification leaves room to grow.", ["ego", "learning", "courage"]],
      ["III, Pride and Vanity: learning magnifies the learner\u2019s disposition", "Bilgi \xE7o\u011Fald\u0131k\xE7a kusurlar\u0131n\u0131n kendili\u011Finden azalaca\u011F\u0131n\u0131 varsayma. Gaz\xE2l\xEE, \xF6\u011Frenmenin kibri de besleyebilece\u011Fini hat\u0131rlat\u0131r; her yeni becerinin yan\u0131nda, onu insanlara nas\u0131l davrand\u0131\u011F\u0131nda g\xF6sterdi\u011Fini de dikkatle g\xF6zden ge\xE7ir.", "More knowledge does not automatically mean fewer faults. Al-Ghazali warns that learning can nourish pride; notice how each new ability changes the way you meet other people.", ["ego", "knowledge", "integrity"]],
      ["III, Pride and Vanity: the pride of the religious devotee", "\u0130badetinin sende b\u0131rakt\u0131\u011F\u0131 izi, ba\u015Fkas\u0131na bakt\u0131\u011F\u0131n yerde de ara. Daha \xE7ok k\xFC\xE7\xFCmsemeye ba\u015Flad\u0131ysan durup niyetini yokla; manev\xEE emek, insanlar\u0131 mahk\xFBm etme yetkisi ald\u0131\u011F\u0131n bir mertebeye d\xF6n\xFC\u015Fmesin.", "Look for the effects of devotion in your regard for others. If contempt is growing, examine the motive; spiritual practice need not become a claim to judge everyone beneath you.", ["faith", "ego", "compassion"]],
      ["III, Pride and Vanity: pride in ancestry", "Ailenden gelen bir ad\u0131, kendi eme\u011Finin yerine koymak zorunda de\u011Filsin. Ge\xE7mi\u015Finle ba\u011F\u0131n\u0131 korurken bug\xFCnk\xFC davran\u0131\u015F\u0131na da sahip \xE7\u0131k; sana b\u0131rak\u0131lan itibar, \u015Fimdi nas\u0131l ya\u015Fad\u0131\u011F\u0131n\u0131n sorusunu senin ad\u0131na cevaplamaz.", "An inherited name cannot do your living for you. Honor your connection with the past while taking responsibility for conduct that belongs to you today.", ["ego", "responsibility", "identity"]],
      ["IV, Friendship and Sincerity: wisdom joined with good character", "Bir dostun yaln\u0131zca zeki olmas\u0131, yan\u0131nda g\xFCvende hissedece\u011Fin anlam\u0131na gelmeyebilir. Yak\u0131nl\u0131k kurarken bilgisiyle birlikte huyuna da bak; akl\u0131n s\u0131cak bir karakterle bulu\u015Fmas\u0131, arkada\u015Fl\u0131\u011Fa daha sa\u011Flam bir zemin verir.", "Intelligence alone does not make a trustworthy companion. Notice character as well as insight; friendship needs a way of treating people that knowledge by itself cannot supply.", ["friendship", "discernment", "trust"]],
      ["IV, Friendship and Sincerity: ideals and practical friendship", "Kusursuz dostu beklerken kurulabilecek b\xFCt\xFCn ba\u011Flardan vazge\xE7me. Gaz\xE2l\xEE, ideal tasvirlerin yan\u0131nda ger\xE7ek hayat\u0131n \u015Fartlar\u0131n\u0131 da d\xFC\u015F\xFCn\xFCr; makul bir beklentiyle yakla\u015Fmak, insanlar\u0131n verebildi\u011Fi iyili\u011Fi g\xF6rmeni ve kar\u015F\u0131l\u0131k vermeni kolayla\u015Ft\u0131rabilir.", "Waiting for a flawless friend can leave every possible connection unopened. Al-Ghazali tempers ideals with practical circumstances; reasonable expectations make the good someone can offer easier to recognize.", ["connection", "hope", "acceptance"]],
      ["IV, Friendship and Sincerity: mixed motives and their effects on the heart", "Bir davran\u0131\u015F\u0131n ard\u0131nda hem iyilik hem g\xF6r\xFCnme iste\u011Fi bulunabilir. Bunu fark etmek, b\xFCt\xFCn eme\u011Fini silmeni gerektirmez; bug\xFCn hangi niyeti besledi\u011Fine bak\u0131p bir sonraki davran\u0131\u015F\u0131n\u0131 daha i\xE7ten se\xE7ebilirsin.", "Care and a wish for recognition can share one action. Noticing the mixture need not erase your effort; consider which motive your next choice will strengthen.", ["ego", "intention", "renewal"]],
      ["V, The Nature of Love: inner beauty and qualities of character", "G\xFCzelli\u011Fi yaln\u0131z g\xF6r\xFCnen bi\xE7ime ba\u011Flad\u0131\u011F\u0131nda, adaletin ve c\xF6mertli\u011Fin \xE7ekicili\u011Fi g\xF6zden ka\xE7abilir. Bir insanda hayran oldu\u011Fun niteli\u011Fi adland\u0131r; kendi hayat\u0131nda o niteli\u011Fe nas\u0131l yer a\xE7abilece\u011Fini de d\xFC\u015F\xFCn.", "Beauty can be encountered in justice and generosity as well as appearance. Name a quality you admire in someone and consider what giving it room in your own life would involve.", ["self", "beauty", "values"]],
      ["VII, The Love of God and its Signs: loving the Creator\u2019s creatures", "Allah\u2019a duydu\u011Fun sevginin, yaratt\u0131klar\u0131na davran\u0131\u015F\u0131nda da kar\u015F\u0131l\u0131k bulmas\u0131na izin ver. Bir insan\u0131n yanl\u0131\u015F\u0131n\u0131 onaylamadan insanl\u0131\u011F\u0131n\u0131 g\xF6zetebilirsin; merhametle s\u0131n\u0131r koymak, kalbindeki ba\u011Fl\u0131l\u0131\u011F\u0131 g\xFCndelik hayatta daha g\xF6r\xFCn\xFCr k\u0131labilir.", "Let love of God find expression in your care for creation. You can reject a harmful action without erasing the person\u2019s humanity; compassion can accompany a clear boundary.", ["faith", "compassion", "boundaries"]]
    ], true),
    ...readings("tufayl", "Ibn Tufayl", "\u0130bn Tufeyl", "Hayy ibn Yaqzan (Ockley, 1708)", "Hayy bin Yakzan (Ockley, 1708)", "https://www.gutenberg.org/cache/epub/16831/pg16831-images.html", [
      ["\xA7\xA712\u201314: bodily comparison and making a covering", "Ba\u015Fkalar\u0131nda g\xF6rd\xFC\u011F\xFCn imk\xE2n sende yoksa, b\xFCt\xFCn g\xFCc\xFCn\xFCn de yok oldu\u011Funu d\xFC\u015F\xFCnme. Hayy\u2019\u0131n kendi ara\xE7lar\u0131n\u0131 yapmas\u0131n\u0131 hat\u0131rla; eksikli\u011Fini kabul ederek, elindeki beceriyle farkl\u0131 bir \xE7\xF6z\xFCm aramaya ba\u015Flayabilirsin.", "Missing an advantage others possess does not mean having no resources. Hayy\u2019s improvised tools suggest a beginning: acknowledge the difference and explore what your own abilities can make possible.", ["self", "courage", "resourcefulness"]],
      ["\xA715: improving an inadequate covering", "\u0130lk buldu\u011Fun \xE7\xF6z\xFCm\xFCn s\xFCrekli onar\u0131m istemesi, aray\u0131\u015F\u0131n\u0131n bo\u015Fa gitti\u011Fini g\xF6stermez. Hayy gibi kullan\u0131m\u0131n \xF6\u011Frettiklerine bak; ayn\u0131 soruna daha uygun bir d\xFCzen bulmak, ba\u015Flad\u0131\u011F\u0131n yoldan \xF6\u011Frenerek ilerlemenin par\xE7as\u0131d\u0131r.", "A first solution that keeps needing repair still teaches something. Hayy revises what he makes through use; improvement can grow from the inconvenience you have learned to describe.", ["action", "learning", "patience"]],
      ["\xA7\xA716\u201322: the doe\u2019s death and inquiry into life", "Sevdi\u011Fin bir varl\u0131\u011F\u0131n kayb\u0131, d\xFCnyay\u0131 eskisi gibi g\xF6rmeni zorla\u015Ft\u0131rabilir. Hayy\u2019\u0131n kederinden do\u011Fan sorular\u0131 d\xFC\u015F\xFCn; yas\u0131n hemen cevap bulmas\u0131n\u0131 beklemeden, anlam aray\u0131\u015F\u0131n\u0131n yan\u0131nda nazik\xE7e durmas\u0131na izin ver.", "Loss can disturb your whole understanding of life. Hayy\u2019s questions arise within grief; an inquiry into meaning can accompany sorrow without requiring an immediate answer or a quick recovery.", ["existence", "grief", "meaning"]],
      ["\xA723: learning burial from the raven", "\xD6\u011Fretmenin her zaman bekledi\u011Fin yerde durmaz. Hayy\u2019\u0131n kuzgundan \xF6\u011Frenmesini hat\u0131rla; kendi bilgisinin d\u0131\u015F\u0131ndaki bir davran\u0131\u015Fa dikkat kesilen insan, en yaln\u0131z zaman\u0131nda bile d\xFCnyadan yeni bir \u015Fey alabilir.", "A teacher need not arrive in a familiar form. Hayy learns by watching a raven; attention to a life unlike your own can keep learning open even in solitude.", ["humility", "attention", "learning"]],
      ["\xA724: approaching the unfamiliar fire", "Yeni bir \u015Fey korkuttu\u011Funda, korkunu yok saymak zorunda de\u011Filsin. Hayy\u2019\u0131n ate\u015Fe uzaktan bak\u0131p yava\u015F\xE7a yakla\u015Fmas\u0131 gibi, \xF6nce tehlikeyi tan\u0131; g\xFCvenli ve \xF6l\xE7\xFCl\xFC bir ad\u0131m merak\u0131na yeniden alan a\xE7abilir.", "Fear of something unfamiliar need not be dismissed. Like Hayy first observing fire from a distance, understand the danger and choose a measured, safe step toward what you want to learn.", ["fear", "courage", "action"]],
      ["\xA730: practical crafts accumulated by the third seven-year period", "Bir hayat\u0131 ta\u015F\u0131yan beceriler tek bir parlak bulu\u015Fla olu\u015Fmayabilir. Hayy\u2019\u0131n bar\u0131naktan ip yap\u0131m\u0131na uzanan eme\u011Fi gibi, k\xFC\xE7\xFCk ihtiya\xE7lar\u0131 \xE7\xF6zmeyi \xF6\u011Frenmek de zamanla kendine dayanabilece\u011Fin somut bir birikim kurar.", "Skills that sustain a life may accumulate through ordinary needs. Hayy\u2019s shelter and cord-making show how practical problems, worked through over time, can build a tangible basis for self-reliance.", ["confidence", "practice", "patience"]],
      ["\xA733: the many members and the unity of a living being", "Kendini yaln\u0131z bir \xF6zelli\u011Finle tan\u0131mlad\u0131\u011F\u0131nda, hayat\u0131n\u0131n geri kalan\u0131 daralabilir. Hayy\u2019\u0131n \xE7okluk i\xE7inde b\xFCt\xFCnl\xFCk aray\u0131\u015F\u0131n\u0131 d\xFC\u015F\xFCn; d\xFC\u015F\xFCncelerin, bedenin ve u\u011Fra\u015Flar\u0131n aras\u0131ndaki ili\u015Fkilere bakarak kendine daha geni\u015F bir yer a\xE7.", "One trait need not stand for your entire existence. Hayy looks for unity among many parts; consider the relationships among your thoughts, body, and pursuits when reflecting on who you are.", ["self", "identity", "existence"]],
      ["\xA7\xA735\u201337: shared characteristics of animals and plants", "Canl\u0131lar aras\u0131ndaki ayr\u0131l\u0131klara bakarken ortak ihtiya\xE7lar\u0131 da fark et. Hayy\u2019\u0131n g\xF6zlemlerinde beslenme ve b\xFCy\xFCme pek \xE7ok bi\xE7imde s\xFCrer; kendini d\xFCnyan\u0131n d\u0131\u015F\u0131nda g\xF6rmeden, ya\u015Famla payla\u015Ft\u0131\u011F\u0131n ba\u011Flar\u0131 d\xFC\u015F\xFCnmeye zaman ay\u0131r.", "Difference among living things can coexist with shared needs. Hayy notices nourishment and growth across forms of life; consider the connections that place your existence within a wider living world.", ["existence", "connection", "care"]],
      ["\xA741: turning from an abstract difficulty to examining water", "Bir soru zihninde fazla soyutla\u015Ft\u0131\u011F\u0131nda, onu g\xF6rebilece\u011Fin bir \xF6rne\u011Fe yakla\u015Ft\u0131r. Hayy\u2019\u0131n suyu incelemeye y\xF6nelmesi gibi, elindeki somut durumdan ba\u015Flamak d\xFC\u015F\xFCnceni k\xFC\xE7\xFCltmez; ara\u015Ft\u0131rmana tutunabilece\u011Fin belirli bir yer verir.", "When a question becomes too abstract, bring it near an example you can examine. Hayy\u2019s attention turns to water; something concrete can provide a foothold for a difficult inquiry.", ["action", "reason", "clarity"]],
      ["\xA7\xA749\u201350: looking beyond nearby bodies to the heavens", "Uzun s\xFCre ayn\u0131 \xE7er\xE7evede d\xFC\u015F\xFCnmek, sorunun s\u0131n\u0131rlar\u0131n\u0131 d\xFCnyan\u0131n s\u0131n\u0131rlar\u0131 gibi g\xF6sterebilir. Hayy\u2019\u0131n bak\u0131\u015F\u0131n\u0131 g\xF6\u011Fe \xE7evirmesi gibi, bazen yeni bir \xF6l\xE7ek se\xE7mek, zihninde s\u0131k\u0131\u015Fan d\xFC\u015F\xFCnceye ba\u015Fka bir hareket alan\u0131 a\xE7ar.", "A familiar frame can begin to feel like the limit of reality. Hayy\u2019s inquiry turns toward the heavens; changing the scale of a question may give thought another direction.", ["perspective", "hope", "reason"]],
      ["\xA7\xA757\u201361: the ordered world and contemplation of its source", "Hayy i\xE7in varl\u0131ktaki d\xFCzen, bak\u0131\u015F\u0131n durdu\u011Fu son nokta de\u011Fil, yarat\u0131c\u0131ya y\xF6nelen d\xFC\u015F\xFCncenin ba\u015Flang\u0131c\u0131d\u0131r. Sen de hayret etti\u011Fin bir \u015Feyi ge\xE7i\u015Ftirmeden, onun sende uyand\u0131rd\u0131\u011F\u0131 anlam sorusuna biraz zaman verebilirsin.", "For Hayy, the world\u2019s order opens contemplation of its source. Stay for a moment with something that awakens wonder and the question of meaning it brings into your life.", ["faith", "existence", "wonder"]],
      ["\xA762: asking which faculty makes knowledge possible", "Bir sonuca vard\u0131\u011F\u0131nda, onu nas\u0131l bildi\u011Fini de sor. Hayy\u2019\u0131n kendi bilme g\xFCc\xFCne d\xF6nmesi gibi, g\xF6zlemle d\xFC\u015F\xFCnceyi ay\u0131rt etmek sana yaln\u0131z cevap de\u011Fil, zihninin i\u015Fleyi\u015Fine dair daha a\xE7\u0131k bir anlay\u0131\u015F kazand\u0131rabilir.", "After reaching a conclusion, ask how you reached it. Hayy examines his own ways of knowing; distinguishing observation from reflection can reveal something about the mind doing the inquiry.", ["self", "reason", "awareness"]],
      ["\xA7\xA766, 74\u201375: contemplation and the needs of bodily life", "Derin bir \u015Feye odaklanmak isterken g\xFCndelik ihtiya\xE7lar\u0131n araya girmesi, aray\u0131\u015F\u0131n\u0131 de\u011Fersiz k\u0131lmaz. Hayy bile bedeninin ihtiya\xE7lar\u0131yla kar\u015F\u0131la\u015F\u0131r; anlaml\u0131 bir u\u011Fra\u015F\u0131 s\xFCrd\xFCrebilmek i\xE7in hayat\u0131n\u0131n temel bak\u0131m\u0131na da yer a\xE7.", "Everyday needs do not invalidate an inward search. Even Hayy encounters bodily demands; sustaining a meaningful pursuit requires room for the ordinary conditions that allow it to continue.", ["self", "care", "meaning"]],
      ["\xA776: nourishment and care for the continuation of living things", "Bir ihtiyac\u0131n\u0131 kar\u015F\u0131larken yaln\u0131z sana sa\u011Flad\u0131\u011F\u0131 yarar\u0131 d\xFC\u015F\xFCnmeyebilirsin. Hayy\u2019\u0131n canl\u0131lar\u0131n devam\u0131n\u0131 g\xF6zeten aray\u0131\u015F\u0131, t\xFCketimin ard\u0131ndaki hayat\u0131 fark etmeye \xE7a\u011F\u0131r\u0131r; bug\xFCn ald\u0131\u011F\u0131n \u015Feyin nas\u0131l bir ili\u015Fki kurdu\u011Funu da d\xFC\u015F\xFCn.", "Meeting a need can include concern for the life that supplies it. Hayy considers the continuation of living things; notice the relationship your everyday consumption establishes with the wider world.", ["care", "responsibility", "existence"]],
      ["\xA779: freeing plants, helping animals and opening watercourses", "Manev\xEE bir aray\u0131\u015F, \xE7evrendeki k\xFC\xE7\xFCk ihtiya\xE7lardan uzakla\u015Fmak zorunda de\u011Fildir. Hayy\u2019\u0131n su yolunu a\xE7mas\u0131 ve zarar g\xF6ren canl\u0131ya yard\u0131m etmesi gibi, bug\xFCn somut bir engeli kald\u0131rmak da i\xE7indeki y\xF6neli\u015Fe kar\u015F\u0131l\u0131k olabilir.", "An inward search can reach outward into practical care. Hayy clears watercourses and helps vulnerable creatures; removing a small obstacle around you can give an inner commitment visible expression.", ["faith", "action", "compassion"]],
      ["\xA780: cleanliness as part of deliberate practice", "Kendine g\xF6sterdi\u011Fin \xF6zenin anlaml\u0131 say\u0131lmas\u0131 i\xE7in b\xFCy\xFCk bir de\u011Fi\u015Fime d\xF6n\xFC\u015Fmesi gerekmez. Hayy\u2019\u0131n g\xFCndelik temizli\u011Fi d\xFC\u015F\xFCn; bedenine ve ya\u015Fad\u0131\u011F\u0131n yere dikkat etmek, i\xE7 d\xFCzen aray\u0131\u015F\u0131n\u0131n sessiz bir par\xE7as\u0131 olabilir.", "Care for yourself need not become a dramatic transformation to matter. Hayy makes cleanliness part of practice; attention to body and surroundings can quietly accompany a search for inward order.", ["care", "self", "action"]],
      ["\xA7100: Asal\u2019s solitude and Salaman\u2019s social inclination", "Baz\u0131 insanlar d\xFC\u015F\xFCnmek i\xE7in yaln\u0131zl\u0131\u011F\u0131, baz\u0131lar\u0131 birlikte ya\u015Famay\u0131 se\xE7er. As\xE2l ile Sal\xE2m\xE2n\u2019\u0131n ayr\u0131l\u0131\u011F\u0131n\u0131 d\xFC\u015F\xFCn; sana iyi gelen d\xFCzeni ararken, herkesin ayn\u0131 yoldan g\xFC\xE7 bulmas\u0131n\u0131 beklemek zorunda de\u011Filsin.", "Some people seek understanding in solitude, others in shared life. Asal and Salaman choose differently; finding your own sustaining arrangement need not require everyone to thrive in the same way.", ["self", "difference", "belonging"]],
      ["\xA7105: Hayy notices Asal\u2019s fear and tries to reassure him", "Birinin senden \xE7ekindi\u011Fini fark etti\u011Finde, hemen kendini anlatmaya y\xFCklenme. Hayy\u2019\u0131n \xF6nce korkuyu yat\u0131\u015Ft\u0131rmaya \xE7al\u0131\u015Fmas\u0131 gibi, g\xFCven kuracak bir tav\u0131r se\xE7; anla\u015F\u0131lman\u0131n yolu bazen ilk olarak kar\u015F\u0131dakine alan vermekten ge\xE7er.", "When someone seems afraid of you, explanation may not be the first need. Hayy tries to reassure Asal; a considerate manner can make space for understanding before words do.", ["fear", "compassion", "connection"]],
      ["\xA7108: learning names through shared objects and companionship", "\u0130leti\u015Fim bir anda kurulmad\u0131\u011F\u0131nda, aradaki bo\u015Flu\u011Fu ba\u015Far\u0131s\u0131zl\u0131k sayma. As\xE2l\u2019\u0131n Hayy\u2019a nesneleri g\xF6stererek dil \xF6\u011Fretmesi gibi, ortak bir deneyimden ba\u015Flamak, kelimelerin zamanla g\xFCven i\xE7inde yerle\u015Fmesine yard\u0131mc\u0131 olabilir.", "A connection need not be complete at the first encounter. Asal teaches Hayy through shared objects; a common experience can give unfamiliar words somewhere to take root.", ["patience", "learning", "connection"]],
      ["\xA7\xA7115\u2013118: unsuccessful teaching and returning to Salaman", "\u0130yi niyetle anlatt\u0131\u011F\u0131n \u015Feyin herkese ula\u015Fmamas\u0131, insanlar\u0131 daha fazla s\u0131k\u0131\u015Ft\u0131rman gerekti\u011Fini g\xF6stermez. Hayy\u2019\u0131n deneyimini d\xFC\u015F\xFCn; anlat\u0131m\u0131n\u0131n s\u0131n\u0131rlar\u0131n\u0131 g\xF6r\xFCp yakla\u015F\u0131m\u0131n\u0131 de\u011Fi\u015Ftirmek de bir d\xFC\u015F\xFCn\xFCr\xFCn \xF6\u011Frenmeye devam etmesidir.", "A sincere message may still fail to reach its audience. Hayy\u2019s encounter with society asks the teacher to recognize limits; reconsidering an approach can be another form of learning.", ["ego", "humility", "communication"]]
    ], true),
    ...readings("rushd", "Ibn Rushd", "\u0130bn R\xFC\u015Fd", "The Decisive Discourse (Jamil ur Rehman, 1921)", "Fasl\xFC\u2019l-Mak\u0101l (Jamil ur Rehman, 1921)", "https://oll-resources.s3.us-east-2.amazonaws.com/oll3/store/titles/77/Averroes_0560_EBk_v6.0.pdf", [
      ["Opening argument: studying beings as signs of their Maker", "Varl\u0131\u011F\u0131 anlamaya \xE7al\u0131\u015F\u0131rken inanc\u0131n\u0131 kap\u0131n\u0131n d\u0131\u015F\u0131nda b\u0131rakmak zorunda de\u011Filsin. \u0130bn R\xFC\u015Fd\u2019\xFCn yakla\u015F\u0131m\u0131nda yarat\u0131lm\u0131\u015Flar\u0131 incelemek, yarat\u0131c\u0131ya ili\u015Fkin d\xFC\u015F\xFCnceyi derinle\u015Ftirebilir; merak\u0131na ciddi ve \xF6zenli bir \xE7al\u0131\u015Fma alan\u0131 a\xE7.", "Inquiry into existence need not leave faith outside the door. Ibn Rushd treats examination of created things as a path toward understanding their Maker; give curiosity a careful discipline.", ["faith", "reason", "curiosity"]],
      ["The instrument of reasoning: learning the kinds of inference", "Do\u011Fru sonuca ula\u015Fma iste\u011Fin kadar, oraya hangi ad\u0131mlarla gitti\u011Fin de \xF6nemlidir. \u0130bn R\xFC\u015Fd\u2019\xFCn ak\u0131l y\xFCr\xFCtme ara\xE7lar\u0131na verdi\u011Fi de\u011Feri d\xFC\u015F\xFCn; gerek\xE7elerini s\u0131raya koymak, zihnindeki g\xFCveni daha sa\u011Flam bir temele ba\u011Flayabilir.", "Wanting a true conclusion includes caring about the route toward it. Ibn Rushd emphasizes the instruments of reasoning; laying out your grounds can give confidence something more dependable to rest on.", ["reason", "confidence", "clarity"]],
      ["Predecessors: benefiting from earlier work regardless of religious affiliation", "Senden farkl\u0131 bir gelenekten gelen insan\u0131n eme\u011Fi de \xF6\u011Frenmene katk\u0131 sunabilir. \u0130bn R\xFC\u015Fd\u2019\xFCn eski d\xFC\u015F\xFCn\xFCrlere yakla\u015F\u0131m\u0131n\u0131 hat\u0131rla; yararl\u0131 bir bilgiyi kayna\u011F\u0131n\u0131n kimli\u011Fi y\xFCz\xFCnden ba\u015Ftan d\u0131\u015Flamadan dikkatle incele.", "Work from another tradition can contribute to your understanding. Ibn Rushd welcomes the labor of earlier thinkers; consider a useful insight without dismissing it merely because of its origin.", ["humility", "learning", "openness"]],
      ["Cumulative knowledge: one person cannot reconstruct astronomy alone", "Her \u015Feyi tek ba\u015F\u0131na yeniden bulman gerekmiyor. \u0130bn R\xFC\u015Fd\u2019\xFCn astronomi \xF6rne\u011Finde oldu\u011Fu gibi, b\xFCy\xFCk bir aray\u0131\u015F \xF6nceki emeklere dayan\u0131r; yard\u0131m almak, kendi katk\u0131n\u0131 m\xFCmk\xFCn k\u0131lan d\xFCr\xFCst bir ba\u015Flang\u0131\xE7 olabilir.", "You need not rediscover everything alone. Ibn Rushd\u2019s example of astronomy shows how inquiry depends on earlier work; accepting that inheritance can make a contribution of your own possible.", ["ego", "support", "action"]],
      ["Reading predecessors: accepting the sound and identifying the unsound", "Bir d\xFC\u015F\xFCn\xFCr\xFC \xF6nemsemek, s\xF6yledi\u011Fi her \u015Feyi kabul etmek de\u011Fildir. Sa\u011Flam buldu\u011Fun yan\u0131 al\u0131rken sorunlu g\xF6rd\xFC\u011F\xFCn k\u0131sm\u0131 gerek\xE7esiyle ay\u0131rabilirsin; sayg\u0131l\u0131 bir okuma, kendi yarg\u0131n\u0131 ba\u015Fkas\u0131na b\xFCt\xFCn\xFCyle teslim etmeyi gerektirmez.", "Respect for a thinker does not require agreement with every claim. Receive what is sound and identify what fails with reasons; careful reading can combine gratitude with independent judgment.", ["self", "discernment", "integrity"]],
      ["Accidental harm: the thirsty person and the water", "Bir arac\u0131n yanl\u0131\u015F kullan\u0131mla zarar vermesi, b\xFCt\xFCn yarar\u0131n\u0131 ortadan kald\u0131rmaz. \u0130bn R\xFC\u015Fd\u2019\xFCn su benzetmesini d\xFC\u015F\xFCn; korkunun seni b\xFCt\xFCn\xFCyle vazge\xE7irmesinden \xF6nce, kullanma ko\u015Fullar\u0131n\u0131 ve gerekli haz\u0131rl\u0131\u011F\u0131 ay\u0131rt etmeye \xE7al\u0131\u015F.", "Misuse does not cancel every benefit of a practice. Ibn Rushd\u2019s water analogy invites a distinction between a thing and the conditions of using it; preparation may answer fear more usefully than rejection.", ["fear", "courage", "discernment"]],
      ["Truth and the Law: truth supports rather than contradicts truth", "\u0130nand\u0131\u011F\u0131nla \xF6\u011Frendi\u011Fin \xE7at\u0131\u015F\u0131yor g\xF6r\xFCnd\xFC\u011F\xFCnde, hemen birini susturmak zorunda de\u011Filsin. \u0130bn R\xFC\u015Fd\u2019\xFCn hakikat anlay\u0131\u015F\u0131n\u0131 d\xFC\u015F\xFCn; hem kan\u0131t\u0131 hem yorumunu yeniden incelemek, acele bir kar\u015F\u0131tl\u0131ktan daha verimli bir aray\u0131\u015F ba\u015Flatabilir.", "When belief and discovery seem opposed, neither needs to be silenced immediately. Ibn Rushd\u2019s account of truth encourages another examination of both the evidence and the interpretation.", ["faith", "reason", "patience"]],
      ["Interpretation: figurative meaning and the conventions of Arabic", "Bir metindeki mecaz\u0131 kendi iste\u011Fine g\xF6re doldurmadan \xF6nce, dilin imk\xE2nlar\u0131n\u0131 ve ba\u011Flam\u0131n\u0131 \xF6\u011Fren. Anlam aray\u0131\u015F\u0131 \xF6zg\xFCrce soru sormay\u0131 i\xE7erirken, yorumunun hangi dayanaklarla kuruldu\u011Funu g\xF6sterecek bir \xF6zen de ister.", "Before filling a metaphor with your preferred meaning, attend to language and context. An inquiry can be open while remaining responsible for the grounds of its interpretation.", ["reason", "responsibility", "meaning"]],
      ["Mistakes of qualified interpreters: the analogy with judicial judgment", "Ciddi bir ara\u015Ft\u0131rmada yan\u0131lmak, b\xFCt\xFCn eme\u011Fin de\u011Fersizle\u015Fti\u011Fi anlam\u0131na gelmeyebilir. \u0130bn R\xFC\u015Fd\u2019\xFCn ehil yorumcunun hatas\u0131na yakla\u015F\u0131m\u0131, gerekli haz\u0131rl\u0131\u011F\u0131 yaparak d\xFC\u015F\xFCnmeye ve bir yanl\u0131\u015F ortaya \xE7\u0131kt\u0131\u011F\u0131nda onu d\xFCr\xFCst\xE7e d\xFCzeltmeye alan a\xE7ar.", "An error in serious inquiry need not cancel the work. Ibn Rushd distinguishes the qualified interpreter\u2019s mistake from careless judgment; preparation can coexist with a willingness to correct yourself.", ["fear", "courage", "learning"]],
      ["Different methods of assent: demonstrative, dialectical and rhetorical", "Sana a\xE7\u0131k g\xF6r\xFCnen bir gerek\xE7e, ba\u015Fka birine ayn\u0131 kap\u0131y\u0131 a\xE7mayabilir. \u0130bn R\xFC\u015Fd\u2019\xFCn farkl\u0131 anlama yollar\u0131n\u0131 d\xFC\u015F\xFCn; insan\u0131 k\xFC\xE7\xFCmsemek yerine, konu\u015Fman\u0131n ona nas\u0131l ula\u015Fabilece\u011Fini ara\u015Ft\u0131rmak da d\xFC\u015F\xFCncenin sorumlulu\u011Fudur.", "A reason that convinces you may not reach another person in the same way. Ibn Rushd distinguishes ways of understanding; consider the listener instead of treating difference as inferiority.", ["ego", "communication", "understanding"]]
    ], true),
    ...readings("spinoza", "Baruch Spinoza", "Baruch Spinoza", "Ethics (Elwes, 1883)", "Etika (Elwes, 1883)", "https://www.gutenberg.org/files/3800/3800-h/3800-h.htm", [
      ["III, propositions 6\u20137: the endeavour to persist in being", "Varl\u0131\u011F\u0131n\u0131 s\xFCrd\xFCrme \xE7aban\u0131 yaln\u0131z b\xFCy\xFCk ba\u015Far\u0131larla \xF6l\xE7me. Spinoza\u2019n\u0131n kendini koruma d\xFC\u015F\xFCncesini hat\u0131rla; bug\xFCn hayat\u0131n\u0131 ayakta tutan bir i\u015Fi yapmak, g\xF6r\xFCn\xFCr bir zafer olmasa da kendi varl\u0131\u011F\u0131na sahip \xE7\u0131kman\u0131n anlaml\u0131 bir bi\xE7imidir.", "Your effort to continue need not be measured only by major achievements. Through Spinoza\u2019s account of persistence, an ordinary act that sustains your life can carry significance without looking like a victory.", ["self", "existence", "action"]],
      ["III, proposition 9, scholium: desire and judgments of goodness", "Bir \u015Feyi istemenle onu iyi bulman birbirine kar\u0131\u015Fabilir. Arzunun karar\u0131na nas\u0131l y\xF6n verdi\u011Fini fark et; benli\u011Fini tan\u0131mak, her g\xFC\xE7l\xFC iste\u011Fi sorgusuzca do\u011Fru bir yolun i\u015Fareti saymamay\u0131 da i\xE7erir.", "Wanting something and judging it good can become intertwined. Notice desire\u2019s part in your decision; knowing yourself includes questioning whether intensity alone makes an aim worth pursuing.", ["ego", "self", "desire"]],
      ["III, proposition 11, scholium: joy and increased power of acting", "Seni sevindiren \u015Feyin hayat\u0131nda nas\u0131l bir hareket alan\u0131 a\xE7t\u0131\u011F\u0131na bak. Spinoza\u2019n\u0131n sevin\xE7 anlay\u0131\u015F\u0131, yaln\u0131z ho\u015F bir an\u0131 de\u011Fil, d\xFC\u015F\xFCnmeye ve ya\u015Famaya daha geni\u015F kat\u0131labildi\u011Fin de\u011Fi\u015Fimi de fark etmeye \xE7a\u011F\u0131r\u0131r.", "Notice what a joy makes possible in your life. Spinoza understands joy through an increase in the power to act; a welcome feeling can invite reflection on what it opens.", ["self", "joy", "possibility"]],
      ["III, proposition 14: emotions associated through simultaneous experience", "Bir yerin ya da sesin sende uyand\u0131rd\u0131\u011F\u0131 duygu, ge\xE7mi\u015Fte onunla birlikte ya\u015Fad\u0131\u011F\u0131n bir andan gelebilir. Bug\xFCnk\xFC tepkinin b\xFCt\xFCn\xFCn\xFC bug\xFCnk\xFC olaya y\xFCklemeden, haf\u0131zan\u0131n kurdu\u011Fu ba\u011F\u0131 merakla inceleyebilirsin.", "A place or sound may carry a feeling from an earlier encounter. Before assigning your whole response to the present situation, consider the association memory might be bringing with it.", ["self", "memory", "awareness"]],
      ["III, proposition 18: images of past and future affect the present", "Hen\xFCz ya\u015Fanmam\u0131\u015F bir olay\u0131 d\xFC\u015F\xFCn\xFCrken, onun duygusu \u015Fimdiki an\u0131na yerle\u015Febilir. Gelecekle ilgili korkunu k\xFC\xE7\xFCmsemeden, d\xFC\u015F\xFCnd\xFC\u011F\xFCn g\xF6r\xFCnt\xFCyle \u015Fu anda \xF6n\xFCnde duran ger\xE7ek durumu birbirinden ay\u0131rmak i\xE7in biraz durakla.", "An imagined future can bring a real feeling into the present. Respect the fear while distinguishing the scene in your mind from the situation actually before you now.", ["fear", "self", "presence"]],
      ["III, proposition 27: imitation of the emotions", "\u0130\xE7indeki duygu, yaln\u0131z kendi ba\u015F\u0131na ya\u015Fad\u0131klar\u0131ndan olu\u015Fmayabilir. Ba\u015Fkas\u0131n\u0131n sevincine veya s\u0131k\u0131nt\u0131s\u0131na e\u015Flik ederken sen de etkilenirsin; bu ba\u011F\u0131 fark etmek, kendini anlamana ve ili\u015Fkilerine daha bilin\xE7li yakla\u015Fmana yard\u0131m edebilir.", "Your feelings can take shape through another person\u2019s experience too. Recognizing this participation may help you understand yourself while approaching companionship with greater awareness.", ["self", "connection", "empathy"]],
      ["III, proposition 32: envy where possession is imagined as exclusive", "Bir ba\u015Fkas\u0131n\u0131n ba\u015Far\u0131s\u0131n\u0131, sana ayr\u0131labilecek b\xFCt\xFCn yerin azalmas\u0131 gibi g\xF6rmeye ba\u015Flad\u0131\u011F\u0131nda dur. Her iyilik payla\u015F\u0131lmaz olmak zorunda de\u011Fildir; rekabetin benli\u011Finde hangi k\u0131tl\u0131k d\xFC\u015F\xFCncesini b\xFCy\xFCtt\xFC\u011F\xFCn\xFC fark etmeye \xE7al\u0131\u015F.", "Pause when another person\u2019s success seems to remove all room for yours. Not every good must be exclusive; consider the picture of scarcity that is shaping your comparison.", ["ego", "envy", "perspective"]],
      ["III, proposition 51: people and times differ in their responses", "D\xFCn seni zorlayan bir \u015Feyin bug\xFCn daha kolay gelmesi, ge\xE7mi\u015Fteki h\xE2linin sahte oldu\u011Fu anlam\u0131na gelmez. Ayn\u0131 insan zamanla farkl\u0131 etkilenebilir; kendini tek bir tepkinin i\xE7inde dondurmadan de\u011Fi\u015Fimine dikkat et.", "If something feels easier today, yesterday\u2019s difficulty was not therefore unreal. A person can respond differently across time; leave room for change in the story you tell about yourself.", ["self", "identity", "hope"]],
      ["III, proposition 53: contemplating one\u2019s own power of acting", "Yapabildi\u011Fin bir \u015Feyi fark etmek i\xE7in ba\u015Fkas\u0131n\u0131n seni \xF6vmesini beklemek zorunda de\u011Filsin. Bug\xFCn kendi eme\u011Finden do\u011Fan bir davran\u0131\u015F\u0131 adland\u0131r; kendini g\xF6rmen, g\xF6steri\u015Fe d\xF6n\xFC\u015Fmeden de sana i\xE7ten bir sevin\xE7 verebilir.", "You need not wait for praise to recognize an ability in action. Name something your effort made possible today; acknowledgment can bring quiet enjoyment without becoming a performance.", ["self", "confidence", "agency"]],
      ["IV, proposition 18, scholium: rational self-interest and mutual usefulness", "Kendi iyili\u011Fini g\xF6zetmekle ba\u015Fkas\u0131na yararl\u0131 olmak her zaman kar\u015F\u0131t de\u011Fildir. Spinoza\u2019n\u0131n ortak yarar d\xFC\u015F\xFCncesi gibi, birlikte g\xFC\xE7lenebilece\u011Finiz bir ili\u015Fki ara; benli\u011Fini korumak, insanlardan b\xFCt\xFCn\xFCyle kopman\u0131 gerektirmeyebilir.", "Care for your own good can meet care for another\u2019s. Spinoza\u2019s account of mutual usefulness invites relationships that strengthen both people, rather than treating self-preservation as necessary isolation.", ["self", "cooperation", "belonging"]],
      ["IV, proposition 37: the good sought for oneself and for others", "Kendin i\xE7in de\u011Ferli buldu\u011Fun anlay\u0131\u015F\u0131n ba\u015Fkalar\u0131na da ula\u015Fmas\u0131n\u0131 isteyebilirsin. Bir \u015Feyi payla\u015Fmak, onun senin hayat\u0131ndaki yerini mutlaka k\xFC\xE7\xFCltmez; baz\u0131 iyilikler, birlikte aranabildiklerinde daha geni\u015F bir anlam kazan\u0131r.", "An understanding you value for yourself can also be something you wish for others. Sharing a good need not diminish its place in your own life.", ["ego", "generosity", "meaning"]],
      ["IV, proposition 46: answering hatred through generosity", "Kar\u015F\u0131ndaki \xF6fkenin seni ayn\u0131 bi\xE7imde y\xF6netmesine izin vermemek m\xFCmk\xFCnd\xFCr. S\u0131n\u0131r\u0131n\u0131 korurken a\u015Fa\u011F\u0131lamaya ba\u015Fvurmadan cevap vermeyi dene; bir \xE7at\u0131\u015Fmada tutumunu se\xE7ebilmek, benli\u011Finin b\xFCt\xFCn\xFCn\xFC o \xE7at\u0131\u015Fmaya teslim etmemektir.", "You can protect a boundary without copying another person\u2019s hostility. A response free of humiliation leaves some authorship of your conduct with you, even within a difficult conflict.", ["self", "courage", "boundaries"]],
      ["IV, proposition 52: self-approval grounded in reason", "Kendine g\xFCvenini yaln\u0131z alk\u0131\u015Fa ba\u011Flad\u0131\u011F\u0131nda, sessizlik bile onu sarsabilir. Neyi neden yapt\u0131\u011F\u0131n\u0131 anlayarak duydu\u011Fun memnuniyete de yer a\xE7; kendi de\u011Ferlendirmene dayanan bir zemin, d\u0131\u015Far\u0131daki seslerden ayr\u0131 olarak kurulabilir.", "Confidence tied only to applause can be unsettled by silence. Make room for satisfaction grounded in understanding your conduct; your own assessment can provide another place to stand.", ["ego", "confidence", "reason"]],
      ["IV, proposition 57: pride and the preference for flatterers", "Seni yaln\u0131z onaylayan insanlarla \xE7evrelendi\u011Finde, kendin hakk\u0131ndaki g\xF6r\xFCnt\xFCn daralabilir. D\xFCr\xFCst bir dostun farkl\u0131 g\xF6r\xFC\u015F\xFCne yer a\xE7; benli\u011Fini korumak i\xE7in her ele\u015Ftiriyi d\xFC\u015Fmanl\u0131k saymak zorunda kalmad\u0131\u011F\u0131n ili\u015Fkiler de kurulabilir.", "A circle of constant approval can narrow your view of yourself. Give an honest companion room to differ; a relationship need not protect your image at the expense of understanding.", ["ego", "friendship", "honesty"]],
      ["IV, proposition 63 and corollary: seeking a good instead of acting only from fear", "Korkun yan\u0131ndayken de neyi de\u011Ferli buldu\u011Funu sorabilirsin. Yaln\u0131z ka\xE7\u0131nmak istedi\u011Fin sonuca odaklanmak yerine, korumak ya da kurmak istedi\u011Fin iyili\u011Fi adland\u0131r; sonraki k\xFC\xE7\xFCk ad\u0131m\u0131n\u0131 o de\u011Fere ba\u011Flamay\u0131 dene.", "Even with fear present, ask what you value. Alongside the outcome you want to avoid, name the good you want to protect or create and connect a small step to it.", ["fear", "courage", "values"]],
      ["IV, proposition 67: the free person\u2019s attention to life", "Hayat\u0131n sonlu oldu\u011Funu bilmek, b\xFCt\xFCn d\xFC\u015F\xFCnceni sona ay\u0131rman\u0131 gerektirmez. Spinoza\u2019n\u0131n ya\u015Fam \xFCzerine d\xFC\u015F\xFCnme \xE7a\u011Fr\u0131s\u0131n\u0131 hat\u0131rla; bug\xFCn nas\u0131l ya\u015Famak istedi\u011Fin sorusu, varolu\u015Funa kat\u0131labilece\u011Fin somut bir kap\u0131 a\xE7abilir.", "Knowing that life ends need not occupy every thought with its ending. Spinoza turns attention toward living; asking how you want to live today can open a practical point of participation.", ["existence", "meaning", "action"]],
      ["IV, proposition 69: courage in avoiding as well as overcoming danger", "Cesaret her tehlikenin i\xE7ine girmek de\u011Fildir. Bazen geri \xE7ekilmek ya da daha g\xFCvenli bir yol se\xE7mek ayn\u0131 kararl\u0131l\u0131\u011F\u0131 ister; korkunu dinleyip ko\u015Fullar\u0131 de\u011Ferlendirmek, yapabileceklerinden vazge\xE7ti\u011Fin anlam\u0131na gelmez.", "Courage does not require entering every danger. Withdrawing or choosing a safer route may demand equal firmness; attending to fear and circumstances need not mean abandoning what you can do.", ["fear", "courage", "judgment"]],
      ["V, proposition 3: understanding an emotion more clearly", "Duygunu yaln\u0131z susturulacak bir engel gibi g\xF6rmeden, i\xE7inde hangi d\xFC\u015F\xFCncenin bulundu\u011Funu ara\u015Ft\u0131r. Onu anlamaya \xE7al\u0131\u015Fmak her \u015Feyi bir anda \xE7\xF6zmeyebilir; yine de kendinle kurdu\u011Fun ili\u015Fkiye biraz a\xE7\u0131kl\u0131k katabilir.", "Instead of treating a feeling only as an obstacle, explore the thought within it. Understanding need not resolve everything immediately to make your relationship with yourself a little clearer.", ["self", "awareness", "compassion"]],
      ["V, proposition 10, scholium: preparing principles when not overwhelmed", "Sakin bir an\u0131nda, zor bir kar\u015F\u0131la\u015Fmada nas\u0131l davranmak istedi\u011Fini d\xFC\u015F\xFCn. K\xFC\xE7\xFCk bir haz\u0131rl\u0131k korkuyu tamamen kald\u0131rmayabilir; fakat duygu y\xFCkseldi\u011Finde, \xF6nceden benimsedi\u011Fin bir ilkeyi hat\u0131rlamana yard\u0131mc\u0131 olacak bir iz b\u0131rakabilir.", "During a calmer moment, consider how you want to act in difficulty. Preparation need not remove fear completely to leave you a principle worth remembering when emotion rises.", ["fear", "courage", "preparation"]],
      ["V, proposition 42: blessedness and virtue rather than an external prize", "\u0130yi ya\u015Faman\u0131n de\u011Ferini yaln\u0131z gelecekte verilecek bir \xF6d\xFCle erteleme. Spinoza\u2019n\u0131n son \xF6nermesi gibi, anlayarak ve de\u011Ferlerine ba\u011Fl\u0131 ya\u015Fayabildi\u011Fin an\u0131n kendisinde de bir sevin\xE7 bulunabilece\u011Fini d\xFC\u015F\xFCnmeye yer a\xE7.", "The value of living well need not be postponed to a later prize. Spinoza\u2019s final proposition locates fulfillment within virtue itself; consider the joy available in an understood and deliberate life.", ["self", "meaning", "joy"]]
    ]),
    ...readings("descartes", "Ren\xE9 Descartes", "Ren\xE9 Descartes", "Discourse on Method (1650 English edition)", "Y\xF6ntem \xDCzerine Konu\u015Fma (1650 \u0130ngilizce bask\u0131)", "https://www.gutenberg.org/cache/epub/25830/pg25830-images.html", [
      ["I: travel and the diversity of customs", "Kendi \xE7evrende al\u0131\u015F\u0131lm\u0131\u015F olan\u0131, insan olman\u0131n tek yolu sayma. Ba\u015Fka ya\u015Fay\u0131\u015Flarla kar\u015F\u0131la\u015Fmak, fark etmeden ta\u015F\u0131d\u0131\u011F\u0131n kabulleri g\xF6r\xFCn\xFCr k\u0131labilir; bu kar\u015F\u0131la\u015Fmadan kendini kaybetmeden, daha bilin\xE7li bir se\xE7imle d\xF6nebilirsin.", "What is customary around you need not be the only way to live. Encountering other ways can reveal assumptions you have carried unnoticed and let you return with a more deliberate choice.", ["self", "identity", "perspective"]],
      ["I: proceeding slowly on a sound route", "H\u0131zl\u0131 g\xF6r\xFCnmek u\u011Fruna y\xF6n\xFCn\xFC kaybetmen gerekmiyor. Descartes\u2019\u0131n yava\u015F fakat do\u011Fru ilerleyen yolcu benzetmesini d\xFC\u015F\xFCn; bug\xFCn anlad\u0131\u011F\u0131n bir ad\u0131m\u0131 \xF6zenle tamamlamak, yeti\u015Fme tela\u015F\u0131 i\xE7inde geli\u015Fig\xFCzel bir\xE7ok ad\u0131m atmaktan daha i\u015Fe yarayabilir.", "Speed does not compensate for losing direction. Descartes\u2019s slower traveler suggests a different measure: completing one understood step carefully can serve you better than hurried motion without a route.", ["courage", "patience", "action"]],
      ["II: rebuilding one\u2019s own opinions rather than reforming the whole state", "Hayat\u0131n\u0131 yeniden d\xFC\u015F\xFCnmek, \xE7evrendeki her d\xFCzeni bir anda de\u011Fi\u015Ftirmeyi gerektirmez. \xD6nce kendi kabullerinin yap\u0131s\u0131na bak; ki\u015Fisel sorumlulu\u011Fun i\xE7indeki bir d\xFCzeltme, ta\u015F\u0131yamayaca\u011F\u0131n b\xFCy\xFCkl\xFCkte bir d\xF6n\xFC\u015F\xFCmden daha sa\u011Flam ba\u015Flayabilir.", "Reconsidering your life need not begin with remaking every surrounding institution. Examine the structure of your own assumptions; a change within your responsibility can provide a sounder beginning.", ["self", "responsibility", "change"]],
      ["II: second rule, dividing difficulties", "Bir g\xFC\xE7l\xFCk g\xF6z\xFCnde b\xFCy\xFCd\xFC\u011F\xFCnde, hepsini ayn\u0131 anda \xE7\xF6zmeye \xE7al\u0131\u015Fma. Onu ger\xE7ekten ele al\u0131nabilecek par\xE7alara ay\u0131r; bug\xFCn yaln\u0131z bir par\xE7aya ba\u015Flamak, korksan da hareket edebilece\u011Fin somut bir ba\u015Flang\u0131\xE7 olu\u015Fturabilir.", "When a difficulty feels too large, separate it into parts you can actually address. Beginning with one part today can create a concrete way to move while fear is still present.", ["fear", "courage", "action"]],
      ["II: third rule, proceeding from the simple to the complex", "\xD6\u011Frenirken en karma\u015F\u0131k noktadan ba\u015Flamak zorunda de\u011Filsin. \xD6nce anlayabildi\u011Fin temel ili\u015Fkiyi kur, sonra \xFCst\xFCne yenisini ekle; zihninin basamaklara ihtiya\xE7 duymas\u0131, d\xFC\u015F\xFCnd\xFC\u011F\xFCn hedefe lay\u0131k olmad\u0131\u011F\u0131n anlam\u0131na gelmez.", "You need not begin learning at its most complicated point. Establish a simple relationship you understand and add to it; needing steps does not make the aim unworthy of you.", ["confidence", "learning", "patience"]],
      ["II: fourth rule, complete review and enumeration", "Bir i\u015Fi bitirdi\u011Finde geriye d\xF6n\xFCp kontrol etmek, kendine g\xFCvensizlik say\u0131lmak zorunda de\u011Fildir. Atlad\u0131\u011F\u0131n bir ba\u011Flant\u0131y\u0131 aramak, eme\u011Fine g\xF6sterdi\u011Fin \xF6zenin par\xE7as\u0131d\u0131r; g\xFCven bazen son bir dikkatli bak\u0131\u015Fla g\xFC\xE7lenir.", "Reviewing completed work need not express distrust in yourself. Looking for an omitted connection is a form of care for your effort; confidence can grow through a final attentive check.", ["confidence", "attention", "integrity"]],
      ["III: provisional morality and the temporary lodging metaphor", "B\xFCt\xFCn sorular\u0131n\u0131 \xE7\xF6zmeden de g\xFCnl\xFCk hayat\u0131n\u0131 s\xFCrd\xFCrecek bir d\xFCzene ihtiyac\u0131n olabilir. Evi yeniden kurarken ge\xE7ici bar\u0131nak bulmak gibi, baz\u0131 ilkeler aray\u0131\u015F\u0131n tamamlanana kadar sana ya\u015Fanabilir bir zemin sa\u011Flayabilir.", "You may need a way to live before every question is settled. Like finding shelter while rebuilding a house, provisional principles can provide a livable ground during an unfinished inquiry.", ["uncertainty", "self", "stability"]],
      ["III: second maxim, the traveler lost in a forest", "Y\xF6n\xFCn\xFC tam bilmedi\u011Finde s\xFCrekli karar de\u011Fi\u015Ftirmek seni ayn\u0131 yerde tutabilir. Yeterince d\xFC\u015F\xFCnd\xFC\u011F\xFCn makul bir yolu bir s\xFCre dene; k\xFC\xE7\xFCk belirsizlikler y\xFCz\xFCnden her ad\u0131m\u0131 geri almak zorunda de\u011Filsin.", "Changing direction at every uncertainty can keep you in place. Give a reasonably considered route a fair attempt instead of withdrawing each step because complete assurance has not arrived.", ["fear", "courage", "will"]],
      ["IV: thinking and the recognition of existence", "Kendin hakk\u0131nda pek \xE7ok \u015Feyden ku\u015Fku duysan bile, bu sorgulaman\u0131n ya\u015Fand\u0131\u011F\u0131 ger\xE7e\u011Fine dikkat edebilirsin. Descartes\u2019\u0131n d\xFC\u015F\xFCnceden ba\u015Flayan aray\u0131\u015F\u0131, haz\u0131r bir kimlik bulmadan da varolu\u015Funu ciddiye alabilece\u011Fin bir nokta a\xE7ar.", "Even when much about yourself feels uncertain, notice the reality of the questioning taking place. Descartes begins there, opening a point from which existence matters before a settled identity is available.", ["self", "existence", "identity"]],
      ["VI: knowledge useful in the conduct of life", "\xD6\u011Frendi\u011Fin \u015Feyin de\u011Ferini yaln\u0131z ne kadar etkileyici anlat\u0131ld\u0131\u011F\u0131yla \xF6l\xE7me. Hayat\u0131n ger\xE7ek bir ihtiyac\u0131na dokunup dokunmad\u0131\u011F\u0131n\u0131 da sor; k\xFC\xE7\xFCk ama kullan\u0131labilir bir anlay\u0131\u015F, bug\xFCn birine yard\u0131m etmenin ba\u015Flang\u0131c\u0131 olabilir.", "Knowledge can be assessed by its contribution to lived needs as well as its presentation. A modest, usable understanding may be enough to begin helping someone today.", ["purpose", "action", "knowledge"]]
    ]),
    ...readings("montaigne", "Michel de Montaigne", "Michel de Montaigne", "Essays (Cotton\u2013Hazlitt, 1877)", "Denemeler (Cotton\u2013Hazlitt, 1877)", "https://www.gutenberg.org/files/3600/3600-h/3600-h.htm", [
      ["III.2, Of Repentance: depicting passage rather than fixed being", "Kendini anlat\u0131rken bitmi\u015F bir heykeli tarif etmek zorunda de\u011Filsin. Montaigne de\u011Fi\u015Fen anlar\u0131 kaydeder; sen de bug\xFCnk\xFC d\xFC\u015F\xFCnceni d\xFCr\xFCst\xE7e s\xF6yleyebilir, yar\u0131n farkl\u0131 d\xFC\u015F\xFCnd\xFC\u011F\xFCnde \xF6nceki b\xFCt\xFCn benli\u011Fini sahte ilan etmeyebilirsin.", "Describing yourself need not mean presenting a finished statue. Montaigne records a life in passage; you can speak honestly today without making every later change a verdict against your former self.", ["self", "identity", "change"]],
      ["III.2, Of Repentance: an ordinary life as a subject of examination", "Hayat\u0131n\u0131n d\xFC\u015F\xFCn\xFClmeye de\u011Fer olmas\u0131 i\xE7in ola\u011Fan\xFCst\xFC bir hik\xE2yeye d\xF6n\xFC\u015Fmesi gerekmez. S\u0131radan se\xE7imlerinde insan olman\u0131n sorular\u0131 zaten vard\u0131r; kendini incelemek, yaln\u0131z \xFCnl\xFC veya b\xFCy\xFCk i\u015Fler yapan insanlara ayr\u0131lm\u0131\u015F bir u\u011Fra\u015F de\u011Fildir.", "Your life need not become an extraordinary story to deserve reflection. Ordinary choices already contain human questions; examining a life is not a privilege reserved for the celebrated.", ["self", "existence", "dignity"]],
      ["III.8, Of the Art of Conference: welcoming contradiction in conversation", "Konu\u015Furken kar\u015F\u0131 \xE7\u0131k\u0131lmas\u0131n\u0131, ki\u015Fili\u011Fine a\xE7\u0131lm\u0131\u015F bir dava gibi g\xF6rmeden dinlemeyi dene. Bir fikrinin s\u0131nanmas\u0131 sana d\xFC\u015F\xFCnceni geni\u015Fletme f\u0131rsat\u0131 verebilir; her sohbetten galip \xE7\u0131kmak, her sohbetten bir \u015Fey \xF6\u011Frenmek de\u011Fildir.", "Try hearing disagreement without turning it into a trial of your worth. A challenged idea can enlarge thought; winning an exchange is not the same as learning from it.", ["ego", "conversation", "learning"]],
      ["III.8, Of the Art of Conference: the manner of reasoning", "Bir tart\u0131\u015Fmada yaln\u0131z ula\u015F\u0131lan sonuca bakma; d\xFC\u015F\xFCncenin oraya nas\u0131l gitti\u011Fini de izle. \u015Eans eseri do\u011Fru s\xF6ylemekle gerek\xE7eli konu\u015Fmak ayr\u0131d\u0131r; kendi s\xF6z\xFCn\xFC de ayn\u0131 dikkatle tartmak, sohbeti daha d\xFCr\xFCst k\u0131labilir.", "In discussion, notice the route of reasoning as well as the conclusion. Being right by chance differs from making a sound case; apply that attention to your own words too.", ["ego", "reason", "honesty"]],
      ["III.10, Of Managing the Will: the mayor and Montaigne as distinct roles", "\xDCstlendi\u011Fin g\xF6rev \xF6nemli olabilir, fakat benli\u011Finin tamam\u0131 o g\xF6rev de\u011Fildir. Montaigne\u2019in belediye ba\u015Fkanl\u0131\u011F\u0131yla kendisini ay\u0131rmas\u0131 gibi, sorumlulu\u011Funu yerine getirirken unvan\u0131n\u0131n d\u0131\u015F\u0131nda kalan hayat\u0131n\u0131 da tan\u0131maya devam edebilirsin.", "A role can matter without becoming your entire identity. Montaigne distinguishes himself from his mayoral office; fulfill a responsibility while continuing to recognize the person whose life extends beyond it.", ["ego", "self", "identity"]],
      ["I.26, Of the Education of Children: digesting rather than repeating learning", "Okudu\u011Fun bir d\xFC\u015F\xFCnceyi yaln\u0131z tekrar edebildi\u011Finde \xF6\u011Frenmenin i\u015Fi bitmi\u015F olmaz. Onu kendi \xF6rne\u011Finle anlatmay\u0131 dene; ba\u015Fkas\u0131ndan ald\u0131\u011F\u0131n bilgiyi sindirmek, zihninde ger\xE7ekten kullanabilece\u011Fin bir anlay\u0131\u015Fa d\xF6n\xFC\u015Fmesine yard\u0131m eder.", "Repeating an idea is not the whole work of learning it. Try explaining it through an example of your own; borrowed knowledge needs to be digested before it becomes usable understanding.", ["self", "learning", "practice"]],
      ["I.31, Of Cannibals: judging unfamiliar customs by one\u2019s own habits", "Sana yabanc\u0131 gelen bir ya\u015Fam\u0131 hemen a\u015Fa\u011F\u0131 bir yere koyma. Al\u0131\u015Fkanl\u0131\u011F\u0131n, tarafs\u0131z bir \xF6l\xE7\xFC gibi konu\u015Fuyor olabilir; kendi \xE7evreni de sorgulayabilmek, farkl\u0131 insanlar\u0131 anlamaya daha adil bir yerden ba\u015Flaman\u0131 sa\u011Flar.", "Unfamiliar ways of living need not be ranked beneath your own. Habit can speak as though it were a neutral measure; examining your own setting makes a fairer encounter possible.", ["ego", "difference", "humility"]],
      ["II.6, Use Makes Perfect: attending closely to one\u2019s own experience", "Kendine dair bir deneyimi anlat\u0131rken yaln\u0131z ba\u015Fkalar\u0131n\u0131n senden bekledi\u011Fi g\xF6r\xFCnt\xFCy\xFC korumaya \xE7al\u0131\u015Fma. Montaigne\u2019in kendini g\xF6zlemleyen anlat\u0131s\u0131n\u0131 d\xFC\u015F\xFCn; k\u0131r\u0131lganl\u0131\u011F\u0131n\u0131 saklamadan tarif etmek de kendin hakk\u0131nda daha ger\xE7ek bir bilgiye kap\u0131 a\xE7abilir.", "An account of your experience need not protect only the image others expect. Montaigne observes himself closely; describing vulnerability honestly can become a source of more truthful self-knowledge.", ["self", "vulnerability", "courage"]],
      ["II.10, Of Books: changing a book and returning with fresh attention", "Bir kitab\u0131n i\xE7inde t\u0131kand\u0131\u011F\u0131nda, kendine hemen yetersiz damgas\u0131 vurma. Montaigne bazen ba\u015Fka bir kitaba ge\xE7er; okumayla ili\u015Fkin, her sayfay\u0131 ayn\u0131 inatla zorlamadan da merak\u0131n\u0131 canl\u0131 tutan bir yol bulabilir.", "Being stuck in a book need not become a judgment of your ability. Montaigne sometimes changes books; a living relationship with reading can leave room for another route and renewed interest.", ["self", "curiosity", "flexibility"]],
      ["III.13, Of Experience: joining the mind to the enjoyment of living", "G\xFCzel bir an ya\u015Farken zihnin yaln\u0131z onu de\u011Ferlendiren bir seyirci olmak zorunda de\u011Fil. Yapt\u0131\u011F\u0131n \u015Feye kat\u0131lmay\u0131 dene; ya\u015Fam\u0131n de\u011Ferini d\xFC\u015F\xFCnmek, bazen onun s\u0131radan bir sevincini ger\xE7ekten ya\u015Famaya yer a\xE7makt\u0131r.", "During a welcome moment, your mind need not remain only an evaluating spectator. Participate in what you are doing; reflection on life can include allowing an ordinary pleasure to be fully lived.", ["self", "presence", "joy"]]
    ]),
    ...readings("boethius", "Boethius", "Boethius", "The Consolation of Philosophy (James, 1897)", "Felsefenin Tesellisi (James, 1897)", "https://www.gutenberg.org/files/14328/14328-h/14328-h.htm", [
      ["II.1: the changing character of Fortune", "De\u011Fi\u015Fken bir ko\u015Fuldan de\u011Fi\u015Fmez g\xFCvence beklemek, benli\u011Fini s\xFCrekli tedirgin edebilir. Boethius\u2019un talih sorgulamas\u0131n\u0131 d\xFC\u015F\xFCn; hayat\u0131ndaki hangi deste\u011Fin kal\u0131c\u0131 olmad\u0131\u011F\u0131n\u0131 g\xF6rmek, bug\xFCn dayanabilece\u011Fin ba\u015Fka kaynaklar\u0131 aramana da yard\u0131m edebilir.", "Expecting permanent assurance from a changing circumstance can keep you unsettled. Boethius questions Fortune\u2019s promises; noticing what is unstable may help you look for other sources of support.", ["self", "uncertainty", "resilience"]],
      ["II.3: remembering earlier happiness without demanding its permanence", "G\xFCzel bir d\xF6nemin bitmesi, o d\xF6nemde ya\u015Fad\u0131\u011F\u0131n iyili\u011Fi hi\xE7 olmam\u0131\u015F yapmaz. Ge\xE7mi\u015Fi yaln\u0131z kayb\u0131n penceresinden okumadan, sana ger\xE7ekten verilmi\u015F olan\u0131 da hat\u0131rlayabilirsin; hat\u0131ra, bug\xFCn\xFCn ac\u0131s\u0131n\u0131 ink\xE2r etmek zorunda de\u011Fildir.", "The end of a good period does not make its goodness unreal. Remembering what you received can coexist with present pain, without asking memory to deny what has been lost.", ["self", "memory", "gratitude"]],
      ["II.4: surviving bonds amid the loss of public fortune", "Bir kay\u0131p hayat\u0131n\u0131n ortas\u0131na yerle\u015Fti\u011Finde, \xE7evresindeki her \u015Fey g\xF6r\xFCnmezle\u015Febilir. Ac\u0131n\u0131 k\xFC\xE7\xFCltmeden, yan\u0131nda kalm\u0131\u015F bir ba\u011F\u0131 da fark etmeyi dene; tek bir ili\u015Fkinin varl\u0131\u011F\u0131 bile hayat\u0131n\u0131n b\xFCt\xFCn\xFCn\xFCn yok olmad\u0131\u011F\u0131n\u0131 hat\u0131rlatabilir.", "A loss can occupy the center until everything around it disappears from view. Without minimizing pain, notice a bond that remains; one relationship can remind you that the whole of life is not gone.", ["self", "connection", "hope"]],
      ["II.5: possessions and adornments cannot supply a person\u2019s own worth", "Sahip oldu\u011Fun \u015Feyler g\xFCzel olabilir; fakat onlar\u0131n g\xFCzelli\u011Fi, senin insanl\u0131k de\u011Ferini \xFCretmez. Benli\u011Fini yaln\u0131z e\u015Fyalar\u0131nla anlatmad\u0131\u011F\u0131nda, bir \u015Fey kaybetmenin neden b\xFCt\xFCn de\u011Ferini kaybetmek anlam\u0131na gelmedi\u011Fini daha a\xE7\u0131k g\xF6rebilirsin.", "Possessions may be beautiful without being the source of your worth. When identity is not described only through belongings, losing a thing need not mean losing everything that makes you valuable.", ["ego", "self", "dignity"]],
      ["II.6: offices do not create virtue in their holders", "Bir unvan\u0131n sana sayg\u0131 getirmesi, onun karakterini senin yerine kurdu\u011Fu anlam\u0131na gelmez. G\xF6revin ne kadar g\xF6r\xFCn\xFCr olursa olsun, adaletin ve \xF6l\xE7\xFCn yine g\xFCnl\xFCk kararlar\u0131nda ortaya \xE7\u0131kar; makam davran\u0131\u015F\u0131n sorumlulu\u011Funu kald\u0131rmaz.", "A title may bring recognition, but it cannot form your character for you. However visible the role, fairness and restraint still have to appear in the decisions you make.", ["ego", "character", "responsibility"]],
      ["II.7: fame measured against the world and time", "Ad\u0131n\u0131n ne kadar duyuldu\u011Fu, ya\u015Fam\u0131n\u0131n b\xFCt\xFCn de\u011Ferini \xF6l\xE7en tek terazi de\u011Fildir. Boethius\u2019un \u015F\xF6hreti geni\u015F zaman i\xE7inde d\xFC\u015F\xFCnmesini hat\u0131rla; g\xF6r\xFClme iste\u011Finin yan\u0131nda, kimse bilmeden \xF6nem ta\u015F\u0131yan u\u011Fra\u015Flar\u0131na da yer a\xE7.", "The reach of your name is not the only measure of a life. Boethius places fame against a wider horizon; make room for pursuits whose importance does not depend on being widely known.", ["ego", "meaning", "recognition"]],
      ["II.8: adverse fortune reveals the quality of friendship", "Ko\u015Fullar de\u011Fi\u015Fti\u011Finde yan\u0131nda kimin kald\u0131\u011F\u0131n\u0131 g\xF6rmek, ili\u015Fkilerinin niteli\u011Fini daha a\xE7\u0131k g\xF6sterebilir. Bu fark edi\u015F kayb\u0131 iyi ilan etmez; yaln\u0131z, zor zamanda belli olan i\xE7ten bir ba\u011Fa daha bilin\xE7li de\u011Fer vermeni sa\u011Flayabilir.", "Changed circumstances may reveal who remains beside you. This does not make loss good; it can help you value more consciously a sincere relationship that becomes visible in difficulty.", ["friendship", "trust", "meaning"]],
      ["III.2: different pursuits aim at happiness", "\u0130nsanlar mutlulu\u011Fu farkl\u0131 \u015Feylerde ararken, sen de pe\u015Finden ko\u015Ftu\u011Fun \u015Feyin hangi ihtiyaca cevap vermesini bekledi\u011Fini sor. Ama\xE7la arac\u0131 ay\u0131rmak, ger\xE7ekten istedi\u011Fin hayat\u0131 yaln\u0131z bir ba\u015Far\u0131 i\u015Faretine indirgememeni kolayla\u015Ft\u0131rabilir.", "When people seek happiness through different pursuits, ask what need you expect your own aim to answer. Distinguishing a means from an end can keep a life from shrinking to one sign of success.", ["self", "purpose", "meaning"]],
      ["III.3: wealth and the continuing experience of need", "Daha fazlas\u0131n\u0131 elde etmek, her zaman yeterlilik duygusu getirmeyebilir. Bir hedef koyarken ne zaman yeter diyece\u011Fini de d\xFC\u015F\xFCn; eksiklik hissinin s\xFCrekli b\xFCy\xFCd\xFC\u011F\xFC bir yar\u0131\u015Fta benli\u011Finin b\xFCt\xFCn enerjisini t\xFCketmek zorunda de\u011Filsin.", "Acquiring more does not always create a sense of enough. When setting an aim, consider what sufficiency would mean, so the pursuit does not absorb your whole life through endlessly renewed need.", ["ego", "desire", "balance"]],
      ["IV.4: wrongdoing, punishment and the rejection of hatred", "Bir haks\u0131zl\u0131\u011F\u0131n d\xFCzelmesini istemekle \xF6fkenin hayat\u0131n\u0131 y\xF6netmesini istemek ayn\u0131 \u015Fey de\u011Fildir. Boethius\u2019un adalet tart\u0131\u015Fmas\u0131 gibi, yap\u0131lan yanl\u0131\u015F\u0131 ciddiye al\u0131rken kendi tutumunun da hangi insana d\xF6n\xFC\u015Fmene hizmet etti\u011Fini d\xFC\u015F\xFCn.", "Wanting a wrong to be corrected differs from wanting anger to govern your life. Take the injustice seriously while considering what your own response is making of you.", ["self", "justice", "will"]]
    ])
  ];

