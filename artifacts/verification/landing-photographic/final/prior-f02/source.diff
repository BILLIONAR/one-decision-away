+.oda-landing-hero :is(button, a):focus-visible { outline: 3px solid #E0AB5A; outline-offset: 5px; box-shadow: 0 0 0 2px #54010C; }
+.oda-landing-hero .oda-landing-button-primary:focus-visible { outline-color: #F7F3EA; }
+.oda-landing-photo-credit { position: absolute; bottom: 18px; right: max(24px, calc((100vw - 1240px) / 2)); display: flex; align-items: center; min-height: 44px; padding: 8px 12px; border-radius: 5px; background: rgb(84 1 12 / 85%); color: #F7F3EA; font-size: 10px; line-height: 1.6; text-underline-offset: 3px; }
+.oda-landing-photo-credit:hover { text-decoration: underline; }
+.oda-landing-example { display: grid; grid-template-columns: .85fr 1.15fr; align-items: center; gap: 86px; padding-block: 74px 78px; border-bottom: 1px solid var(--border-strong); }
+.oda-landing-example .oda-landing-principle { display: flex; flex-direction: column; align-items: flex-start; border: 0; padding: 0; gap: 28px; }
+.oda-landing-example .oda-landing-principle > p { max-width: 20ch; font-size: clamp(31px, 3.1vw, 42px); line-height: 1.18; }
+.oda-landing-example .oda-landing-principle > span { font-size: 11px; gap: 16px; }
+.oda-landing-preview { width: 100%; margin: 0; }
+.oda-landing-preview-stage { min-height: 0; padding: 0; border: 0; border-radius: 0; background: none; }
+.oda-landing-preview-caption { justify-content: space-between; padding: 0 0 17px; color: #54010C; }
+.oda-landing-preview-card { box-shadow: 0 12px 28px -22px rgb(84 1 12 / 35%); }
+.oda-landing-preview-card::before { display: none; }
+.oda-landing-preview-content { min-height: 260px; }
+.oda-landing-preview-controls button[aria-pressed="true"] { background: #C51624; color: #F7F3EA; }
+.oda-landing-preview-controls button[aria-pressed="true"] > span { color: #F7F3EA; }
+.oda-landing-preview figcaption { max-width: none; }
+.oda-landing-course-art { height: 64px; border-bottom: 1px solid var(--border); background: #54010C; color: #F7F3EA; }
+.oda-landing-course-art .oda-landing-course-art-number { position: absolute; top: 18px; left: 25px; color: #E0AB5A; }
+.oda-landing-course-0 .oda-landing-course-art { background: #54010C; }
+.oda-landing-course-1 .oda-landing-course-art { background: #740B1B; color: #F7F3EA; }
+.oda-landing-course-2 .oda-landing-course-art { background: #54010C; color: #F7F3EA; }
+.oda-landing-trust { background: #54010C; }
+.oda-landing-trust .oda-landing-kicker, .oda-landing-trust-items article > span { color: #E0AB5A; }
+.oda-landing-trust-items p { color: #F7F3EA; }
+@media (max-width: 1060px) {
+  .oda-landing-shell { width: calc(100% - 60px); }
+  .oda-landing-example { gap: 45px; }
+  .oda-landing-hero-copy { max-width: 560px; }
+}
+@media (max-width: 640px) {
+  .oda-landing-shell { width: calc(100% - 40px); }
+  .oda-landing-nav-content { min-height: 88px; gap: 12px; }
+  .oda-landing-nav-actions { gap: 10px; }
+  .oda-landing-hero-inner { min-height: 0; padding-block: 53px 305px; }
+  .oda-landing-hero-copy { max-width: 100%; }
+  .oda-landing-hero-photo img { object-position: 65% 50%; }
+  .oda-landing-hero::before { background: linear-gradient(180deg, rgb(84 1 12 / 80%) 0%, rgb(84 1 12 / 72%) 36%, rgb(84 1 12 / 62%) 64%, rgb(84 1 12 / 4%) 80%, transparent 89%); }
+  .oda-landing-title { max-width: 12ch; font-size: clamp(47px, 14.8vw, 70px); line-height: 1.05; margin-block: 22px; }
+  .oda-landing-introduction { font-size: 15px; line-height: 1.85; }
+  .oda-landing-hero-actions { gap: 7px 18px; margin-top: 26px; }
+  .oda-landing-hero-actions .oda-landing-button { padding-inline: 20px; font-size: 13px; }
+  .oda-landing-hero-actions .oda-landing-link { font-size: 12px; }
+  .oda-landing-privacy { margin-top: 16px; font-size: 11px; }
+  .oda-landing-photo-credit { right: 20px; bottom: 16px; }
+  .oda-landing-example { grid-template-columns: 1fr; gap: 34px; padding-block: 47px 48px; }
+  .oda-landing-example .oda-landing-principle { gap: 16px; }
+  .oda-landing-example .oda-landing-principle > p { max-width: 24ch; font-size: 29px; }
+  .oda-landing-preview-content { min-height: 285px; }
+  .oda-landing-preview-card { padding-inline: 21px; }
+  .oda-landing-preview-title { font-size: 30px; }
+  .oda-landing-preview-controls button { flex-direction: row; }
+}
+@media (max-width: 359px) {
+  .oda-landing-shell { width: calc(100% - 32px); }
+  .oda-landing-nav-actions { gap: 7px; }
+  .oda-landing-nav-content { gap: 7px; }
+  .oda-landing-hero-inner { padding-top: 43px; }
+  .oda-landing-title { font-size: 47px; }
+  .oda-landing-hero-actions .oda-landing-button { width: 100%; }
+  .oda-landing-preview-card { padding-inline: 17px; }
+  .oda-landing-preview-title { font-size: 27px; }
+  .oda-landing-preview-controls button { flex-direction: column; }
+}
