+
+/* All palette changes belong to the public landing, including under dark preference. */
+.oda-landing {
+  --bg: #F7F3EA;
+  --fg: #54010C;
+  --fg-muted: #79535A;
+  --bg-muted: #F1E7DC;
+  --bg-elevated: #FFFDF8;
+  --border: #DECABA;
+  --border-strong: #AD8074;
+  --accent: #C51624;
+  --on-accent: #F7F3EA;
+  --accent-soft: #FAE6E6;
+  --brand-burgundy: #54010C;
+  --brand-burgundy-soft: #F4DDD9;
+}
+.oda-landing-shell { width: min(1240px, calc(100% - 80px)); }
+.oda-landing .oda-domino8-mark { filter: none; }
